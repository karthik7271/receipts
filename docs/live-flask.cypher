  (:Symbol {body_hash: '770f22649fecf1bf', deleted: false, end: 90, key: 'src/flask/json/tag.py::JSONTag.tag', kind: 'method', name: 'tag', path: 'src/flask/json/tag.py', qualname: 'JSONTag.tag', sig_hash: '81e944650cc6d217', signature: 'tag(self, value: t.Any) -> dict[str, t.Any]', source: '    def tag(self, value: t.Any) -> dict[str, t.Any]:\n        """Convert the value to a valid JSON type and add the tag structure\n        around it."""\n        return {self.key: self.to_json(value)}', start: 87, tick: 5, types_hash: '24e5243b2a36da0e', _vid: 508}),
  (:Symbol {body_hash: '4f79a3388e04752c', deleted: false, end: 116, key: 'src/flask/json/tag.py::TagDict', kind: 'class', name: 'TagDict', path: 'src/flask/json/tag.py', qualname: 'TagDict', sig_hash: 'c0b5926b89b3cbaa', signature: 'class TagDict(JSONTag)', source: 'class TagDict(JSONTag):\n    """Tag for 1-item dicts whose only key matches a registered tag.\n\n    Internally, the dict key is suffixed with `__`, and the suffix is removed\n    when deserializing.\n    """\n\n    __slots__ = ()\n    key = " di"\n\n    def check(self, value: t.Any) -> bool:\n        return (\n            isinstance(value, dict)\n            and len(value) == 1\n            and next(iter(value)) in self.serializer.tags\n        )\n\n    def to_json(self, value: t.Any) -> t.Any:\n        key = next(iter(value))\n        return {f"{key}__": self.serializer.tag(value[key])}\n\n    def to_python(self, value: t.Any) -> t.Any:\n        key = next(iter(value))\n        return {key[:-2]: value[key]}', start: 93, tick: 5, types_hash: '', _vid: 509}),
  (:Symbol {body_hash: 'a147c81b8a965728', deleted: false, end: 108, key: 'src/flask/json/tag.py::TagDict.check', kind: 'method', name: 'check', path: 'src/flask/json/tag.py', qualname: 'TagDict.check', sig_hash: '81e944650cc6d217', signature: 'check(self, value: t.Any) -> bool', source: '    def check(self, value: t.Any) -> bool:\n        return (\n            isinstance(value, dict)\n            and len(value) == 1\n            and next(iter(value)) in self.serializer.tags\n        )', start: 103, tick: 5, types_hash: 'd437b73b0779045c', _vid: 510}),
  (:Symbol {body_hash: 'f8fd7aae5a345a9f', deleted: false, end: 112, key: 'src/flask/json/tag.py::TagDict.to_json', kind: 'method', name: 'to_json', path: 'src/flask/json/tag.py', qualname: 'TagDict.to_json', sig_hash: '81e944650cc6d217', signature: 'to_json(self, value: t.Any) -> t.Any', source: '    def to_json(self, value: t.Any) -> t.Any:\n        key = next(iter(value))\n        return {f"{key}__": self.serializer.tag(value[key])}', start: 110, tick: 5, types_hash: '84217169eaf761d6', _vid: 511}),
  (:Symbol {body_hash: 'f00a5cb181f6b3fa', deleted: false, end: 116, key: 'src/flask/json/tag.py::TagDict.to_python', kind: 'method', name: 'to_python', path: 'src/flask/json/tag.py', qualname: 'TagDict.to_python', sig_hash: '81e944650cc6d217', signature: 'to_python(self, value: t.Any) -> t.Any', source: '    def to_python(self, value: t.Any) -> t.Any:\n        key = next(iter(value))\n        return {key[:-2]: value[key]}', start: 114, tick: 5, types_hash: '84217169eaf761d6', _vid: 512}),
  (:Symbol {body_hash: 'd4f2b9af11cc5796', deleted: false, end: 130, key: 'src/flask/json/tag.py::PassDict', kind: 'class', name: 'PassDict', path: 'src/flask/json/tag.py', qualname: 'PassDict', sig_hash: 'c0b5926b89b3cbaa', signature: 'class PassDict(JSONTag)', source: 'class PassDict(JSONTag):\n    __slots__ = ()\n\n    def check(self, value: t.Any) -> bool:\n        return isinstance(value, dict)\n\n    def to_json(self, value: t.Any) -> t.Any:\n        # JSON objects may only have string keys, so don\'t bother tagging the\n        # key here.\n        return {k: self.serializer.tag(v) for k, v in value.items()}\n\n    tag = to_json', start: 119, tick: 5, types_hash: '', _vid: 513}),
  (:Symbol {body_hash: 'd0c027e75c689079', deleted: false, end: 123, key: 'src/flask/json/tag.py::PassDict.check', kind: 'method', name: 'check', path: 'src/flask/json/tag.py', qualname: 'PassDict.check', sig_hash: '81e944650cc6d217', signature: 'check(self, value: t.Any) -> bool', source: '    def check(self, value: t.Any) -> bool:\n        return isinstance(value, dict)', start: 122, tick: 5, types_hash: 'd437b73b0779045c', _vid: 514}),
  (:Symbol {body_hash: 'a171dcc464642ca3', deleted: false, end: 128, key: 'src/flask/json/tag.py::PassDict.to_json', kind: 'method', name: 'to_json', path: 'src/flask/json/tag.py', qualname: 'PassDict.to_json', sig_hash: '81e944650cc6d217', signature: 'to_json(self, value: t.Any) -> t.Any', source: '    def to_json(self, value: t.Any) -> t.Any:\n        # JSON objects may only have string keys, so don\'t bother tagging the\n        # key here.\n        return {k: self.serializer.tag(v) for k, v in value.items()}', start: 125, tick: 5, types_hash: '84217169eaf761d6', _vid: 515}),
  (:Symbol {body_hash: '920b0f0870285b29', deleted: false, end: 144, key: 'src/flask/json/tag.py::TagTuple', kind: 'class', name: 'TagTuple', path: 'src/flask/json/tag.py', qualname: 'TagTuple', sig_hash: 'c0b5926b89b3cbaa', signature: 'class TagTuple(JSONTag)', source: 'class TagTuple(JSONTag):\n    __slots__ = ()\n    key = " t"\n\n    def check(self, value: t.Any) -> bool:\n        return isinstance(value, tuple)\n\n    def to_json(self, value: t.Any) -> t.Any:\n        return [self.serializer.tag(item) for item in value]\n\n    def to_python(self, value: t.Any) -> t.Any:\n        return tuple(value)', start: 133, tick: 5, types_hash: '', _vid: 516}),
  (:Symbol {body_hash: '5f465a4802be59cd', deleted: false, end: 138, key: 'src/flask/json/tag.py::TagTuple.check', kind: 'method', name: 'check', path: 'src/flask/json/tag.py', qualname: 'TagTuple.check', sig_hash: '81e944650cc6d217', signature: 'check(self, value: t.Any) -> bool', source: '    def check(self, value: t.Any) -> bool:\n        return isinstance(value, tuple)', start: 137, tick: 5, types_hash: 'd437b73b0779045c', _vid: 517}),
  (:Symbol {body_hash: 'e8961330389b501c', deleted: false, end: 141, key: 'src/flask/json/tag.py::TagTuple.to_json', kind: 'method', name: 'to_json', path: 'src/flask/json/tag.py', qualname: 'TagTuple.to_json', sig_hash: '81e944650cc6d217', signature: 'to_json(self, value: t.Any) -> t.Any', source: '    def to_json(self, value: t.Any) -> t.Any:\n        return [self.serializer.tag(item) for item in value]', start: 140, tick: 5, types_hash: '84217169eaf761d6', _vid: 518}),
  (:Symbol {body_hash: '422d6f397d6a0e7c', deleted: false, end: 144, key: 'src/flask/json/tag.py::TagTuple.to_python', kind: 'method', name: 'to_python', path: 'src/flask/json/tag.py', qualname: 'TagTuple.to_python', sig_hash: '81e944650cc6d217', signature: 'to_python(self, value: t.Any) -> t.Any', source: '    def to_python(self, value: t.Any) -> t.Any:\n        return tuple(value)', start: 143, tick: 5, types_hash: '84217169eaf761d6', _vid: 519}),
  (:Symbol {body_hash: 'e2f1468a4d322564', deleted: false, end: 156, key: 'src/flask/json/tag.py::PassList', kind: 'class', name: 'PassList', path: 'src/flask/json/tag.py', qualname: 'PassList', sig_hash: 'c0b5926b89b3cbaa', signature: 'class PassList(JSONTag)', source: 'class PassList(JSONTag):\n    __slots__ = ()\n\n    def check(self, value: t.Any) -> bool:\n        return isinstance(value, list)\n\n    def to_json(self, value: t.Any) -> t.Any:\n        return [self.serializer.tag(item) for item in value]\n\n    tag = to_json', start: 147, tick: 5, types_hash: '', _vid: 520}),
  (:Symbol {body_hash: '09926725c203c479', deleted: false, end: 151, key: 'src/flask/json/tag.py::PassList.check', kind: 'method', name: 'check', path: 'src/flask/json/tag.py', qualname: 'PassList.check', sig_hash: '81e944650cc6d217', signature: 'check(self, value: t.Any) -> bool', source: '    def check(self, value: t.Any) -> bool:\n        return isinstance(value, list)', start: 150, tick: 5, types_hash: 'd437b73b0779045c', _vid: 521}),
  (:Symbol {body_hash: 'e8961330389b501c', deleted: false, end: 154, key: 'src/flask/json/tag.py::PassList.to_json', kind: 'method', name: 'to_json', path: 'src/flask/json/tag.py', qualname: 'PassList.to_json', sig_hash: '81e944650cc6d217', signature: 'to_json(self, value: t.Any) -> t.Any', source: '    def to_json(self, value: t.Any) -> t.Any:\n        return [self.serializer.tag(item) for item in value]', start: 153, tick: 5, types_hash: '84217169eaf761d6', _vid: 522}),
  (:Symbol {body_hash: 'd9fa69ec58a0a6df', deleted: false, end: 170, key: 'src/flask/json/tag.py::TagBytes', kind: 'class', name: 'TagBytes', path: 'src/flask/json/tag.py', qualname: 'TagBytes', sig_hash: 'c0b5926b89b3cbaa', signature: 'class TagBytes(JSONTag)', source: 'class TagBytes(JSONTag):\n    __slots__ = ()\n    key = " b"\n\n    def check(self, value: t.Any) -> bool:\n        return isinstance(value, bytes)\n\n    def to_json(self, value: t.Any) -> t.Any:\n        return b64encode(value).decode("ascii")\n\n    def to_python(self, value: t.Any) -> t.Any:\n        return b64decode(value)', start: 159, tick: 5, types_hash: '', _vid: 523}),
  (:Symbol {body_hash: '52d257e08d45b25f', deleted: false, end: 164, key: 'src/flask/json/tag.py::TagBytes.check', kind: 'method', name: 'check', path: 'src/flask/json/tag.py', qualname: 'TagBytes.check', sig_hash: '81e944650cc6d217', signature: 'check(self, value: t.Any) -> bool', source: '    def check(self, value: t.Any) -> bool:\n        return isinstance(value, bytes)', start: 163, tick: 5, types_hash: 'd437b73b0779045c', _vid: 524}),
  (:Symbol {body_hash: 'c1c45f0f67e142d3', deleted: false, end: 167, key: 'src/flask/json/tag.py::TagBytes.to_json', kind: 'method', name: 'to_json', path: 'src/flask/json/tag.py', qualname: 'TagBytes.to_json', sig_hash: '81e944650cc6d217', signature: 'to_json(self, value: t.Any) -> t.Any', source: '    def to_json(self, value: t.Any) -> t.Any:\n        return b64encode(value).decode("ascii")', start: 166, tick: 5, types_hash: '84217169eaf761d6', _vid: 525}),
  (:Symbol {body_hash: '0b4ecef60c670ad8', deleted: false, end: 170, key: 'src/flask/json/tag.py::TagBytes.to_python', kind: 'method', name: 'to_python', path: 'src/flask/json/tag.py', qualname: 'TagBytes.to_python', sig_hash: '81e944650cc6d217', signature: 'to_python(self, value: t.Any) -> t.Any', source: '    def to_python(self, value: t.Any) -> t.Any:\n        return b64decode(value)', start: 169, tick: 5, types_hash: '84217169eaf761d6', _vid: 526}),
  (:Symbol {body_hash: '68a3c5d582ad37c2', deleted: false, end: 188, key: 'src/flask/json/tag.py::TagMarkup', kind: 'class', name: 'TagMarkup', path: 'src/flask/json/tag.py', qualname: 'TagMarkup', sig_hash: 'c0b5926b89b3cbaa', signature: 'class TagMarkup(JSONTag)', source: 'class TagMarkup(JSONTag):\n    """Serialize anything matching the :class:`~markupsafe.Markup` API by\n    having a ``__html__`` method to the result of that method. Always\n    deserializes to an instance of :class:`~markupsafe.Markup`."""\n\n    __slots__ = ()\n    key = " m"\n\n    def check(self, value: t.Any) -> bool:\n        return callable(getattr(value, "__html__", None))\n\n    def to_json(self, value: t.Any) -> t.Any:\n        return str(value.__html__())\n\n    def to_python(self, value: t.Any) -> t.Any:\n        return Markup(value)', start: 173, tick: 5, types_hash: '', _vid: 527}),
  (:Symbol {body_hash: 'fdc805c926be666f', deleted: false, end: 182, key: 'src/flask/json/tag.py::TagMarkup.check', kind: 'method', name: 'check', path: 'src/flask/json/tag.py', qualname: 'TagMarkup.check', sig_hash: '81e944650cc6d217', signature: 'check(self, value: t.Any) -> bool', source: '    def check(self, value: t.Any) -> bool:\n        return callable(getattr(value, "__html__", None))', start: 181, tick: 5, types_hash: 'd437b73b0779045c', _vid: 528}),
  (:Symbol {body_hash: '1b719c7f71d0b229', deleted: false, end: 185, key: 'src/flask/json/tag.py::TagMarkup.to_json', kind: 'method', name: 'to_json', path: 'src/flask/json/tag.py', qualname: 'TagMarkup.to_json', sig_hash: '81e944650cc6d217', signature: 'to_json(self, value: t.Any) -> t.Any', source: '    def to_json(self, value: t.Any) -> t.Any:\n        return str(value.__html__())', start: 184, tick: 5, types_hash: '84217169eaf761d6', _vid: 529}),
  (:Symbol {body_hash: '09210d6ebbcdb220', deleted: false, end: 188, key: 'src/flask/json/tag.py::TagMarkup.to_python', kind: 'method', name: 'to_python', path: 'src/flask/json/tag.py', qualname: 'TagMarkup.to_python', sig_hash: '81e944650cc6d217', signature: 'to_python(self, value: t.Any) -> t.Any', source: '    def to_python(self, value: t.Any) -> t.Any:\n        return Markup(value)', start: 187, tick: 5, types_hash: '84217169eaf761d6', _vid: 530}),
  (:Symbol {body_hash: '90151ff7cf10ea7b', deleted: false, end: 202, key: 'src/flask/json/tag.py::TagUUID', kind: 'class', name: 'TagUUID', path: 'src/flask/json/tag.py', qualname: 'TagUUID', sig_hash: 'c0b5926b89b3cbaa', signature: 'class TagUUID(JSONTag)', source: 'class TagUUID(JSONTag):\n    __slots__ = ()\n    key = " u"\n\n    def check(self, value: t.Any) -> bool:\n        return isinstance(value, UUID)\n\n    def to_json(self, value: t.Any) -> t.Any:\n        return value.hex\n\n    def to_python(self, value: t.Any) -> t.Any:\n        return UUID(value)', start: 191, tick: 5, types_hash: '', _vid: 531}),
  (:Symbol {body_hash: '96bf4003e82d5a4b', deleted: false, end: 196, key: 'src/flask/json/tag.py::TagUUID.check', kind: 'method', name: 'check', path: 'src/flask/json/tag.py', qualname: 'TagUUID.check', sig_hash: '81e944650cc6d217', signature: 'check(self, value: t.Any) -> bool', source: '    def check(self, value: t.Any) -> bool:\n        return isinstance(value, UUID)', start: 195, tick: 5, types_hash: 'd437b73b0779045c', _vid: 532}),
  (:Symbol {body_hash: 'cf576bd60ac7275e', deleted: false, end: 199, key: 'src/flask/json/tag.py::TagUUID.to_json', kind: 'method', name: 'to_json', path: 'src/flask/json/tag.py', qualname: 'TagUUID.to_json', sig_hash: '81e944650cc6d217', signature: 'to_json(self, value: t.Any) -> t.Any', source: '    def to_json(self, value: t.Any) -> t.Any:\n        return value.hex', start: 198, tick: 5, types_hash: '84217169eaf761d6', _vid: 533}),
  (:Symbol {body_hash: '28d77bb35416a5c9', deleted: false, end: 202, key: 'src/flask/json/tag.py::TagUUID.to_python', kind: 'method', name: 'to_python', path: 'src/flask/json/tag.py', qualname: 'TagUUID.to_python', sig_hash: '81e944650cc6d217', signature: 'to_python(self, value: t.Any) -> t.Any', source: '    def to_python(self, value: t.Any) -> t.Any:\n        return UUID(value)', start: 201, tick: 5, types_hash: '84217169eaf761d6', _vid: 534}),
  (:Symbol {body_hash: 'f967542cbf9303e7', deleted: false, end: 216, key: 'src/flask/json/tag.py::TagDateTime', kind: 'class', name: 'TagDateTime', path: 'src/flask/json/tag.py', qualname: 'TagDateTime', sig_hash: 'c0b5926b89b3cbaa', signature: 'class TagDateTime(JSONTag)', source: 'class TagDateTime(JSONTag):\n    __slots__ = ()\n    key = " d"\n\n    def check(self, value: t.Any) -> bool:\n        return isinstance(value, datetime)\n\n    def to_json(self, value: t.Any) -> t.Any:\n        return http_date(value)\n\n    def to_python(self, value: t.Any) -> t.Any:\n        return parse_date(value)', start: 205, tick: 5, types_hash: '', _vid: 535}),
  (:Symbol {body_hash: 'bab0692866078059', deleted: false, end: 210, key: 'src/flask/json/tag.py::TagDateTime.check', kind: 'method', name: 'check', path: 'src/flask/json/tag.py', qualname: 'TagDateTime.check', sig_hash: '81e944650cc6d217', signature: 'check(self, value: t.Any) -> bool', source: '    def check(self, value: t.Any) -> bool:\n        return isinstance(value, datetime)', start: 209, tick: 5, types_hash: 'd437b73b0779045c', _vid: 536}),
  (:Symbol {body_hash: 'c5ee0430539bbeb8', deleted: false, end: 213, key: 'src/flask/json/tag.py::TagDateTime.to_json', kind: 'method', name: 'to_json', path: 'src/flask/json/tag.py', qualname: 'TagDateTime.to_json', sig_hash: '81e944650cc6d217', signature: 'to_json(self, value: t.Any) -> t.Any', source: '    def to_json(self, value: t.Any) -> t.Any:\n        return http_date(value)', start: 212, tick: 5, types_hash: '84217169eaf761d6', _vid: 537}),
  (:Symbol {body_hash: '933f10996f371ea7', deleted: false, end: 216, key: 'src/flask/json/tag.py::TagDateTime.to_python', kind: 'method', name: 'to_python', path: 'src/flask/json/tag.py', qualname: 'TagDateTime.to_python', sig_hash: '81e944650cc6d217', signature: 'to_python(self, value: t.Any) -> t.Any', source: '    def to_python(self, value: t.Any) -> t.Any:\n        return parse_date(value)', start: 215, tick: 5, types_hash: '84217169eaf761d6', _vid: 538}),
  (:Symbol {body_hash: '251f68071ac00a3a', deleted: false, end: 327, key: 'src/flask/json/tag.py::TaggedJSONSerializer', kind: 'class', name: 'TaggedJSONSerializer', path: 'src/flask/json/tag.py', qualname: 'TaggedJSONSerializer', sig_hash: '42ba610a86d15094', signature: 'class TaggedJSONSerializer', source: 'class TaggedJSONSerializer:\n    """Serializer that uses a tag system to compactly represent objects that\n    are not JSON types. Passed as the intermediate serializer to\n    :class:`itsdangerous.Serializer`.\n\n    The following extra types are supported:\n\n    * :class:`dict`\n    * :class:`tuple`\n    * :class:`bytes`\n    * :class:`~markupsafe.Markup`\n    * :class:`~uuid.UUID`\n    * :class:`~datetime.datetime`\n    """\n\n    __slots__ = ("tags", "order")\n\n    #: Tag classes to bind when creating the serializer. Other tags can be\n    #: added later using :meth:`~register`.\n    default_tags = [\n        TagDict,\n        PassDict,\n        TagTuple,\n        PassList,\n        TagBytes,\n        TagMarkup,\n        TagUUID,\n        TagDateTime,\n    ]\n\n    def __init__(self) -> None:\n        self.tags: dict[str, JSONTag] = {}\n        self.order: list[JSONTag] = []\n\n        for cls in self.default_tags:\n            self.register(cls)\n\n    def register(\n        self,\n        tag_class: type[JSONTag],\n        force: bool = False,\n        index: int | None = None,\n    ) -> None:\n        """Register a new tag with this serializer.\n\n        :param tag_class: tag class to register. Will be instantiated with this\n            serializer instance.\n        :param force: overwrite an existing tag. If false (default), a\n            :exc:`KeyError` is raised.\n        :param index: index to insert the new tag in the tag order. Useful when\n            the new tag is a special case of an existing tag. If ``\n…', start: 219, tick: 5, types_hash: '', _vid: 539}),
  (:Symbol {body_hash: '4b93d7d60d7f34ca', deleted: false, end: 254, key: 'src/flask/json/tag.py::TaggedJSONSerializer.__init__', kind: 'method', name: '__init__', path: 'src/flask/json/tag.py', qualname: 'TaggedJSONSerializer.__init__', sig_hash: '9626d105938f0039', signature: '__init__(self) -> None', source: '    def __init__(self) -> None:\n        self.tags: dict[str, JSONTag] = {}\n        self.order: list[JSONTag] = []\n\n        for cls in self.default_tags:\n            self.register(cls)', start: 249, tick: 5, types_hash: '80ab440e4379605f', _vid: 540}),
  (:Symbol {body_hash: '6b9fa299584b0c3a', deleted: false, end: 287, key: 'src/flask/json/tag.py::TaggedJSONSerializer.register', kind: 'method', name: 'register', path: 'src/flask/json/tag.py', qualname: 'TaggedJSONSerializer.register', sig_hash: '6406467eb4e078f5', signature: 'register(self, tag_class: type[JSONTag], force: bool=False, index: int | None=None) -> None', source: '    def register(\n        self,\n        tag_class: type[JSONTag],\n        force: bool = False,\n        index: int | None = None,\n    ) -> None:\n        """Register a new tag with this serializer.\n\n        :param tag_class: tag class to register. Will be instantiated with this\n            serializer instance.\n        :param force: overwrite an existing tag. If false (default), a\n            :exc:`KeyError` is raised.\n        :param index: index to insert the new tag in the tag order. Useful when\n            the new tag is a special case of an existing tag. If ``None``\n            (default), the tag is appended to the end of the order.\n\n        :raise KeyError: if the tag key is already registered and ``force`` is\n            not true.\n        """\n        tag = tag_class(self)\n        key = tag.key\n\n        if key:\n            if not force and key in self.tags:\n                raise KeyError(f"Tag \'{key}\' is already registered.")\n\n            self.tags[key] = tag\n\n        if index is None:\n            self.order.append(tag)\n        else:\n            self.order.insert(index, tag)', start: 256, tick: 5, types_hash: 'ba04d595d4977070', _vid: 541}),
  (:Symbol {body_hash: '9faeb1a946e2e6ba', deleted: false, end: 295, key: 'src/flask/json/tag.py::TaggedJSONSerializer.tag', kind: 'method', name: 'tag', path: 'src/flask/json/tag.py', qualname: 'TaggedJSONSerializer.tag', sig_hash: '81e944650cc6d217', signature: 'tag(self, value: t.Any) -> t.Any', source: '    def tag(self, value: t.Any) -> t.Any:\n        """Convert a value to a tagged representation if necessary."""\n        for tag in self.order:\n            if tag.check(value):\n                return tag.tag(value)\n\n        return value', start: 289, tick: 5, types_hash: '84217169eaf761d6', _vid: 542}),
  (:Symbol {body_hash: '9aef7a6f38130746', deleted: false, end: 307, key: 'src/flask/json/tag.py::TaggedJSONSerializer.untag', kind: 'method', name: 'untag', path: 'src/flask/json/tag.py', qualname: 'TaggedJSONSerializer.untag', sig_hash: '81e944650cc6d217', signature: 'untag(self, value: dict[str, t.Any]) -> t.Any', source: '    def untag(self, value: dict[str, t.Any]) -> t.Any:\n        """Convert a tagged representation back to the original type."""\n        if len(value) != 1:\n            return value\n\n        key = next(iter(value))\n\n        if key not in self.tags:\n            return value\n\n        return self.tags[key].to_python(value[key])', start: 297, tick: 5, types_hash: '1e8884b18f4da0f9', _vid: 543}),
  (:Symbol {body_hash: '23ba27c2e9300484', deleted: false, end: 323, key: 'src/flask/json/tag.py::TaggedJSONSerializer.dumps', kind: 'method', name: 'dumps', path: 'src/flask/json/tag.py', qualname: 'TaggedJSONSerializer.dumps', sig_hash: '81e944650cc6d217', signature: 'dumps(self, value: t.Any) -> str', source: '    def dumps(self, value: t.Any) -> str:\n        """Tag the value and dump it to a compact JSON string."""\n        return dumps(self.tag(value), separators=(",", ":"))', start: 321, tick: 5, types_hash: '4b2cfac68a28cc19', _vid: 544}),
  (:Symbol {body_hash: '552f1df8b84f5cb9', deleted: false, end: 327, key: 'src/flask/json/tag.py::TaggedJSONSerializer.loads', kind: 'method', name: 'loads', path: 'src/flask/json/tag.py', qualname: 'TaggedJSONSerializer.loads', sig_hash: '81e944650cc6d217', signature: 'loads(self, value: str) -> t.Any', source: '    def loads(self, value: str) -> t.Any:\n        """Load data from a JSON string and deserialized any tagged objects."""\n        return self._untag_scan(loads(value))', start: 325, tick: 5, types_hash: '4f70da5a07243f07', _vid: 545}),
  (:Symbol {body_hash: 'd88e9d3e1afd5b15', deleted: false, end: 28, key: 'src/flask/logging.py::wsgi_errors_stream', kind: 'function', name: 'wsgi_errors_stream', path: 'src/flask/logging.py', qualname: 'wsgi_errors_stream', sig_hash: '4943fbd3d489f4fa', signature: 'wsgi_errors_stream() -> t.TextIO', source: '@LocalProxy\ndef wsgi_errors_stream() -> t.TextIO:\n    """Find the most appropriate error stream for the application. If a request\n    is active, log to ``wsgi.errors``, otherwise use ``sys.stderr``.\n\n    If you configure your own :class:`logging.StreamHandler`, you may want to\n    use this for the stream. If you are using file or dict configuration and\n    can\'t import this directly, you can refer to it as\n    ``ext://flask.logging.wsgi_errors_stream``.\n    """\n    if request:\n        return request.environ["wsgi.errors"]  # type: ignore[no-any-return]\n\n    return sys.stderr', start: 16, tick: 5, types_hash: '040d832286ce15da', _vid: 546}),
  (:Symbol {body_hash: 'c4e0dffce3d4515f', deleted: false, end: 47, key: 'src/flask/logging.py::has_level_handler', kind: 'function', name: 'has_level_handler', path: 'src/flask/logging.py', qualname: 'has_level_handler', sig_hash: '6ceacff419e43d26', signature: 'has_level_handler(logger: logging.Logger) -> bool', source: 'def has_level_handler(logger: logging.Logger) -> bool:\n    """Check if there is a handler in the logging chain that will handle the\n    given logger\'s :meth:`effective level <~logging.Logger.getEffectiveLevel>`.\n    """\n    level = logger.getEffectiveLevel()\n    current = logger\n\n    while current:\n        if any(handler.level <= level for handler in current.handlers):\n            return True\n\n        if not current.propagate:\n            break\n\n        current = current.parent  # type: ignore\n\n    return False', start: 31, tick: 5, types_hash: 'e209d15103aa27b7', _vid: 547}),
  (:Symbol {body_hash: 'c8bc8e26109944d0', deleted: false, end: 79, key: 'src/flask/logging.py::create_logger', kind: 'function', name: 'create_logger', path: 'src/flask/logging.py', qualname: 'create_logger', sig_hash: '462ce794eb370ded', signature: 'create_logger(app: App) -> logging.Logger', source: 'def create_logger(app: App) -> logging.Logger:\n    """Get the Flask app\'s logger and configure it if needed.\n\n    The logger name will be the same as\n    :attr:`app.import_name <flask.Flask.name>`.\n\n    When :attr:`~flask.Flask.debug` is enabled, set the logger level to\n    :data:`logging.DEBUG` if it is not set.\n\n    If there is no handler for the logger\'s effective level, add a\n    :class:`~logging.StreamHandler` for\n    :func:`~flask.logging.wsgi_errors_stream` with a basic format.\n    """\n    logger = logging.getLogger(app.name)\n\n    if app.debug and not logger.level:\n        logger.setLevel(logging.DEBUG)\n\n    if not has_level_handler(logger):\n        logger.addHandler(default_handler)\n\n    return logger', start: 58, tick: 5, types_hash: '1739a371a8698572', _vid: 548}),
  (:Symbol {body_hash: 'f604b0b59c6ab26d', deleted: true, deleted_tick: 5, end: 31, key: 'src/flask/scaffold.py::F', kind: 'constant', name: 'F', path: 'src/flask/scaffold.py', qualname: 'F', sig_hash: 'f604b0b59c6ab26d', signature: 'F = t.TypeVar("F", bound=t.Callable[..., t.Any])', source: 'F = t.TypeVar("F", bound=t.Callable[..., t.Any])', start: 31, tick: 1, types_hash: '', _vid: 549}),
  (:Symbol {body_hash: '8110d6e1adcd3a47', deleted: true, deleted_tick: 5, end: 53, key: 'src/flask/scaffold.py::setupmethod', kind: 'function', name: 'setupmethod', path: 'src/flask/scaffold.py', qualname: 'setupmethod', sig_hash: '5f4579065549aa63', signature: 'setupmethod(f: F) -> F', source: 'def setupmethod(f: F) -> F:\n    f_name = f.__name__\n\n    def wrapper_func(self, *args: t.Any, **kwargs: t.Any) -> t.Any:\n        self._check_setup_finished(f_name)\n        return f(self, *args, **kwargs)\n\n    return t.cast(F, update_wrapper(wrapper_func, f))', start: 46, tick: 1, types_hash: '12142ee83ef0c418', _vid: 550}),
  (:Symbol {body_hash: '589a0975b53117c8', deleted: true, deleted_tick: 5, end: 772, key: 'src/flask/scaffold.py::Scaffold', kind: 'class', name: 'Scaffold', path: 'src/flask/scaffold.py', qualname: 'Scaffold', sig_hash: '42ba610a86d15094', signature: 'class Scaffold', source: 'class Scaffold:\n    """Common behavior shared between :class:`~flask.Flask` and\n    :class:`~flask.blueprints.Blueprint`.\n\n    :param import_name: The import name of the module where this object\n        is defined. Usually :attr:`__name__` should be used.\n    :param static_folder: Path to a folder of static files to serve.\n        If this is set, a static route will be added.\n    :param static_url_path: URL prefix for the static route.\n    :param template_folder: Path to a folder containing template files.\n        for rendering. If this is set, a Jinja loader will be added.\n    :param root_path: The path that static, template, and resource files\n        are relative to. Typically not set, it is discovered based on\n        the ``import_name``.\n\n    .. versionadded:: 2.0\n    """\n\n    name: str\n    _static_folder: str | None = None\n    _static_url_path: str | None = None\n\n    def __init__(\n        self,\n        import_name: str,\n        static_folder: str | os.PathLike | None = None,\n        static_url_path: str | None = None,\n        template_folder: str | os.PathLike | None = None,\n        root_path: str | None = None,\n    ):\n        #: The name of the package or module that this object belongs\n        #: to. Do not change this once it is set by the constructor.\n        self.import_name = import_name\n\n        self.static_folder = static_folder  # type: ignore\n        self.static_url_path = static_url_path\n\n        #: The path to the templates folder, relative to\n        #: :at\n…', start: 56, tick: 1, types_hash: '', _vid: 551}),
  (:Symbol {body_hash: '22bf2617310e755f', deleted: true, deleted_tick: 5, end: 224, key: 'src/flask/scaffold.py::Scaffold.__init__', kind: 'method', name: '__init__', path: 'src/flask/scaffold.py', qualname: 'Scaffold.__init__', sig_hash: '0f70264e9ecfb7af', signature: '__init__(self, import_name: str, static_folder: str | os.PathLike | None=None, static_url_path: str | None=None, template_folder: str | os.PathLike | None=None, root_path: str | None=None)', source: '    def __init__(\n        self,\n        import_name: str,\n        static_folder: str | os.PathLike | None = None,\n        static_url_path: str | None = None,\n        template_folder: str | os.PathLike | None = None,\n        root_path: str | None = None,\n    ):\n        #: The name of the package or module that this object belongs\n        #: to. Do not change this once it is set by the constructor.\n        self.import_name = import_name\n\n        self.static_folder = static_folder  # type: ignore\n        self.static_url_path = static_url_path\n\n        #: The path to the templates folder, relative to\n        #: :attr:`root_path`, to add to the template loader. ``None`` if\n        #: templates should not be added.\n        self.template_folder = template_folder\n\n        if root_path is None:\n            root_path = get_root_path(self.import_name)\n\n        #: Absolute path to the package on the filesystem. Used to look\n        #: up resources contained in the package.\n        self.root_path = root_path\n\n        #: The Click command group for registering CLI commands for this\n        #: object. The commands are available from the ``flask`` command\n        #: once the application has been discovered and blueprints have\n        #: been registered.\n        self.cli = AppGroup()\n\n        #: A dictionary mapping endpoint names to view functions.\n        #:\n        #: To register a view function, use the :meth:`route` decorator.\n        #:\n        #: This data structure is internal. It sho\n…', start: 78, tick: 1, types_hash: 'c9d4785f23a45e66', _vid: 552}),
  (:Symbol {body_hash: '3f9a12fc6fc594a8', deleted: true, deleted_tick: 5, end: 227, key: 'src/flask/scaffold.py::Scaffold.__repr__', kind: 'method', name: '__repr__', path: 'src/flask/scaffold.py', qualname: 'Scaffold.__repr__', sig_hash: '9626d105938f0039', signature: '__repr__(self) -> str', source: '    def __repr__(self) -> str:\n        return f"<{type(self).__name__} {self.name!r}>"', start: 226, tick: 1, types_hash: '151bde88b2690c8e', _vid: 553}),
  (:Symbol {body_hash: '20355cbd5020aeb4', deleted: true, deleted_tick: 5, end: 230, key: 'src/flask/scaffold.py::Scaffold._check_setup_finished', kind: 'method', name: '_check_setup_finished', path: 'src/flask/scaffold.py', qualname: 'Scaffold._check_setup_finished', sig_hash: '3d397074aa2665af', signature: '_check_setup_finished(self, f_name: str) -> None', source: '    def _check_setup_finished(self, f_name: str) -> None:\n        raise NotImplementedError', start: 229, tick: 1, types_hash: '13c1224caf2bd244', _vid: 554}),
  (:Symbol {body_hash: '18ad29937dcf8fc5', deleted: true, deleted_tick: 5, end: 247, key: 'src/flask/scaffold.py::Scaffold.static_folder', kind: 'method', name: 'static_folder', path: 'src/flask/scaffold.py', qualname: 'Scaffold.static_folder', sig_hash: '81e944650cc6d217', signature: 'static_folder(self, value: str | os.PathLike | None) -> None', source: '    @static_folder.setter\n    def static_folder(self, value: str | os.PathLike | None) -> None:\n        if value is not None:\n            value = os.fspath(value).rstrip(r"\\/")\n\n        self._static_folder = value', start: 243, tick: 1, types_hash: '0d2464f8216e9082', _vid: 555}),
  (:Symbol {body_hash: 'a8d81f2cb252ce00', deleted: true, deleted_tick: 5, end: 255, key: 'src/flask/scaffold.py::Scaffold.has_static_folder', kind: 'method', name: 'has_static_folder', path: 'src/flask/scaffold.py', qualname: 'Scaffold.has_static_folder', sig_hash: '9626d105938f0039', signature: 'has_static_folder(self) -> bool', source: '    @property\n    def has_static_folder(self) -> bool:\n        """``True`` if :attr:`static_folder` is set.\n\n        .. versionadded:: 0.5\n        """\n        return self.static_folder is not None', start: 250, tick: 1, types_hash: '64c86fa5713fa282', _vid: 556}),
  (:Symbol {body_hash: 'b292397bf76f3351', deleted: true, deleted_tick: 5, end: 278, key: 'src/flask/scaffold.py::Scaffold.static_url_path', kind: 'method', name: 'static_url_path', path: 'src/flask/scaffold.py', qualname: 'Scaffold.static_url_path', sig_hash: '81e944650cc6d217', signature: 'static_url_path(self, value: str | None) -> None', source: '    @static_url_path.setter\n    def static_url_path(self, value: str | None) -> None:\n        if value is not None:\n            value = value.rstrip("/")\n\n        self._static_url_path = value', start: 274, tick: 1, types_hash: 'b24cbb92d6c14bbd', _vid: 557}),
  (:Symbol {body_hash: '0acfb5c7235a4765', deleted: true, deleted_tick: 5, end: 302, key: 'src/flask/scaffold.py::Scaffold.get_send_file_max_age', kind: 'method', name: 'get_send_file_max_age', path: 'src/flask/scaffold.py', qualname: 'Scaffold.get_send_file_max_age', sig_hash: '673744f8011d99c2', signature: 'get_send_file_max_age(self, filename: str | None) -> int | None', source: '    def get_send_file_max_age(self, filename: str | None) -> int | None:\n        """Used by :func:`send_file` to determine the ``max_age`` cache\n        value for a given file path if it wasn\'t passed.\n\n        By default, this returns :data:`SEND_FILE_MAX_AGE_DEFAULT` from\n        the configuration of :data:`~flask.current_app`. This defaults\n        to ``None``, which tells the browser to use conditional requests\n        instead of a timed cache, which is usually preferable.\n\n        .. versionchanged:: 2.0\n            The default configuration is ``None`` instead of 12 hours.\n\n        .. versionadded:: 0.9\n        """\n        value = current_app.config["SEND_FILE_MAX_AGE_DEFAULT"]\n\n        if value is None:\n            return None\n\n        if isinstance(value, timedelta):\n            return int(value.total_seconds())\n\n        return value', start: 280, tick: 1, types_hash: 'c2fd11ae4334cb9c', _vid: 558}),
  (:Symbol {body_hash: '23975c9784b8a550', deleted: true, deleted_tick: 5, end: 320, key: 'src/flask/scaffold.py::Scaffold.send_static_file', kind: 'method', name: 'send_static_file', path: 'src/flask/scaffold.py', qualname: 'Scaffold.send_static_file', sig_hash: '673744f8011d99c2', signature: 'send_static_file(self, filename: str) -> Response', source: '    def send_static_file(self, filename: str) -> Response:\n        """The view function used to serve files from\n        :attr:`static_folder`. A route is automatically registered for\n        this view at :attr:`static_url_path` if :attr:`static_folder` is\n        set.\n\n        .. versionadded:: 0.5\n        """\n        if not self.has_static_folder:\n            raise RuntimeError("\'static_folder\' must be set to serve static_files.")\n\n        # send_file only knows to call get_send_file_max_age on the app,\n        # call it here so it works for blueprints too.\n        max_age = self.get_send_file_max_age(filename)\n        return send_from_directory(\n            t.cast(str, self.static_folder), filename, max_age=max_age\n        )', start: 304, tick: 1, types_hash: '357e939093982212', _vid: 559}),
  (:Symbol {body_hash: '0fb9f791235fbf59', deleted: true, deleted_tick: 5, end: 333, key: 'src/flask/scaffold.py::Scaffold.jinja_loader', kind: 'method', name: 'jinja_loader', path: 'src/flask/scaffold.py', qualname: 'Scaffold.jinja_loader', sig_hash: '9626d105938f0039', signature: 'jinja_loader(self) -> FileSystemLoader | None', source: '    @cached_property\n    def jinja_loader(self) -> FileSystemLoader | None:\n        """The Jinja loader for this object\'s templates. By default this\n        is a class :class:`jinja2.loaders.FileSystemLoader` to\n        :attr:`template_folder` if it is set.\n\n        .. versionadded:: 0.5\n        """\n        if self.template_folder is not None:\n            return FileSystemLoader(os.path.join(self.root_path, self.template_folder))\n        else:\n            return None', start: 323, tick: 1, types_hash: '7853d601483b279c', _vid: 560}),
  (:Symbol {body_hash: 'c0225b8e83b8c8a7', deleted: true, deleted_tick: 5, end: 356, key: 'src/flask/scaffold.py::Scaffold.open_resource', kind: 'method', name: 'open_resource', path: 'src/flask/scaffold.py', qualname: 'Scaffold.open_resource', sig_hash: 'f2fb9e4b949050bf', signature: 'open_resource(self, resource: str, mode: str=\'rb\') -> t.IO[t.AnyStr]', source: '    def open_resource(self, resource: str, mode: str = "rb") -> t.IO[t.AnyStr]:\n        """Open a resource file relative to :attr:`root_path` for\n        reading.\n\n        For example, if the file ``schema.sql`` is next to the file\n        ``app.py`` where the ``Flask`` app is defined, it can be opened\n        with:\n\n        .. code-block:: python\n\n            with app.open_resource("schema.sql") as f:\n                conn.executescript(f.read())\n\n        :param resource: Path to the resource relative to\n            :attr:`root_path`.\n        :param mode: Open the file in this mode. Only reading is\n            supported, valid values are "r" (or "rt") and "rb".\n        """\n        if mode not in {"r", "rt", "rb"}:\n            raise ValueError("Resources can only be opened for reading.")\n\n        return open(os.path.join(self.root_path, resource), mode)', start: 335, tick: 1, types_hash: '579219ccb4e784ae', _vid: 561}),
  (:Symbol {body_hash: '4ebb357976a3bb30', deleted: true, deleted_tick: 5, end: 367, key: 'src/flask/scaffold.py::Scaffold._method_route', kind: 'method', name: '_method_route', path: 'src/flask/scaffold.py', qualname: 'Scaffold._method_route', sig_hash: 'b9104893442eb477', signature: '_method_route(self, method: str, rule: str, options: dict) -> t.Callable[[T_route], T_route]', source: '    def _method_route(\n        self,\n        method: str,\n        rule: str,\n        options: dict,\n    ) -> t.Callable[[T_route], T_route]:\n        if "methods" in options:\n            raise TypeError("Use the \'route\' decorator to use the \'methods\' argument.")\n\n        return self.route(rule, methods=[method], **options)', start: 358, tick: 1, types_hash: 'ca1b4b6e695b0ad5', _vid: 562}),
  (:Symbol {body_hash: 'e3181d3d579b1421', deleted: true, deleted_tick: 5, end: 375, key: 'src/flask/scaffold.py::Scaffold.get', kind: 'method', name: 'get', path: 'src/flask/scaffold.py', qualname: 'Scaffold.get', sig_hash: '4cb65333a5963a1d', signature: 'get(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]', source: '    @setupmethod\n    def get(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]:\n        """Shortcut for :meth:`route` with ``methods=["GET"]``.\n\n        .. versionadded:: 2.0\n        """\n        return self._method_route("GET", rule, options)', start: 370, tick: 1, types_hash: '507d2e3716252a34', _vid: 563}),
  (:Symbol {body_hash: 'eaad29ca48827ce7', deleted: true, deleted_tick: 5, end: 383, key: 'src/flask/scaffold.py::Scaffold.post', kind: 'method', name: 'post', path: 'src/flask/scaffold.py', qualname: 'Scaffold.post', sig_hash: '4cb65333a5963a1d', signature: 'post(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]', source: '    @setupmethod\n    def post(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]:\n        """Shortcut for :meth:`route` with ``methods=["POST"]``.\n\n        .. versionadded:: 2.0\n        """\n        return self._method_route("POST", rule, options)', start: 378, tick: 1, types_hash: '507d2e3716252a34', _vid: 564}),
  (:Symbol {body_hash: 'd8a7983da586e2be', deleted: true, deleted_tick: 5, end: 391, key: 'src/flask/scaffold.py::Scaffold.put', kind: 'method', name: 'put', path: 'src/flask/scaffold.py', qualname: 'Scaffold.put', sig_hash: '4cb65333a5963a1d', signature: 'put(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]', source: '    @setupmethod\n    def put(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]:\n        """Shortcut for :meth:`route` with ``methods=["PUT"]``.\n\n        .. versionadded:: 2.0\n        """\n        return self._method_route("PUT", rule, options)', start: 386, tick: 1, types_hash: '507d2e3716252a34', _vid: 565}),
  (:Symbol {body_hash: 'c1438143edc06693', deleted: true, deleted_tick: 5, end: 399, key: 'src/flask/scaffold.py::Scaffold.delete', kind: 'method', name: 'delete', path: 'src/flask/scaffold.py', qualname: 'Scaffold.delete', sig_hash: '4cb65333a5963a1d', signature: 'delete(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]', source: '    @setupmethod\n    def delete(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]:\n        """Shortcut for :meth:`route` with ``methods=["DELETE"]``.\n\n        .. versionadded:: 2.0\n        """\n        return self._method_route("DELETE", rule, options)', start: 394, tick: 1, types_hash: '507d2e3716252a34', _vid: 566}),
  (:Symbol {body_hash: '22f521aa2735109f', deleted: true, deleted_tick: 5, end: 407, key: 'src/flask/scaffold.py::Scaffold.patch', kind: 'method', name: 'patch', path: 'src/flask/scaffold.py', qualname: 'Scaffold.patch', sig_hash: '4cb65333a5963a1d', signature: 'patch(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]', source: '    @setupmethod\n    def patch(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]:\n        """Shortcut for :meth:`route` with ``methods=["PATCH"]``.\n\n        .. versionadded:: 2.0\n        """\n        return self._method_route("PATCH", rule, options)', start: 402, tick: 1, types_hash: '507d2e3716252a34', _vid: 567}),
  (:Symbol {body_hash: '465045eef0ba80f3', deleted: true, deleted_tick: 5, end: 439, key: 'src/flask/scaffold.py::Scaffold.route', kind: 'method', name: 'route', path: 'src/flask/scaffold.py', qualname: 'Scaffold.route', sig_hash: '4cb65333a5963a1d', signature: 'route(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]', source: '    @setupmethod\n    def route(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]:\n        """Decorate a view function to register it with the given URL\n        rule and options. Calls :meth:`add_url_rule`, which has more\n        details about the implementation.\n\n        .. code-block:: python\n\n            @app.route("/")\n            def index():\n                return "Hello, World!"\n\n        See :ref:`url-route-registrations`.\n\n        The endpoint name for the route defaults to the name of the view\n        function if the ``endpoint`` parameter isn\'t passed.\n\n        The ``methods`` parameter defaults to ``["GET"]``. ``HEAD`` and\n        ``OPTIONS`` are added automatically.\n\n        :param rule: The URL rule string.\n        :param options: Extra options passed to the\n            :class:`~werkzeug.routing.Rule` object.\n        """\n\n        def decorator(f: T_route) -> T_route:\n            endpoint = options.pop("endpoint", None)\n            self.add_url_rule(rule, endpoint, f, **options)\n            return f\n\n        return decorator', start: 410, tick: 1, types_hash: '507d2e3716252a34', _vid: 568}),
  (:Symbol {body_hash: '8b9ab53577da7394', deleted: true, deleted_tick: 5, end: 507, key: 'src/flask/scaffold.py::Scaffold.add_url_rule', kind: 'method', name: 'add_url_rule', path: 'src/flask/scaffold.py', qualname: 'Scaffold.add_url_rule', sig_hash: '2754b8847381d8d9', signature: 'add_url_rule(self, rule: str, endpoint: str | None=None, view_func: ft.RouteCallable | None=None, provide_automatic_options: bool | None=None, **options: t.Any) -> None', source: '    @setupmethod\n    def add_url_rule(\n        self,\n        rule: str,\n        endpoint: str | None = None,\n        view_func: ft.RouteCallable | None = None,\n        provide_automatic_options: bool | None = None,\n        **options: t.Any,\n    ) -> None:\n        """Register a rule for routing incoming requests and building\n        URLs. The :meth:`route` decorator is a shortcut to call this\n        with the ``view_func`` argument. These are equivalent:\n\n        .. code-block:: python\n\n            @app.route("/")\n            def index():\n                ...\n\n        .. code-block:: python\n\n            def index():\n                ...\n\n            app.add_url_rule("/", view_func=index)\n\n        See :ref:`url-route-registrations`.\n\n        The endpoint name for the route defaults to the name of the view\n        function if the ``endpoint`` parameter isn\'t passed. An error\n        will be raised if a function has already been registered for the\n        endpoint.\n\n        The ``methods`` parameter defaults to ``["GET"]``. ``HEAD`` is\n        always added automatically, and ``OPTIONS`` is added\n        automatically by default.\n\n        ``view_func`` does not necessarily need to be passed, but if the\n        rule should participate in routing an endpoint name must be\n        associated with a view function at some point with the\n        :meth:`endpoint` decorator.\n\n        .. code-block:: python\n\n            app.add_url_rule("/", endpoint="index")\n\n            @app.endpoint("index\n…', start: 442, tick: 1, types_hash: '321dce8d6f484a1f', _vid: 569}),
  (:Symbol {body_hash: '4447ab323f3678f7', deleted: true, deleted_tick: 5, end: 531, key: 'src/flask/scaffold.py::Scaffold.endpoint', kind: 'method', name: 'endpoint', path: 'src/flask/scaffold.py', qualname: 'Scaffold.endpoint', sig_hash: '2ee582ec75ea84f6', signature: 'endpoint(self, endpoint: str) -> t.Callable[[F], F]', source: '    @setupmethod\n    def endpoint(self, endpoint: str) -> t.Callable[[F], F]:\n        """Decorate a view function to register it for the given\n        endpoint. Used if a rule is added without a ``view_func`` with\n        :meth:`add_url_rule`.\n\n        .. code-block:: python\n\n            app.add_url_rule("/ex", endpoint="example")\n\n            @app.endpoint("example")\n            def example():\n                ...\n\n        :param endpoint: The endpoint name to associate with the view\n            function.\n        """\n\n        def decorator(f: F) -> F:\n            self.view_functions[endpoint] = f\n            return f\n\n        return decorator', start: 510, tick: 1, types_hash: 'd685993277b77ee8', _vid: 570}),
  (:Symbol {body_hash: 'def05ba096c8b1a6', deleted: true, deleted_tick: 5, end: 558, key: 'src/flask/scaffold.py::Scaffold.before_request', kind: 'method', name: 'before_request', path: 'src/flask/scaffold.py', qualname: 'Scaffold.before_request', sig_hash: 'ebc36a671d7c2913', signature: 'before_request(self, f: T_before_request) -> T_before_request', source: '    @setupmethod\n    def before_request(self, f: T_before_request) -> T_before_request:\n        """Register a function to run before each request.\n\n        For example, this can be used to open a database connection, or\n        to load the logged in user from the session.\n\n        .. code-block:: python\n\n            @app.before_request\n            def load_user():\n                if "user_id" in session:\n                    g.user = db.session.get(session["user_id"])\n\n        The function will be called without any arguments. If it returns\n        a non-``None`` value, the value is handled as if it was the\n        return value from the view, and further request handling is\n        stopped.\n\n        This is available on both app and blueprint objects. When used on an app, this\n        executes before every request. When used on a blueprint, this executes before\n        every request that the blueprint handles. To register with a blueprint and\n        execute before every request, use :meth:`.Blueprint.before_app_request`.\n        """\n        self.before_request_funcs.setdefault(None, []).append(f)\n        return f', start: 534, tick: 1, types_hash: '051402312aa72da7', _vid: 571}),
  (:Symbol {body_hash: '89edaa159281d715', deleted: true, deleted_tick: 5, end: 579, key: 'src/flask/scaffold.py::Scaffold.after_request', kind: 'method', name: 'after_request', path: 'src/flask/scaffold.py', qualname: 'Scaffold.after_request', sig_hash: 'ebc36a671d7c2913', signature: 'after_request(self, f: T_after_request) -> T_after_request', source: '    @setupmethod\n    def after_request(self, f: T_after_request) -> T_after_request:\n        """Register a function to run after each request to this object.\n\n        The function is called with the response object, and must return\n        a response object. This allows the functions to modify or\n        replace the response before it is sent.\n\n        If a function raises an exception, any remaining\n        ``after_request`` functions will not be called. Therefore, this\n        should not be used for actions that must execute, such as to\n        close resources. Use :meth:`teardown_request` for that.\n\n        This is available on both app and blueprint objects. When used on an app, this\n        executes after every request. When used on a blueprint, this executes after\n        every request that the blueprint handles. To register with a blueprint and\n        execute after every request, use :meth:`.Blueprint.after_app_request`.\n        """\n        self.after_request_funcs.setdefault(None, []).append(f)\n        return f', start: 561, tick: 1, types_hash: '11cebedf592cd20f', _vid: 572}),
  (:Symbol {body_hash: '761dc7b031412b52', deleted: true, deleted_tick: 5, end: 613, key: 'src/flask/scaffold.py::Scaffold.teardown_request', kind: 'method', name: 'teardown_request', path: 'src/flask/scaffold.py', qualname: 'Scaffold.teardown_request', sig_hash: 'ebc36a671d7c2913', signature: 'teardown_request(self, f: T_teardown) -> T_teardown', source: '    @setupmethod\n    def teardown_request(self, f: T_teardown) -> T_teardown:\n        """Register a function to be called when the request context is\n        popped. Typically this happens at the end of each request, but\n        contexts may be pushed manually as well during testing.\n\n        .. code-block:: python\n\n            with app.test_request_context():\n                ...\n\n        When the ``with`` block exits (or ``ctx.pop()`` is called), the\n        teardown functions are called just before the request context is\n        made inactive.\n\n        When a teardown function was called because of an unhandled\n        exception it will be passed an error object. If an\n        :meth:`errorhandler` is registered, it will handle the exception\n        and the teardown will not receive it.\n\n        Teardown functions must avoid raising exceptions. If they\n        execute code that might fail they must surround that code with a\n        ``try``/``except`` block and log any errors.\n\n        The return values of teardown functions are ignored.\n\n        This is available on both app and blueprint objects. When used on an app, this\n        executes after every request. When used on a blueprint, this executes after\n        every request that the blueprint handles. To register with a blueprint and\n        execute after every request, use :meth:`.Blueprint.teardown_app_request`.\n        """\n        self.teardown_request_funcs.setdefault(None, []).append(f)\n        return f', start: 582, tick: 1, types_hash: 'e5437a4dc4c93fdb', _vid: 573}),
  (:Symbol {body_hash: '27ea85946913165e', deleted: true, deleted_tick: 5, end: 630, key: 'src/flask/scaffold.py::Scaffold.context_processor', kind: 'method', name: 'context_processor', path: 'src/flask/scaffold.py', qualname: 'Scaffold.context_processor', sig_hash: 'ebc36a671d7c2913', signature: 'context_processor(self, f: T_template_context_processor) -> T_template_context_processor', source: '    @setupmethod\n    def context_processor(\n        self,\n        f: T_template_context_processor,\n    ) -> T_template_context_processor:\n        """Registers a template context processor function. These functions run before\n        rendering a template. The keys of the returned dict are added as variables\n        available in the template.\n\n        This is available on both app and blueprint objects. When used on an app, this\n        is called for every rendered template. When used on a blueprint, this is called\n        for templates rendered from the blueprint\'s views. To register with a blueprint\n        and affect every template, use :meth:`.Blueprint.app_context_processor`.\n        """\n        self.template_context_processors[None].append(f)\n        return f', start: 616, tick: 1, types_hash: 'dd857fb5c4772440', _vid: 574}),
  (:Symbol {body_hash: '276c2762e1641d95', deleted: true, deleted_tick: 5, end: 655, key: 'src/flask/scaffold.py::Scaffold.url_value_preprocessor', kind: 'method', name: 'url_value_preprocessor', path: 'src/flask/scaffold.py', qualname: 'Scaffold.url_value_preprocessor', sig_hash: 'ebc36a671d7c2913', signature: 'url_value_preprocessor(self, f: T_url_value_preprocessor) -> T_url_value_preprocessor', source: '    @setupmethod\n    def url_value_preprocessor(\n        self,\n        f: T_url_value_preprocessor,\n    ) -> T_url_value_preprocessor:\n        """Register a URL value preprocessor function for all view\n        functions in the application. These functions will be called before the\n        :meth:`before_request` functions.\n\n        The function can modify the values captured from the matched url before\n        they are passed to the view. For example, this can be used to pop a\n        common language code value and place it in ``g`` rather than pass it to\n        every view.\n\n        The function is passed the endpoint name and values dict. The return\n        value is ignored.\n\n        This is available on both app and blueprint objects. When used on an app, this\n        is called for every request. When used on a blueprint, this is called for\n        requests that the blueprint handles. To register with a blueprint and affect\n        every request, use :meth:`.Blueprint.app_url_value_preprocessor`.\n        """\n        self.url_value_preprocessors[None].append(f)\n        return f', start: 633, tick: 1, types_hash: '51578653f0862796', _vid: 575}),
  (:Symbol {body_hash: '6ba012cb7ab00049', deleted: true, deleted_tick: 5, end: 669, key: 'src/flask/scaffold.py::Scaffold.url_defaults', kind: 'method', name: 'url_defaults', path: 'src/flask/scaffold.py', qualname: 'Scaffold.url_defaults', sig_hash: 'ebc36a671d7c2913', signature: 'url_defaults(self, f: T_url_defaults) -> T_url_defaults', source: '    @setupmethod\n    def url_defaults(self, f: T_url_defaults) -> T_url_defaults:\n        """Callback function for URL defaults for all view functions of the\n        application.  It\'s called with the endpoint and values and should\n        update the values passed in place.\n\n        This is available on both app and blueprint objects. When used on an app, this\n        is called for every request. When used on a blueprint, this is called for\n        requests that the blueprint handles. To register with a blueprint and affect\n        every request, use :meth:`.Blueprint.app_url_defaults`.\n        """\n        self.url_default_functions[None].append(f)\n        return f', start: 658, tick: 1, types_hash: '9a48bf9aab352d7a', _vid: 576}),
  (:Symbol {body_hash: '94d02e7c98c201d0', deleted: true, deleted_tick: 5, end: 713, key: 'src/flask/scaffold.py::Scaffold.errorhandler', kind: 'method', name: 'errorhandler', path: 'src/flask/scaffold.py', qualname: 'Scaffold.errorhandler', sig_hash: '95e4c361c4335bf9', signature: 'errorhandler(self, code_or_exception: type[Exception] | int) -> t.Callable[[T_error_handler], T_error_handler]', source: '    @setupmethod\n    def errorhandler(\n        self, code_or_exception: type[Exception] | int\n    ) -> t.Callable[[T_error_handler], T_error_handler]:\n        """Register a function to handle errors by code or exception class.\n\n        A decorator that is used to register a function given an\n        error code.  Example::\n\n            @app.errorhandler(404)\n            def page_not_found(error):\n                return \'This page does not exist\', 404\n\n        You can also register handlers for arbitrary exceptions::\n\n            @app.errorhandler(DatabaseError)\n            def special_exception_handler(error):\n                return \'Database connection failed\', 500\n\n        This is available on both app and blueprint objects. When used on an app, this\n        can handle errors from every request. When used on a blueprint, this can handle\n        errors from requests that the blueprint handles. To register with a blueprint\n        and affect every request, use :meth:`.Blueprint.app_errorhandler`.\n\n        .. versionadded:: 0.7\n            Use :meth:`register_error_handler` instead of modifying\n            :attr:`error_handler_spec` directly, for application wide error\n            handlers.\n\n        .. versionadded:: 0.7\n           One can now additionally also register custom exception types\n           that do not necessarily have to be a subclass of the\n           :class:`~werkzeug.exceptions.HTTPException` class.\n\n        :param code_or_exception: the code as integer for the\n…', start: 672, tick: 1, types_hash: '4348ce84f2c5c482', _vid: 577}),
  (:Symbol {body_hash: '101732d830648f09', deleted: true, deleted_tick: 5, end: 728, key: 'src/flask/scaffold.py::Scaffold.register_error_handler', kind: 'method', name: 'register_error_handler', path: 'src/flask/scaffold.py', qualname: 'Scaffold.register_error_handler', sig_hash: '7d24fd4d39d3edb4', signature: 'register_error_handler(self, code_or_exception: type[Exception] | int, f: ft.ErrorHandlerCallable) -> None', source: '    @setupmethod\n    def register_error_handler(\n        self,\n        code_or_exception: type[Exception] | int,\n        f: ft.ErrorHandlerCallable,\n    ) -> None:\n        """Alternative error attach function to the :meth:`errorhandler`\n        decorator that is more straightforward to use for non decorator\n        usage.\n\n        .. versionadded:: 0.7\n        """\n        exc_class, code = self._get_exc_class_and_code(code_or_exception)\n        self.error_handler_spec[None][code][exc_class] = f', start: 716, tick: 1, types_hash: 'da880d4031d609aa', _vid: 578}),
  (:Symbol {body_hash: '0ea49af771bbc2d3', deleted: true, deleted_tick: 5, end: 772, key: 'src/flask/scaffold.py::Scaffold._get_exc_class_and_code', kind: 'method', name: '_get_exc_class_and_code', path: 'src/flask/scaffold.py', qualname: 'Scaffold._get_exc_class_and_code', sig_hash: '0f91a5ccf12243e5', signature: '_get_exc_class_and_code(exc_class_or_code: type[Exception] | int) -> tuple[type[Exception], int | None]', source: '    @staticmethod\n    def _get_exc_class_and_code(\n        exc_class_or_code: type[Exception] | int,\n    ) -> tuple[type[Exception], int | None]:\n        """Get the exception class being handled. For HTTP status codes\n        or ``HTTPException`` subclasses, return both the exception and\n        status code.\n\n        :param exc_class_or_code: Any exception class, or an HTTP status\n            code as an integer.\n        """\n        exc_class: type[Exception]\n\n        if isinstance(exc_class_or_code, int):\n            try:\n                exc_class = default_exceptions[exc_class_or_code]\n            except KeyError:\n                raise ValueError(\n                    f"\'{exc_class_or_code}\' is not a recognized HTTP"\n                    " error code. Use a subclass of HTTPException with"\n                    " that code instead."\n                ) from None\n        else:\n            exc_class = exc_class_or_code\n\n        if isinstance(exc_class, Exception):\n            raise TypeError(\n                f"{exc_class!r} is an instance, not a class. Handlers"\n                " can only be registered for Exception classes or HTTP"\n                " error codes."\n            )\n\n        if not issubclass(exc_class, Exception):\n            raise ValueError(\n                f"\'{exc_class.__name__}\' is not a subclass of Exception."\n                " Handlers can only be registered for Exception classes"\n                " or HTTP error codes."\n            )\n\n        if issubclass(exc_cla\n…', start: 731, tick: 1, types_hash: '136948ad73a48e1a', _vid: 579}),
  (:Symbol {body_hash: 'b05f6f4282111b92', deleted: true, deleted_tick: 5, end: 780, key: 'src/flask/scaffold.py::_endpoint_from_view_func', kind: 'function', name: '_endpoint_from_view_func', path: 'src/flask/scaffold.py', qualname: '_endpoint_from_view_func', sig_hash: '09453761aed62e04', signature: '_endpoint_from_view_func(view_func: t.Callable) -> str', source: 'def _endpoint_from_view_func(view_func: t.Callable) -> str:\n    """Internal helper that returns the default endpoint for a given\n    function.  This always is the function name.\n    """\n    assert view_func is not None, "expected view func if endpoint is not provided."\n    return view_func.__name__', start: 775, tick: 1, types_hash: '3d33c570f2109b30', _vid: 580}),
  (:Symbol {body_hash: '6c072689e81d7eb8', deleted: true, deleted_tick: 5, end: 805, key: 'src/flask/scaffold.py::_matching_loader_thinks_module_is_package', kind: 'function', name: '_matching_loader_thinks_module_is_package', path: 'src/flask/scaffold.py', qualname: '_matching_loader_thinks_module_is_package', sig_hash: '54792f55f9dbf7f7', signature: '_matching_loader_thinks_module_is_package(loader, mod_name)', source: 'def _matching_loader_thinks_module_is_package(loader, mod_name):\n    """Attempt to figure out if the given name is a package or a module.\n\n    :param: loader: The loader that handled the name.\n    :param mod_name: The name of the package or module.\n    """\n    # Use loader.is_package if it\'s available.\n    if hasattr(loader, "is_package"):\n        return loader.is_package(mod_name)\n\n    cls = type(loader)\n\n    # NamespaceLoader doesn\'t implement is_package, but all names it\n    # loads must be packages.\n    if cls.__module__ == "_frozen_importlib" and cls.__name__ == "NamespaceLoader":\n        return True\n\n    # Otherwise we need to fail with an error that explains what went\n    # wrong.\n    raise AttributeError(\n        f"\'{cls.__name__}.is_package()\' must be implemented for PEP 302"\n        f" import hooks."\n    )', start: 783, tick: 1, types_hash: '95d02521c150f5b1', _vid: 581}),
  (:Symbol {body_hash: '650633351de5c1f3', deleted: true, deleted_tick: 5, end: 814, key: 'src/flask/scaffold.py::_path_is_relative_to', kind: 'function', name: '_path_is_relative_to', path: 'src/flask/scaffold.py', qualname: '_path_is_relative_to', sig_hash: 'bedf9ed26ae83a40', signature: '_path_is_relative_to(path: pathlib.PurePath, base: str) -> bool', source: 'def _path_is_relative_to(path: pathlib.PurePath, base: str) -> bool:\n    # Path.is_relative_to doesn\'t exist until Python 3.9\n    try:\n        path.relative_to(base)\n        return True\n    except ValueError:\n        return False', start: 808, tick: 1, types_hash: 'c3756a67ae9fe620', _vid: 582}),
  (:Symbol {body_hash: '6b20c7fcef9c61aa', deleted: true, deleted_tick: 5, end: 882, key: 'src/flask/scaffold.py::_find_package_path', kind: 'function', name: '_find_package_path', path: 'src/flask/scaffold.py', qualname: '_find_package_path', sig_hash: '2188e13e5563eb55', signature: '_find_package_path(import_name)', source: 'def _find_package_path(import_name):\n    """Find the path that contains the package or module."""\n    root_mod_name, _, _ = import_name.partition(".")\n\n    try:\n        root_spec = importlib.util.find_spec(root_mod_name)\n\n        if root_spec is None:\n            raise ValueError("not found")\n    # ImportError: the machinery told us it does not exist\n    # ValueError:\n    #    - the module name was invalid\n    #    - the module name is __main__\n    #    - *we* raised `ValueError` due to `root_spec` being `None`\n    except (ImportError, ValueError):\n        pass  # handled below\n    else:\n        # namespace package\n        if root_spec.origin in {"namespace", None}:\n            package_spec = importlib.util.find_spec(import_name)\n            if package_spec is not None and package_spec.submodule_search_locations:\n                # Pick the path in the namespace that contains the submodule.\n                package_path = pathlib.Path(\n                    os.path.commonpath(package_spec.submodule_search_locations)\n                )\n                search_locations = (\n                    location\n                    for location in root_spec.submodule_search_locations\n                    if _path_is_relative_to(package_path, location)\n                )\n            else:\n                # Pick the first path.\n                search_locations = iter(root_spec.submodule_search_locations)\n            return os.path.dirname(next(search_locations))\n        # a package (with __init__.\n…', start: 817, tick: 1, types_hash: '29c42d0de3578dd8', _vid: 583}),
  (:Symbol {body_hash: '352d39c901eca25c', deleted: true, deleted_tick: 5, end: 923, key: 'src/flask/scaffold.py::find_package', kind: 'function', name: 'find_package', path: 'src/flask/scaffold.py', qualname: 'find_package', sig_hash: '2188e13e5563eb55', signature: 'find_package(import_name: str)', source: 'def find_package(import_name: str):\n    """Find the prefix that a package is installed under, and the path\n    that it would be imported from.\n\n    The prefix is the directory containing the standard directory\n    hierarchy (lib, bin, etc.). If the package is not installed to the\n    system (:attr:`sys.prefix`) or a virtualenv (``site-packages``),\n    ``None`` is returned.\n\n    The path is the entry in :attr:`sys.path` that contains the package\n    for import. If the package is not installed, it\'s assumed that the\n    package was imported from the current working directory.\n    """\n    package_path = _find_package_path(import_name)\n    py_prefix = os.path.abspath(sys.prefix)\n\n    # installed to the system\n    if _path_is_relative_to(pathlib.PurePath(package_path), py_prefix):\n        return py_prefix, package_path\n\n    site_parent, site_folder = os.path.split(package_path)\n\n    # installed to a virtualenv\n    if site_folder.lower() == "site-packages":\n        parent, folder = os.path.split(site_parent)\n\n        # Windows (prefix/lib/site-packages)\n        if folder.lower() == "lib":\n            return parent, package_path\n\n        # Unix (prefix/lib/pythonX.Y/site-packages)\n        if os.path.basename(parent).lower() == "lib":\n            return os.path.dirname(parent), package_path\n\n        # something else (prefix/site-packages)\n        return site_parent, package_path\n\n    # not installed\n    return None, package_path', start: 885, tick: 1, types_hash: '76d5c83a12c8e084', _vid: 584}),
  (:Symbol {body_hash: '4b48cba7375300c9', deleted: false, end: 49, key: 'src/flask/sessions.py::SessionMixin', kind: 'class', name: 'SessionMixin', path: 'src/flask/sessions.py', qualname: 'SessionMixin', sig_hash: '7c2ea66fdb38d6eb', signature: 'class SessionMixin(MutableMapping[str, t.Any])', source: 'class SessionMixin(MutableMapping[str, t.Any]):\n    """Expands a basic dictionary with session attributes."""\n\n    @property\n    def permanent(self) -> bool:\n        """This reflects the ``\'_permanent\'`` key in the dict."""\n        return self.get("_permanent", False)\n\n    @permanent.setter\n    def permanent(self, value: bool) -> None:\n        self["_permanent"] = bool(value)\n\n    #: Some implementations can detect whether a session is newly\n    #: created, but that is not guaranteed. Use with caution. The mixin\n    # default is hard-coded ``False``.\n    new = False\n\n    #: Some implementations can detect changes to the session and set\n    #: this when that happens. The mixin default is hard coded to\n    #: ``True``.\n    modified = True\n\n    #: Some implementations can detect when session data is read or\n    #: written and set this when that happens. The mixin default is hard\n    #: coded to ``True``.\n    accessed = True', start: 24, tick: 5, types_hash: '', _vid: 585}),
  (:Symbol {body_hash: 'fc206cef0e9c7757', deleted: false, end: 34, key: 'src/flask/sessions.py::SessionMixin.permanent', kind: 'method', name: 'permanent', path: 'src/flask/sessions.py', qualname: 'SessionMixin.permanent', sig_hash: '81e944650cc6d217', signature: 'permanent(self, value: bool) -> None', source: '    @permanent.setter\n    def permanent(self, value: bool) -> None:\n        self["_permanent"] = bool(value)', start: 33, tick: 5, types_hash: '9fead63e8a5500d0', _vid: 586}),
  (:Symbol {body_hash: '909799e3956e9232', deleted: false, end: 94, key: 'src/flask/sessions.py::SecureCookieSession', kind: 'class', name: 'SecureCookieSession', path: 'src/flask/sessions.py', qualname: 'SecureCookieSession', sig_hash: 'c2bc7b6ea8ced549', signature: 'class SecureCookieSession(CallbackDict[str, t.Any], SessionMixin)', source: 'class SecureCookieSession(CallbackDict[str, t.Any], SessionMixin):\n    """Base class for sessions based on signed cookies.\n\n    This session backend will set the :attr:`modified` and\n    :attr:`accessed` attributes. It cannot reliably track whether a\n    session is new (vs. empty), so :attr:`new` remains hard coded to\n    ``False``.\n    """\n\n    #: When data is changed, this is set to ``True``. Only the session\n    #: dictionary itself is tracked; if the session contains mutable\n    #: data (for example a nested dict) then this must be set to\n    #: ``True`` manually when modifying that data. The session cookie\n    #: will only be written to the response if this is ``True``.\n    modified = False\n\n    #: When data is read or written, this is set to ``True``. Used by\n    # :class:`.SecureCookieSessionInterface` to add a ``Vary: Cookie``\n    #: header, which allows caching proxies to cache different pages for\n    #: different users.\n    accessed = False\n\n    def __init__(\n        self,\n        initial: c.Mapping[str, t.Any] | c.Iterable[tuple[str, t.Any]] | None = None,\n    ) -> None:\n        def on_update(self: te.Self) -> None:\n            self.modified = True\n            self.accessed = True\n\n        super().__init__(initial, on_update)\n\n    def __getitem__(self, key: str) -> t.Any:\n        self.accessed = True\n        return super().__getitem__(key)\n\n    def get(self, key: str, default: t.Any = None) -> t.Any:\n        self.accessed = True\n        return super().get(key, defa\n…', start: 52, tick: 5, types_hash: '', _vid: 587}),
  (:Symbol {body_hash: 'bd2de98e0909c743', deleted: false, end: 82, key: 'src/flask/sessions.py::SecureCookieSession.__init__', kind: 'method', name: '__init__', path: 'src/flask/sessions.py', qualname: 'SecureCookieSession.__init__', sig_hash: 'fd2c74e1d0fbba0f', signature: '__init__(self, initial: c.Mapping[str, t.Any] | c.Iterable[tuple[str, t.Any]] | None=None) -> None', source: '    def __init__(\n        self,\n        initial: c.Mapping[str, t.Any] | c.Iterable[tuple[str, t.Any]] | None = None,\n    ) -> None:\n        def on_update(self: te.Self) -> None:\n            self.modified = True\n            self.accessed = True\n\n        super().__init__(initial, on_update)', start: 74, tick: 5, types_hash: '6edf9f544d061847', _vid: 588}),
  (:Symbol {body_hash: '5164e9dec4fcc46c', deleted: false, end: 86, key: 'src/flask/sessions.py::SecureCookieSession.__getitem__', kind: 'method', name: '__getitem__', path: 'src/flask/sessions.py', qualname: 'SecureCookieSession.__getitem__', sig_hash: '8e77764cbdffbd07', signature: '__getitem__(self, key: str) -> t.Any', source: '    def __getitem__(self, key: str) -> t.Any:\n        self.accessed = True\n        return super().__getitem__(key)', start: 84, tick: 5, types_hash: 'c21ceea4c6cfc75a', _vid: 589}),
  (:Symbol {body_hash: 'bbd6eeadf6d63e0d', deleted: false, end: 90, key: 'src/flask/sessions.py::SecureCookieSession.get', kind: 'method', name: 'get', path: 'src/flask/sessions.py', qualname: 'SecureCookieSession.get', sig_hash: '551829734a6da0fd', signature: 'get(self, key: str, default: t.Any=None) -> t.Any', source: '    def get(self, key: str, default: t.Any = None) -> t.Any:\n        self.accessed = True\n        return super().get(key, default)', start: 88, tick: 5, types_hash: '6889861229a63a31', _vid: 590}),
  (:Symbol {body_hash: '26c97a74499cdf19', deleted: false, end: 94, key: 'src/flask/sessions.py::SecureCookieSession.setdefault', kind: 'method', name: 'setdefault', path: 'src/flask/sessions.py', qualname: 'SecureCookieSession.setdefault', sig_hash: '551829734a6da0fd', signature: 'setdefault(self, key: str, default: t.Any=None) -> t.Any', source: '    def setdefault(self, key: str, default: t.Any = None) -> t.Any:\n        self.accessed = True\n        return super().setdefault(key, default)', start: 92, tick: 5, types_hash: '6889861229a63a31', _vid: 591}),
  (:Symbol {body_hash: 'ab7027f0c12010b7', deleted: false, end: 111, key: 'src/flask/sessions.py::NullSession', kind: 'class', name: 'NullSession', path: 'src/flask/sessions.py', qualname: 'NullSession', sig_hash: '20ce250eeb5167e8', signature: 'class NullSession(SecureCookieSession)', source: 'class NullSession(SecureCookieSession):\n    """Class used to generate nicer error messages if sessions are not\n    available.  Will still allow read-only access to the empty session\n    but fail on setting.\n    """\n\n    def _fail(self, *args: t.Any, **kwargs: t.Any) -> t.NoReturn:\n        raise RuntimeError(\n            "The session is unavailable because no secret "\n            "key was set.  Set the secret_key on the "\n            "application to something unique and secret."\n        )\n\n    __setitem__ = __delitem__ = clear = pop = popitem = update = setdefault = _fail  # type: ignore # noqa: B950\n    del _fail', start: 97, tick: 5, types_hash: '', _vid: 592}),
  (:Symbol {body_hash: '26e4a61fb589245e', deleted: false, end: 108, key: 'src/flask/sessions.py::NullSession._fail', kind: 'method', name: '_fail', path: 'src/flask/sessions.py', qualname: 'NullSession._fail', sig_hash: '720606666acb024c', signature: '_fail(self, *args: t.Any, **kwargs: t.Any) -> t.NoReturn', source: '    def _fail(self, *args: t.Any, **kwargs: t.Any) -> t.NoReturn:\n        raise RuntimeError(\n            "The session is unavailable because no secret "\n            "key was set.  Set the secret_key on the "\n            "application to something unique and secret."\n        )', start: 103, tick: 5, types_hash: 'c19773818e6529ed', _vid: 593}),
  (:Symbol {body_hash: 'e90df0015226f72e', deleted: false, end: 284, key: 'src/flask/sessions.py::SessionInterface', kind: 'class', name: 'SessionInterface', path: 'src/flask/sessions.py', qualname: 'SessionInterface', sig_hash: '42ba610a86d15094', signature: 'class SessionInterface', source: 'class SessionInterface:\n    """The basic interface you have to implement in order to replace the\n    default session interface which uses werkzeug\'s securecookie\n    implementation.  The only methods you have to implement are\n    :meth:`open_session` and :meth:`save_session`, the others have\n    useful defaults which you don\'t need to change.\n\n    The session object returned by the :meth:`open_session` method has to\n    provide a dictionary like interface plus the properties and methods\n    from the :class:`SessionMixin`.  We recommend just subclassing a dict\n    and adding that mixin::\n\n        class Session(dict, SessionMixin):\n            pass\n\n    If :meth:`open_session` returns ``None`` Flask will call into\n    :meth:`make_null_session` to create a session that acts as replacement\n    if the session support cannot work because some requirement is not\n    fulfilled.  The default :class:`NullSession` class that is created\n    will complain that the secret key was not set.\n\n    To replace the session interface on an application all you have to do\n    is to assign :attr:`flask.Flask.session_interface`::\n\n        app = Flask(__name__)\n        app.session_interface = MySessionInterface()\n\n    Multiple requests with the same session may be sent and handled\n    concurrently. When implementing a new session interface, consider\n    whether reads or writes to the backing store must be synchronized.\n    There is no guarantee on the order in which the session for each\n    request is \n…', start: 114, tick: 5, types_hash: '', _vid: 594}),
  (:Symbol {body_hash: '33c4c4053a50f797', deleted: false, end: 174, key: 'src/flask/sessions.py::SessionInterface.make_null_session', kind: 'method', name: 'make_null_session', path: 'src/flask/sessions.py', qualname: 'SessionInterface.make_null_session', sig_hash: 'd5a3a5b9721effdf', signature: 'make_null_session(self, app: Flask) -> NullSession', source: '    def make_null_session(self, app: Flask) -> NullSession:\n        """Creates a null session which acts as a replacement object if the\n        real session support could not be loaded due to a configuration\n        error.  This mainly aids the user experience because the job of the\n        null session is to still support lookup without complaining but\n        modifications are answered with a helpful error message of what\n        failed.\n\n        This creates an instance of :attr:`null_session_class` by default.\n        """\n        return self.null_session_class()', start: 164, tick: 5, types_hash: '47acb141d2b6f1a9', _vid: 595}),
  (:Symbol {body_hash: '1edf2cf762dbc194', deleted: false, end: 183, key: 'src/flask/sessions.py::SessionInterface.is_null_session', kind: 'method', name: 'is_null_session', path: 'src/flask/sessions.py', qualname: 'SessionInterface.is_null_session', sig_hash: 'c3f2dfe08294f2a3', signature: 'is_null_session(self, obj: object) -> bool', source: '    def is_null_session(self, obj: object) -> bool:\n        """Checks if a given object is a null session.  Null sessions are\n        not asked to be saved.\n\n        This checks if the object is an instance of :attr:`null_session_class`\n        by default.\n        """\n        return isinstance(obj, self.null_session_class)', start: 176, tick: 5, types_hash: '1bb9bf0fa93f0286', _vid: 596}),
  (:Symbol {body_hash: 'b4ddc4a9f2c0b48c', deleted: false, end: 187, key: 'src/flask/sessions.py::SessionInterface.get_cookie_name', kind: 'method', name: 'get_cookie_name', path: 'src/flask/sessions.py', qualname: 'SessionInterface.get_cookie_name', sig_hash: 'd5a3a5b9721effdf', signature: 'get_cookie_name(self, app: Flask) -> str', source: '    def get_cookie_name(self, app: Flask) -> str:\n        """The name of the session cookie. Uses``app.config["SESSION_COOKIE_NAME"]``."""\n        return app.config["SESSION_COOKIE_NAME"]  # type: ignore[no-any-return]', start: 185, tick: 5, types_hash: '79e168aca7be3dc6', _vid: 597}),
  (:Symbol {body_hash: '1d11d1594f7c141a', deleted: false, end: 199, key: 'src/flask/sessions.py::SessionInterface.get_cookie_domain', kind: 'method', name: 'get_cookie_domain', path: 'src/flask/sessions.py', qualname: 'SessionInterface.get_cookie_domain', sig_hash: 'd5a3a5b9721effdf', signature: 'get_cookie_domain(self, app: Flask) -> str | None', source: '    def get_cookie_domain(self, app: Flask) -> str | None:\n        """The value of the ``Domain`` parameter on the session cookie. If not set,\n        browsers will only send the cookie to the exact domain it was set from.\n        Otherwise, they will send it to any subdomain of the given value as well.\n\n        Uses the :data:`SESSION_COOKIE_DOMAIN` config.\n\n        .. versionchanged:: 2.3\n            Not set by default, does not fall back to ``SERVER_NAME``.\n        """\n        return app.config["SESSION_COOKIE_DOMAIN"]  # type: ignore[no-any-return]', start: 189, tick: 5, types_hash: 'dd9e351b663cfc3e', _vid: 598}),
  (:Symbol {body_hash: 'd1bc6b332a8aa69a', deleted: false, end: 207, key: 'src/flask/sessions.py::SessionInterface.get_cookie_path', kind: 'method', name: 'get_cookie_path', path: 'src/flask/sessions.py', qualname: 'SessionInterface.get_cookie_path', sig_hash: 'd5a3a5b9721effdf', signature: 'get_cookie_path(self, app: Flask) -> str', source: '    def get_cookie_path(self, app: Flask) -> str:\n        """Returns the path for which the cookie should be valid.  The\n        default implementation uses the value from the ``SESSION_COOKIE_PATH``\n        config var if it\'s set, and falls back to ``APPLICATION_ROOT`` or\n        uses ``/`` if it\'s ``None``.\n        """\n        return app.config["SESSION_COOKIE_PATH"] or app.config["APPLICATION_ROOT"]  # type: ignore[no-any-return]', start: 201, tick: 5, types_hash: '79e168aca7be3dc6', _vid: 599});
CREATE (:Symbol {body_hash: '9bacf286ddb08868', deleted: false, end: 214, key: 'src/flask/sessions.py::SessionInterface.get_cookie_httponly', kind: 'method', name: 'get_cookie_httponly', path: 'src/flask/sessions.py', qualname: 'SessionInterface.get_cookie_httponly', sig_hash: 'd5a3a5b9721effdf', signature: 'get_cookie_httponly(self, app: Flask) -> bool', source: '    def get_cookie_httponly(self, app: Flask) -> bool:\n        """Returns True if the session cookie should be httponly.  This\n        currently just returns the value of the ``SESSION_COOKIE_HTTPONLY``\n        config var.\n        """\n        return app.config["SESSION_COOKIE_HTTPONLY"]  # type: ignore[no-any-return]', start: 209, tick: 5, types_hash: 'f6a5810733cc6a2c', _vid: 600}),
  (:Symbol {body_hash: '3fd842e101c3307f', deleted: false, end: 220, key: 'src/flask/sessions.py::SessionInterface.get_cookie_secure', kind: 'method', name: 'get_cookie_secure', path: 'src/flask/sessions.py', qualname: 'SessionInterface.get_cookie_secure', sig_hash: 'd5a3a5b9721effdf', signature: 'get_cookie_secure(self, app: Flask) -> bool', source: '    def get_cookie_secure(self, app: Flask) -> bool:\n        """Returns True if the cookie should be secure.  This currently\n        just returns the value of the ``SESSION_COOKIE_SECURE`` setting.\n        """\n        return app.config["SESSION_COOKIE_SECURE"]  # type: ignore[no-any-return]', start: 216, tick: 5, types_hash: 'f6a5810733cc6a2c', _vid: 601}),
  (:Symbol {body_hash: 'aa8ffce8690ac105', deleted: false, end: 227, key: 'src/flask/sessions.py::SessionInterface.get_cookie_samesite', kind: 'method', name: 'get_cookie_samesite', path: 'src/flask/sessions.py', qualname: 'SessionInterface.get_cookie_samesite', sig_hash: 'd5a3a5b9721effdf', signature: 'get_cookie_samesite(self, app: Flask) -> str | None', source: '    def get_cookie_samesite(self, app: Flask) -> str | None:\n        """Return ``\'Strict\'`` or ``\'Lax\'`` if the cookie should use the\n        ``SameSite`` attribute. This currently just returns the value of\n        the :data:`SESSION_COOKIE_SAMESITE` setting.\n        """\n        return app.config["SESSION_COOKIE_SAMESITE"]  # type: ignore[no-any-return]', start: 222, tick: 5, types_hash: 'dd9e351b663cfc3e', _vid: 602}),
  (:Symbol {body_hash: '55050938f9762e0b', deleted: false, end: 245, key: 'src/flask/sessions.py::SessionInterface.get_expiration_time', kind: 'method', name: 'get_expiration_time', path: 'src/flask/sessions.py', qualname: 'SessionInterface.get_expiration_time', sig_hash: '1f904393276bdee7', signature: 'get_expiration_time(self, app: Flask, session: SessionMixin) -> datetime | None', source: '    def get_expiration_time(self, app: Flask, session: SessionMixin) -> datetime | None:\n        """A helper method that returns an expiration date for the session\n        or ``None`` if the session is linked to the browser session.  The\n        default implementation returns now + the permanent session\n        lifetime configured on the application.\n        """\n        if session.permanent:\n            return datetime.now(timezone.utc) + app.permanent_session_lifetime\n        return None', start: 237, tick: 5, types_hash: '68007c4c6913480c', _vid: 603}),
  (:Symbol {body_hash: '0f0bf57e1b54ecb3', deleted: false, end: 261, key: 'src/flask/sessions.py::SessionInterface.should_set_cookie', kind: 'method', name: 'should_set_cookie', path: 'src/flask/sessions.py', qualname: 'SessionInterface.should_set_cookie', sig_hash: '1f904393276bdee7', signature: 'should_set_cookie(self, app: Flask, session: SessionMixin) -> bool', source: '    def should_set_cookie(self, app: Flask, session: SessionMixin) -> bool:\n        """Used by session backends to determine if a ``Set-Cookie`` header\n        should be set for this session cookie for this response. If the session\n        has been modified, the cookie is set. If the session is permanent and\n        the ``SESSION_REFRESH_EACH_REQUEST`` config is true, the cookie is\n        always set.\n\n        This check is usually skipped if the session was deleted.\n\n        .. versionadded:: 0.11\n        """\n\n        return session.modified or (\n            session.permanent and app.config["SESSION_REFRESH_EACH_REQUEST"]\n        )', start: 247, tick: 5, types_hash: '13d097e1f608301c', _vid: 604}),
  (:Symbol {body_hash: 'f877a37d1609fcdf', deleted: false, end: 275, key: 'src/flask/sessions.py::SessionInterface.open_session', kind: 'method', name: 'open_session', path: 'src/flask/sessions.py', qualname: 'SessionInterface.open_session', sig_hash: 'faaffa266f1a86eb', signature: 'open_session(self, app: Flask, request: Request) -> SessionMixin | None', source: '    def open_session(self, app: Flask, request: Request) -> SessionMixin | None:\n        """This is called at the beginning of each request, after\n        pushing the request context, before matching the URL.\n\n        This must return an object which implements a dictionary-like\n        interface as well as the :class:`SessionMixin` interface.\n\n        This will return ``None`` to indicate that loading failed in\n        some way that is not immediately an error. The request\n        context will fall back to using :meth:`make_null_session`\n        in this case.\n        """\n        raise NotImplementedError()', start: 263, tick: 5, types_hash: '3ac027bdb835ca54', _vid: 605}),
  (:Symbol {body_hash: '0bb21a2821be999d', deleted: false, end: 284, key: 'src/flask/sessions.py::SessionInterface.save_session', kind: 'method', name: 'save_session', path: 'src/flask/sessions.py', qualname: 'SessionInterface.save_session', sig_hash: '8c8b058d8e3c4583', signature: 'save_session(self, app: Flask, session: SessionMixin, response: Response) -> None', source: '    def save_session(\n        self, app: Flask, session: SessionMixin, response: Response\n    ) -> None:\n        """This is called at the end of each request, after generating\n        a response, before removing the request context. It is skipped\n        if :meth:`is_null_session` returns ``True``.\n        """\n        raise NotImplementedError()', start: 277, tick: 5, types_hash: '777e75d17f7e3768', _vid: 606}),
  (:Symbol {body_hash: 'c24e1fa41ba9e65a', deleted: false, end: 398, key: 'src/flask/sessions.py::SecureCookieSessionInterface', kind: 'class', name: 'SecureCookieSessionInterface', path: 'src/flask/sessions.py', qualname: 'SecureCookieSessionInterface', sig_hash: '8bd16d18142c15ee', signature: 'class SecureCookieSessionInterface(SessionInterface)', source: 'class SecureCookieSessionInterface(SessionInterface):\n    """The default session interface that stores sessions in signed cookies\n    through the :mod:`itsdangerous` module.\n    """\n\n    #: the salt that should be applied on top of the secret key for the\n    #: signing of cookie based sessions.\n    salt = "cookie-session"\n    #: the hash function to use for the signature.  The default is sha1\n    digest_method = staticmethod(_lazy_sha1)\n    #: the name of the itsdangerous supported key derivation.  The default\n    #: is hmac.\n    key_derivation = "hmac"\n    #: A python serializer for the payload.  The default is a compact\n    #: JSON derived serializer with support for some extra Python types\n    #: such as datetime objects or tuples.\n    serializer = session_json_serializer\n    session_class = SecureCookieSession\n\n    def get_signing_serializer(self, app: Flask) -> URLSafeTimedSerializer | None:\n        if not app.secret_key:\n            return None\n\n        keys: list[str | bytes] = [app.secret_key]\n\n        if fallbacks := app.config["SECRET_KEY_FALLBACKS"]:\n            keys.extend(fallbacks)\n\n        return URLSafeTimedSerializer(\n            keys,  # type: ignore[arg-type]\n            salt=self.salt,\n            serializer=self.serializer,\n            signer_kwargs={\n                "key_derivation": self.key_derivation,\n                "digest_method": self.digest_method,\n            },\n        )\n\n    def open_session(self, app: Flask, request: Request) -> SecureCookieS\n…', start: 298, tick: 5, types_hash: '', _vid: 607}),
  (:Symbol {body_hash: '9560e563bccff6ba', deleted: false, end: 334, key: 'src/flask/sessions.py::SecureCookieSessionInterface.get_signing_serializer', kind: 'method', name: 'get_signing_serializer', path: 'src/flask/sessions.py', qualname: 'SecureCookieSessionInterface.get_signing_serializer', sig_hash: 'd5a3a5b9721effdf', signature: 'get_signing_serializer(self, app: Flask) -> URLSafeTimedSerializer | None', source: '    def get_signing_serializer(self, app: Flask) -> URLSafeTimedSerializer | None:\n        if not app.secret_key:\n            return None\n\n        keys: list[str | bytes] = [app.secret_key]\n\n        if fallbacks := app.config["SECRET_KEY_FALLBACKS"]:\n            keys.extend(fallbacks)\n\n        return URLSafeTimedSerializer(\n            keys,  # type: ignore[arg-type]\n            salt=self.salt,\n            serializer=self.serializer,\n            signer_kwargs={\n                "key_derivation": self.key_derivation,\n                "digest_method": self.digest_method,\n            },\n        )', start: 317, tick: 5, types_hash: '5da1e1a92d72dec9', _vid: 608}),
  (:Symbol {body_hash: '633545cb9a3b7ffa', deleted: false, end: 348, key: 'src/flask/sessions.py::SecureCookieSessionInterface.open_session', kind: 'method', name: 'open_session', path: 'src/flask/sessions.py', qualname: 'SecureCookieSessionInterface.open_session', sig_hash: 'faaffa266f1a86eb', signature: 'open_session(self, app: Flask, request: Request) -> SecureCookieSession | None', source: '    def open_session(self, app: Flask, request: Request) -> SecureCookieSession | None:\n        s = self.get_signing_serializer(app)\n        if s is None:\n            return None\n        val = request.cookies.get(self.get_cookie_name(app))\n        if not val:\n            return self.session_class()\n        max_age = int(app.permanent_session_lifetime.total_seconds())\n        try:\n            data = s.loads(val, max_age=max_age)\n            return self.session_class(data)\n        except BadSignature:\n            return self.session_class()', start: 336, tick: 5, types_hash: 'c74115911da73646', _vid: 609}),
  (:Symbol {body_hash: '07de818f0f2f8f68', deleted: false, end: 398, key: 'src/flask/sessions.py::SecureCookieSessionInterface.save_session', kind: 'method', name: 'save_session', path: 'src/flask/sessions.py', qualname: 'SecureCookieSessionInterface.save_session', sig_hash: '8c8b058d8e3c4583', signature: 'save_session(self, app: Flask, session: SessionMixin, response: Response) -> None', source: '    def save_session(\n        self, app: Flask, session: SessionMixin, response: Response\n    ) -> None:\n        name = self.get_cookie_name(app)\n        domain = self.get_cookie_domain(app)\n        path = self.get_cookie_path(app)\n        secure = self.get_cookie_secure(app)\n        partitioned = self.get_cookie_partitioned(app)\n        samesite = self.get_cookie_samesite(app)\n        httponly = self.get_cookie_httponly(app)\n\n        # Add a "Vary: Cookie" header if the session was accessed at all.\n        if session.accessed:\n            response.vary.add("Cookie")\n\n        # If the session is modified to be empty, remove the cookie.\n        # If the session is empty, return without setting the cookie.\n        if not session:\n            if session.modified:\n                response.delete_cookie(\n                    name,\n                    domain=domain,\n                    path=path,\n                    secure=secure,\n                    partitioned=partitioned,\n                    samesite=samesite,\n                    httponly=httponly,\n                )\n                response.vary.add("Cookie")\n\n            return\n\n        if not self.should_set_cookie(app, session):\n            return\n\n        expires = self.get_expiration_time(app, session)\n        val = self.get_signing_serializer(app).dumps(dict(session))  # type: ignore[union-attr]\n        response.set_cookie(\n            name,\n            val,\n            expires=expires,\n            httponly=httponly,\n      \n…', start: 350, tick: 5, types_hash: '777e75d17f7e3768', _vid: 610}),
  (:Symbol {body_hash: 'c195b4fa9797d34a', deleted: true, deleted_tick: 5, end: 33, key: 'src/flask/signals.py::__getattr__', kind: 'function', name: '__getattr__', path: 'src/flask/signals.py', qualname: '__getattr__', sig_hash: '7e99456a26cf0784', signature: '__getattr__(name: str) -> t.Any', source: 'def __getattr__(name: str) -> t.Any:\n    if name == "signals_available":\n        warnings.warn(\n            "The \'signals_available\' attribute is deprecated and will be removed in"\n            " Flask 2.4. Signals are always available.",\n            DeprecationWarning,\n            stacklevel=2,\n        )\n        return True\n\n    raise AttributeError(name)', start: 23, tick: 1, types_hash: 'c179ade2eacf2023', _vid: 611}),
  (:Symbol {body_hash: 'a1e70429568112d3', deleted: false, end: 36, key: 'src/flask/templating.py::_default_template_ctx_processor', kind: 'function', name: '_default_template_ctx_processor', path: 'src/flask/templating.py', qualname: '_default_template_ctx_processor', sig_hash: '4943fbd3d489f4fa', signature: '_default_template_ctx_processor() -> dict[str, t.Any]', source: 'def _default_template_ctx_processor() -> dict[str, t.Any]:\n    """Default template context processor.  Injects `request`,\n    `session` and `g`.\n    """\n    appctx = _cv_app.get(None)\n    reqctx = _cv_request.get(None)\n    rv: dict[str, t.Any] = {}\n    if appctx is not None:\n        rv["g"] = appctx.g\n    if reqctx is not None:\n        rv["request"] = reqctx.request\n        rv["session"] = reqctx.session\n    return rv', start: 24, tick: 5, types_hash: '54cc309b8bf4ff67', _vid: 612}),
  (:Symbol {body_hash: '66e39695237b041f', deleted: false, end: 49, key: 'src/flask/templating.py::Environment', kind: 'class', name: 'Environment', path: 'src/flask/templating.py', qualname: 'Environment', sig_hash: '07d5f11372aab77a', signature: 'class Environment(BaseEnvironment)', source: 'class Environment(BaseEnvironment):\n    """Works like a regular Jinja2 environment but has some additional\n    knowledge of how Flask\'s blueprint works so that it can prepend the\n    name of the blueprint to referenced templates if necessary.\n    """\n\n    def __init__(self, app: App, **options: t.Any) -> None:\n        if "loader" not in options:\n            options["loader"] = app.create_global_jinja_loader()\n        BaseEnvironment.__init__(self, **options)\n        self.app = app', start: 39, tick: 5, types_hash: '', _vid: 613}),
  (:Symbol {body_hash: '7f2715f5c71c2fca', deleted: false, end: 49, key: 'src/flask/templating.py::Environment.__init__', kind: 'method', name: '__init__', path: 'src/flask/templating.py', qualname: 'Environment.__init__', sig_hash: 'b75efc9fc74f7866', signature: '__init__(self, app: App, **options: t.Any) -> None', source: '    def __init__(self, app: App, **options: t.Any) -> None:\n        if "loader" not in options:\n            options["loader"] = app.create_global_jinja_loader()\n        BaseEnvironment.__init__(self, **options)\n        self.app = app', start: 45, tick: 5, types_hash: 'ea5dedb6a93eeda9', _vid: 614}),
  (:Symbol {body_hash: '7eb5d1d694f09ca1', deleted: false, end: 123, key: 'src/flask/templating.py::DispatchingJinjaLoader', kind: 'class', name: 'DispatchingJinjaLoader', path: 'src/flask/templating.py', qualname: 'DispatchingJinjaLoader', sig_hash: 'b9c32cf502818e02', signature: 'class DispatchingJinjaLoader(BaseLoader)', source: 'class DispatchingJinjaLoader(BaseLoader):\n    """A loader that looks for templates in the application and all\n    the blueprint folders.\n    """\n\n    def __init__(self, app: App) -> None:\n        self.app = app\n\n    def get_source(\n        self, environment: BaseEnvironment, template: str\n    ) -> tuple[str, str | None, t.Callable[[], bool] | None]:\n        if self.app.config["EXPLAIN_TEMPLATE_LOADING"]:\n            return self._get_source_explained(environment, template)\n        return self._get_source_fast(environment, template)\n\n    def _get_source_explained(\n        self, environment: BaseEnvironment, template: str\n    ) -> tuple[str, str | None, t.Callable[[], bool] | None]:\n        attempts = []\n        rv: tuple[str, str | None, t.Callable[[], bool] | None] | None\n        trv: None | (tuple[str, str | None, t.Callable[[], bool] | None]) = None\n\n        for srcobj, loader in self._iter_loaders(template):\n            try:\n                rv = loader.get_source(environment, template)\n                if trv is None:\n                    trv = rv\n            except TemplateNotFound:\n                rv = None\n            attempts.append((loader, srcobj, rv))\n\n        from .debughelpers import explain_template_loading_attempts\n\n        explain_template_loading_attempts(self.app, template, attempts)\n\n        if trv is not None:\n            return trv\n        raise TemplateNotFound(template)\n\n    def _get_source_fast(\n        self, environment: BaseEnvironment, template: str\n   \n…', start: 52, tick: 5, types_hash: '', _vid: 615}),
  (:Symbol {body_hash: 'b3fa788a22a8a19a', deleted: false, end: 58, key: 'src/flask/templating.py::DispatchingJinjaLoader.__init__', kind: 'method', name: '__init__', path: 'src/flask/templating.py', qualname: 'DispatchingJinjaLoader.__init__', sig_hash: 'd5a3a5b9721effdf', signature: '__init__(self, app: App) -> None', source: '    def __init__(self, app: App) -> None:\n        self.app = app', start: 57, tick: 5, types_hash: '532280d60d9f158b', _vid: 616}),
  (:Symbol {body_hash: '38c5e991444867c9', deleted: false, end: 65, key: 'src/flask/templating.py::DispatchingJinjaLoader.get_source', kind: 'method', name: 'get_source', path: 'src/flask/templating.py', qualname: 'DispatchingJinjaLoader.get_source', sig_hash: 'cf6ed9dc270632bb', signature: 'get_source(self, environment: BaseEnvironment, template: str) -> tuple[str, str | None, t.Callable[[], bool] | None]', source: '    def get_source(\n        self, environment: BaseEnvironment, template: str\n    ) -> tuple[str, str | None, t.Callable[[], bool] | None]:\n        if self.app.config["EXPLAIN_TEMPLATE_LOADING"]:\n            return self._get_source_explained(environment, template)\n        return self._get_source_fast(environment, template)', start: 60, tick: 5, types_hash: 'd9bda11c9b393060', _vid: 617}),
  (:Symbol {body_hash: '9b6057c25fa15cc8', deleted: false, end: 89, key: 'src/flask/templating.py::DispatchingJinjaLoader._get_source_explained', kind: 'method', name: '_get_source_explained', path: 'src/flask/templating.py', qualname: 'DispatchingJinjaLoader._get_source_explained', sig_hash: 'cf6ed9dc270632bb', signature: '_get_source_explained(self, environment: BaseEnvironment, template: str) -> tuple[str, str | None, t.Callable[[], bool] | None]', source: '    def _get_source_explained(\n        self, environment: BaseEnvironment, template: str\n    ) -> tuple[str, str | None, t.Callable[[], bool] | None]:\n        attempts = []\n        rv: tuple[str, str | None, t.Callable[[], bool] | None] | None\n        trv: None | (tuple[str, str | None, t.Callable[[], bool] | None]) = None\n\n        for srcobj, loader in self._iter_loaders(template):\n            try:\n                rv = loader.get_source(environment, template)\n                if trv is None:\n                    trv = rv\n            except TemplateNotFound:\n                rv = None\n            attempts.append((loader, srcobj, rv))\n\n        from .debughelpers import explain_template_loading_attempts\n\n        explain_template_loading_attempts(self.app, template, attempts)\n\n        if trv is not None:\n            return trv\n        raise TemplateNotFound(template)', start: 67, tick: 5, types_hash: 'd9bda11c9b393060', _vid: 618}),
  (:Symbol {body_hash: '0e1ebfcc8ad81eba', deleted: false, end: 99, key: 'src/flask/templating.py::DispatchingJinjaLoader._get_source_fast', kind: 'method', name: '_get_source_fast', path: 'src/flask/templating.py', qualname: 'DispatchingJinjaLoader._get_source_fast', sig_hash: 'cf6ed9dc270632bb', signature: '_get_source_fast(self, environment: BaseEnvironment, template: str) -> tuple[str, str | None, t.Callable[[], bool] | None]', source: '    def _get_source_fast(\n        self, environment: BaseEnvironment, template: str\n    ) -> tuple[str, str | None, t.Callable[[], bool] | None]:\n        for _srcobj, loader in self._iter_loaders(template):\n            try:\n                return loader.get_source(environment, template)\n            except TemplateNotFound:\n                continue\n        raise TemplateNotFound(template)', start: 91, tick: 5, types_hash: 'd9bda11c9b393060', _vid: 619}),
  (:Symbol {body_hash: 'c6291160575ded50', deleted: false, end: 109, key: 'src/flask/templating.py::DispatchingJinjaLoader._iter_loaders', kind: 'method', name: '_iter_loaders', path: 'src/flask/templating.py', qualname: 'DispatchingJinjaLoader._iter_loaders', sig_hash: 'd279f77ab9131afa', signature: '_iter_loaders(self, template: str) -> t.Iterator[tuple[Scaffold, BaseLoader]]', source: '    def _iter_loaders(self, template: str) -> t.Iterator[tuple[Scaffold, BaseLoader]]:\n        loader = self.app.jinja_loader\n        if loader is not None:\n            yield self.app, loader\n\n        for blueprint in self.app.iter_blueprints():\n            loader = blueprint.jinja_loader\n            if loader is not None:\n                yield blueprint, loader', start: 101, tick: 5, types_hash: '7beaaab2fcef5732', _vid: 620}),
  (:Symbol {body_hash: '638155c8ef0e536f', deleted: false, end: 123, key: 'src/flask/templating.py::DispatchingJinjaLoader.list_templates', kind: 'method', name: 'list_templates', path: 'src/flask/templating.py', qualname: 'DispatchingJinjaLoader.list_templates', sig_hash: '9626d105938f0039', signature: 'list_templates(self) -> list[str]', source: '    def list_templates(self) -> list[str]:\n        result = set()\n        loader = self.app.jinja_loader\n        if loader is not None:\n            result.update(loader.list_templates())\n\n        for blueprint in self.app.iter_blueprints():\n            loader = blueprint.jinja_loader\n            if loader is not None:\n                for template in loader.list_templates():\n                    result.add(template)\n\n        return list(result)', start: 111, tick: 5, types_hash: '658106d433ba12e4', _vid: 621}),
  (:Symbol {body_hash: '941974310770f7a6', deleted: false, end: 135, key: 'src/flask/templating.py::_render', kind: 'function', name: '_render', path: 'src/flask/templating.py', qualname: '_render', sig_hash: '3dcca3a061194e59', signature: '_render(app: Flask, template: Template, context: dict[str, t.Any]) -> str', source: 'def _render(app: Flask, template: Template, context: dict[str, t.Any]) -> str:\n    app.update_template_context(context)\n    before_render_template.send(\n        app, _async_wrapper=app.ensure_sync, template=template, context=context\n    )\n    rv = template.render(context)\n    template_rendered.send(\n        app, _async_wrapper=app.ensure_sync, template=template, context=context\n    )\n    return rv', start: 126, tick: 5, types_hash: '8804800b1edd121d', _vid: 622}),
  (:Symbol {body_hash: '620cba01f5dc3da8', deleted: false, end: 150, key: 'src/flask/templating.py::render_template', kind: 'function', name: 'render_template', path: 'src/flask/templating.py', qualname: 'render_template', sig_hash: '0d1fa7365f44fc42', signature: 'render_template(template_name_or_list: str | Template | list[str | Template], **context: t.Any) -> str', source: 'def render_template(\n    template_name_or_list: str | Template | list[str | Template],\n    **context: t.Any,\n) -> str:\n    """Render a template by name with the given context.\n\n    :param template_name_or_list: The name of the template to render. If\n        a list is given, the first name to exist will be rendered.\n    :param context: The variables to make available in the template.\n    """\n    app = current_app._get_current_object()  # type: ignore[attr-defined]\n    template = app.jinja_env.get_or_select_template(template_name_or_list)\n    return _render(app, template, context)', start: 138, tick: 5, types_hash: '673e35d34c51ce6d', _vid: 623}),
  (:Symbol {body_hash: '47c7563d8a31374b', deleted: false, end: 162, key: 'src/flask/templating.py::render_template_string', kind: 'function', name: 'render_template_string', path: 'src/flask/templating.py', qualname: 'render_template_string', sig_hash: '851c313b7262cc24', signature: 'render_template_string(source: str, **context: t.Any) -> str', source: 'def render_template_string(source: str, **context: t.Any) -> str:\n    """Render a template from the given source string with the given\n    context.\n\n    :param source: The source code of the template to render.\n    :param context: The variables to make available in the template.\n    """\n    app = current_app._get_current_object()  # type: ignore[attr-defined]\n    template = app.jinja_env.from_string(source)\n    return _render(app, template, context)', start: 153, tick: 5, types_hash: 'b6f59a7170c3b7b5', _vid: 624}),
  (:Symbol {body_hash: 'f532f861b13c36c7', deleted: false, end: 185, key: 'src/flask/templating.py::_stream', kind: 'function', name: '_stream', path: 'src/flask/templating.py', qualname: '_stream', sig_hash: '3dcca3a061194e59', signature: '_stream(app: Flask, template: Template, context: dict[str, t.Any]) -> t.Iterator[str]', source: 'def _stream(\n    app: Flask, template: Template, context: dict[str, t.Any]\n) -> t.Iterator[str]:\n    app.update_template_context(context)\n    before_render_template.send(\n        app, _async_wrapper=app.ensure_sync, template=template, context=context\n    )\n\n    def generate() -> t.Iterator[str]:\n        yield from template.generate(context)\n        template_rendered.send(\n            app, _async_wrapper=app.ensure_sync, template=template, context=context\n        )\n\n    rv = generate()\n\n    # If a request context is active, keep it while generating.\n    if request:\n        rv = stream_with_context(rv)\n\n    return rv', start: 165, tick: 5, types_hash: '72a5520dc453c693', _vid: 625}),
  (:Symbol {body_hash: '30177b72c853debc', deleted: false, end: 204, key: 'src/flask/templating.py::stream_template', kind: 'function', name: 'stream_template', path: 'src/flask/templating.py', qualname: 'stream_template', sig_hash: '0d1fa7365f44fc42', signature: 'stream_template(template_name_or_list: str | Template | list[str | Template], **context: t.Any) -> t.Iterator[str]', source: 'def stream_template(\n    template_name_or_list: str | Template | list[str | Template],\n    **context: t.Any,\n) -> t.Iterator[str]:\n    """Render a template by name with the given context as a stream.\n    This returns an iterator of strings, which can be used as a\n    streaming response from a view.\n\n    :param template_name_or_list: The name of the template to render. If\n        a list is given, the first name to exist will be rendered.\n    :param context: The variables to make available in the template.\n\n    .. versionadded:: 2.2\n    """\n    app = current_app._get_current_object()  # type: ignore[attr-defined]\n    template = app.jinja_env.get_or_select_template(template_name_or_list)\n    return _stream(app, template, context)', start: 188, tick: 5, types_hash: '34ea774df8a04dff', _vid: 626}),
  (:Symbol {body_hash: '86feffb1872efaf3', deleted: false, end: 219, key: 'src/flask/templating.py::stream_template_string', kind: 'function', name: 'stream_template_string', path: 'src/flask/templating.py', qualname: 'stream_template_string', sig_hash: '851c313b7262cc24', signature: 'stream_template_string(source: str, **context: t.Any) -> t.Iterator[str]', source: 'def stream_template_string(source: str, **context: t.Any) -> t.Iterator[str]:\n    """Render a template from the given source string with the given\n    context as a stream. This returns an iterator of strings, which can\n    be used as a streaming response from a view.\n\n    :param source: The source code of the template to render.\n    :param context: The variables to make available in the template.\n\n    .. versionadded:: 2.2\n    """\n    app = current_app._get_current_object()  # type: ignore[attr-defined]\n    template = app.jinja_env.from_string(source)\n    return _stream(app, template, context)', start: 207, tick: 5, types_hash: 'ba60c2ff731108f2', _vid: 627}),
  (:Symbol {body_hash: 'b6eece67a9f73f1f', deleted: false, end: 93, key: 'src/flask/testing.py::EnvironBuilder', kind: 'class', name: 'EnvironBuilder', path: 'src/flask/testing.py', qualname: 'EnvironBuilder', sig_hash: '69ca177dac3d1cea', signature: 'class EnvironBuilder(werkzeug.test.EnvironBuilder)', source: 'class EnvironBuilder(werkzeug.test.EnvironBuilder):\n    """An :class:`~werkzeug.test.EnvironBuilder`, that takes defaults from the\n    application.\n\n    :param app: The Flask application to configure the environment from.\n    :param path: URL path being requested.\n    :param base_url: Base URL where the app is being served, which\n        ``path`` is relative to. If not given, built from\n        :data:`PREFERRED_URL_SCHEME`, ``subdomain``,\n        :data:`SERVER_NAME`, and :data:`APPLICATION_ROOT`.\n    :param subdomain: Subdomain name to append to :data:`SERVER_NAME`.\n    :param url_scheme: Scheme to use instead of\n        :data:`PREFERRED_URL_SCHEME`.\n    :param json: If given, this is serialized as JSON and passed as\n        ``data``. Also defaults ``content_type`` to\n        ``application/json``.\n    :param args: other positional arguments passed to\n        :class:`~werkzeug.test.EnvironBuilder`.\n    :param kwargs: other keyword arguments passed to\n        :class:`~werkzeug.test.EnvironBuilder`.\n    """\n\n    def __init__(\n        self,\n        app: Flask,\n        path: str = "/",\n        base_url: str | None = None,\n        subdomain: str | None = None,\n        url_scheme: str | None = None,\n        *args: t.Any,\n        **kwargs: t.Any,\n    ) -> None:\n        assert not (base_url or subdomain or url_scheme) or (\n            base_url is not None\n        ) != bool(\n            subdomain or url_scheme\n        ), \'Cannot pass "subdomain" or "url_scheme" with "base_url".\'\n\n     \n…', start: 26, tick: 5, types_hash: '', _vid: 628}),
  (:Symbol {body_hash: '97d5badec103d5ea', deleted: false, end: 85, key: 'src/flask/testing.py::EnvironBuilder.__init__', kind: 'method', name: '__init__', path: 'src/flask/testing.py', qualname: 'EnvironBuilder.__init__', sig_hash: '0ac4d7501a7f37dc', signature: '__init__(self, app: Flask, path: str=\'/\', base_url: str | None=None, subdomain: str | None=None, url_scheme: str | None=None, *args: t.Any, **kwargs: t.Any) -> None', source: '    def __init__(\n        self,\n        app: Flask,\n        path: str = "/",\n        base_url: str | None = None,\n        subdomain: str | None = None,\n        url_scheme: str | None = None,\n        *args: t.Any,\n        **kwargs: t.Any,\n    ) -> None:\n        assert not (base_url or subdomain or url_scheme) or (\n            base_url is not None\n        ) != bool(\n            subdomain or url_scheme\n        ), \'Cannot pass "subdomain" or "url_scheme" with "base_url".\'\n\n        if base_url is None:\n            http_host = app.config.get("SERVER_NAME") or "localhost"\n            app_root = app.config["APPLICATION_ROOT"]\n\n            if subdomain:\n                http_host = f"{subdomain}.{http_host}"\n\n            if url_scheme is None:\n                url_scheme = app.config["PREFERRED_URL_SCHEME"]\n\n            url = urlsplit(path)\n            base_url = (\n                f"{url.scheme or url_scheme}://{url.netloc or http_host}"\n                f"/{app_root.lstrip(\'/\')}"\n            )\n            path = url.path\n\n            if url.query:\n                path = f"{path}?{url.query}"\n\n        self.app = app\n        super().__init__(path, base_url, *args, **kwargs)', start: 48, tick: 5, types_hash: '4f5d7bf980798bc2', _vid: 629}),
  (:Symbol {body_hash: 'a954c6983a30be4a', deleted: false, end: 93, key: 'src/flask/testing.py::EnvironBuilder.json_dumps', kind: 'method', name: 'json_dumps', path: 'src/flask/testing.py', qualname: 'EnvironBuilder.json_dumps', sig_hash: 'a5c89d899bc11549', signature: 'json_dumps(self, obj: t.Any, **kwargs: t.Any) -> str', source: '    def json_dumps(self, obj: t.Any, **kwargs: t.Any) -> str:  # type: ignore\n        """Serialize ``obj`` to a JSON-formatted string.\n\n        The serialization will be configured according to the config associated\n        with this EnvironBuilder\'s ``app``.\n        """\n        return self.app.json.dumps(obj, **kwargs)', start: 87, tick: 5, types_hash: 'a3b67a40e2f40ce5', _vid: 630}),
  (:Symbol {body_hash: 'dd96003220df0772', deleted: false, end: 261, key: 'src/flask/testing.py::FlaskClient', kind: 'class', name: 'FlaskClient', path: 'src/flask/testing.py', qualname: 'FlaskClient', sig_hash: '7e0e980ffe1f8c03', signature: 'class FlaskClient(Client)', source: 'class FlaskClient(Client):\n    """Works like a regular Werkzeug test client but has knowledge about\n    Flask\'s contexts to defer the cleanup of the request context until\n    the end of a ``with`` block. For general information about how to\n    use this class refer to :class:`werkzeug.test.Client`.\n\n    .. versionchanged:: 0.12\n       `app.test_client()` includes preset default environment, which can be\n       set after instantiation of the `app.test_client()` object in\n       `client.environ_base`.\n\n    Basic usage is outlined in the :doc:`/testing` chapter.\n    """\n\n    application: Flask\n\n    def __init__(self, *args: t.Any, **kwargs: t.Any) -> None:\n        super().__init__(*args, **kwargs)\n        self.preserve_context = False\n        self._new_contexts: list[t.ContextManager[t.Any]] = []\n        self._context_stack = ExitStack()\n        self.environ_base = {\n            "REMOTE_ADDR": "127.0.0.1",\n            "HTTP_USER_AGENT": f"Werkzeug/{_get_werkzeug_version()}",\n        }\n\n    @contextmanager\n    def session_transaction(\n        self, *args: t.Any, **kwargs: t.Any\n    ) -> t.Iterator[SessionMixin]:\n        """When used in combination with a ``with`` statement this opens a\n        session transaction.  This can be used to modify the session that\n        the test client uses.  Once the ``with`` block is left the session is\n        stored back.\n\n        ::\n\n            with client.session_transaction() as session:\n                session[\'value\'] = 42\n\n        Internal\n…', start: 108, tick: 5, types_hash: '', _vid: 631}),
  (:Symbol {body_hash: '242e4914a6eeec65', deleted: false, end: 132, key: 'src/flask/testing.py::FlaskClient.__init__', kind: 'method', name: '__init__', path: 'src/flask/testing.py', qualname: 'FlaskClient.__init__', sig_hash: '720606666acb024c', signature: '__init__(self, *args: t.Any, **kwargs: t.Any) -> None', source: '    def __init__(self, *args: t.Any, **kwargs: t.Any) -> None:\n        super().__init__(*args, **kwargs)\n        self.preserve_context = False\n        self._new_contexts: list[t.ContextManager[t.Any]] = []\n        self._context_stack = ExitStack()\n        self.environ_base = {\n            "REMOTE_ADDR": "127.0.0.1",\n            "HTTP_USER_AGENT": f"Werkzeug/{_get_werkzeug_version()}",\n        }', start: 124, tick: 5, types_hash: '6d2fdaca47e73faa', _vid: 632}),
  (:Symbol {body_hash: '3eb7337a901688ff', deleted: false, end: 182, key: 'src/flask/testing.py::FlaskClient.session_transaction', kind: 'method', name: 'session_transaction', path: 'src/flask/testing.py', qualname: 'FlaskClient.session_transaction', sig_hash: '720606666acb024c', signature: 'session_transaction(self, *args: t.Any, **kwargs: t.Any) -> t.Iterator[SessionMixin]', source: '    @contextmanager\n    def session_transaction(\n        self, *args: t.Any, **kwargs: t.Any\n    ) -> t.Iterator[SessionMixin]:\n        """When used in combination with a ``with`` statement this opens a\n        session transaction.  This can be used to modify the session that\n        the test client uses.  Once the ``with`` block is left the session is\n        stored back.\n\n        ::\n\n            with client.session_transaction() as session:\n                session[\'value\'] = 42\n\n        Internally this is implemented by going through a temporary test\n        request context and since session handling could depend on\n        request variables this function accepts the same arguments as\n        :meth:`~flask.Flask.test_request_context` which are directly\n        passed through.\n        """\n        if self._cookies is None:\n            raise TypeError(\n                "Cookies are disabled. Create a client with \'use_cookies=True\'."\n            )\n\n        app = self.application\n        ctx = app.test_request_context(*args, **kwargs)\n        self._add_cookies_to_wsgi(ctx.request.environ)\n\n        with ctx:\n            sess = app.session_interface.open_session(app, ctx.request)\n\n        if sess is None:\n            raise RuntimeError("Session backend did not open a session.")\n\n        yield sess\n        resp = app.response_class()\n\n        if app.session_interface.is_null_session(sess):\n            return\n\n        with ctx:\n            app.session_interface.save_session(app, sess\n…', start: 135, tick: 5, types_hash: '38c2e4fca3a65c4b', _vid: 633}),
  (:Symbol {body_hash: 'b14a17672dcf4cbc', deleted: false, end: 190, key: 'src/flask/testing.py::FlaskClient._copy_environ', kind: 'method', name: '_copy_environ', path: 'src/flask/testing.py', qualname: 'FlaskClient._copy_environ', sig_hash: '64424d10ce4f1c1b', signature: '_copy_environ(self, other: WSGIEnvironment) -> WSGIEnvironment', source: '    def _copy_environ(self, other: WSGIEnvironment) -> WSGIEnvironment:\n        out = {**self.environ_base, **other}\n\n        if self.preserve_context:\n            out["werkzeug.debug.preserve_context"] = self._new_contexts.append\n\n        return out', start: 184, tick: 5, types_hash: '84130aaed729757f', _vid: 634}),
  (:Symbol {body_hash: '868d88fff59edb30', deleted: false, end: 201, key: 'src/flask/testing.py::FlaskClient._request_from_builder_args', kind: 'method', name: '_request_from_builder_args', path: 'src/flask/testing.py', qualname: 'FlaskClient._request_from_builder_args', sig_hash: '79a21af59c9db009', signature: '_request_from_builder_args(self, args: tuple[t.Any, ...], kwargs: dict[str, t.Any]) -> BaseRequest', source: '    def _request_from_builder_args(\n        self, args: tuple[t.Any, ...], kwargs: dict[str, t.Any]\n    ) -> BaseRequest:\n        kwargs["environ_base"] = self._copy_environ(kwargs.get("environ_base", {}))\n        builder = EnvironBuilder(self.application, *args, **kwargs)\n\n        try:\n            return builder.get_request()\n        finally:\n            builder.close()', start: 192, tick: 5, types_hash: 'bbca7ffeb1e67588', _vid: 635}),
  (:Symbol {body_hash: '4f8067bdcedef71e', deleted: false, end: 246, key: 'src/flask/testing.py::FlaskClient.open', kind: 'method', name: 'open', path: 'src/flask/testing.py', qualname: 'FlaskClient.open', sig_hash: '6e46de26e4bec492', signature: 'open(self, *args: t.Any, buffered: bool=False, follow_redirects: bool=False, **kwargs: t.Any) -> TestResponse', source: '    def open(\n        self,\n        *args: t.Any,\n        buffered: bool = False,\n        follow_redirects: bool = False,\n        **kwargs: t.Any,\n    ) -> TestResponse:\n        if args and isinstance(\n            args[0], (werkzeug.test.EnvironBuilder, dict, BaseRequest)\n        ):\n            if isinstance(args[0], werkzeug.test.EnvironBuilder):\n                builder = copy(args[0])\n                builder.environ_base = self._copy_environ(builder.environ_base or {})  # type: ignore[arg-type]\n                request = builder.get_request()\n            elif isinstance(args[0], dict):\n                request = EnvironBuilder.from_environ(\n                    args[0], app=self.application, environ_base=self._copy_environ({})\n                ).get_request()\n            else:\n                # isinstance(args[0], BaseRequest)\n                request = copy(args[0])\n                request.environ = self._copy_environ(request.environ)\n        else:\n            # request is None\n            request = self._request_from_builder_args(args, kwargs)\n\n        # Pop any previously preserved contexts. This prevents contexts\n        # from being preserved across redirects or multiple requests\n        # within a single block.\n        self._context_stack.close()\n\n        response = super().open(\n            request,\n            buffered=buffered,\n            follow_redirects=follow_redirects,\n        )\n        response.json_module = self.application.json  # type: ignore[assignment]\n\n     \n…', start: 203, tick: 5, types_hash: '38d3e71e72ab36df', _vid: 636}),
  (:Symbol {body_hash: '1c2a02d21dfe1cfd', deleted: false, end: 252, key: 'src/flask/testing.py::FlaskClient.__enter__', kind: 'method', name: '__enter__', path: 'src/flask/testing.py', qualname: 'FlaskClient.__enter__', sig_hash: '9626d105938f0039', signature: '__enter__(self) -> FlaskClient', source: '    def __enter__(self) -> FlaskClient:\n        if self.preserve_context:\n            raise RuntimeError("Cannot nest client invocations")\n        self.preserve_context = True\n        return self', start: 248, tick: 5, types_hash: '550a96761f3b2976', _vid: 637}),
  (:Symbol {body_hash: '7fbac7e3599c151c', deleted: false, end: 261, key: 'src/flask/testing.py::FlaskClient.__exit__', kind: 'method', name: '__exit__', path: 'src/flask/testing.py', qualname: 'FlaskClient.__exit__', sig_hash: '882cf357ee9d7ad0', signature: '__exit__(self, exc_type: type | None, exc_value: BaseException | None, tb: TracebackType | None) -> None', source: '    def __exit__(\n        self,\n        exc_type: type | None,\n        exc_value: BaseException | None,\n        tb: TracebackType | None,\n    ) -> None:\n        self.preserve_context = False\n        self._context_stack.close()', start: 254, tick: 5, types_hash: 'bb5d73f1f25ee6cb', _vid: 638}),
  (:Symbol {body_hash: '431f789f6097ae9b', deleted: false, end: 297, key: 'src/flask/testing.py::FlaskCliRunner', kind: 'class', name: 'FlaskCliRunner', path: 'src/flask/testing.py', qualname: 'FlaskCliRunner', sig_hash: '5f76efdc952db060', signature: 'class FlaskCliRunner(CliRunner)', source: 'class FlaskCliRunner(CliRunner):\n    """A :class:`~click.testing.CliRunner` for testing a Flask app\'s\n    CLI commands. Typically created using\n    :meth:`~flask.Flask.test_cli_runner`. See :ref:`testing-cli`.\n    """\n\n    def __init__(self, app: Flask, **kwargs: t.Any) -> None:\n        self.app = app\n        super().__init__(**kwargs)\n\n    def invoke(  # type: ignore\n        self, cli: t.Any = None, args: t.Any = None, **kwargs: t.Any\n    ) -> t.Any:\n        """Invokes a CLI command in an isolated environment. See\n        :meth:`CliRunner.invoke <click.testing.CliRunner.invoke>` for\n        full method documentation. See :ref:`testing-cli` for examples.\n\n        If the ``obj`` argument is not given, passes an instance of\n        :class:`~flask.cli.ScriptInfo` that knows how to load the Flask\n        app being tested.\n\n        :param cli: Command object to invoke. Default is the app\'s\n            :attr:`~flask.app.Flask.cli` group.\n        :param args: List of strings to invoke the command with.\n\n        :return: a :class:`~click.testing.Result` object.\n        """\n        if cli is None:\n            cli = self.app.cli\n\n        if "obj" not in kwargs:\n            kwargs["obj"] = ScriptInfo(create_app=lambda: self.app)\n\n        return super().invoke(cli, args, **kwargs)', start: 264, tick: 5, types_hash: '', _vid: 639}),
  (:Symbol {body_hash: '3390d3d893ed8e76', deleted: false, end: 272, key: 'src/flask/testing.py::FlaskCliRunner.__init__', kind: 'method', name: '__init__', path: 'src/flask/testing.py', qualname: 'FlaskCliRunner.__init__', sig_hash: '8909dc923d6a3e27', signature: '__init__(self, app: Flask, **kwargs: t.Any) -> None', source: '    def __init__(self, app: Flask, **kwargs: t.Any) -> None:\n        self.app = app\n        super().__init__(**kwargs)', start: 270, tick: 5, types_hash: '73152ca46f919aba', _vid: 640}),
  (:Symbol {body_hash: '14897db23ea74aae', deleted: false, end: 297, key: 'src/flask/testing.py::FlaskCliRunner.invoke', kind: 'method', name: 'invoke', path: 'src/flask/testing.py', qualname: 'FlaskCliRunner.invoke', sig_hash: '6dbc6bd3e3f7b076', signature: 'invoke(self, cli: t.Any=None, args: t.Any=None, **kwargs: t.Any) -> t.Any', source: '    def invoke(  # type: ignore\n        self, cli: t.Any = None, args: t.Any = None, **kwargs: t.Any\n    ) -> t.Any:\n        """Invokes a CLI command in an isolated environment. See\n        :meth:`CliRunner.invoke <click.testing.CliRunner.invoke>` for\n        full method documentation. See :ref:`testing-cli` for examples.\n\n        If the ``obj`` argument is not given, passes an instance of\n        :class:`~flask.cli.ScriptInfo` that knows how to load the Flask\n        app being tested.\n\n        :param cli: Command object to invoke. Default is the app\'s\n            :attr:`~flask.app.Flask.cli` group.\n        :param args: List of strings to invoke the command with.\n\n        :return: a :class:`~click.testing.Result` object.\n        """\n        if cli is None:\n            cli = self.app.cli\n\n        if "obj" not in kwargs:\n            kwargs["obj"] = ScriptInfo(create_app=lambda: self.app)\n\n        return super().invoke(cli, args, **kwargs)', start: 274, tick: 5, types_hash: '505faccd9dde5971', _vid: 641}),
  (:Symbol {body_hash: '94325379ac1989fc', deleted: false, end: 135, key: 'src/flask/views.py::View', kind: 'class', name: 'View', path: 'src/flask/views.py', qualname: 'View', sig_hash: '42ba610a86d15094', signature: 'class View', source: 'class View:\n    """Subclass this class and override :meth:`dispatch_request` to\n    create a generic class-based view. Call :meth:`as_view` to create a\n    view function that creates an instance of the class with the given\n    arguments and calls its ``dispatch_request`` method with any URL\n    variables.\n\n    See :doc:`views` for a detailed guide.\n\n    .. code-block:: python\n\n        class Hello(View):\n            init_every_request = False\n\n            def dispatch_request(self, name):\n                return f"Hello, {name}!"\n\n        app.add_url_rule(\n            "/hello/<name>", view_func=Hello.as_view("hello")\n        )\n\n    Set :attr:`methods` on the class to change what methods the view\n    accepts.\n\n    Set :attr:`decorators` on the class to apply a list of decorators to\n    the generated view function. Decorators applied to the class itself\n    will not be applied to the generated view function!\n\n    Set :attr:`init_every_request` to ``False`` for efficiency, unless\n    you need to store request-global data on ``self``.\n    """\n\n    #: The methods this view is registered for. Uses the same default\n    #: (``["GET", "HEAD", "OPTIONS"]``) as ``route`` and\n    #: ``add_url_rule`` by default.\n    methods: t.ClassVar[t.Collection[str] | None] = None\n\n    #: Control whether the ``OPTIONS`` method is handled automatically.\n    #: Uses the same default (``True``) as ``route`` and\n    #: ``add_url_rule`` by default.\n    provide_automatic_options: t.ClassVar[bool | None] = Non\n…', start: 16, tick: 5, types_hash: '', _vid: 642}),
  (:Symbol {body_hash: '1a4ae51d94e8ce87', deleted: false, end: 83, key: 'src/flask/views.py::View.dispatch_request', kind: 'method', name: 'dispatch_request', path: 'src/flask/views.py', qualname: 'View.dispatch_request', sig_hash: '9626d105938f0039', signature: 'dispatch_request(self) -> ft.ResponseReturnValue', source: '    def dispatch_request(self) -> ft.ResponseReturnValue:\n        """The actual view function behavior. Subclasses must override\n        this and return a valid response. Any variables from the URL\n        rule are passed as keyword arguments.\n        """\n        raise NotImplementedError()', start: 78, tick: 5, types_hash: '1a88bd29a23f92d2', _vid: 643}),
  (:Symbol {body_hash: 'f65ed62aff0fe667', deleted: false, end: 135, key: 'src/flask/views.py::View.as_view', kind: 'method', name: 'as_view', path: 'src/flask/views.py', qualname: 'View.as_view', sig_hash: '516bb590def9e71f', signature: 'as_view(cls, name: str, *class_args: t.Any, **class_kwargs: t.Any) -> ft.RouteCallable', source: '    @classmethod\n    def as_view(\n        cls, name: str, *class_args: t.Any, **class_kwargs: t.Any\n    ) -> ft.RouteCallable:\n        """Convert the class into a view function that can be registered\n        for a route.\n\n        By default, the generated view will create a new instance of the\n        view class for every request and call its\n        :meth:`dispatch_request` method. If the view class sets\n        :attr:`init_every_request` to ``False``, the same instance will\n        be used for every request.\n\n        Except for ``name``, all other arguments passed to this method\n        are forwarded to the view class ``__init__`` method.\n\n        .. versionchanged:: 2.2\n            Added the ``init_every_request`` class attribute.\n        """\n        if cls.init_every_request:\n\n            def view(**kwargs: t.Any) -> ft.ResponseReturnValue:\n                self = view.view_class(  # type: ignore[attr-defined]\n                    *class_args, **class_kwargs\n                )\n                return current_app.ensure_sync(self.dispatch_request)(**kwargs)  # type: ignore[no-any-return]\n\n        else:\n            self = cls(*class_args, **class_kwargs)  # pyright: ignore\n\n            def view(**kwargs: t.Any) -> ft.ResponseReturnValue:\n                return current_app.ensure_sync(self.dispatch_request)(**kwargs)  # type: ignore[no-any-return]\n\n        if cls.decorators:\n            view.__name__ = name\n            view.__module__ = cls.__module__\n            for decorator i\n…', start: 86, tick: 5, types_hash: 'd76ca4b45848b6cd', _vid: 644}),
  (:Symbol {body_hash: '9f2cfaef2024c351', deleted: false, end: 191, key: 'src/flask/views.py::MethodView', kind: 'class', name: 'MethodView', path: 'src/flask/views.py', qualname: 'MethodView', sig_hash: '8f40e5b7eeb17735', signature: 'class MethodView(View)', source: 'class MethodView(View):\n    """Dispatches request methods to the corresponding instance methods.\n    For example, if you implement a ``get`` method, it will be used to\n    handle ``GET`` requests.\n\n    This can be useful for defining a REST API.\n\n    :attr:`methods` is automatically set based on the methods defined on\n    the class.\n\n    See :doc:`views` for a detailed guide.\n\n    .. code-block:: python\n\n        class CounterAPI(MethodView):\n            def get(self):\n                return str(session.get("counter", 0))\n\n            def post(self):\n                session["counter"] = session.get("counter", 0) + 1\n                return redirect(url_for("counter"))\n\n        app.add_url_rule(\n            "/counter", view_func=CounterAPI.as_view("counter")\n        )\n    """\n\n    def __init_subclass__(cls, **kwargs: t.Any) -> None:\n        super().__init_subclass__(**kwargs)\n\n        if "methods" not in cls.__dict__:\n            methods = set()\n\n            for base in cls.__bases__:\n                if getattr(base, "methods", None):\n                    methods.update(base.methods)  # type: ignore[attr-defined]\n\n            for key in http_method_funcs:\n                if hasattr(cls, key):\n                    methods.add(key.upper())\n\n            if methods:\n                cls.methods = methods\n\n    def dispatch_request(self, **kwargs: t.Any) -> ft.ResponseReturnValue:\n        meth = getattr(self, request.method.lower(), None)\n\n        # If the request method is HEAD and we d\n…', start: 138, tick: 5, types_hash: '', _vid: 645}),
  (:Symbol {body_hash: '1d1d49f51d1eddcb', deleted: false, end: 180, key: 'src/flask/views.py::MethodView.__init_subclass__', kind: 'method', name: '__init_subclass__', path: 'src/flask/views.py', qualname: 'MethodView.__init_subclass__', sig_hash: 'c557ff9e4ccb3873', signature: '__init_subclass__(cls, **kwargs: t.Any) -> None', source: '    def __init_subclass__(cls, **kwargs: t.Any) -> None:\n        super().__init_subclass__(**kwargs)\n\n        if "methods" not in cls.__dict__:\n            methods = set()\n\n            for base in cls.__bases__:\n                if getattr(base, "methods", None):\n                    methods.update(base.methods)  # type: ignore[attr-defined]\n\n            for key in http_method_funcs:\n                if hasattr(cls, key):\n                    methods.add(key.upper())\n\n            if methods:\n                cls.methods = methods', start: 165, tick: 5, types_hash: 'a601c7061895ff99', _vid: 646}),
  (:Symbol {body_hash: '49fda465b1117c3b', deleted: false, end: 191, key: 'src/flask/views.py::MethodView.dispatch_request', kind: 'method', name: 'dispatch_request', path: 'src/flask/views.py', qualname: 'MethodView.dispatch_request', sig_hash: '6f98df794c611ebd', signature: 'dispatch_request(self, **kwargs: t.Any) -> ft.ResponseReturnValue', source: '    def dispatch_request(self, **kwargs: t.Any) -> ft.ResponseReturnValue:\n        meth = getattr(self, request.method.lower(), None)\n\n        # If the request method is HEAD and we don\'t have a handler for it\n        # retry with GET.\n        if meth is None and request.method == "HEAD":\n            meth = getattr(self, "get", None)\n\n        assert meth is not None, f"Unimplemented method {request.method!r}"\n        return current_app.ensure_sync(meth)(**kwargs)  # type: ignore[no-any-return]', start: 182, tick: 5, types_hash: 'c2685c671ff0094d', _vid: 647}),
  (:Symbol {body_hash: '1ee9d736be678f40', deleted: false, end: 219, key: 'src/flask/wrappers.py::Request', kind: 'class', name: 'Request', path: 'src/flask/wrappers.py', qualname: 'Request', sig_hash: '2759eefadd77b1a7', signature: 'class Request(RequestBase)', source: 'class Request(RequestBase):\n    """The request object used by default in Flask.  Remembers the\n    matched endpoint and view arguments.\n\n    It is what ends up as :class:`~flask.request`.  If you want to replace\n    the request object used you can subclass this and set\n    :attr:`~flask.Flask.request_class` to your subclass.\n\n    The request object is a :class:`~werkzeug.wrappers.Request` subclass and\n    provides all of the attributes Werkzeug defines plus a few Flask\n    specific ones.\n    """\n\n    json_module: t.Any = json\n\n    #: The internal URL rule that matched the request.  This can be\n    #: useful to inspect which methods are allowed for the URL from\n    #: a before/after handler (``request.url_rule.methods``) etc.\n    #: Though if the request\'s method was invalid for the URL rule,\n    #: the valid list is available in ``routing_exception.valid_methods``\n    #: instead (an attribute of the Werkzeug exception\n    #: :exc:`~werkzeug.exceptions.MethodNotAllowed`)\n    #: because the request was never internally bound.\n    #:\n    #: .. versionadded:: 0.6\n    url_rule: Rule | None = None\n\n    #: A dict of view arguments that matched the request.  If an exception\n    #: happened when matching, this will be ``None``.\n    view_args: dict[str, t.Any] | None = None\n\n    #: If matching the URL failed, this is the exception that will be\n    #: raised / was raised as part of the request handling.  This is\n    #: usually a :exc:`~werkzeug.exceptions.NotFound` exception or\n    #: s\n…', start: 18, tick: 5, types_hash: '', _vid: 648}),
  (:Symbol {body_hash: 'bd0f4bcf8d615497', deleted: false, end: 90, key: 'src/flask/wrappers.py::Request.max_content_length', kind: 'method', name: 'max_content_length', path: 'src/flask/wrappers.py', qualname: 'Request.max_content_length', sig_hash: '81e944650cc6d217', signature: 'max_content_length(self, value: int | None) -> None', source: '    @max_content_length.setter\n    def max_content_length(self, value: int | None) -> None:\n        self._max_content_length = value', start: 89, tick: 5, types_hash: 'a14fa08f7293a7c3', _vid: 649}),
  (:Symbol {body_hash: 'ebaaf2684a44e0c4', deleted: false, end: 159, key: 'src/flask/wrappers.py::Request.endpoint', kind: 'method', name: 'endpoint', path: 'src/flask/wrappers.py', qualname: 'Request.endpoint', sig_hash: '9626d105938f0039', signature: 'endpoint(self) -> str | None', source: '    @property\n    def endpoint(self) -> str | None:\n        """The endpoint that matched the request URL.\n\n        This will be ``None`` if matching failed or has not been\n        performed yet.\n\n        This in combination with :attr:`view_args` can be used to\n        reconstruct the same URL or a modified URL.\n        """\n        if self.url_rule is not None:\n            return self.url_rule.endpoint  # type: ignore[no-any-return]\n\n        return None', start: 147, tick: 5, types_hash: '463f4e9e18b33c80', _vid: 650}),
  (:Symbol {body_hash: '3cb134586474a669', deleted: false, end: 178, key: 'src/flask/wrappers.py::Request.blueprint', kind: 'method', name: 'blueprint', path: 'src/flask/wrappers.py', qualname: 'Request.blueprint', sig_hash: '9626d105938f0039', signature: 'blueprint(self) -> str | None', source: '    @property\n    def blueprint(self) -> str | None:\n        """The registered name of the current blueprint.\n\n        This will be ``None`` if the endpoint is not part of a\n        blueprint, or if URL matching failed or has not been performed\n        yet.\n\n        This does not necessarily match the name the blueprint was\n        created with. It may have been nested, or registered with a\n        different name.\n        """\n        endpoint = self.endpoint\n\n        if endpoint is not None and "." in endpoint:\n            return endpoint.rpartition(".")[0]\n\n        return None', start: 162, tick: 5, types_hash: '463f4e9e18b33c80', _vid: 651}),
  (:Symbol {body_hash: '8dcde28c2aa59f8f', deleted: false, end: 195, key: 'src/flask/wrappers.py::Request.blueprints', kind: 'method', name: 'blueprints', path: 'src/flask/wrappers.py', qualname: 'Request.blueprints', sig_hash: '9626d105938f0039', signature: 'blueprints(self) -> list[str]', source: '    @property\n    def blueprints(self) -> list[str]:\n        """The registered names of the current blueprint upwards through\n        parent blueprints.\n\n        This will be an empty list if there is no current blueprint, or\n        if URL matching failed.\n\n        .. versionadded:: 2.0.1\n        """\n        name = self.blueprint\n\n        if name is None:\n            return []\n\n        return _split_blueprint_path(name)', start: 181, tick: 5, types_hash: '658106d433ba12e4', _vid: 652}),
  (:Symbol {body_hash: '04b8a2b074c39451', deleted: false, end: 210, key: 'src/flask/wrappers.py::Request._load_form_data', kind: 'method', name: '_load_form_data', path: 'src/flask/wrappers.py', qualname: 'Request._load_form_data', sig_hash: '9626d105938f0039', signature: '_load_form_data(self) -> None', source: '    def _load_form_data(self) -> None:\n        super()._load_form_data()\n\n        # In debug mode we\'re replacing the files multidict with an ad-hoc\n        # subclass that raises a different error for key errors.\n        if (\n            current_app\n            and current_app.debug\n            and self.mimetype != "multipart/form-data"\n            and not self.files\n        ):\n            from .debughelpers import attach_enctype_error_multidict\n\n            attach_enctype_error_multidict(self)', start: 197, tick: 5, types_hash: '80ab440e4379605f', _vid: 653}),
  (:Symbol {body_hash: '747618248a93108c', deleted: false, end: 219, key: 'src/flask/wrappers.py::Request.on_json_loading_failed', kind: 'method', name: 'on_json_loading_failed', path: 'src/flask/wrappers.py', qualname: 'Request.on_json_loading_failed', sig_hash: 'eca50bbe187484e8', signature: 'on_json_loading_failed(self, e: ValueError | None) -> t.Any', source: '    def on_json_loading_failed(self, e: ValueError | None) -> t.Any:\n        try:\n            return super().on_json_loading_failed(e)\n        except BadRequest as ebr:\n            if current_app and current_app.debug:\n                raise\n\n            raise BadRequest() from ebr', start: 212, tick: 5, types_hash: '0bad453f2b19a17c', _vid: 654}),
  (:Symbol {body_hash: '81d29219a7835c71', deleted: false, end: 257, key: 'src/flask/wrappers.py::Response', kind: 'class', name: 'Response', path: 'src/flask/wrappers.py', qualname: 'Response', sig_hash: '7216112a38f0d67f', signature: 'class Response(ResponseBase)', source: 'class Response(ResponseBase):\n    """The response object that is used by default in Flask.  Works like the\n    response object from Werkzeug but is set to have an HTML mimetype by\n    default.  Quite often you don\'t have to create this object yourself because\n    :meth:`~flask.Flask.make_response` will take care of that for you.\n\n    If you want to replace the response object used you can subclass this and\n    set :attr:`~flask.Flask.response_class` to your subclass.\n\n    .. versionchanged:: 1.0\n        JSON support is added to the response, like the request. This is useful\n        when testing to get the test client response data as JSON.\n\n    .. versionchanged:: 1.0\n\n        Added :attr:`max_cookie_size`.\n    """\n\n    default_mimetype: str | None = "text/html"\n\n    json_module = json\n\n    autocorrect_location_header = False\n\n    @property\n    def max_cookie_size(self) -> int:  # type: ignore\n        """Read-only view of the :data:`MAX_COOKIE_SIZE` config key.\n\n        See :attr:`~werkzeug.wrappers.Response.max_cookie_size` in\n        Werkzeug\'s docs.\n        """\n        if current_app:\n            return current_app.config["MAX_COOKIE_SIZE"]  # type: ignore[no-any-return]\n\n        # return Werkzeug\'s default when not in an app context\n        return super().max_cookie_size', start: 222, tick: 5, types_hash: '', _vid: 655}),
  (:Symbol {body_hash: '258754dfd0dbd7dd', deleted: false, end: 257, key: 'src/flask/wrappers.py::Response.max_cookie_size', kind: 'method', name: 'max_cookie_size', path: 'src/flask/wrappers.py', qualname: 'Response.max_cookie_size', sig_hash: '9626d105938f0039', signature: 'max_cookie_size(self) -> int', source: '    @property\n    def max_cookie_size(self) -> int:  # type: ignore\n        """Read-only view of the :data:`MAX_COOKIE_SIZE` config key.\n\n        See :attr:`~werkzeug.wrappers.Response.max_cookie_size` in\n        Werkzeug\'s docs.\n        """\n        if current_app:\n            return current_app.config["MAX_COOKIE_SIZE"]  # type: ignore[no-any-return]\n\n        # return Werkzeug\'s default when not in an app context\n        return super().max_cookie_size', start: 247, tick: 5, types_hash: 'a605f0df266244dc', _vid: 656}),
  (:Symbol {body_hash: '348418dea51213b0', deleted: false, end: 34, key: 'tests/conftest.py::_standard_os_environ', kind: 'function', name: '_standard_os_environ', path: 'tests/conftest.py', qualname: '_standard_os_environ', sig_hash: '4943fbd3d489f4fa', signature: '_standard_os_environ()', source: '@pytest.fixture(scope="session", autouse=True)\ndef _standard_os_environ():\n    """Set up ``os.environ`` at the start of the test session to have\n    standard values. Returns a list of operations that is used by\n    :func:`._reset_os_environ` after each test.\n    """\n    mp = monkeypatch.MonkeyPatch()\n    out = (\n        (os.environ, "FLASK_ENV_FILE", monkeypatch.notset),\n        (os.environ, "FLASK_APP", monkeypatch.notset),\n        (os.environ, "FLASK_DEBUG", monkeypatch.notset),\n        (os.environ, "FLASK_RUN_FROM_CLI", monkeypatch.notset),\n        (os.environ, "WERKZEUG_RUN_MAIN", monkeypatch.notset),\n    )\n\n    for _, key, value in out:\n        if value is monkeypatch.notset:\n            mp.delenv(key, False)\n        else:\n            mp.setenv(key, value)\n\n    yield out\n    mp.undo()', start: 13, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 657}),
  (:Symbol {body_hash: 'ed0e283e0509ec94', deleted: false, end: 42, key: 'tests/conftest.py::_reset_os_environ', kind: 'function', name: '_reset_os_environ', path: 'tests/conftest.py', qualname: '_reset_os_environ', sig_hash: '80333c7c7eb5c71a', signature: '_reset_os_environ(monkeypatch, _standard_os_environ)', source: '@pytest.fixture(autouse=True)\ndef _reset_os_environ(monkeypatch, _standard_os_environ):\n    """Reset ``os.environ`` to the standard environ after each test,\n    in case a test changed something without cleaning up.\n    """\n    monkeypatch._setitem.extend(_standard_os_environ)', start: 38, tick: 5, types_hash: 'b7e909febee91788', _vid: 658}),
  (:Symbol {body_hash: '994f2ce61dd71c85', deleted: false, end: 52, key: 'tests/conftest.py::app', kind: 'function', name: 'app', path: 'tests/conftest.py', qualname: 'app', sig_hash: '4943fbd3d489f4fa', signature: 'app()', source: '@pytest.fixture\ndef app():\n    app = Flask("flask_test", root_path=os.path.dirname(__file__))\n    app.config.update(\n        TESTING=True,\n        SECRET_KEY="test key",\n    )\n    return app', start: 46, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 659}),
  (:Symbol {body_hash: 'e479ecffc5cf743d', deleted: false, end: 58, key: 'tests/conftest.py::app_ctx', kind: 'function', name: 'app_ctx', path: 'tests/conftest.py', qualname: 'app_ctx', sig_hash: '462ce794eb370ded', signature: 'app_ctx(app)', source: '@pytest.fixture\ndef app_ctx(app):\n    with app.app_context() as ctx:\n        yield ctx', start: 56, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 660}),
  (:Symbol {body_hash: '1cafefc78f401a21', deleted: false, end: 64, key: 'tests/conftest.py::req_ctx', kind: 'function', name: 'req_ctx', path: 'tests/conftest.py', qualname: 'req_ctx', sig_hash: '462ce794eb370ded', signature: 'req_ctx(app)', source: '@pytest.fixture\ndef req_ctx(app):\n    with app.test_request_context() as ctx:\n        yield ctx', start: 62, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 661}),
  (:Symbol {body_hash: 'a8bfce15e1a84844', deleted: false, end: 69, key: 'tests/conftest.py::client', kind: 'function', name: 'client', path: 'tests/conftest.py', qualname: 'client', sig_hash: '462ce794eb370ded', signature: 'client(app)', source: '@pytest.fixture\ndef client(app):\n    return app.test_client()', start: 68, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 662}),
  (:Symbol {body_hash: 'ccd6f43902ea20a7', deleted: false, end: 82, key: 'tests/conftest.py::test_apps', kind: 'function', name: 'test_apps', path: 'tests/conftest.py', qualname: 'test_apps', sig_hash: '9425c7af8ac344a2', signature: 'test_apps(monkeypatch)', source: '@pytest.fixture\ndef test_apps(monkeypatch):\n    monkeypatch.syspath_prepend(os.path.join(os.path.dirname(__file__), "test_apps"))\n    original_modules = set(sys.modules.keys())\n\n    yield\n\n    # Remove any imports cached during the test. Otherwise "import app"\n    # will work in the next test even though it\'s no longer on the path.\n    for key in sys.modules.keys() - original_modules:\n        sys.modules.pop(key)', start: 73, tick: 5, types_hash: 'be76cb0cf36c6384', _vid: 663}),
  (:Symbol {body_hash: 'a3d2d036c3fbb0a1', deleted: false, end: 96, key: 'tests/conftest.py::leak_detector', kind: 'function', name: 'leak_detector', path: 'tests/conftest.py', qualname: 'leak_detector', sig_hash: '4943fbd3d489f4fa', signature: 'leak_detector()', source: '@pytest.fixture(autouse=True)\ndef leak_detector():\n    yield\n\n    # make sure we\'re not leaking a request context since we are\n    # testing flask internally in debug mode in a few cases\n    leaks = []\n    while request_ctx:\n        leaks.append(request_ctx._get_current_object())\n        request_ctx.pop()\n\n    assert leaks == []', start: 86, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 664}),
  (:Symbol {body_hash: '0a42b9678fc6b67f', deleted: false, end: 127, key: 'tests/conftest.py::limit_loader', kind: 'function', name: 'limit_loader', path: 'tests/conftest.py', qualname: 'limit_loader', sig_hash: 'e3f5ccd9b4060067', signature: 'limit_loader(request, monkeypatch)', source: '@pytest.fixture(params=(True, False))\ndef limit_loader(request, monkeypatch):\n    """Patch pkgutil.get_loader to give loader without get_filename or archive.\n\n    This provides for tests where a system has custom loaders, e.g. Google App\n    Engine\'s HardenedModulesHook, which have neither the `get_filename` method\n    nor the `archive` attribute.\n\n    This fixture will run the testcase twice, once with and once without the\n    limitation/mock.\n    """\n    if not request.param:\n        return\n\n    class LimitedLoader:\n        def __init__(self, loader):\n            self.loader = loader\n\n        def __getattr__(self, name):\n            if name in {"archive", "get_filename"}:\n                raise AttributeError(f"Mocking a loader which does not have {name!r}.")\n            return getattr(self.loader, name)\n\n    old_get_loader = pkgutil.get_loader\n\n    def get_loader(*args, **kwargs):\n        return LimitedLoader(old_get_loader(*args, **kwargs))\n\n    monkeypatch.setattr(pkgutil, "get_loader", get_loader)', start: 100, tick: 5, types_hash: '7b3ac712a3422e41', _vid: 665}),
  (:Symbol {body_hash: 'db11af090a62ad23', deleted: true, deleted_tick: 5, end: 136, key: 'tests/conftest.py::modules_tmpdir', kind: 'function', name: 'modules_tmpdir', path: 'tests/conftest.py', qualname: 'modules_tmpdir', sig_hash: '2a941a080b02e859', signature: 'modules_tmpdir(tmpdir, monkeypatch)', source: '@pytest.fixture\ndef modules_tmpdir(tmpdir, monkeypatch):\n    """A tmpdir added to sys.path."""\n    rv = tmpdir.mkdir("modules_tmpdir")\n    monkeypatch.syspath_prepend(str(rv))\n    return rv', start: 132, tick: 1, types_hash: '42044e82cd943ec4', _vid: 666}),
  (:Symbol {body_hash: 'c50a3168292cc104', deleted: true, deleted_tick: 5, end: 142, key: 'tests/conftest.py::modules_tmpdir_prefix', kind: 'function', name: 'modules_tmpdir_prefix', path: 'tests/conftest.py', qualname: 'modules_tmpdir_prefix', sig_hash: 'fa6c89a6af392b5e', signature: 'modules_tmpdir_prefix(modules_tmpdir, monkeypatch)', source: '@pytest.fixture\ndef modules_tmpdir_prefix(modules_tmpdir, monkeypatch):\n    monkeypatch.setattr(sys, "prefix", str(modules_tmpdir))\n    return modules_tmpdir', start: 140, tick: 1, types_hash: '839026a45608d08b', _vid: 667}),
  (:Symbol {body_hash: '7be6a47b284e6b1e', deleted: false, end: 152, key: 'tests/conftest.py::site_packages', kind: 'function', name: 'site_packages', path: 'tests/conftest.py', qualname: 'site_packages', sig_hash: 'f97af840c1f9916f', signature: 'site_packages(modules_tmp_path, monkeypatch)', source: '@pytest.fixture\ndef site_packages(modules_tmp_path, monkeypatch):\n    """Create a fake site-packages."""\n    py_dir = f"python{sys.version_info.major}.{sys.version_info.minor}"\n    rv = modules_tmp_path / "lib" / py_dir / "site-packages"\n    rv.mkdir(parents=True)\n    monkeypatch.syspath_prepend(os.fspath(rv))\n    return rv', start: 146, tick: 5, types_hash: '99ae6fa114e79828', _vid: 668}),
  (:Symbol {body_hash: 'cf8ce9a3fe75243d', deleted: true, deleted_tick: 5, end: 190, key: 'tests/conftest.py::install_egg', kind: 'function', name: 'install_egg', path: 'tests/conftest.py', qualname: 'install_egg', sig_hash: 'fa6c89a6af392b5e', signature: 'install_egg(modules_tmpdir, monkeypatch)', source: '@pytest.fixture\ndef install_egg(modules_tmpdir, monkeypatch):\n    """Generate egg from package name inside base and put the egg into\n    sys.path."""\n\n    def inner(name, base=modules_tmpdir):\n        base.join(name).ensure_dir()\n        base.join(name).join("__init__.py").ensure()\n\n        egg_setup = base.join("setup.py")\n        egg_setup.write(\n            textwrap.dedent(\n                f"""\n                from setuptools import setup\n                setup(\n                    name="{name}",\n                    version="1.0",\n                    packages=["site_egg"],\n                    zip_safe=True,\n                )\n                """\n            )\n        )\n\n        import subprocess\n\n        subprocess.check_call(\n            [sys.executable, "setup.py", "bdist_egg"], cwd=str(modules_tmpdir)\n        )\n        (egg_path,) = modules_tmpdir.join("dist/").listdir()\n        monkeypatch.syspath_prepend(str(egg_path))\n        return egg_path\n\n    return inner', start: 158, tick: 1, types_hash: '839026a45608d08b', _vid: 669}),
  (:Symbol {body_hash: '657136e92149cdaa', deleted: false, end: 160, key: 'tests/conftest.py::purge_module', kind: 'function', name: 'purge_module', path: 'tests/conftest.py', qualname: 'purge_module', sig_hash: '6ed90b2c280a5d9c', signature: 'purge_module(request)', source: '@pytest.fixture\ndef purge_module(request):\n    def inner(name):\n        request.addfinalizer(lambda: sys.modules.pop(name, None))\n\n    return inner', start: 156, tick: 5, types_hash: '09266c8cdf6d653c', _vid: 670}),
  (:Symbol {body_hash: 'e080c43f23a8b8be', deleted: false, end: 18, key: 'tests/test_appctx.py::test_basic_url_generation', kind: 'function', name: 'test_basic_url_generation', path: 'tests/test_appctx.py', qualname: 'test_basic_url_generation', sig_hash: '462ce794eb370ded', signature: 'test_basic_url_generation(app)', source: 'def test_basic_url_generation(app):\n    app.config["SERVER_NAME"] = "localhost"\n    app.config["PREFERRED_URL_SCHEME"] = "https"\n\n    @app.route("/")\n    def index():\n        pass\n\n    with app.app_context():\n        rv = flask.url_for("index")\n        assert rv == "https://localhost/"', start: 8, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 671}),
  (:Symbol {body_hash: 'eb1e9b9eb32efbd4', deleted: false, end: 24, key: 'tests/test_appctx.py::test_url_generation_requires_server_name', kind: 'function', name: 'test_url_generation_requires_server_name', path: 'tests/test_appctx.py', qualname: 'test_url_generation_requires_server_name', sig_hash: '462ce794eb370ded', signature: 'test_url_generation_requires_server_name(app)', source: 'def test_url_generation_requires_server_name(app):\n    with app.app_context():\n        with pytest.raises(RuntimeError):\n            flask.url_for("index")', start: 21, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 672}),
  (:Symbol {body_hash: '082606cc89104052', deleted: false, end: 29, key: 'tests/test_appctx.py::test_url_generation_without_context_fails', kind: 'function', name: 'test_url_generation_without_context_fails', path: 'tests/test_appctx.py', qualname: 'test_url_generation_without_context_fails', sig_hash: '4943fbd3d489f4fa', signature: 'test_url_generation_without_context_fails()', source: 'def test_url_generation_without_context_fails():\n    with pytest.raises(RuntimeError):\n        flask.url_for("index")', start: 27, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 673}),
  (:Symbol {body_hash: 'a14fa7824f48b0c1', deleted: false, end: 35, key: 'tests/test_appctx.py::test_request_context_means_app_context', kind: 'function', name: 'test_request_context_means_app_context', path: 'tests/test_appctx.py', qualname: 'test_request_context_means_app_context', sig_hash: '462ce794eb370ded', signature: 'test_request_context_means_app_context(app)', source: 'def test_request_context_means_app_context(app):\n    with app.test_request_context():\n        assert flask.current_app._get_current_object() is app\n    assert not flask.current_app', start: 32, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 674}),
  (:Symbol {body_hash: 'a00854d53c23bc41', deleted: false, end: 41, key: 'tests/test_appctx.py::test_app_context_provides_current_app', kind: 'function', name: 'test_app_context_provides_current_app', path: 'tests/test_appctx.py', qualname: 'test_app_context_provides_current_app', sig_hash: '462ce794eb370ded', signature: 'test_app_context_provides_current_app(app)', source: 'def test_app_context_provides_current_app(app):\n    with app.app_context():\n        assert flask.current_app._get_current_object() is app\n    assert not flask.current_app', start: 38, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 675}),
  (:Symbol {body_hash: '1b33fa6387081565', deleted: false, end: 54, key: 'tests/test_appctx.py::test_app_tearing_down', kind: 'function', name: 'test_app_tearing_down', path: 'tests/test_appctx.py', qualname: 'test_app_tearing_down', sig_hash: '462ce794eb370ded', signature: 'test_app_tearing_down(app)', source: 'def test_app_tearing_down(app):\n    cleanup_stuff = []\n\n    @app.teardown_appcontext\n    def cleanup(exception):\n        cleanup_stuff.append(exception)\n\n    with app.app_context():\n        pass\n\n    assert cleanup_stuff == [None]', start: 44, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 676}),
  (:Symbol {body_hash: '00fdc6c65729316d', deleted: false, end: 72, key: 'tests/test_appctx.py::test_app_tearing_down_with_previous_exception', kind: 'function', name: 'test_app_tearing_down_with_previous_exception', path: 'tests/test_appctx.py', qualname: 'test_app_tearing_down_with_previous_exception', sig_hash: '462ce794eb370ded', signature: 'test_app_tearing_down_with_previous_exception(app)', source: 'def test_app_tearing_down_with_previous_exception(app):\n    cleanup_stuff = []\n\n    @app.teardown_appcontext\n    def cleanup(exception):\n        cleanup_stuff.append(exception)\n\n    try:\n        raise Exception("dummy")\n    except Exception:\n        pass\n\n    with app.app_context():\n        pass\n\n    assert cleanup_stuff == [None]', start: 57, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 677}),
  (:Symbol {body_hash: '565c19c783349a9b', deleted: false, end: 88, key: 'tests/test_appctx.py::test_app_tearing_down_with_handled_exception_by_except_block', kind: 'function', name: 'test_app_tearing_down_with_handled_exception_by_except_block', path: 'tests/test_appctx.py', qualname: 'test_app_tearing_down_with_handled_exception_by_except_block', sig_hash: '462ce794eb370ded', signature: 'test_app_tearing_down_with_handled_exception_by_except_block(app)', source: 'def test_app_tearing_down_with_handled_exception_by_except_block(app):\n    cleanup_stuff = []\n\n    @app.teardown_appcontext\n    def cleanup(exception):\n        cleanup_stuff.append(exception)\n\n    with app.app_context():\n        try:\n            raise Exception("dummy")\n        except Exception:\n            pass\n\n    assert cleanup_stuff == [None]', start: 75, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 678}),
  (:Symbol {body_hash: '147d77eea0cd49f7', deleted: false, end: 110, key: 'tests/test_appctx.py::test_app_tearing_down_with_handled_exception_by_app_handler', kind: 'function', name: 'test_app_tearing_down_with_handled_exception_by_app_handler', path: 'tests/test_appctx.py', qualname: 'test_app_tearing_down_with_handled_exception_by_app_handler', sig_hash: 'df6ec3162cad163f', signature: 'test_app_tearing_down_with_handled_exception_by_app_handler(app, client)', source: 'def test_app_tearing_down_with_handled_exception_by_app_handler(app, client):\n    app.config["PROPAGATE_EXCEPTIONS"] = True\n    cleanup_stuff = []\n\n    @app.teardown_appcontext\n    def cleanup(exception):\n        cleanup_stuff.append(exception)\n\n    @app.route("/")\n    def index():\n        raise Exception("dummy")\n\n    @app.errorhandler(Exception)\n    def handler(f):\n        return flask.jsonify(str(f))\n\n    with app.app_context():\n        client.get("/")\n\n    assert cleanup_stuff == [None]', start: 91, tick: 5, types_hash: '95304b3d97188d9c', _vid: 679}),
  (:Symbol {body_hash: '3946ab8932a9507e', deleted: false, end: 131, key: 'tests/test_appctx.py::test_app_tearing_down_with_unhandled_exception', kind: 'function', name: 'test_app_tearing_down_with_unhandled_exception', path: 'tests/test_appctx.py', qualname: 'test_app_tearing_down_with_unhandled_exception', sig_hash: 'df6ec3162cad163f', signature: 'test_app_tearing_down_with_unhandled_exception(app, client)', source: 'def test_app_tearing_down_with_unhandled_exception(app, client):\n    app.config["PROPAGATE_EXCEPTIONS"] = True\n    cleanup_stuff = []\n\n    @app.teardown_appcontext\n    def cleanup(exception):\n        cleanup_stuff.append(exception)\n\n    @app.route("/")\n    def index():\n        raise ValueError("dummy")\n\n    with pytest.raises(ValueError, match="dummy"):\n        with app.app_context():\n            client.get("/")\n\n    assert len(cleanup_stuff) == 1\n    assert isinstance(cleanup_stuff[0], ValueError)\n    assert str(cleanup_stuff[0]) == "dummy"', start: 113, tick: 5, types_hash: '95304b3d97188d9c', _vid: 680}),
  (:Symbol {body_hash: '124056f14ff73361', deleted: false, end: 154, key: 'tests/test_appctx.py::test_app_ctx_globals_methods', kind: 'function', name: 'test_app_ctx_globals_methods', path: 'tests/test_appctx.py', qualname: 'test_app_ctx_globals_methods', sig_hash: '3acf5b76887f15f2', signature: 'test_app_ctx_globals_methods(app, app_ctx)', source: 'def test_app_ctx_globals_methods(app, app_ctx):\n    # get\n    assert flask.g.get("foo") is None\n    assert flask.g.get("foo", "bar") == "bar"\n    # __contains__\n    assert "foo" not in flask.g\n    flask.g.foo = "bar"\n    assert "foo" in flask.g\n    # setdefault\n    flask.g.setdefault("bar", "the cake is a lie")\n    flask.g.setdefault("bar", "hello world")\n    assert flask.g.bar == "the cake is a lie"\n    # pop\n    assert flask.g.pop("bar") == "the cake is a lie"\n    with pytest.raises(KeyError):\n        flask.g.pop("bar")\n    assert flask.g.pop("bar", "more cake") == "more cake"\n    # __iter__\n    assert list(flask.g) == ["foo"]\n    # __repr__\n    assert repr(flask.g) == "<flask.g of \'flask_test\'>"', start: 134, tick: 5, types_hash: '45f7071ec66cb28f', _vid: 681}),
  (:Symbol {body_hash: '0bd67793313a9aeb', deleted: false, end: 164, key: 'tests/test_appctx.py::test_custom_app_ctx_globals_class', kind: 'function', name: 'test_custom_app_ctx_globals_class', path: 'tests/test_appctx.py', qualname: 'test_custom_app_ctx_globals_class', sig_hash: '462ce794eb370ded', signature: 'test_custom_app_ctx_globals_class(app)', source: 'def test_custom_app_ctx_globals_class(app):\n    class CustomRequestGlobals:\n        def __init__(self):\n            self.spam = "eggs"\n\n    app.app_ctx_globals_class = CustomRequestGlobals\n    with app.app_context():\n        assert flask.render_template_string("{{ g.spam }}") == "eggs"', start: 157, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 682}),
  (:Symbol {body_hash: '7a4265de2d6b0c04', deleted: false, end: 190, key: 'tests/test_appctx.py::test_context_refcounts', kind: 'function', name: 'test_context_refcounts', path: 'tests/test_appctx.py', qualname: 'test_context_refcounts', sig_hash: 'df6ec3162cad163f', signature: 'test_context_refcounts(app, client)', source: 'def test_context_refcounts(app, client):\n    called = []\n\n    @app.teardown_request\n    def teardown_req(error=None):\n        called.append("request")\n\n    @app.teardown_appcontext\n    def teardown_app(error=None):\n        called.append("app")\n\n    @app.route("/")\n    def index():\n        with app_ctx:\n            with request_ctx:\n                pass\n\n        assert flask.request.environ["werkzeug.request"] is not None\n        return ""\n\n    res = client.get("/")\n    assert res.status_code == 200\n    assert res.data == b""\n    assert called == ["request", "app"]', start: 167, tick: 5, types_hash: '95304b3d97188d9c', _vid: 683}),
  (:Symbol {body_hash: 'dfd7506d9ff04415', deleted: false, end: 209, key: 'tests/test_appctx.py::test_clean_pop', kind: 'function', name: 'test_clean_pop', path: 'tests/test_appctx.py', qualname: 'test_clean_pop', sig_hash: '462ce794eb370ded', signature: 'test_clean_pop(app)', source: 'def test_clean_pop(app):\n    app.testing = False\n    called = []\n\n    @app.teardown_request\n    def teardown_req(error=None):\n        raise ZeroDivisionError\n\n    @app.teardown_appcontext\n    def teardown_app(error=None):\n        called.append("TEARDOWN")\n\n    with app.app_context():\n        called.append(flask.current_app.name)\n\n    assert called == ["flask_test", "TEARDOWN"]\n    assert not flask.current_app', start: 193, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 684}),
  (:Symbol {body_hash: 'f2b93f695b7c71a1', deleted: false, end: 15, key: 'tests/test_apps/blueprintapp/apps/admin/__init__.py::index', kind: 'function', name: 'index', path: 'tests/test_apps/blueprintapp/apps/admin/__init__.py', qualname: 'index', sig_hash: '4943fbd3d489f4fa', signature: 'index()', source: '@admin.route("/")\ndef index():\n    return render_template("admin/index.html")', start: 14, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 685}),
  (:Symbol {body_hash: '38bb3fd8e23fdcbc', deleted: false, end: 20, key: 'tests/test_apps/blueprintapp/apps/admin/__init__.py::index2', kind: 'function', name: 'index2', path: 'tests/test_apps/blueprintapp/apps/admin/__init__.py', qualname: 'index2', sig_hash: '4943fbd3d489f4fa', signature: 'index2()', source: '@admin.route("/index2")\ndef index2():\n    return render_template("./admin/index.html")', start: 19, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 686}),
  (:Symbol {body_hash: 'cd04420746443073', deleted: false, end: 9, key: 'tests/test_apps/blueprintapp/apps/frontend/__init__.py::index', kind: 'function', name: 'index', path: 'tests/test_apps/blueprintapp/apps/frontend/__init__.py', qualname: 'index', sig_hash: '4943fbd3d489f4fa', signature: 'index()', source: '@frontend.route("/")\ndef index():\n    return render_template("frontend/index.html")', start: 8, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 687}),
  (:Symbol {body_hash: 'ff86a9eb6d9a0557', deleted: false, end: 14, key: 'tests/test_apps/blueprintapp/apps/frontend/__init__.py::missing_template', kind: 'function', name: 'missing_template', path: 'tests/test_apps/blueprintapp/apps/frontend/__init__.py', qualname: 'missing_template', sig_hash: '4943fbd3d489f4fa', signature: 'missing_template()', source: '@frontend.route("/missing")\ndef missing_template():\n    return render_template("missing_template.html")', start: 13, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 688}),
  (:Symbol {body_hash: '2908d2841cc2559f', deleted: false, end: 5, key: 'tests/test_apps/cliapp/factory.py::create_app', kind: 'function', name: 'create_app', path: 'tests/test_apps/cliapp/factory.py', qualname: 'create_app', sig_hash: '4943fbd3d489f4fa', signature: 'create_app()', source: 'def create_app():\n    return Flask("app")', start: 4, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 689}),
  (:Symbol {body_hash: 'ec2f25c295fe047f', deleted: false, end: 9, key: 'tests/test_apps/cliapp/factory.py::create_app2', kind: 'function', name: 'create_app2', path: 'tests/test_apps/cliapp/factory.py', qualname: 'create_app2', sig_hash: '7382c71187a9320a', signature: 'create_app2(foo, bar)', source: 'def create_app2(foo, bar):\n    return Flask("_".join(["app2", foo, bar]))', start: 8, tick: 1, types_hash: '3e23df9e57312565', _vid: 690}),
  (:Symbol {body_hash: 'e186d998043b8fbe', deleted: false, end: 13, key: 'tests/test_apps/cliapp/factory.py::no_app', kind: 'function', name: 'no_app', path: 'tests/test_apps/cliapp/factory.py', qualname: 'no_app', sig_hash: '4943fbd3d489f4fa', signature: 'no_app()', source: 'def no_app():\n    pass', start: 12, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 691}),
  (:Symbol {body_hash: '85f0e5ac0ff8ae04', deleted: false, end: 8, key: 'tests/test_apps/helloworld/hello.py::hello', kind: 'function', name: 'hello', path: 'tests/test_apps/helloworld/hello.py', qualname: 'hello', sig_hash: '4943fbd3d489f4fa', signature: 'hello()', source: '@app.route("/")\ndef hello():\n    return "Hello World!"', start: 7, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 692}),
  (:Symbol {body_hash: 'a0bbdd4b9e04e4d0', deleted: false, end: 15, key: 'tests/test_async.py::AppError', kind: 'class', name: 'AppError', path: 'tests/test_async.py', qualname: 'AppError', sig_hash: 'c4a05d927bdc2f1e', signature: 'class AppError(Exception)', source: 'class AppError(Exception):\n    pass', start: 14, tick: 1, types_hash: '', _vid: 693}),
  (:Symbol {body_hash: 'a0bbdd4b9e04e4d0', deleted: false, end: 19, key: 'tests/test_async.py::BlueprintError', kind: 'class', name: 'BlueprintError', path: 'tests/test_async.py', qualname: 'BlueprintError', sig_hash: 'c4a05d927bdc2f1e', signature: 'class BlueprintError(Exception)', source: 'class BlueprintError(Exception):\n    pass', start: 18, tick: 1, types_hash: '', _vid: 694}),
  (:Symbol {body_hash: '37002113851d2bdf', deleted: false, end: 27, key: 'tests/test_async.py::AsyncView', kind: 'class', name: 'AsyncView', path: 'tests/test_async.py', qualname: 'AsyncView', sig_hash: '8f40e5b7eeb17735', signature: 'class AsyncView(View)', source: 'class AsyncView(View):\n    methods = ["GET", "POST"]\n\n    async def dispatch_request(self):\n        await asyncio.sleep(0)\n        return request.method', start: 22, tick: 1, types_hash: '', _vid: 695}),
  (:Symbol {body_hash: 'c6896b6f5436456b', deleted: false, end: 27, key: 'tests/test_async.py::AsyncView.dispatch_request', kind: 'method', name: 'dispatch_request', path: 'tests/test_async.py', qualname: 'AsyncView.dispatch_request', sig_hash: '9626d105938f0039', signature: 'dispatch_request(self)', source: '    async def dispatch_request(self):\n        await asyncio.sleep(0)\n        return request.method', start: 25, tick: 1, types_hash: '10a585bd39808d65', _vid: 696}),
  (:Symbol {body_hash: '7b3988f301cdb73f', deleted: false, end: 37, key: 'tests/test_async.py::AsyncMethodView', kind: 'class', name: 'AsyncMethodView', path: 'tests/test_async.py', qualname: 'AsyncMethodView', sig_hash: '6c393030afdd25df', signature: 'class AsyncMethodView(MethodView)', source: 'class AsyncMethodView(MethodView):\n    async def get(self):\n        await asyncio.sleep(0)\n        return "GET"\n\n    async def post(self):\n        await asyncio.sleep(0)\n        return "POST"', start: 30, tick: 1, types_hash: '', _vid: 697}),
  (:Symbol {body_hash: 'e04b75c5c1376741', deleted: false, end: 33, key: 'tests/test_async.py::AsyncMethodView.get', kind: 'method', name: 'get', path: 'tests/test_async.py', qualname: 'AsyncMethodView.get', sig_hash: '9626d105938f0039', signature: 'get(self)', source: '    async def get(self):\n        await asyncio.sleep(0)\n        return "GET"', start: 31, tick: 1, types_hash: '10a585bd39808d65', _vid: 698}),
  (:Symbol {body_hash: '6394f331c6b66a4c', deleted: false, end: 37, key: 'tests/test_async.py::AsyncMethodView.post', kind: 'method', name: 'post', path: 'tests/test_async.py', qualname: 'AsyncMethodView.post', sig_hash: '9626d105938f0039', signature: 'post(self)', source: '    async def post(self):\n        await asyncio.sleep(0)\n        return "POST"', start: 35, tick: 1, types_hash: '10a585bd39808d65', _vid: 699}),
  (:Symbol {body_hash: 'bc993f438cb3e0ba', deleted: false, end: 78, key: 'tests/test_async.py::_async_app', kind: 'function', name: '_async_app', path: 'tests/test_async.py', qualname: '_async_app', sig_hash: '4943fbd3d489f4fa', signature: '_async_app()', source: '@pytest.fixture(name="async_app")\ndef _async_app():\n    app = Flask(__name__)\n\n    @app.route("/", methods=["GET", "POST"])\n    @app.route("/home", methods=["GET", "POST"])\n    async def index():\n        await asyncio.sleep(0)\n        return request.method\n\n    @app.errorhandler(AppError)\n    async def handle(_):\n        return "", 412\n\n    @app.route("/error")\n    async def error():\n        raise AppError()\n\n    blueprint = Blueprint("bp", __name__)\n\n    @blueprint.route("/", methods=["GET", "POST"])\n    async def bp_index():\n        await asyncio.sleep(0)\n        return request.method\n\n    @blueprint.errorhandler(BlueprintError)\n    async def bp_handle(_):\n        return "", 412\n\n    @blueprint.route("/error")\n    async def bp_error():\n        raise BlueprintError()\n\n    app.register_blueprint(blueprint, url_prefix="/bp")\n\n    app.add_url_rule("/view", view_func=AsyncView.as_view("view"))\n    app.add_url_rule("/methodview", view_func=AsyncMethodView.as_view("methodview"))\n\n    return app', start: 41, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 700}),
  (:Symbol {body_hash: '70090f1cba2ec92f', deleted: false, end: 87, key: 'tests/test_async.py::test_async_route', kind: 'function', name: 'test_async_route', path: 'tests/test_async.py', qualname: 'test_async_route', sig_hash: '8b8b322cb839c533', signature: 'test_async_route(path, async_app)', source: '@pytest.mark.parametrize("path", ["/", "/home", "/bp/", "/view", "/methodview"])\ndef test_async_route(path, async_app):\n    test_client = async_app.test_client()\n    response = test_client.get(path)\n    assert b"GET" in response.get_data()\n    response = test_client.post(path)\n    assert b"POST" in response.get_data()', start: 82, tick: 1, types_hash: 'cfb59624774cc921', _vid: 701}),
  (:Symbol {body_hash: '553150d84d98dc64', deleted: false, end: 94, key: 'tests/test_async.py::test_async_error_handler', kind: 'function', name: 'test_async_error_handler', path: 'tests/test_async.py', qualname: 'test_async_error_handler', sig_hash: '8b8b322cb839c533', signature: 'test_async_error_handler(path, async_app)', source: '@pytest.mark.parametrize("path", ["/error", "/bp/error"])\ndef test_async_error_handler(path, async_app):\n    test_client = async_app.test_client()\n    response = test_client.get(path)\n    assert response.status_code == 412', start: 91, tick: 1, types_hash: 'cfb59624774cc921', _vid: 702}),
  (:Symbol {body_hash: '8406f6a8fb57ffe8', deleted: false, end: 145, key: 'tests/test_async.py::test_async_before_after_request', kind: 'function', name: 'test_async_before_after_request', path: 'tests/test_async.py', qualname: 'test_async_before_after_request', sig_hash: '4943fbd3d489f4fa', signature: 'test_async_before_after_request()', source: 'def test_async_before_after_request():\n    app_before_called = False\n    app_after_called = False\n    bp_before_called = False\n    bp_after_called = False\n\n    app = Flask(__name__)\n\n    @app.route("/")\n    def index():\n        return ""\n\n    @app.before_request\n    async def before():\n        nonlocal app_before_called\n        app_before_called = True\n\n    @app.after_request\n    async def after(response):\n        nonlocal app_after_called\n        app_after_called = True\n        return response\n\n    blueprint = Blueprint("bp", __name__)\n\n    @blueprint.route("/")\n    def bp_index():\n        return ""\n\n    @blueprint.before_request\n    async def bp_before():\n        nonlocal bp_before_called\n        bp_before_called = True\n\n    @blueprint.after_request\n    async def bp_after(response):\n        nonlocal bp_after_called\n        bp_after_called = True\n        return response\n\n    app.register_blueprint(blueprint, url_prefix="/bp")\n\n    test_client = app.test_client()\n    test_client.get("/")\n    assert app_before_called\n    assert app_after_called\n    test_client.get("/bp/")\n    assert bp_before_called\n    assert bp_after_called', start: 97, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 703}),
  (:Symbol {body_hash: 'df4c991a658cbbbf', deleted: false, end: 37, key: 'tests/test_basic.py::test_options_work', kind: 'function', name: 'test_options_work', path: 'tests/test_basic.py', qualname: 'test_options_work', sig_hash: 'df6ec3162cad163f', signature: 'test_options_work(app, client)', source: 'def test_options_work(app, client):\n    @app.route("/", methods=["GET", "POST"])\n    def index():\n        return "Hello World"\n\n    rv = client.open("/", method="OPTIONS")\n    assert sorted(rv.allow) == ["GET", "HEAD", "OPTIONS", "POST"]\n    assert rv.data == b""', start: 30, tick: 5, types_hash: '95304b3d97188d9c', _vid: 704}),
  (:Symbol {body_hash: '46e98d92f3dce908', deleted: false, end: 50, key: 'tests/test_basic.py::test_options_on_multiple_rules', kind: 'function', name: 'test_options_on_multiple_rules', path: 'tests/test_basic.py', qualname: 'test_options_on_multiple_rules', sig_hash: 'df6ec3162cad163f', signature: 'test_options_on_multiple_rules(app, client)', source: 'def test_options_on_multiple_rules(app, client):\n    @app.route("/", methods=["GET", "POST"])\n    def index():\n        return "Hello World"\n\n    @app.route("/", methods=["PUT"])\n    def index_put():\n        return "Aha!"\n\n    rv = client.open("/", method="OPTIONS")\n    assert sorted(rv.allow) == ["GET", "HEAD", "OPTIONS", "POST", "PUT"]', start: 40, tick: 5, types_hash: '95304b3d97188d9c', _vid: 705}),
  (:Symbol {body_hash: '05dc696c22aed7fa', deleted: false, end: 62, key: 'tests/test_basic.py::test_method_route', kind: 'function', name: 'test_method_route', path: 'tests/test_basic.py', qualname: 'test_method_route', sig_hash: '05d5d3e6b251b5b4', signature: 'test_method_route(app, client, method)', source: '@pytest.mark.parametrize("method", ["get", "post", "put", "delete", "patch"])\ndef test_method_route(app, client, method):\n    method_route = getattr(app, method)\n    client_method = getattr(client, method)\n\n    @method_route("/")\n    def hello():\n        return "Hello"\n\n    assert client_method("/").data == b"Hello"', start: 54, tick: 5, types_hash: '8975ea8730e79b28', _vid: 706}),
  (:Symbol {body_hash: 'b55a336b9b063345', deleted: false, end: 67, key: 'tests/test_basic.py::test_method_route_no_methods', kind: 'function', name: 'test_method_route_no_methods', path: 'tests/test_basic.py', qualname: 'test_method_route_no_methods', sig_hash: '462ce794eb370ded', signature: 'test_method_route_no_methods(app)', source: 'def test_method_route_no_methods(app):\n    with pytest.raises(TypeError):\n        app.get("/", methods=["GET", "POST"])', start: 65, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 707}),
  (:Symbol {body_hash: '6936f6bbc4ee877f', deleted: false, end: 89, key: 'tests/test_basic.py::test_provide_automatic_options_attr', kind: 'function', name: 'test_provide_automatic_options_attr', path: 'tests/test_basic.py', qualname: 'test_provide_automatic_options_attr', sig_hash: '4943fbd3d489f4fa', signature: 'test_provide_automatic_options_attr()', source: 'def test_provide_automatic_options_attr():\n    app = flask.Flask(__name__)\n\n    def index():\n        return "Hello World!"\n\n    index.provide_automatic_options = False\n    app.route("/")(index)\n    rv = app.test_client().open("/", method="OPTIONS")\n    assert rv.status_code == 405\n\n    app = flask.Flask(__name__)\n\n    def index2():\n        return "Hello World!"\n\n    index2.provide_automatic_options = True\n    app.route("/", methods=["OPTIONS"])(index2)\n    rv = app.test_client().open("/", method="OPTIONS")\n    assert sorted(rv.allow) == ["OPTIONS"]', start: 70, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 708}),
  (:Symbol {body_hash: '39ad0cd6348b5bee', deleted: false, end: 126, key: 'tests/test_basic.py::test_provide_automatic_options_kwarg', kind: 'function', name: 'test_provide_automatic_options_kwarg', path: 'tests/test_basic.py', qualname: 'test_provide_automatic_options_kwarg', sig_hash: 'df6ec3162cad163f', signature: 'test_provide_automatic_options_kwarg(app, client)', source: 'def test_provide_automatic_options_kwarg(app, client):\n    def index():\n        return flask.request.method\n\n    def more():\n        return flask.request.method\n\n    app.add_url_rule("/", view_func=index, provide_automatic_options=False)\n    app.add_url_rule(\n        "/more",\n        view_func=more,\n        methods=["GET", "POST"],\n        provide_automatic_options=False,\n    )\n    assert client.get("/").data == b"GET"\n\n    rv = client.post("/")\n    assert rv.status_code == 405\n    assert sorted(rv.allow) == ["GET", "HEAD"]\n\n    rv = client.open("/", method="OPTIONS")\n    assert rv.status_code == 405\n\n    rv = client.head("/")\n    assert rv.status_code == 200\n    assert not rv.data  # head truncates\n    assert client.post("/more").data == b"POST"\n    assert client.get("/more").data == b"GET"\n\n    rv = client.delete("/more")\n    assert rv.status_code == 405\n    assert sorted(rv.allow) == ["GET", "HEAD", "POST"]\n\n    rv = client.open("/more", method="OPTIONS")\n    assert rv.status_code == 405', start: 92, tick: 5, types_hash: '95304b3d97188d9c', _vid: 709}),
  (:Symbol {body_hash: 'd36f6a8a8afa718d', deleted: false, end: 149, key: 'tests/test_basic.py::test_request_dispatching', kind: 'function', name: 'test_request_dispatching', path: 'tests/test_basic.py', qualname: 'test_request_dispatching', sig_hash: 'df6ec3162cad163f', signature: 'test_request_dispatching(app, client)', source: 'def test_request_dispatching(app, client):\n    @app.route("/")\n    def index():\n        return flask.request.method\n\n    @app.route("/more", methods=["GET", "POST"])\n    def more():\n        return flask.request.method\n\n    assert client.get("/").data == b"GET"\n    rv = client.post("/")\n    assert rv.status_code == 405\n    assert sorted(rv.allow) == ["GET", "HEAD", "OPTIONS"]\n    rv = client.head("/")\n    assert rv.status_code == 200\n    assert not rv.data  # head truncates\n    assert client.post("/more").data == b"POST"\n    assert client.get("/more").data == b"GET"\n    rv = client.delete("/more")\n    assert rv.status_code == 405\n    assert sorted(rv.allow) == ["GET", "HEAD", "OPTIONS", "POST"]', start: 129, tick: 5, types_hash: '95304b3d97188d9c', _vid: 710}),
  (:Symbol {body_hash: '673665b6bcf7d8c3', deleted: false, end: 154, key: 'tests/test_basic.py::test_disallow_string_for_allowed_methods', kind: 'function', name: 'test_disallow_string_for_allowed_methods', path: 'tests/test_basic.py', qualname: 'test_disallow_string_for_allowed_methods', sig_hash: '462ce794eb370ded', signature: 'test_disallow_string_for_allowed_methods(app)', source: 'def test_disallow_string_for_allowed_methods(app):\n    with pytest.raises(TypeError):\n        app.add_url_rule("/", methods="GET POST", endpoint="test")', start: 152, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 711}),
  (:Symbol {body_hash: '0a41c603b1ab8f65', deleted: false, end: 190, key: 'tests/test_basic.py::test_url_mapping', kind: 'function', name: 'test_url_mapping', path: 'tests/test_basic.py', qualname: 'test_url_mapping', sig_hash: 'df6ec3162cad163f', signature: 'test_url_mapping(app, client)', source: 'def test_url_mapping(app, client):\n    random_uuid4 = "7eb41166-9ebf-4d26-b771-ea3f54f8b383"\n\n    def index():\n        return flask.request.method\n\n    def more():\n        return flask.request.method\n\n    def options():\n        return random_uuid4\n\n    app.add_url_rule("/", "index", index)\n    app.add_url_rule("/more", "more", more, methods=["GET", "POST"])\n\n    # Issue 1288: Test that automatic options are not added\n    #             when non-uppercase \'options\' in methods\n    app.add_url_rule("/options", "options", options, methods=["options"])\n\n    assert client.get("/").data == b"GET"\n    rv = client.post("/")\n    assert rv.status_code == 405\n    assert sorted(rv.allow) == ["GET", "HEAD", "OPTIONS"]\n    rv = client.head("/")\n    assert rv.status_code == 200\n    assert not rv.data  # head truncates\n    assert client.post("/more").data == b"POST"\n    assert client.get("/more").data == b"GET"\n    rv = client.delete("/more")\n    assert rv.status_code == 405\n    assert sorted(rv.allow) == ["GET", "HEAD", "OPTIONS", "POST"]\n    rv = client.open("/options", method="OPTIONS")\n    assert rv.status_code == 200\n    assert random_uuid4 in rv.data.decode("utf-8")', start: 157, tick: 5, types_hash: '95304b3d97188d9c', _vid: 712}),
  (:Symbol {body_hash: 'daec5d89fb39d8fa', deleted: false, end: 211, key: 'tests/test_basic.py::test_werkzeug_routing', kind: 'function', name: 'test_werkzeug_routing', path: 'tests/test_basic.py', qualname: 'test_werkzeug_routing', sig_hash: 'df6ec3162cad163f', signature: 'test_werkzeug_routing(app, client)', source: 'def test_werkzeug_routing(app, client):\n    from werkzeug.routing import Rule\n    from werkzeug.routing import Submount\n\n    app.url_map.add(\n        Submount("/foo", [Rule("/bar", endpoint="bar"), Rule("/", endpoint="index")])\n    )\n\n    def bar():\n        return "bar"\n\n    def index():\n        return "index"\n\n    app.view_functions["bar"] = bar\n    app.view_functions["index"] = index\n\n    assert client.get("/foo/").data == b"index"\n    assert client.get("/foo/bar").data == b"bar"', start: 193, tick: 5, types_hash: '95304b3d97188d9c', _vid: 713}),
  (:Symbol {body_hash: '150c6db76ecadc86', deleted: false, end: 231, key: 'tests/test_basic.py::test_endpoint_decorator', kind: 'function', name: 'test_endpoint_decorator', path: 'tests/test_basic.py', qualname: 'test_endpoint_decorator', sig_hash: 'df6ec3162cad163f', signature: 'test_endpoint_decorator(app, client)', source: 'def test_endpoint_decorator(app, client):\n    from werkzeug.routing import Rule\n    from werkzeug.routing import Submount\n\n    app.url_map.add(\n        Submount("/foo", [Rule("/bar", endpoint="bar"), Rule("/", endpoint="index")])\n    )\n\n    @app.endpoint("bar")\n    def bar():\n        return "bar"\n\n    @app.endpoint("index")\n    def index():\n        return "index"\n\n    assert client.get("/foo/").data == b"index"\n    assert client.get("/foo/bar").data == b"bar"', start: 214, tick: 5, types_hash: '95304b3d97188d9c', _vid: 714}),
  (:Symbol {body_hash: '1363b10ea4f64442', deleted: false, end: 254, key: 'tests/test_basic.py::test_session', kind: 'function', name: 'test_session', path: 'tests/test_basic.py', qualname: 'test_session', sig_hash: 'df6ec3162cad163f', signature: 'test_session(app, client)', source: 'def test_session(app, client):\n    @app.route("/set", methods=["POST"])\n    def set():\n        assert not flask.session.accessed\n        assert not flask.session.modified\n        flask.session["value"] = flask.request.form["value"]\n        assert flask.session.accessed\n        assert flask.session.modified\n        return "value set"\n\n    @app.route("/get")\n    def get():\n        assert not flask.session.accessed\n        assert not flask.session.modified\n        v = flask.session.get("value", "None")\n        assert flask.session.accessed\n        assert not flask.session.modified\n        return v\n\n    assert client.post("/set", data={"value": "42"}).data == b"value set"\n    assert client.get("/get").data == b"42"', start: 234, tick: 5, types_hash: '95304b3d97188d9c', _vid: 715}),
  (:Symbol {body_hash: '23d7b009021c9ef7', deleted: false, end: 266, key: 'tests/test_basic.py::test_session_path', kind: 'function', name: 'test_session_path', path: 'tests/test_basic.py', qualname: 'test_session_path', sig_hash: 'df6ec3162cad163f', signature: 'test_session_path(app, client)', source: 'def test_session_path(app, client):\n    app.config.update(APPLICATION_ROOT="/foo")\n\n    @app.route("/")\n    def index():\n        flask.session["testing"] = 42\n        return "Hello World"\n\n    rv = client.get("/", "http://example.com:8080/foo")\n    assert "path=/foo" in rv.headers["set-cookie"].lower()', start: 257, tick: 5, types_hash: '95304b3d97188d9c', _vid: 716}),
  (:Symbol {body_hash: '934dde6b34cd892d', deleted: false, end: 288, key: 'tests/test_basic.py::test_session_using_application_root', kind: 'function', name: 'test_session_using_application_root', path: 'tests/test_basic.py', qualname: 'test_session_using_application_root', sig_hash: 'df6ec3162cad163f', signature: 'test_session_using_application_root(app, client)', source: 'def test_session_using_application_root(app, client):\n    class PrefixPathMiddleware:\n        def __init__(self, app, prefix):\n            self.app = app\n            self.prefix = prefix\n\n        def __call__(self, environ, start_response):\n            environ["SCRIPT_NAME"] = self.prefix\n            return self.app(environ, start_response)\n\n    app.wsgi_app = PrefixPathMiddleware(app.wsgi_app, "/bar")\n    app.config.update(APPLICATION_ROOT="/bar")\n\n    @app.route("/")\n    def index():\n        flask.session["testing"] = 42\n        return "Hello World"\n\n    rv = client.get("/", "http://example.com:8080/")\n    assert "path=/bar" in rv.headers["set-cookie"].lower()', start: 269, tick: 5, types_hash: '95304b3d97188d9c', _vid: 717}),
  (:Symbol {body_hash: 'ddb867313bddd17f', deleted: false, end: 331, key: 'tests/test_basic.py::test_session_using_session_settings', kind: 'function', name: 'test_session_using_session_settings', path: 'tests/test_basic.py', qualname: 'test_session_using_session_settings', sig_hash: 'df6ec3162cad163f', signature: 'test_session_using_session_settings(app, client)', source: 'def test_session_using_session_settings(app, client):\n    app.config.update(\n        SERVER_NAME="www.example.com:8080",\n        APPLICATION_ROOT="/test",\n        SESSION_COOKIE_DOMAIN=".example.com",\n        SESSION_COOKIE_HTTPONLY=False,\n        SESSION_COOKIE_SECURE=True,\n        SESSION_COOKIE_PARTITIONED=True,\n        SESSION_COOKIE_SAMESITE="Lax",\n        SESSION_COOKIE_PATH="/",\n    )\n\n    @app.route("/")\n    def index():\n        flask.session["testing"] = 42\n        return "Hello World"\n\n    @app.route("/clear")\n    def clear():\n        flask.session.pop("testing", None)\n        return "Goodbye World"\n\n    rv = client.get("/", "http://www.example.com:8080/test/")\n    cookie = rv.headers["set-cookie"].lower()\n    # or condition for Werkzeug < 2.3\n    assert "domain=example.com" in cookie or "domain=.example.com" in cookie\n    assert "path=/" in cookie\n    assert "secure" in cookie\n    assert "httponly" not in cookie\n    assert "samesite" in cookie\n    assert "partitioned" in cookie\n\n    rv = client.get("/clear", "http://www.example.com:8080/test/")\n    cookie = rv.headers["set-cookie"].lower()\n    assert "session=;" in cookie\n    # or condition for Werkzeug < 2.3\n    assert "domain=example.com" in cookie or "domain=.example.com" in cookie\n    assert "path=/" in cookie\n    assert "secure" in cookie\n    assert "samesite" in cookie\n    assert "partitioned" in cookie', start: 291, tick: 5, types_hash: '95304b3d97188d9c', _vid: 718}),
  (:Symbol {body_hash: '2f7c718bdbe9900a', deleted: false, end: 358, key: 'tests/test_basic.py::test_session_using_samesite_attribute', kind: 'function', name: 'test_session_using_samesite_attribute', path: 'tests/test_basic.py', qualname: 'test_session_using_samesite_attribute', sig_hash: 'df6ec3162cad163f', signature: 'test_session_using_samesite_attribute(app, client)', source: 'def test_session_using_samesite_attribute(app, client):\n    @app.route("/")\n    def index():\n        flask.session["testing"] = 42\n        return "Hello World"\n\n    app.config.update(SESSION_COOKIE_SAMESITE="invalid")\n\n    with pytest.raises(ValueError):\n        client.get("/")\n\n    app.config.update(SESSION_COOKIE_SAMESITE=None)\n    rv = client.get("/")\n    cookie = rv.headers["set-cookie"].lower()\n    assert "samesite" not in cookie\n\n    app.config.update(SESSION_COOKIE_SAMESITE="Strict")\n    rv = client.get("/")\n    cookie = rv.headers["set-cookie"].lower()\n    assert "samesite=strict" in cookie\n\n    app.config.update(SESSION_COOKIE_SAMESITE="Lax")\n    rv = client.get("/")\n    cookie = rv.headers["set-cookie"].lower()\n    assert "samesite=lax" in cookie', start: 334, tick: 5, types_hash: '95304b3d97188d9c', _vid: 719}),
  (:Symbol {body_hash: 'f549749ac016765d', deleted: false, end: 371, key: 'tests/test_basic.py::test_missing_session', kind: 'function', name: 'test_missing_session', path: 'tests/test_basic.py', qualname: 'test_missing_session', sig_hash: '462ce794eb370ded', signature: 'test_missing_session(app)', source: 'def test_missing_session(app):\n    app.secret_key = None\n\n    def expect_exception(f, *args, **kwargs):\n        e = pytest.raises(RuntimeError, f, *args, **kwargs)\n        assert e.value.args and "session is unavailable" in e.value.args[0]\n\n    with app.test_request_context():\n        assert flask.session.get("missing_key") is None\n        expect_exception(flask.session.__setitem__, "foo", 42)\n        expect_exception(flask.session.pop, "foo")', start: 361, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 720}),
  (:Symbol {body_hash: 'b920edd99a801e6b', deleted: false, end: 424, key: 'tests/test_basic.py::test_session_expiration', kind: 'function', name: 'test_session_expiration', path: 'tests/test_basic.py', qualname: 'test_session_expiration', sig_hash: 'df6ec3162cad163f', signature: 'test_session_expiration(app, client)', source: 'def test_session_expiration(app, client):\n    permanent = True\n\n    @app.route("/")\n    def index():\n        flask.session["test"] = 42\n        flask.session.permanent = permanent\n        return ""\n\n    @app.route("/test")\n    def test():\n        return str(flask.session.permanent)\n\n    rv = client.get("/")\n    assert "set-cookie" in rv.headers\n    match = re.search(r"(?i)\\bexpires=([^;]+)", rv.headers["set-cookie"])\n    expires = parse_date(match.group())\n    expected = datetime.now(timezone.utc) + app.permanent_session_lifetime\n    assert expires.year == expected.year\n    assert expires.month == expected.month\n    assert expires.day == expected.day\n\n    rv = client.get("/test")\n    assert rv.data == b"True"\n\n    permanent = False\n    rv = client.get("/")\n    assert "set-cookie" in rv.headers\n    match = re.search(r"\\bexpires=([^;]+)", rv.headers["set-cookie"])\n    assert match is None', start: 395, tick: 5, types_hash: '95304b3d97188d9c', _vid: 721}),
  (:Symbol {body_hash: '12ab98c338daa2f3', deleted: false, end: 438, key: 'tests/test_basic.py::test_session_stored_last', kind: 'function', name: 'test_session_stored_last', path: 'tests/test_basic.py', qualname: 'test_session_stored_last', sig_hash: 'df6ec3162cad163f', signature: 'test_session_stored_last(app, client)', source: 'def test_session_stored_last(app, client):\n    @app.after_request\n    def modify_session(response):\n        flask.session["foo"] = 42\n        return response\n\n    @app.route("/")\n    def dump_session_contents():\n        return repr(flask.session.get("foo"))\n\n    assert client.get("/").data == b"None"\n    assert client.get("/").data == b"42"', start: 427, tick: 5, types_hash: '95304b3d97188d9c', _vid: 722}),
  (:Symbol {body_hash: '633759d0ab5f9b50', deleted: false, end: 469, key: 'tests/test_basic.py::test_session_special_types', kind: 'function', name: 'test_session_special_types', path: 'tests/test_basic.py', qualname: 'test_session_special_types', sig_hash: 'df6ec3162cad163f', signature: 'test_session_special_types(app, client)', source: 'def test_session_special_types(app, client):\n    now = datetime.now(timezone.utc).replace(microsecond=0)\n    the_uuid = uuid.uuid4()\n\n    @app.route("/")\n    def dump_session_contents():\n        flask.session["t"] = (1, 2, 3)\n        flask.session["b"] = b"\\xff"\n        flask.session["m"] = Markup("<html>")\n        flask.session["u"] = the_uuid\n        flask.session["d"] = now\n        flask.session["t_tag"] = {" t": "not-a-tuple"}\n        flask.session["di_t_tag"] = {" t__": "not-a-tuple"}\n        flask.session["di_tag"] = {" di": "not-a-dict"}\n        return "", 204\n\n    with client:\n        client.get("/")\n        s = flask.session\n        assert s["t"] == (1, 2, 3)\n        assert type(s["b"]) is bytes  # noqa: E721\n        assert s["b"] == b"\\xff"\n        assert type(s["m"]) is Markup  # noqa: E721\n        assert s["m"] == Markup("<html>")\n        assert s["u"] == the_uuid\n        assert s["d"] == now\n        assert s["t_tag"] == {" t": "not-a-tuple"}\n        assert s["di_t_tag"] == {" t__": "not-a-tuple"}\n        assert s["di_tag"] == {" di": "not-a-dict"}', start: 441, tick: 5, types_hash: '95304b3d97188d9c', _vid: 723}),
  (:Symbol {body_hash: 'b7f47b6508e8646b', deleted: false, end: 510, key: 'tests/test_basic.py::test_session_cookie_setting', kind: 'function', name: 'test_session_cookie_setting', path: 'tests/test_basic.py', qualname: 'test_session_cookie_setting', sig_hash: '462ce794eb370ded', signature: 'test_session_cookie_setting(app)', source: 'def test_session_cookie_setting(app):\n    is_permanent = True\n\n    @app.route("/bump")\n    def bump():\n        rv = flask.session["foo"] = flask.session.get("foo", 0) + 1\n        flask.session.permanent = is_permanent\n        return str(rv)\n\n    @app.route("/read")\n    def read():\n        return str(flask.session.get("foo", 0))\n\n    def run_test(expect_header):\n        with app.test_client() as c:\n            assert c.get("/bump").data == b"1"\n            assert c.get("/bump").data == b"2"\n            assert c.get("/bump").data == b"3"\n\n            rv = c.get("/read")\n            set_cookie = rv.headers.get("set-cookie")\n            assert (set_cookie is not None) == expect_header\n            assert rv.data == b"3"\n\n    is_permanent = True\n    app.config["SESSION_REFRESH_EACH_REQUEST"] = True\n    run_test(expect_header=True)\n\n    is_permanent = True\n    app.config["SESSION_REFRESH_EACH_REQUEST"] = False\n    run_test(expect_header=False)\n\n    is_permanent = False\n    app.config["SESSION_REFRESH_EACH_REQUEST"] = True\n    run_test(expect_header=False)\n\n    is_permanent = False\n    app.config["SESSION_REFRESH_EACH_REQUEST"] = False\n    run_test(expect_header=False)', start: 472, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 724}),
  (:Symbol {body_hash: '3673ab2c8580026e', deleted: false, end: 571, key: 'tests/test_basic.py::test_session_vary_cookie', kind: 'function', name: 'test_session_vary_cookie', path: 'tests/test_basic.py', qualname: 'test_session_vary_cookie', sig_hash: 'df6ec3162cad163f', signature: 'test_session_vary_cookie(app, client)', source: 'def test_session_vary_cookie(app, client):\n    @app.route("/set")\n    def set_session():\n        flask.session["test"] = "test"\n        return ""\n\n    @app.route("/get")\n    def get():\n        return flask.session.get("test")\n\n    @app.route("/getitem")\n    def getitem():\n        return flask.session["test"]\n\n    @app.route("/setdefault")\n    def setdefault():\n        return flask.session.setdefault("test", "default")\n\n    @app.route("/clear")\n    def clear():\n        flask.session.clear()\n        return ""\n\n    @app.route("/vary-cookie-header-set")\n    def vary_cookie_header_set():\n        response = flask.Response()\n        response.vary.add("Cookie")\n        flask.session["test"] = "test"\n        return response\n\n    @app.route("/vary-header-set")\n    def vary_header_set():\n        response = flask.Response()\n        response.vary.update(("Accept-Encoding", "Accept-Language"))\n        flask.session["test"] = "test"\n        return response\n\n    @app.route("/no-vary-header")\n    def no_vary_header():\n        return ""\n\n    def expect(path, header_value="Cookie"):\n        rv = client.get(path)\n\n        if header_value:\n            # The \'Vary\' key should exist in the headers only once.\n            assert len(rv.headers.get_all("Vary")) == 1\n            assert rv.headers["Vary"] == header_value\n        else:\n            assert "Vary" not in rv.headers\n\n    expect("/set")\n    expect("/get")\n    expect("/getitem")\n    expect("/setdefault")\n    expect("/clear")\n    expect("/vary-\n…', start: 513, tick: 5, types_hash: '95304b3d97188d9c', _vid: 725}),
  (:Symbol {body_hash: '3d09719ad17327a0', deleted: false, end: 597, key: 'tests/test_basic.py::test_flashes', kind: 'function', name: 'test_flashes', path: 'tests/test_basic.py', qualname: 'test_flashes', sig_hash: '2714d7bd06e83efe', signature: 'test_flashes(app, req_ctx)', source: 'def test_flashes(app, req_ctx):\n    assert not flask.session.modified\n    flask.flash("Zap")\n    flask.session.modified = False\n    flask.flash("Zip")\n    assert flask.session.modified\n    assert list(flask.get_flashed_messages()) == ["Zap", "Zip"]', start: 591, tick: 5, types_hash: '8515d83b8719fd6b', _vid: 726}),
  (:Symbol {body_hash: 'ceac9bd42c128b56', deleted: false, end: 678, key: 'tests/test_basic.py::test_extended_flashing', kind: 'function', name: 'test_extended_flashing', path: 'tests/test_basic.py', qualname: 'test_extended_flashing', sig_hash: '462ce794eb370ded', signature: 'test_extended_flashing(app)', source: 'def test_extended_flashing(app):\n    # Be sure app.testing=True below, else tests can fail silently.\n    #\n    # Specifically, if app.testing is not set to True, the AssertionErrors\n    # in the view functions will cause a 500 response to the test client\n    # instead of propagating exceptions.\n\n    @app.route("/")\n    def index():\n        flask.flash("Hello World")\n        flask.flash("Hello World", "error")\n        flask.flash(Markup("<em>Testing</em>"), "warning")\n        return ""\n\n    @app.route("/test/")\n    def test():\n        messages = flask.get_flashed_messages()\n        assert list(messages) == [\n            "Hello World",\n            "Hello World",\n            Markup("<em>Testing</em>"),\n        ]\n        return ""\n\n    @app.route("/test_with_categories/")\n    def test_with_categories():\n        messages = flask.get_flashed_messages(with_categories=True)\n        assert len(messages) == 3\n        assert list(messages) == [\n            ("message", "Hello World"),\n            ("error", "Hello World"),\n            ("warning", Markup("<em>Testing</em>")),\n        ]\n        return ""\n\n    @app.route("/test_filter/")\n    def test_filter():\n        messages = flask.get_flashed_messages(\n            category_filter=["message"], with_categories=True\n        )\n        assert list(messages) == [("message", "Hello World")]\n        return ""\n\n    @app.route("/test_filters/")\n    def test_filters():\n        messages = flask.get_flashed_messages(\n            category_filter=["mes\n…', start: 600, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 727}),
  (:Symbol {body_hash: 'a35e665d304ae18e', deleted: false, end: 703, key: 'tests/test_basic.py::test_request_processing', kind: 'function', name: 'test_request_processing', path: 'tests/test_basic.py', qualname: 'test_request_processing', sig_hash: 'df6ec3162cad163f', signature: 'test_request_processing(app, client)', source: 'def test_request_processing(app, client):\n    evts = []\n\n    @app.before_request\n    def before_request():\n        evts.append("before")\n\n    @app.after_request\n    def after_request(response):\n        response.data += b"|after"\n        evts.append("after")\n        return response\n\n    @app.route("/")\n    def index():\n        assert "before" in evts\n        assert "after" not in evts\n        return "request"\n\n    assert "after" not in evts\n    rv = client.get("/").data\n    assert "after" in evts\n    assert rv == b"request|after"', start: 681, tick: 5, types_hash: '95304b3d97188d9c', _vid: 728}),
  (:Symbol {body_hash: '5fb1ccc2dbe60a3c', deleted: false, end: 730, key: 'tests/test_basic.py::test_request_preprocessing_early_return', kind: 'function', name: 'test_request_preprocessing_early_return', path: 'tests/test_basic.py', qualname: 'test_request_preprocessing_early_return', sig_hash: 'df6ec3162cad163f', signature: 'test_request_preprocessing_early_return(app, client)', source: 'def test_request_preprocessing_early_return(app, client):\n    evts = []\n\n    @app.before_request\n    def before_request1():\n        evts.append(1)\n\n    @app.before_request\n    def before_request2():\n        evts.append(2)\n        return "hello"\n\n    @app.before_request\n    def before_request3():\n        evts.append(3)\n        return "bye"\n\n    @app.route("/")\n    def index():\n        evts.append("index")\n        return "damnit"\n\n    rv = client.get("/").data.strip()\n    assert rv == b"hello"\n    assert evts == [1, 2]', start: 706, tick: 5, types_hash: '95304b3d97188d9c', _vid: 729}),
  (:Symbol {body_hash: '01c447c16a94b8d3', deleted: false, end: 745, key: 'tests/test_basic.py::test_after_request_processing', kind: 'function', name: 'test_after_request_processing', path: 'tests/test_basic.py', qualname: 'test_after_request_processing', sig_hash: 'df6ec3162cad163f', signature: 'test_after_request_processing(app, client)', source: 'def test_after_request_processing(app, client):\n    @app.route("/")\n    def index():\n        @flask.after_this_request\n        def foo(response):\n            response.headers["X-Foo"] = "a header"\n            return response\n\n        return "Test"\n\n    resp = client.get("/")\n    assert resp.status_code == 200\n    assert resp.headers["X-Foo"] == "a header"', start: 733, tick: 5, types_hash: '95304b3d97188d9c', _vid: 730}),
  (:Symbol {body_hash: '5ca67a3cca7c7656', deleted: false, end: 763, key: 'tests/test_basic.py::test_teardown_request_handler', kind: 'function', name: 'test_teardown_request_handler', path: 'tests/test_basic.py', qualname: 'test_teardown_request_handler', sig_hash: 'df6ec3162cad163f', signature: 'test_teardown_request_handler(app, client)', source: 'def test_teardown_request_handler(app, client):\n    called = []\n\n    @app.teardown_request\n    def teardown_request(exc):\n        called.append(True)\n        return "Ignored"\n\n    @app.route("/")\n    def root():\n        return "Response"\n\n    rv = client.get("/")\n    assert rv.status_code == 200\n    assert b"Response" in rv.data\n    assert len(called) == 1', start: 748, tick: 5, types_hash: '95304b3d97188d9c', _vid: 731}),
  (:Symbol {body_hash: '5ca67a3cca7c7656', deleted: false, end: 781, key: 'tests/test_basic.py::test_teardown_request_handler_debug_mode', kind: 'function', name: 'test_teardown_request_handler_debug_mode', path: 'tests/test_basic.py', qualname: 'test_teardown_request_handler_debug_mode', sig_hash: 'df6ec3162cad163f', signature: 'test_teardown_request_handler_debug_mode(app, client)', source: 'def test_teardown_request_handler_debug_mode(app, client):\n    called = []\n\n    @app.teardown_request\n    def teardown_request(exc):\n        called.append(True)\n        return "Ignored"\n\n    @app.route("/")\n    def root():\n        return "Response"\n\n    rv = client.get("/")\n    assert rv.status_code == 200\n    assert b"Response" in rv.data\n    assert len(called) == 1', start: 766, tick: 5, types_hash: '95304b3d97188d9c', _vid: 732}),
  (:Symbol {body_hash: 'ffa8601cb40731c7', deleted: false, end: 819, key: 'tests/test_basic.py::test_teardown_request_handler_error', kind: 'function', name: 'test_teardown_request_handler_error', path: 'tests/test_basic.py', qualname: 'test_teardown_request_handler_error', sig_hash: 'df6ec3162cad163f', signature: 'test_teardown_request_handler_error(app, client)', source: 'def test_teardown_request_handler_error(app, client):\n    called = []\n    app.testing = False\n\n    @app.teardown_request\n    def teardown_request1(exc):\n        assert type(exc) is ZeroDivisionError\n        called.append(True)\n        # This raises a new error and blows away sys.exc_info(), so we can\n        # test that all teardown_requests get passed the same original\n        # exception.\n        try:\n            raise TypeError()\n        except Exception:\n            pass\n\n    @app.teardown_request\n    def teardown_request2(exc):\n        assert type(exc) is ZeroDivisionError\n        called.append(True)\n        # This raises a new error and blows away sys.exc_info(), so we can\n        # test that all teardown_requests get passed the same original\n        # exception.\n        try:\n            raise TypeError()\n        except Exception:\n            pass\n\n    @app.route("/")\n    def fails():\n        raise ZeroDivisionError\n\n    rv = client.get("/")\n    assert rv.status_code == 500\n    assert b"Internal Server Error" in rv.data\n    assert len(called) == 2', start: 784, tick: 5, types_hash: '95304b3d97188d9c', _vid: 733}),
  (:Symbol {body_hash: 'e799d20b9d1e043a', deleted: false, end: 857, key: 'tests/test_basic.py::test_before_after_request_order', kind: 'function', name: 'test_before_after_request_order', path: 'tests/test_basic.py', qualname: 'test_before_after_request_order', sig_hash: 'df6ec3162cad163f', signature: 'test_before_after_request_order(app, client)', source: 'def test_before_after_request_order(app, client):\n    called = []\n\n    @app.before_request\n    def before1():\n        called.append(1)\n\n    @app.before_request\n    def before2():\n        called.append(2)\n\n    @app.after_request\n    def after1(response):\n        called.append(4)\n        return response\n\n    @app.after_request\n    def after2(response):\n        called.append(3)\n        return response\n\n    @app.teardown_request\n    def finish1(exc):\n        called.append(6)\n\n    @app.teardown_request\n    def finish2(exc):\n        called.append(5)\n\n    @app.route("/")\n    def index():\n        return "42"\n\n    rv = client.get("/")\n    assert rv.data == b"42"\n    assert called == [1, 2, 3, 4, 5, 6]', start: 822, tick: 5, types_hash: '95304b3d97188d9c', _vid: 734}),
  (:Symbol {body_hash: 'e02684de6ca1d1d0', deleted: false, end: 895, key: 'tests/test_basic.py::test_error_handling', kind: 'function', name: 'test_error_handling', path: 'tests/test_basic.py', qualname: 'test_error_handling', sig_hash: 'df6ec3162cad163f', signature: 'test_error_handling(app, client)', source: 'def test_error_handling(app, client):\n    app.testing = False\n\n    @app.errorhandler(404)\n    def not_found(e):\n        return "not found", 404\n\n    @app.errorhandler(500)\n    def internal_server_error(e):\n        return "internal server error", 500\n\n    @app.errorhandler(Forbidden)\n    def forbidden(e):\n        return "forbidden", 403\n\n    @app.route("/")\n    def index():\n        flask.abort(404)\n\n    @app.route("/error")\n    def error():\n        raise ZeroDivisionError\n\n    @app.route("/forbidden")\n    def error2():\n        flask.abort(403)\n\n    rv = client.get("/")\n    assert rv.status_code == 404\n    assert rv.data == b"not found"\n    rv = client.get("/error")\n    assert rv.status_code == 500\n    assert b"internal server error" == rv.data\n    rv = client.get("/forbidden")\n    assert rv.status_code == 403\n    assert b"forbidden" == rv.data', start: 860, tick: 5, types_hash: '95304b3d97188d9c', _vid: 735}),
  (:Symbol {body_hash: '2600fa4ee3f548bd', deleted: false, end: 916, key: 'tests/test_basic.py::test_error_handling_processing', kind: 'function', name: 'test_error_handling_processing', path: 'tests/test_basic.py', qualname: 'test_error_handling_processing', sig_hash: 'df6ec3162cad163f', signature: 'test_error_handling_processing(app, client)', source: 'def test_error_handling_processing(app, client):\n    app.testing = False\n\n    @app.errorhandler(500)\n    def internal_server_error(e):\n        return "internal server error", 500\n\n    @app.route("/")\n    def broken_func():\n        raise ZeroDivisionError\n\n    @app.after_request\n    def after_request(resp):\n        resp.mimetype = "text/x-special"\n        return resp\n\n    resp = client.get("/")\n    assert resp.mimetype == "text/x-special"\n    assert resp.data == b"internal server error"', start: 898, tick: 5, types_hash: '95304b3d97188d9c', _vid: 736}),
  (:Symbol {body_hash: 'e75196c88767f24a', deleted: false, end: 927, key: 'tests/test_basic.py::test_baseexception_error_handling', kind: 'function', name: 'test_baseexception_error_handling', path: 'tests/test_basic.py', qualname: 'test_baseexception_error_handling', sig_hash: 'df6ec3162cad163f', signature: 'test_baseexception_error_handling(app, client)', source: 'def test_baseexception_error_handling(app, client):\n    app.testing = False\n\n    @app.route("/")\n    def broken_func():\n        raise KeyboardInterrupt()\n\n    with pytest.raises(KeyboardInterrupt):\n        client.get("/")', start: 919, tick: 5, types_hash: '95304b3d97188d9c', _vid: 737}),
  (:Symbol {body_hash: '9189e5fdd2430a27', deleted: false, end: 941, key: 'tests/test_basic.py::test_before_request_and_routing_errors', kind: 'function', name: 'test_before_request_and_routing_errors', path: 'tests/test_basic.py', qualname: 'test_before_request_and_routing_errors', sig_hash: 'df6ec3162cad163f', signature: 'test_before_request_and_routing_errors(app, client)', source: 'def test_before_request_and_routing_errors(app, client):\n    @app.before_request\n    def attach_something():\n        flask.g.something = "value"\n\n    @app.errorhandler(404)\n    def return_something(error):\n        return flask.g.something, 404\n\n    rv = client.get("/")\n    assert rv.status_code == 404\n    assert rv.data == b"value"', start: 930, tick: 5, types_hash: '95304b3d97188d9c', _vid: 738}),
  (:Symbol {body_hash: 'fc74cb514dd48134', deleted: false, end: 957, key: 'tests/test_basic.py::test_user_error_handling', kind: 'function', name: 'test_user_error_handling', path: 'tests/test_basic.py', qualname: 'test_user_error_handling', sig_hash: 'df6ec3162cad163f', signature: 'test_user_error_handling(app, client)', source: 'def test_user_error_handling(app, client):\n    class MyException(Exception):\n        pass\n\n    @app.errorhandler(MyException)\n    def handle_my_exception(e):\n        assert isinstance(e, MyException)\n        return "42"\n\n    @app.route("/")\n    def index():\n        raise MyException()\n\n    assert client.get("/").data == b"42"', start: 944, tick: 5, types_hash: '95304b3d97188d9c', _vid: 739}),
  (:Symbol {body_hash: '856254f2f57bc06b', deleted: false, end: 989, key: 'tests/test_basic.py::test_http_error_subclass_handling', kind: 'function', name: 'test_http_error_subclass_handling', path: 'tests/test_basic.py', qualname: 'test_http_error_subclass_handling', sig_hash: 'df6ec3162cad163f', signature: 'test_http_error_subclass_handling(app, client)', source: 'def test_http_error_subclass_handling(app, client):\n    class ForbiddenSubclass(Forbidden):\n        pass\n\n    @app.errorhandler(ForbiddenSubclass)\n    def handle_forbidden_subclass(e):\n        assert isinstance(e, ForbiddenSubclass)\n        return "banana"\n\n    @app.errorhandler(403)\n    def handle_403(e):\n        assert not isinstance(e, ForbiddenSubclass)\n        assert isinstance(e, Forbidden)\n        return "apple"\n\n    @app.route("/1")\n    def index1():\n        raise ForbiddenSubclass()\n\n    @app.route("/2")\n    def index2():\n        flask.abort(403)\n\n    @app.route("/3")\n    def index3():\n        raise Forbidden()\n\n    assert client.get("/1").data == b"banana"\n    assert client.get("/2").data == b"apple"\n    assert client.get("/3").data == b"apple"', start: 960, tick: 5, types_hash: '95304b3d97188d9c', _vid: 740}),
  (:Symbol {body_hash: 'b88eb4f44ebddd08', deleted: false, end: 1022, key: 'tests/test_basic.py::test_errorhandler_precedence', kind: 'function', name: 'test_errorhandler_precedence', path: 'tests/test_basic.py', qualname: 'test_errorhandler_precedence', sig_hash: 'df6ec3162cad163f', signature: 'test_errorhandler_precedence(app, client)', source: 'def test_errorhandler_precedence(app, client):\n    class E1(Exception):\n        pass\n\n    class E2(Exception):\n        pass\n\n    class E3(E1, E2):\n        pass\n\n    @app.errorhandler(E2)\n    def handle_e2(e):\n        return "E2"\n\n    @app.errorhandler(Exception)\n    def handle_exception(e):\n        return "Exception"\n\n    @app.route("/E1")\n    def raise_e1():\n        raise E1\n\n    @app.route("/E3")\n    def raise_e3():\n        raise E3\n\n    rv = client.get("/E1")\n    assert rv.data == b"Exception"\n\n    rv = client.get("/E3")\n    assert rv.data == b"E2"', start: 992, tick: 5, types_hash: '95304b3d97188d9c', _vid: 741}),
  (:Symbol {body_hash: '096bd0b3ad8bfdde', deleted: false, end: 1057, key: 'tests/test_basic.py::test_trap_bad_request_key_error', kind: 'function', name: 'test_trap_bad_request_key_error', path: 'tests/test_basic.py', qualname: 'test_trap_bad_request_key_error', sig_hash: '4b7d828a6946e7ac', signature: 'test_trap_bad_request_key_error(app, client, debug, trap, expect_key, expect_abort)', source: '@pytest.mark.parametrize(\n    ("debug", "trap", "expect_key", "expect_abort"),\n    [(False, None, True, True), (True, None, False, True), (False, True, False, False)],\n)\ndef test_trap_bad_request_key_error(app, client, debug, trap, expect_key, expect_abort):\n    app.config["DEBUG"] = debug\n    app.config["TRAP_BAD_REQUEST_ERRORS"] = trap\n\n    @app.route("/key")\n    def fail():\n        flask.request.form["missing_key"]\n\n    @app.route("/abort")\n    def allow_abort():\n        flask.abort(400)\n\n    if expect_key:\n        rv = client.get("/key")\n        assert rv.status_code == 400\n        assert b"missing_key" not in rv.data\n    else:\n        with pytest.raises(KeyError) as exc_info:\n            client.get("/key")\n\n        assert exc_info.errisinstance(BadRequest)\n        assert "missing_key" in exc_info.value.get_description()\n\n    if expect_abort:\n        rv = client.get("/abort")\n        assert rv.status_code == 400\n    else:\n        with pytest.raises(BadRequest):\n            client.get("/abort")', start: 1029, tick: 5, types_hash: '7f96dfdd063c11a5', _vid: 742}),
  (:Symbol {body_hash: 'e5a8d9204a13b9e2', deleted: false, end: 1068, key: 'tests/test_basic.py::test_trapping_of_all_http_exceptions', kind: 'function', name: 'test_trapping_of_all_http_exceptions', path: 'tests/test_basic.py', qualname: 'test_trapping_of_all_http_exceptions', sig_hash: 'df6ec3162cad163f', signature: 'test_trapping_of_all_http_exceptions(app, client)', source: 'def test_trapping_of_all_http_exceptions(app, client):\n    app.config["TRAP_HTTP_EXCEPTIONS"] = True\n\n    @app.route("/fail")\n    def fail():\n        flask.abort(404)\n\n    with pytest.raises(NotFound):\n        client.get("/fail")', start: 1060, tick: 5, types_hash: '95304b3d97188d9c', _vid: 743}),
  (:Symbol {body_hash: '9da94ae4da895aa4', deleted: false, end: 1097, key: 'tests/test_basic.py::test_error_handler_after_processor_error', kind: 'function', name: 'test_error_handler_after_processor_error', path: 'tests/test_basic.py', qualname: 'test_error_handler_after_processor_error', sig_hash: 'df6ec3162cad163f', signature: 'test_error_handler_after_processor_error(app, client)', source: 'def test_error_handler_after_processor_error(app, client):\n    app.testing = False\n\n    @app.before_request\n    def before_request():\n        if _trigger == "before":\n            raise ZeroDivisionError\n\n    @app.after_request\n    def after_request(response):\n        if _trigger == "after":\n            raise ZeroDivisionError\n\n        return response\n\n    @app.route("/")\n    def index():\n        return "Foo"\n\n    @app.errorhandler(500)\n    def internal_server_error(e):\n        return "Hello Server Error", 500\n\n    for _trigger in "before", "after":\n        rv = client.get("/")\n        assert rv.status_code == 500\n        assert rv.data == b"Hello Server Error"', start: 1071, tick: 5, types_hash: '95304b3d97188d9c', _vid: 744}),
  (:Symbol {body_hash: 'fd61ca70da3b7e31', deleted: false, end: 1112, key: 'tests/test_basic.py::test_enctype_debug_helper', kind: 'function', name: 'test_enctype_debug_helper', path: 'tests/test_basic.py', qualname: 'test_enctype_debug_helper', sig_hash: 'df6ec3162cad163f', signature: 'test_enctype_debug_helper(app, client)', source: 'def test_enctype_debug_helper(app, client):\n    from flask.debughelpers import DebugFilesKeyError\n\n    app.debug = True\n\n    @app.route("/fail", methods=["POST"])\n    def index():\n        return flask.request.files["foo"].filename\n\n    with pytest.raises(DebugFilesKeyError) as e:\n        client.post("/fail", data={"foo": "index.txt"})\n    assert "no file contents were transmitted" in str(e.value)\n    assert "This was submitted: \'index.txt\'" in str(e.value)', start: 1100, tick: 5, types_hash: '95304b3d97188d9c', _vid: 745}),
  (:Symbol {body_hash: 'd5201b70f9073971', deleted: false, end: 1206, key: 'tests/test_basic.py::test_response_types', kind: 'function', name: 'test_response_types', path: 'tests/test_basic.py', qualname: 'test_response_types', sig_hash: 'df6ec3162cad163f', signature: 'test_response_types(app, client)', source: 'def test_response_types(app, client):\n    @app.route("/text")\n    def from_text():\n        return "Hällo Wörld"\n\n    @app.route("/bytes")\n    def from_bytes():\n        return "Hällo Wörld".encode()\n\n    @app.route("/full_tuple")\n    def from_full_tuple():\n        return (\n            "Meh",\n            400,\n            {"X-Foo": "Testing", "Content-Type": "text/plain; charset=utf-8"},\n        )\n\n    @app.route("/text_headers")\n    def from_text_headers():\n        return "Hello", {"X-Foo": "Test", "Content-Type": "text/plain; charset=utf-8"}\n\n    @app.route("/text_status")\n    def from_text_status():\n        return "Hi, status!", 400\n\n    @app.route("/response_headers")\n    def from_response_headers():\n        return (\n            flask.Response(\n                "Hello world", 404, {"Content-Type": "text/html", "X-Foo": "Baz"}\n            ),\n            {"Content-Type": "text/plain", "X-Foo": "Bar", "X-Bar": "Foo"},\n        )\n\n    @app.route("/response_status")\n    def from_response_status():\n        return app.response_class("Hello world", 400), 500\n\n    @app.route("/wsgi")\n    def from_wsgi():\n        return NotFound()\n\n    @app.route("/dict")\n    def from_dict():\n        return {"foo": "bar"}, 201\n\n    @app.route("/list")\n    def from_list():\n        return ["foo", "bar"], 201\n\n    assert client.get("/text").data == "Hällo Wörld".encode()\n    assert client.get("/bytes").data == "Hällo Wörld".encode()\n\n    rv = client.get("/full_tuple")\n    assert rv.data == b"Meh"\n    asser\n…', start: 1115, tick: 5, types_hash: '95304b3d97188d9c', _vid: 746}),
  (:Symbol {body_hash: '14acb57ac0b6b4df', deleted: false, end: 1255, key: 'tests/test_basic.py::test_response_type_errors', kind: 'function', name: 'test_response_type_errors', path: 'tests/test_basic.py', qualname: 'test_response_type_errors', sig_hash: '4943fbd3d489f4fa', signature: 'test_response_type_errors()', source: 'def test_response_type_errors():\n    app = flask.Flask(__name__)\n    app.testing = True\n\n    @app.route("/none")\n    def from_none():\n        pass\n\n    @app.route("/small_tuple")\n    def from_small_tuple():\n        return ("Hello",)\n\n    @app.route("/large_tuple")\n    def from_large_tuple():\n        return "Hello", 234, {"X-Foo": "Bar"}, "???"\n\n    @app.route("/bad_type")\n    def from_bad_type():\n        return True\n\n    @app.route("/bad_wsgi")\n    def from_bad_wsgi():\n        return lambda: None\n\n    c = app.test_client()\n\n    with pytest.raises(TypeError) as e:\n        c.get("/none")\n\n    assert "returned None" in str(e.value)\n    assert "from_none" in str(e.value)\n\n    with pytest.raises(TypeError) as e:\n        c.get("/small_tuple")\n\n    assert "tuple must have the form" in str(e.value)\n\n    with pytest.raises(TypeError):\n        c.get("/large_tuple")\n\n    with pytest.raises(TypeError) as e:\n        c.get("/bad_type")\n\n    assert "it was a bool" in str(e.value)\n\n    with pytest.raises(TypeError):\n        c.get("/bad_wsgi")', start: 1209, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 747}),
  (:Symbol {body_hash: '37eeced2d1e8624d', deleted: false, end: 1277, key: 'tests/test_basic.py::test_make_response', kind: 'function', name: 'test_make_response', path: 'tests/test_basic.py', qualname: 'test_make_response', sig_hash: '2714d7bd06e83efe', signature: 'test_make_response(app, req_ctx)', source: 'def test_make_response(app, req_ctx):\n    rv = flask.make_response()\n    assert rv.status_code == 200\n    assert rv.data == b""\n    assert rv.mimetype == "text/html"\n\n    rv = flask.make_response("Awesome")\n    assert rv.status_code == 200\n    assert rv.data == b"Awesome"\n    assert rv.mimetype == "text/html"\n\n    rv = flask.make_response("W00t", 404)\n    assert rv.status_code == 404\n    assert rv.data == b"W00t"\n    assert rv.mimetype == "text/html"\n\n    rv = flask.make_response(c for c in "Hello")\n    assert rv.status_code == 200\n    assert rv.data == b"Hello"\n    assert rv.mimetype == "text/html"', start: 1258, tick: 5, types_hash: '8515d83b8719fd6b', _vid: 748}),
  (:Symbol {body_hash: '5707a8cea1335ccb', deleted: false, end: 1298, key: 'tests/test_basic.py::test_make_response_with_response_instance', kind: 'function', name: 'test_make_response_with_response_instance', path: 'tests/test_basic.py', qualname: 'test_make_response_with_response_instance', sig_hash: '2714d7bd06e83efe', signature: 'test_make_response_with_response_instance(app, req_ctx)', source: 'def test_make_response_with_response_instance(app, req_ctx):\n    rv = flask.make_response(flask.jsonify({"msg": "W00t"}), 400)\n    assert rv.status_code == 400\n    assert rv.data == b\'{"msg":"W00t"}\\n\'\n    assert rv.mimetype == "application/json"\n\n    rv = flask.make_response(flask.Response(""), 400)\n    assert rv.status_code == 400\n    assert rv.data == b""\n    assert rv.mimetype == "text/html"\n\n    rv = flask.make_response(\n        flask.Response("", headers={"Content-Type": "text/html"}),\n        400,\n        [("X-Foo", "bar")],\n    )\n    assert rv.status_code == 400\n    assert rv.headers["Content-Type"] == "text/html"\n    assert rv.headers["X-Foo"] == "bar"', start: 1280, tick: 5, types_hash: '8515d83b8719fd6b', _vid: 749}),
  (:Symbol {body_hash: 'a9ad93261c901930', deleted: false, end: 1307, key: 'tests/test_basic.py::test_jsonify_no_prettyprint', kind: 'function', name: 'test_jsonify_no_prettyprint', path: 'tests/test_basic.py', qualname: 'test_jsonify_no_prettyprint', sig_hash: '5b3dc18c3b0a10fb', signature: 'test_jsonify_no_prettyprint(app, compact)', source: '@pytest.mark.parametrize("compact", [True, False])\ndef test_jsonify_no_prettyprint(app, compact):\n    app.json.compact = compact\n    rv = app.json.response({"msg": {"submsg": "W00t"}, "msg2": "foobar"})\n    data = rv.data.strip()\n    assert (b" " not in data) is compact\n    assert (b"\\n" not in data) is compact', start: 1302, tick: 5, types_hash: '83b9891476e6b260', _vid: 750}),
  (:Symbol {body_hash: 'fa1c0d3cd8b638a1', deleted: false, end: 1314, key: 'tests/test_basic.py::test_jsonify_mimetype', kind: 'function', name: 'test_jsonify_mimetype', path: 'tests/test_basic.py', qualname: 'test_jsonify_mimetype', sig_hash: '2714d7bd06e83efe', signature: 'test_jsonify_mimetype(app, req_ctx)', source: 'def test_jsonify_mimetype(app, req_ctx):\n    app.json.mimetype = "application/vnd.api+json"\n    msg = {"msg": {"submsg": "W00t"}}\n    rv = flask.make_response(flask.jsonify(msg), 200)\n    assert rv.mimetype == "application/vnd.api+json"', start: 1310, tick: 5, types_hash: '8515d83b8719fd6b', _vid: 751}),
  (:Symbol {body_hash: '2664789b41da56c1', deleted: false, end: 1323, key: 'tests/test_basic.py::test_json_dump_dataclass', kind: 'function', name: 'test_json_dump_dataclass', path: 'tests/test_basic.py', qualname: 'test_json_dump_dataclass', sig_hash: '2714d7bd06e83efe', signature: 'test_json_dump_dataclass(app, req_ctx)', source: 'def test_json_dump_dataclass(app, req_ctx):\n    from dataclasses import make_dataclass\n\n    Data = make_dataclass("Data", [("name", str)])\n    value = app.json.dumps(Data("Flask"))\n    value = app.json.loads(value)\n    assert value == {"name": "Flask"}', start: 1317, tick: 5, types_hash: '8515d83b8719fd6b', _vid: 752}),
  (:Symbol {body_hash: 'f60b83c7bc354d8b', deleted: false, end: 1329, key: 'tests/test_basic.py::test_jsonify_args_and_kwargs_check', kind: 'function', name: 'test_jsonify_args_and_kwargs_check', path: 'tests/test_basic.py', qualname: 'test_jsonify_args_and_kwargs_check', sig_hash: '2714d7bd06e83efe', signature: 'test_jsonify_args_and_kwargs_check(app, req_ctx)', source: 'def test_jsonify_args_and_kwargs_check(app, req_ctx):\n    with pytest.raises(TypeError) as e:\n        flask.jsonify("fake args", kwargs="fake")\n    assert "args or kwargs" in str(e.value)', start: 1326, tick: 5, types_hash: '8515d83b8719fd6b', _vid: 753}),
  (:Symbol {body_hash: '00f545dc52a54f92', deleted: false, end: 1341, key: 'tests/test_basic.py::test_url_generation', kind: 'function', name: 'test_url_generation', path: 'tests/test_basic.py', qualname: 'test_url_generation', sig_hash: '2714d7bd06e83efe', signature: 'test_url_generation(app, req_ctx)', source: 'def test_url_generation(app, req_ctx):\n    @app.route("/hello/<name>", methods=["POST"])\n    def hello():\n        pass\n\n    assert flask.url_for("hello", name="test x") == "/hello/test%20x"\n    assert (\n        flask.url_for("hello", name="test x", _external=True)\n        == "http://localhost/hello/test%20x"\n    )', start: 1332, tick: 5, types_hash: '8515d83b8719fd6b', _vid: 754}),
  (:Symbol {body_hash: '956b452e1c0a11cc', deleted: false, end: 1367, key: 'tests/test_basic.py::test_build_error_handler', kind: 'function', name: 'test_build_error_handler', path: 'tests/test_basic.py', qualname: 'test_build_error_handler', sig_hash: '462ce794eb370ded', signature: 'test_build_error_handler(app)', source: 'def test_build_error_handler(app):\n    # Test base case, a URL which results in a BuildError.\n    with app.test_request_context():\n        pytest.raises(BuildError, flask.url_for, "spam")\n\n    # Verify the error is re-raised if not the current exception.\n    try:\n        with app.test_request_context():\n            flask.url_for("spam")\n    except BuildError as err:\n        error = err\n    try:\n        raise RuntimeError("Test case where BuildError is not current.")\n    except RuntimeError:\n        pytest.raises(BuildError, app.handle_url_build_error, error, "spam", {})\n\n    # Test a custom handler.\n    def handler(error, endpoint, values):\n        # Just a test.\n        return "/test_handler/"\n\n    app.url_build_error_handlers.append(handler)\n    with app.test_request_context():\n        assert flask.url_for("spam") == "/test_handler/"', start: 1344, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 755}),
  (:Symbol {body_hash: 'f881af77f1954acc', deleted: false, end: 1378, key: 'tests/test_basic.py::test_build_error_handler_reraise', kind: 'function', name: 'test_build_error_handler_reraise', path: 'tests/test_basic.py', qualname: 'test_build_error_handler_reraise', sig_hash: '462ce794eb370ded', signature: 'test_build_error_handler_reraise(app)', source: 'def test_build_error_handler_reraise(app):\n    # Test a custom handler which reraises the BuildError\n    def handler_raises_build_error(error, endpoint, values):\n        raise error\n\n    app.url_build_error_handlers.append(handler_raises_build_error)\n\n    with app.test_request_context():\n        pytest.raises(BuildError, flask.url_for, "not.existing")', start: 1370, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 756}),
  (:Symbol {body_hash: 'efb4d3f210de6762', deleted: false, end: 1393, key: 'tests/test_basic.py::test_url_for_passes_special_values_to_build_error_handler', kind: 'function', name: 'test_url_for_passes_special_values_to_build_error_handler', path: 'tests/test_basic.py', qualname: 'test_url_for_passes_special_values_to_build_error_handler', sig_hash: '462ce794eb370ded', signature: 'test_url_for_passes_special_values_to_build_error_handler(app)', source: 'def test_url_for_passes_special_values_to_build_error_handler(app):\n    @app.url_build_error_handlers.append\n    def handler(error, endpoint, values):\n        assert values == {\n            "_external": False,\n            "_anchor": None,\n            "_method": None,\n            "_scheme": None,\n        }\n        return "handled"\n\n    with app.test_request_context():\n        flask.url_for("/")', start: 1381, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 757}),
  (:Symbol {body_hash: 'a23805193202a92b', deleted: false, end: 1402, key: 'tests/test_basic.py::test_static_files', kind: 'function', name: 'test_static_files', path: 'tests/test_basic.py', qualname: 'test_static_files', sig_hash: 'df6ec3162cad163f', signature: 'test_static_files(app, client)', source: 'def test_static_files(app, client):\n    rv = client.get("/static/index.html")\n    assert rv.status_code == 200\n    assert rv.data.strip() == b"<h1>Hello World!</h1>"\n    with app.test_request_context():\n        assert flask.url_for("static", filename="index.html") == "/static/index.html"\n    rv.close()', start: 1396, tick: 5, types_hash: '95304b3d97188d9c', _vid: 758}),
  (:Symbol {body_hash: '74f1286fb2ab4b28', deleted: false, end: 1413, key: 'tests/test_basic.py::test_static_url_path', kind: 'function', name: 'test_static_url_path', path: 'tests/test_basic.py', qualname: 'test_static_url_path', sig_hash: '4943fbd3d489f4fa', signature: 'test_static_url_path()', source: 'def test_static_url_path():\n    app = flask.Flask(__name__, static_url_path="/foo")\n    app.testing = True\n    rv = app.test_client().get("/foo/index.html")\n    assert rv.status_code == 200\n    rv.close()\n\n    with app.test_request_context():\n        assert flask.url_for("static", filename="index.html") == "/foo/index.html"', start: 1405, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 759}),
  (:Symbol {body_hash: '92cd4a3d34caa7d1', deleted: false, end: 1424, key: 'tests/test_basic.py::test_static_url_path_with_ending_slash', kind: 'function', name: 'test_static_url_path_with_ending_slash', path: 'tests/test_basic.py', qualname: 'test_static_url_path_with_ending_slash', sig_hash: '4943fbd3d489f4fa', signature: 'test_static_url_path_with_ending_slash()', source: 'def test_static_url_path_with_ending_slash():\n    app = flask.Flask(__name__, static_url_path="/foo/")\n    app.testing = True\n    rv = app.test_client().get("/foo/index.html")\n    assert rv.status_code == 200\n    rv.close()\n\n    with app.test_request_context():\n        assert flask.url_for("static", filename="index.html") == "/foo/index.html"', start: 1416, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 760}),
  (:Symbol {body_hash: '35d7a2e9dc9f1f5e', deleted: false, end: 1431, key: 'tests/test_basic.py::test_static_url_empty_path', kind: 'function', name: 'test_static_url_empty_path', path: 'tests/test_basic.py', qualname: 'test_static_url_empty_path', sig_hash: '462ce794eb370ded', signature: 'test_static_url_empty_path(app)', source: 'def test_static_url_empty_path(app):\n    app = flask.Flask(__name__, static_folder="", static_url_path="")\n    rv = app.test_client().open("/static/index.html", method="GET")\n    assert rv.status_code == 200\n    rv.close()', start: 1427, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 761}),
  (:Symbol {body_hash: '79251c850095a93b', deleted: false, end: 1438, key: 'tests/test_basic.py::test_static_url_empty_path_default', kind: 'function', name: 'test_static_url_empty_path_default', path: 'tests/test_basic.py', qualname: 'test_static_url_empty_path_default', sig_hash: '462ce794eb370ded', signature: 'test_static_url_empty_path_default(app)', source: 'def test_static_url_empty_path_default(app):\n    app = flask.Flask(__name__, static_folder="")\n    rv = app.test_client().open("/static/index.html", method="GET")\n    assert rv.status_code == 200\n    rv.close()', start: 1434, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 762}),
  (:Symbol {body_hash: '94d3bb6ca56eb667', deleted: false, end: 1447, key: 'tests/test_basic.py::test_static_folder_with_pathlib_path', kind: 'function', name: 'test_static_folder_with_pathlib_path', path: 'tests/test_basic.py', qualname: 'test_static_folder_with_pathlib_path', sig_hash: '462ce794eb370ded', signature: 'test_static_folder_with_pathlib_path(app)', source: 'def test_static_folder_with_pathlib_path(app):\n    from pathlib import Path\n\n    app = flask.Flask(__name__, static_folder=Path("static"))\n    rv = app.test_client().open("/static/index.html", method="GET")\n    assert rv.status_code == 200\n    rv.close()', start: 1441, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 763}),
  (:Symbol {body_hash: '8f6ba9eff1ab1ddd', deleted: false, end: 1458, key: 'tests/test_basic.py::test_static_folder_with_ending_slash', kind: 'function', name: 'test_static_folder_with_ending_slash', path: 'tests/test_basic.py', qualname: 'test_static_folder_with_ending_slash', sig_hash: '4943fbd3d489f4fa', signature: 'test_static_folder_with_ending_slash()', source: 'def test_static_folder_with_ending_slash():\n    app = flask.Flask(__name__, static_folder="static/")\n\n    @app.route("/<path:path>")\n    def catch_all(path):\n        return path\n\n    rv = app.test_client().get("/catch/all")\n    assert rv.data == b"catch/all"', start: 1450, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 764}),
  (:Symbol {body_hash: 'ddec10138191925e', deleted: false, end: 1479, key: 'tests/test_basic.py::test_static_route_with_host_matching', kind: 'function', name: 'test_static_route_with_host_matching', path: 'tests/test_basic.py', qualname: 'test_static_route_with_host_matching', sig_hash: '4943fbd3d489f4fa', signature: 'test_static_route_with_host_matching()', source: 'def test_static_route_with_host_matching():\n    app = flask.Flask(__name__, host_matching=True, static_host="example.com")\n    c = app.test_client()\n    rv = c.get("http://example.com/static/index.html")\n    assert rv.status_code == 200\n    rv.close()\n    with app.test_request_context():\n        rv = flask.url_for("static", filename="index.html", _external=True)\n        assert rv == "http://example.com/static/index.html"\n    # Providing static_host without host_matching=True should error.\n    with pytest.raises(AssertionError):\n        flask.Flask(__name__, static_host="example.com")\n    # Providing host_matching=True with static_folder\n    # but without static_host should error.\n    with pytest.raises(AssertionError):\n        flask.Flask(__name__, host_matching=True)\n    # Providing host_matching=True without static_host\n    # but with static_folder=None should not error.\n    flask.Flask(__name__, host_matching=True, static_folder=None)', start: 1461, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 765}),
  (:Symbol {body_hash: '4726f2258c6be4ad', deleted: false, end: 1484, key: 'tests/test_basic.py::test_request_locals', kind: 'function', name: 'test_request_locals', path: 'tests/test_basic.py', qualname: 'test_request_locals', sig_hash: '4943fbd3d489f4fa', signature: 'test_request_locals()', source: 'def test_request_locals():\n    assert repr(flask.g) == "<LocalProxy unbound>"\n    assert not flask.g', start: 1482, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 766}),
  (:Symbol {body_hash: '797811fc75af6a7b', deleted: false, end: 1571, key: 'tests/test_basic.py::test_server_name_subdomain', kind: 'function', name: 'test_server_name_subdomain', path: 'tests/test_basic.py', qualname: 'test_server_name_subdomain', sig_hash: '4943fbd3d489f4fa', signature: 'test_server_name_subdomain()', source: 'def test_server_name_subdomain():\n    app = flask.Flask(__name__, subdomain_matching=True)\n    client = app.test_client()\n\n    @app.route("/")\n    def index():\n        return "default"\n\n    @app.route("/", subdomain="foo")\n    def subdomain():\n        return "subdomain"\n\n    app.config["SERVER_NAME"] = "dev.local:5000"\n    rv = client.get("/")\n    assert rv.data == b"default"\n\n    rv = client.get("/", "http://dev.local:5000")\n    assert rv.data == b"default"\n\n    rv = client.get("/", "https://dev.local:5000")\n    assert rv.data == b"default"\n\n    app.config["SERVER_NAME"] = "dev.local:443"\n    rv = client.get("/", "https://dev.local")\n\n    # Werkzeug 1.0 fixes matching https scheme with 443 port\n    if rv.status_code != 404:\n        assert rv.data == b"default"\n\n    app.config["SERVER_NAME"] = "dev.local"\n    rv = client.get("/", "https://dev.local")\n    assert rv.data == b"default"\n\n    # suppress Werkzeug 0.15 warning about name mismatch\n    with warnings.catch_warnings():\n        warnings.filterwarnings(\n            "ignore", "Current server name", UserWarning, "flask.app"\n        )\n        rv = client.get("/", "http://foo.localhost")\n        assert rv.status_code == 404\n\n    rv = client.get("/", "http://foo.dev.local")\n    assert rv.data == b"subdomain"', start: 1529, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 767}),
  (:Symbol {body_hash: 'f59a2c8842534e48', deleted: false, end: 1588, key: 'tests/test_basic.py::test_exception_propagation', kind: 'function', name: 'test_exception_propagation', path: 'tests/test_basic.py', qualname: 'test_exception_propagation', sig_hash: '7aa6f3d07f6b8f87', signature: 'test_exception_propagation(app, client, key)', source: '@pytest.mark.parametrize("key", ["TESTING", "PROPAGATE_EXCEPTIONS", "DEBUG", None])\ndef test_exception_propagation(app, client, key):\n    app.testing = False\n\n    @app.route("/")\n    def index():\n        raise ZeroDivisionError\n\n    if key is not None:\n        app.config[key] = True\n\n        with pytest.raises(ZeroDivisionError):\n            client.get("/")\n    else:\n        assert client.get("/").status_code == 500', start: 1575, tick: 5, types_hash: '20f7eedcf28162ed', _vid: 768}),
  (:Symbol {body_hash: 'fb405c83022ffa3a', deleted: false, end: 1606, key: 'tests/test_basic.py::test_werkzeug_passthrough_errors', kind: 'function', name: 'test_werkzeug_passthrough_errors', path: 'tests/test_basic.py', qualname: 'test_werkzeug_passthrough_errors', sig_hash: 'ffe2d1884b614003', signature: 'test_werkzeug_passthrough_errors(monkeypatch, debug, use_debugger, use_reloader, propagate_exceptions, app)', source: '@pytest.mark.parametrize("debug", [True, False])\n@pytest.mark.parametrize("use_debugger", [True, False])\n@pytest.mark.parametrize("use_reloader", [True, False])\n@pytest.mark.parametrize("propagate_exceptions", [None, True, False])\ndef test_werkzeug_passthrough_errors(\n    monkeypatch, debug, use_debugger, use_reloader, propagate_exceptions, app\n):\n    rv = {}\n\n    # Mocks werkzeug.serving.run_simple method\n    def run_simple_mock(*args, **kwargs):\n        rv["passthrough_errors"] = kwargs.get("passthrough_errors")\n\n    monkeypatch.setattr(werkzeug.serving, "run_simple", run_simple_mock)\n    app.config["PROPAGATE_EXCEPTIONS"] = propagate_exceptions\n    app.run(debug=debug, use_debugger=use_debugger, use_reloader=use_reloader)', start: 1595, tick: 5, types_hash: '5960a453ffe6e38a', _vid: 769}),
  (:Symbol {body_hash: '05789911900ce890', deleted: true, deleted_tick: 5, end: 1534, key: 'tests/test_basic.py::test_max_content_length', kind: 'function', name: 'test_max_content_length', path: 'tests/test_basic.py', qualname: 'test_max_content_length', sig_hash: 'df6ec3162cad163f', signature: 'test_max_content_length(app, client)', source: 'def test_max_content_length(app, client):\n    app.config["MAX_CONTENT_LENGTH"] = 64\n\n    @app.before_request\n    def always_first():\n        flask.request.form["myfile"]\n        AssertionError()\n\n    @app.route("/accept", methods=["POST"])\n    def accept_file():\n        flask.request.form["myfile"]\n        AssertionError()\n\n    @app.errorhandler(413)\n    def catcher(error):\n        return "42"\n\n    rv = client.post("/accept", data={"myfile": "foo" * 100})\n    assert rv.data == b"42"', start: 1516, tick: 1, types_hash: '95304b3d97188d9c', _vid: 770}),
  (:Symbol {body_hash: 'b90a47f82a3bcd0e', deleted: false, end: 1635, key: 'tests/test_basic.py::test_url_processors', kind: 'function', name: 'test_url_processors', path: 'tests/test_basic.py', qualname: 'test_url_processors', sig_hash: 'df6ec3162cad163f', signature: 'test_url_processors(app, client)', source: 'def test_url_processors(app, client):\n    @app.url_defaults\n    def add_language_code(endpoint, values):\n        if flask.g.lang_code is not None and app.url_map.is_endpoint_expecting(\n            endpoint, "lang_code"\n        ):\n            values.setdefault("lang_code", flask.g.lang_code)\n\n    @app.url_value_preprocessor\n    def pull_lang_code(endpoint, values):\n        flask.g.lang_code = values.pop("lang_code", None)\n\n    @app.route("/<lang_code>/")\n    def index():\n        return flask.url_for("about")\n\n    @app.route("/<lang_code>/about")\n    def about():\n        return flask.url_for("something_else")\n\n    @app.route("/foo")\n    def something_else():\n        return flask.url_for("about", lang_code="en")\n\n    assert client.get("/de/").data == b"/de/about"\n    assert client.get("/de/about").data == b"/foo"\n    assert client.get("/foo").data == b"/en/about"', start: 1609, tick: 5, types_hash: '95304b3d97188d9c', _vid: 771}),
  (:Symbol {body_hash: '083c3953114c08cf', deleted: false, end: 1659, key: 'tests/test_basic.py::test_inject_blueprint_url_defaults', kind: 'function', name: 'test_inject_blueprint_url_defaults', path: 'tests/test_basic.py', qualname: 'test_inject_blueprint_url_defaults', sig_hash: '462ce794eb370ded', signature: 'test_inject_blueprint_url_defaults(app)', source: 'def test_inject_blueprint_url_defaults(app):\n    bp = flask.Blueprint("foo", __name__, template_folder="template")\n\n    @bp.url_defaults\n    def bp_defaults(endpoint, values):\n        values["page"] = "login"\n\n    @bp.route("/<page>")\n    def view(page):\n        pass\n\n    app.register_blueprint(bp)\n\n    values = dict()\n    app.inject_url_defaults("foo.view", values)\n    expected = dict(page="login")\n    assert values == expected\n\n    with app.test_request_context("/somepage"):\n        url = flask.url_for("foo.view")\n    expected = "/login"\n    assert url == expected', start: 1638, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 772}),
  (:Symbol {body_hash: '3fb171269644af40', deleted: false, end: 1668, key: 'tests/test_basic.py::test_nonascii_pathinfo', kind: 'function', name: 'test_nonascii_pathinfo', path: 'tests/test_basic.py', qualname: 'test_nonascii_pathinfo', sig_hash: 'df6ec3162cad163f', signature: 'test_nonascii_pathinfo(app, client)', source: 'def test_nonascii_pathinfo(app, client):\n    @app.route("/киртест")\n    def index():\n        return "Hello World!"\n\n    rv = client.get("/киртест")\n    assert rv.data == b"Hello World!"', start: 1662, tick: 5, types_hash: '95304b3d97188d9c', _vid: 773}),
  (:Symbol {body_hash: '1c55ce692d8e4aa7', deleted: false, end: 1683, key: 'tests/test_basic.py::test_no_setup_after_first_request', kind: 'function', name: 'test_no_setup_after_first_request', path: 'tests/test_basic.py', qualname: 'test_no_setup_after_first_request', sig_hash: 'df6ec3162cad163f', signature: 'test_no_setup_after_first_request(app, client)', source: 'def test_no_setup_after_first_request(app, client):\n    app.debug = True\n\n    @app.route("/")\n    def index():\n        return "Awesome"\n\n    assert client.get("/").data == b"Awesome"\n\n    with pytest.raises(AssertionError) as exc_info:\n        app.add_url_rule("/foo", endpoint="late")\n\n    assert "setup method \'add_url_rule\'" in str(exc_info.value)', start: 1671, tick: 5, types_hash: '95304b3d97188d9c', _vid: 774}),
  (:Symbol {body_hash: '800028a4f8d121d9', deleted: false, end: 1703, key: 'tests/test_basic.py::test_routing_redirect_debugging', kind: 'function', name: 'test_routing_redirect_debugging', path: 'tests/test_basic.py', qualname: 'test_routing_redirect_debugging', sig_hash: '55d1d20927c8c044', signature: 'test_routing_redirect_debugging(monkeypatch, app, client)', source: 'def test_routing_redirect_debugging(monkeypatch, app, client):\n    app.config["DEBUG"] = True\n\n    @app.route("/user/", methods=["GET", "POST"])\n    def user():\n        return flask.request.form["status"]\n\n    # default redirect code preserves form data\n    rv = client.post("/user", data={"status": "success"}, follow_redirects=True)\n    assert rv.data == b"success"\n\n    # 301 and 302 raise error\n    monkeypatch.setattr(RequestRedirect, "code", 301)\n\n    with client, pytest.raises(AssertionError) as exc_info:\n        client.post("/user", data={"status": "error"}, follow_redirects=True)\n\n    assert "canonical URL \'http://localhost/user/\'" in str(exc_info.value)', start: 1686, tick: 5, types_hash: 'a7ba8be7519c197e', _vid: 775}),
  (:Symbol {body_hash: '2f0e3c9830159b8a', deleted: false, end: 1728, key: 'tests/test_basic.py::test_route_decorator_custom_endpoint', kind: 'function', name: 'test_route_decorator_custom_endpoint', path: 'tests/test_basic.py', qualname: 'test_route_decorator_custom_endpoint', sig_hash: 'df6ec3162cad163f', signature: 'test_route_decorator_custom_endpoint(app, client)', source: 'def test_route_decorator_custom_endpoint(app, client):\n    app.debug = True\n\n    @app.route("/foo/")\n    def foo():\n        return flask.request.endpoint\n\n    @app.route("/bar/", endpoint="bar")\n    def for_bar():\n        return flask.request.endpoint\n\n    @app.route("/bar/123", endpoint="123")\n    def for_bar_foo():\n        return flask.request.endpoint\n\n    with app.test_request_context():\n        assert flask.url_for("foo") == "/foo/"\n        assert flask.url_for("bar") == "/bar/"\n        assert flask.url_for("123") == "/bar/123"\n\n    assert client.get("/foo/").data == b"foo"\n    assert client.get("/bar/").data == b"bar"\n    assert client.get("/bar/123").data == b"123"', start: 1706, tick: 5, types_hash: '95304b3d97188d9c', _vid: 776}),
  (:Symbol {body_hash: 'ec19adf90f846a2e', deleted: false, end: 1736, key: 'tests/test_basic.py::test_get_method_on_g', kind: 'function', name: 'test_get_method_on_g', path: 'tests/test_basic.py', qualname: 'test_get_method_on_g', sig_hash: '30f36914758edd3f', signature: 'test_get_method_on_g(app_ctx)', source: 'def test_get_method_on_g(app_ctx):\n    assert flask.g.get("x") is None\n    assert flask.g.get("x", 11) == 11\n    flask.g.x = 42\n    assert flask.g.get("x") == 42\n    assert flask.g.x == 42', start: 1731, tick: 5, types_hash: '9c609209fa2b38dc', _vid: 777}),
  (:Symbol {body_hash: '18d8c4f94b98bd5c', deleted: false, end: 1744, key: 'tests/test_basic.py::test_g_iteration_protocol', kind: 'function', name: 'test_g_iteration_protocol', path: 'tests/test_basic.py', qualname: 'test_g_iteration_protocol', sig_hash: '30f36914758edd3f', signature: 'test_g_iteration_protocol(app_ctx)', source: 'def test_g_iteration_protocol(app_ctx):\n    flask.g.foo = 23\n    flask.g.bar = 42\n    assert "foo" in flask.g\n    assert "foos" not in flask.g\n    assert sorted(flask.g) == ["bar", "foo"]', start: 1739, tick: 5, types_hash: '9c609209fa2b38dc', _vid: 778}),
  (:Symbol {body_hash: '2269bedc4d27b1ee', deleted: false, end: 1764, key: 'tests/test_basic.py::test_subdomain_basic_support', kind: 'function', name: 'test_subdomain_basic_support', path: 'tests/test_basic.py', qualname: 'test_subdomain_basic_support', sig_hash: '4943fbd3d489f4fa', signature: 'test_subdomain_basic_support()', source: 'def test_subdomain_basic_support():\n    app = flask.Flask(__name__, subdomain_matching=True)\n    app.config["SERVER_NAME"] = "localhost.localdomain"\n    client = app.test_client()\n\n    @app.route("/")\n    def normal_index():\n        return "normal index"\n\n    @app.route("/", subdomain="test")\n    def test_index():\n        return "test index"\n\n    rv = client.get("/", "http://localhost.localdomain/")\n    assert rv.data == b"normal index"\n\n    rv = client.get("/", "http://test.localhost.localdomain/")\n    assert rv.data == b"test index"', start: 1747, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 779}),
  (:Symbol {body_hash: 'c696f644c32839ee', deleted: false, end: 1777, key: 'tests/test_basic.py::test_subdomain_matching', kind: 'function', name: 'test_subdomain_matching', path: 'tests/test_basic.py', qualname: 'test_subdomain_matching', sig_hash: '4943fbd3d489f4fa', signature: 'test_subdomain_matching()', source: 'def test_subdomain_matching():\n    app = flask.Flask(__name__, subdomain_matching=True)\n    client = app.test_client()\n    app.config["SERVER_NAME"] = "localhost.localdomain"\n\n    @app.route("/", subdomain="<user>")\n    def index(user):\n        return f"index for {user}"\n\n    rv = client.get("/", "http://mitsuhiko.localhost.localdomain/")\n    assert rv.data == b"index for mitsuhiko"', start: 1767, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 780}),
  (:Symbol {body_hash: '2cf114d3aa230f88', deleted: false, end: 1790, key: 'tests/test_basic.py::test_subdomain_matching_with_ports', kind: 'function', name: 'test_subdomain_matching_with_ports', path: 'tests/test_basic.py', qualname: 'test_subdomain_matching_with_ports', sig_hash: '4943fbd3d489f4fa', signature: 'test_subdomain_matching_with_ports()', source: 'def test_subdomain_matching_with_ports():\n    app = flask.Flask(__name__, subdomain_matching=True)\n    app.config["SERVER_NAME"] = "localhost.localdomain:3000"\n    client = app.test_client()\n\n    @app.route("/", subdomain="<user>")\n    def index(user):\n        return f"index for {user}"\n\n    rv = client.get("/", "http://mitsuhiko.localhost.localdomain:3000/")\n    assert rv.data == b"index for mitsuhiko"', start: 1780, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 781}),
  (:Symbol {body_hash: 'ce687e162a1f53dd', deleted: false, end: 1814, key: 'tests/test_basic.py::test_subdomain_matching_other_name', kind: 'function', name: 'test_subdomain_matching_other_name', path: 'tests/test_basic.py', qualname: 'test_subdomain_matching_other_name', sig_hash: '2e5d3874f818d7ca', signature: 'test_subdomain_matching_other_name(matching)', source: '@pytest.mark.parametrize("matching", (False, True))\ndef test_subdomain_matching_other_name(matching):\n    app = flask.Flask(__name__, subdomain_matching=matching)\n    app.config["SERVER_NAME"] = "localhost.localdomain:3000"\n    client = app.test_client()\n\n    @app.route("/")\n    def index():\n        return "", 204\n\n    # suppress Werkzeug 0.15 warning about name mismatch\n    with warnings.catch_warnings():\n        warnings.filterwarnings(\n            "ignore", "Current server name", UserWarning, "flask.app"\n        )\n        # ip address can\'t match name\n        rv = client.get("/", "http://127.0.0.1:3000/")\n        assert rv.status_code == 404 if matching else 204\n\n    # allow all subdomains if matching is disabled\n    rv = client.get("/", "http://www.localhost.localdomain:3000/")\n    assert rv.status_code == 404 if matching else 204', start: 1794, tick: 5, types_hash: '7aee262ff37ed303', _vid: 782}),
  (:Symbol {body_hash: 'bf649ef557b26cfa', deleted: false, end: 1826, key: 'tests/test_basic.py::test_multi_route_rules', kind: 'function', name: 'test_multi_route_rules', path: 'tests/test_basic.py', qualname: 'test_multi_route_rules', sig_hash: 'df6ec3162cad163f', signature: 'test_multi_route_rules(app, client)', source: 'def test_multi_route_rules(app, client):\n    @app.route("/")\n    @app.route("/<test>/")\n    def index(test="a"):\n        return test\n\n    rv = client.open("/")\n    assert rv.data == b"a"\n    rv = client.open("/b/")\n    assert rv.data == b"b"', start: 1817, tick: 5, types_hash: '95304b3d97188d9c', _vid: 783}),
  (:Symbol {body_hash: '548bc54645570375', deleted: false, end: 1842, key: 'tests/test_basic.py::test_multi_route_class_views', kind: 'function', name: 'test_multi_route_class_views', path: 'tests/test_basic.py', qualname: 'test_multi_route_class_views', sig_hash: 'df6ec3162cad163f', signature: 'test_multi_route_class_views(app, client)', source: 'def test_multi_route_class_views(app, client):\n    class View:\n        def __init__(self, app):\n            app.add_url_rule("/", "index", self.index)\n            app.add_url_rule("/<test>/", "index", self.index)\n\n        def index(self, test="a"):\n            return test\n\n    _ = View(app)\n    rv = client.open("/")\n    assert rv.data == b"a"\n    rv = client.open("/b/")\n    assert rv.data == b"b"', start: 1829, tick: 5, types_hash: '95304b3d97188d9c', _vid: 784}),
  (:Symbol {body_hash: 'eb6dd72252456512', deleted: false, end: 1854, key: 'tests/test_basic.py::test_run_defaults', kind: 'function', name: 'test_run_defaults', path: 'tests/test_basic.py', qualname: 'test_run_defaults', sig_hash: '3f71d8b56c76eb2a', signature: 'test_run_defaults(monkeypatch, app)', source: 'def test_run_defaults(monkeypatch, app):\n    rv = {}\n\n    # Mocks werkzeug.serving.run_simple method\n    def run_simple_mock(*args, **kwargs):\n        rv["result"] = "running..."\n\n    monkeypatch.setattr(werkzeug.serving, "run_simple", run_simple_mock)\n    app.run()\n    assert rv["result"] == "running..."', start: 1845, tick: 5, types_hash: '147fd75ddc743f49', _vid: 785}),
  (:Symbol {body_hash: '7436742ffbb1e8d4', deleted: false, end: 1867, key: 'tests/test_basic.py::test_run_server_port', kind: 'function', name: 'test_run_server_port', path: 'tests/test_basic.py', qualname: 'test_run_server_port', sig_hash: '3f71d8b56c76eb2a', signature: 'test_run_server_port(monkeypatch, app)', source: 'def test_run_server_port(monkeypatch, app):\n    rv = {}\n\n    # Mocks werkzeug.serving.run_simple method\n    def run_simple_mock(hostname, port, application, *args, **kwargs):\n        rv["result"] = f"running on {hostname}:{port} ..."\n\n    monkeypatch.setattr(werkzeug.serving, "run_simple", run_simple_mock)\n    hostname, port = "localhost", 8000\n    app.run(hostname, port, debug=True)\n    assert rv["result"] == f"running on {hostname}:{port} ..."', start: 1857, tick: 5, types_hash: '147fd75ddc743f49', _vid: 786}),
  (:Symbol {body_hash: '1ca964166f3d6c2a', deleted: false, end: 1891, key: 'tests/test_basic.py::test_run_from_config', kind: 'function', name: 'test_run_from_config', path: 'tests/test_basic.py', qualname: 'test_run_from_config', sig_hash: '642e28439fd65733', signature: 'test_run_from_config(monkeypatch, host, port, server_name, expect_host, expect_port, app)', source: '@pytest.mark.parametrize(\n    "host,port,server_name,expect_host,expect_port",\n    (\n        (None, None, "pocoo.org:8080", "pocoo.org", 8080),\n        ("localhost", None, "pocoo.org:8080", "localhost", 8080),\n        (None, 80, "pocoo.org:8080", "pocoo.org", 80),\n        ("localhost", 80, "pocoo.org:8080", "localhost", 80),\n        ("localhost", 0, "localhost:8080", "localhost", 0),\n        (None, None, "localhost:8080", "localhost", 8080),\n        (None, None, "localhost:0", "localhost", 0),\n    ),\n)\ndef test_run_from_config(\n    monkeypatch, host, port, server_name, expect_host, expect_port, app\n):\n    def run_simple_mock(hostname, port, *args, **kwargs):\n        assert hostname == expect_host\n        assert port == expect_port\n\n    monkeypatch.setattr(werkzeug.serving, "run_simple", run_simple_mock)\n    app.config["SERVER_NAME"] = server_name\n    app.run(host, port)', start: 1882, tick: 5, types_hash: '0acc685f6b425f84', _vid: 787}),
  (:Symbol {body_hash: '984ada5b37407d49', deleted: false, end: 1921, key: 'tests/test_basic.py::test_max_cookie_size', kind: 'function', name: 'test_max_cookie_size', path: 'tests/test_basic.py', qualname: 'test_max_cookie_size', sig_hash: '4666b2be4be09e46', signature: 'test_max_cookie_size(app, client, recwarn)', source: 'def test_max_cookie_size(app, client, recwarn):\n    app.config["MAX_COOKIE_SIZE"] = 100\n\n    # outside app context, default to Werkzeug static value,\n    # which is also the default config\n    response = flask.Response()\n    default = flask.Flask.default_config["MAX_COOKIE_SIZE"]\n    assert response.max_cookie_size == default\n\n    # inside app context, use app config\n    with app.app_context():\n        assert flask.Response().max_cookie_size == 100\n\n    @app.route("/")\n    def index():\n        r = flask.Response("", status=204)\n        r.set_cookie("foo", "bar" * 100)\n        return r\n\n    client.get("/")\n    assert len(recwarn) == 1\n    w = recwarn.pop()\n    assert "cookie is too large" in str(w.message)\n\n    app.config["MAX_COOKIE_SIZE"] = 0\n\n    client.get("/")\n    assert len(recwarn) == 0', start: 1894, tick: 5, types_hash: '9ddc2d298d543517', _vid: 788}),
  (:Symbol {body_hash: '64705e1809ab44c6', deleted: false, end: 1937, key: 'tests/test_basic.py::test_app_freed_on_zero_refcount', kind: 'function', name: 'test_app_freed_on_zero_refcount', path: 'tests/test_basic.py', qualname: 'test_app_freed_on_zero_refcount', sig_hash: '4943fbd3d489f4fa', signature: 'test_app_freed_on_zero_refcount()', source: '@require_cpython_gc\ndef test_app_freed_on_zero_refcount():\n    # A Flask instance should not create a reference cycle that prevents CPython\n    # from freeing it when all external references to it are released (see #3761).\n    gc.disable()\n    try:\n        app = flask.Flask(__name__)\n        assert app.view_functions["static"]\n        weak = weakref.ref(app)\n        assert weak() is not None\n        del app\n        assert weak() is None\n    finally:\n        gc.enable()', start: 1925, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 789}),
  (:Symbol {body_hash: '944dd3e2f26d9970', deleted: false, end: 43, key: 'tests/test_blueprints.py::test_blueprint_specific_error_handling', kind: 'function', name: 'test_blueprint_specific_error_handling', path: 'tests/test_blueprints.py', qualname: 'test_blueprint_specific_error_handling', sig_hash: 'df6ec3162cad163f', signature: 'test_blueprint_specific_error_handling(app, client)', source: 'def test_blueprint_specific_error_handling(app, client):\n    frontend = flask.Blueprint("frontend", __name__)\n    backend = flask.Blueprint("backend", __name__)\n    sideend = flask.Blueprint("sideend", __name__)\n\n    @frontend.errorhandler(403)\n    def frontend_forbidden(e):\n        return "frontend says no", 403\n\n    @frontend.route("/frontend-no")\n    def frontend_no():\n        flask.abort(403)\n\n    @backend.errorhandler(403)\n    def backend_forbidden(e):\n        return "backend says no", 403\n\n    @backend.route("/backend-no")\n    def backend_no():\n        flask.abort(403)\n\n    @sideend.route("/what-is-a-sideend")\n    def sideend_no():\n        flask.abort(403)\n\n    app.register_blueprint(frontend)\n    app.register_blueprint(backend)\n    app.register_blueprint(sideend)\n\n    @app.errorhandler(403)\n    def app_forbidden(e):\n        return "application itself says no", 403\n\n    assert client.get("/frontend-no").data == b"frontend says no"\n    assert client.get("/backend-no").data == b"backend says no"\n    assert client.get("/what-is-a-sideend").data == b"application itself says no"', start: 8, tick: 5, types_hash: '95304b3d97188d9c', _vid: 790}),
  (:Symbol {body_hash: 'a4088973a925b485', deleted: false, end: 77, key: 'tests/test_blueprints.py::test_blueprint_specific_user_error_handling', kind: 'function', name: 'test_blueprint_specific_user_error_handling', path: 'tests/test_blueprints.py', qualname: 'test_blueprint_specific_user_error_handling', sig_hash: 'df6ec3162cad163f', signature: 'test_blueprint_specific_user_error_handling(app, client)', source: 'def test_blueprint_specific_user_error_handling(app, client):\n    class MyDecoratorException(Exception):\n        pass\n\n    class MyFunctionException(Exception):\n        pass\n\n    blue = flask.Blueprint("blue", __name__)\n\n    @blue.errorhandler(MyDecoratorException)\n    def my_decorator_exception_handler(e):\n        assert isinstance(e, MyDecoratorException)\n        return "boom"\n\n    def my_function_exception_handler(e):\n        assert isinstance(e, MyFunctionException)\n        return "bam"\n\n    blue.register_error_handler(MyFunctionException, my_function_exception_handler)\n\n    @blue.route("/decorator")\n    def blue_deco_test():\n        raise MyDecoratorException()\n\n    @blue.route("/function")\n    def blue_func_test():\n        raise MyFunctionException()\n\n    app.register_blueprint(blue)\n\n    assert client.get("/decorator").data == b"boom"\n    assert client.get("/function").data == b"bam"', start: 46, tick: 5, types_hash: '95304b3d97188d9c', _vid: 791}),
  (:Symbol {body_hash: '3baae20bcfe8ee8d', deleted: false, end: 101, key: 'tests/test_blueprints.py::test_blueprint_app_error_handling', kind: 'function', name: 'test_blueprint_app_error_handling', path: 'tests/test_blueprints.py', qualname: 'test_blueprint_app_error_handling', sig_hash: 'df6ec3162cad163f', signature: 'test_blueprint_app_error_handling(app, client)', source: 'def test_blueprint_app_error_handling(app, client):\n    errors = flask.Blueprint("errors", __name__)\n\n    @errors.app_errorhandler(403)\n    def forbidden_handler(e):\n        return "you shall not pass", 403\n\n    @app.route("/forbidden")\n    def app_forbidden():\n        flask.abort(403)\n\n    forbidden_bp = flask.Blueprint("forbidden_bp", __name__)\n\n    @forbidden_bp.route("/nope")\n    def bp_forbidden():\n        flask.abort(403)\n\n    app.register_blueprint(errors)\n    app.register_blueprint(forbidden_bp)\n\n    assert client.get("/forbidden").data == b"you shall not pass"\n    assert client.get("/nope").data == b"you shall not pass"', start: 80, tick: 5, types_hash: '95304b3d97188d9c', _vid: 792}),
  (:Symbol {body_hash: 'f61b9df21c79ae2a', deleted: false, end: 128, key: 'tests/test_blueprints.py::test_blueprint_prefix_slash', kind: 'function', name: 'test_blueprint_prefix_slash', path: 'tests/test_blueprints.py', qualname: 'test_blueprint_prefix_slash', sig_hash: '0a1deb17dec6fb6a', signature: 'test_blueprint_prefix_slash(app, client, prefix, rule, url)', source: '@pytest.mark.parametrize(\n    ("prefix", "rule", "url"),\n    (\n        ("", "/", "/"),\n        ("/", "", "/"),\n        ("/", "/", "/"),\n        ("/foo", "", "/foo"),\n        ("/foo/", "", "/foo/"),\n        ("", "/bar", "/bar"),\n        ("/foo/", "/bar", "/foo/bar"),\n        ("/foo/", "bar", "/foo/bar"),\n        ("/foo", "/bar", "/foo/bar"),\n        ("/foo/", "//bar", "/foo/bar"),\n        ("/foo//", "/bar", "/foo/bar"),\n    ),\n)\ndef test_blueprint_prefix_slash(app, client, prefix, rule, url):\n    bp = flask.Blueprint("test", __name__, url_prefix=prefix)\n\n    @bp.route(rule)\n    def index():\n        return "", 204\n\n    app.register_blueprint(bp)\n    assert client.get(url).status_code == 204', start: 120, tick: 5, types_hash: '94c3f940edd6702b', _vid: 793}),
  (:Symbol {body_hash: '6afe765b92545216', deleted: false, end: 148, key: 'tests/test_blueprints.py::test_blueprint_url_defaults', kind: 'function', name: 'test_blueprint_url_defaults', path: 'tests/test_blueprints.py', qualname: 'test_blueprint_url_defaults', sig_hash: 'df6ec3162cad163f', signature: 'test_blueprint_url_defaults(app, client)', source: 'def test_blueprint_url_defaults(app, client):\n    bp = flask.Blueprint("test", __name__)\n\n    @bp.route("/foo", defaults={"baz": 42})\n    def foo(bar, baz):\n        return f"{bar}/{baz:d}"\n\n    @bp.route("/bar")\n    def bar(bar):\n        return str(bar)\n\n    app.register_blueprint(bp, url_prefix="/1", url_defaults={"bar": 23})\n    app.register_blueprint(bp, name="test2", url_prefix="/2", url_defaults={"bar": 19})\n\n    assert client.get("/1/foo").data == b"23/42"\n    assert client.get("/2/foo").data == b"19/42"\n    assert client.get("/1/bar").data == b"23"\n    assert client.get("/2/bar").data == b"19"', start: 131, tick: 5, types_hash: '95304b3d97188d9c', _vid: 794}),
  (:Symbol {body_hash: 'f16869fcc3102f88', deleted: false, end: 173, key: 'tests/test_blueprints.py::test_blueprint_url_processors', kind: 'function', name: 'test_blueprint_url_processors', path: 'tests/test_blueprints.py', qualname: 'test_blueprint_url_processors', sig_hash: 'df6ec3162cad163f', signature: 'test_blueprint_url_processors(app, client)', source: 'def test_blueprint_url_processors(app, client):\n    bp = flask.Blueprint("frontend", __name__, url_prefix="/<lang_code>")\n\n    @bp.url_defaults\n    def add_language_code(endpoint, values):\n        values.setdefault("lang_code", flask.g.lang_code)\n\n    @bp.url_value_preprocessor\n    def pull_lang_code(endpoint, values):\n        flask.g.lang_code = values.pop("lang_code")\n\n    @bp.route("/")\n    def index():\n        return flask.url_for(".about")\n\n    @bp.route("/about")\n    def about():\n        return flask.url_for(".index")\n\n    app.register_blueprint(bp)\n\n    assert client.get("/de/").data == b"/de/about"\n    assert client.get("/de/about").data == b"/de/"', start: 151, tick: 5, types_hash: '95304b3d97188d9c', _vid: 795}),
  (:Symbol {body_hash: '05f081e115c452e0', deleted: false, end: 220, key: 'tests/test_blueprints.py::test_templates_and_static', kind: 'function', name: 'test_templates_and_static', path: 'tests/test_blueprints.py', qualname: 'test_templates_and_static', sig_hash: '937937a61f63cb91', signature: 'test_templates_and_static(test_apps)', source: 'def test_templates_and_static(test_apps):\n    from blueprintapp import app\n\n    client = app.test_client()\n\n    rv = client.get("/")\n    assert rv.data == b"Hello from the Frontend"\n    rv = client.get("/admin/")\n    assert rv.data == b"Hello from the Admin"\n    rv = client.get("/admin/index2")\n    assert rv.data == b"Hello from the Admin"\n    rv = client.get("/admin/static/test.txt")\n    assert rv.data.strip() == b"Admin File"\n    rv.close()\n    rv = client.get("/admin/static/css/test.css")\n    assert rv.data.strip() == b"/* nested file */"\n    rv.close()\n\n    # try/finally, in case other tests use this app for Blueprint tests.\n    max_age_default = app.config["SEND_FILE_MAX_AGE_DEFAULT"]\n    try:\n        expected_max_age = 3600\n        if app.config["SEND_FILE_MAX_AGE_DEFAULT"] == expected_max_age:\n            expected_max_age = 7200\n        app.config["SEND_FILE_MAX_AGE_DEFAULT"] = expected_max_age\n        rv = client.get("/admin/static/css/test.css")\n        cc = parse_cache_control_header(rv.headers["Cache-Control"])\n        assert cc.max_age == expected_max_age\n        rv.close()\n    finally:\n        app.config["SEND_FILE_MAX_AGE_DEFAULT"] = max_age_default\n\n    with app.test_request_context():\n        assert (\n            flask.url_for("admin.static", filename="test.txt")\n            == "/admin/static/test.txt"\n        )\n\n    with app.test_request_context():\n        with pytest.raises(TemplateNotFound) as e:\n            flask.render_template("missing.html")\n        ass\n…', start: 176, tick: 5, types_hash: '56a10b38091a5073', _vid: 796}),
  (:Symbol {body_hash: 'ba65ad79e8e7ce82', deleted: false, end: 244, key: 'tests/test_blueprints.py::test_default_static_max_age', kind: 'function', name: 'test_default_static_max_age', path: 'tests/test_blueprints.py', qualname: 'test_default_static_max_age', sig_hash: '462ce794eb370ded', signature: 'test_default_static_max_age(app)', source: 'def test_default_static_max_age(app):\n    class MyBlueprint(flask.Blueprint):\n        def get_send_file_max_age(self, filename):\n            return 100\n\n    blueprint = MyBlueprint("blueprint", __name__, static_folder="static")\n    app.register_blueprint(blueprint)\n\n    # try/finally, in case other tests use this app for Blueprint tests.\n    max_age_default = app.config["SEND_FILE_MAX_AGE_DEFAULT"]\n    try:\n        with app.test_request_context():\n            unexpected_max_age = 3600\n            if app.config["SEND_FILE_MAX_AGE_DEFAULT"] == unexpected_max_age:\n                unexpected_max_age = 7200\n            app.config["SEND_FILE_MAX_AGE_DEFAULT"] = unexpected_max_age\n            rv = blueprint.send_static_file("index.html")\n            cc = parse_cache_control_header(rv.headers["Cache-Control"])\n            assert cc.max_age == 100\n            rv.close()\n    finally:\n        app.config["SEND_FILE_MAX_AGE_DEFAULT"] = max_age_default', start: 223, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 797}),
  (:Symbol {body_hash: 'edde7bf32901e537', deleted: false, end: 251, key: 'tests/test_blueprints.py::test_templates_list', kind: 'function', name: 'test_templates_list', path: 'tests/test_blueprints.py', qualname: 'test_templates_list', sig_hash: '937937a61f63cb91', signature: 'test_templates_list(test_apps)', source: 'def test_templates_list(test_apps):\n    from blueprintapp import app\n\n    templates = sorted(app.jinja_env.list_templates())\n    assert templates == ["admin/index.html", "frontend/index.html"]', start: 247, tick: 5, types_hash: '56a10b38091a5073', _vid: 798}),
  (:Symbol {body_hash: '93e038e312be3d1b', deleted: false, end: 256, key: 'tests/test_blueprints.py::test_dotted_name_not_allowed', kind: 'function', name: 'test_dotted_name_not_allowed', path: 'tests/test_blueprints.py', qualname: 'test_dotted_name_not_allowed', sig_hash: 'df6ec3162cad163f', signature: 'test_dotted_name_not_allowed(app, client)', source: 'def test_dotted_name_not_allowed(app, client):\n    with pytest.raises(ValueError):\n        flask.Blueprint("app.ui", __name__)', start: 254, tick: 5, types_hash: '95304b3d97188d9c', _vid: 799});
CREATE (:Symbol {body_hash: '4d7b9acbef7a1090', deleted: false, end: 261, key: 'tests/test_blueprints.py::test_empty_name_not_allowed', kind: 'function', name: 'test_empty_name_not_allowed', path: 'tests/test_blueprints.py', qualname: 'test_empty_name_not_allowed', sig_hash: 'df6ec3162cad163f', signature: 'test_empty_name_not_allowed(app, client)', source: 'def test_empty_name_not_allowed(app, client):\n    with pytest.raises(ValueError):\n        flask.Blueprint("", __name__)', start: 259, tick: 5, types_hash: '95304b3d97188d9c', _vid: 800}),
  (:Symbol {body_hash: 'bdc71ae0a4810be4', deleted: false, end: 278, key: 'tests/test_blueprints.py::test_dotted_names_from_app', kind: 'function', name: 'test_dotted_names_from_app', path: 'tests/test_blueprints.py', qualname: 'test_dotted_names_from_app', sig_hash: 'df6ec3162cad163f', signature: 'test_dotted_names_from_app(app, client)', source: 'def test_dotted_names_from_app(app, client):\n    test = flask.Blueprint("test", __name__)\n\n    @app.route("/")\n    def app_index():\n        return flask.url_for("test.index")\n\n    @test.route("/test/")\n    def index():\n        return flask.url_for("app_index")\n\n    app.register_blueprint(test)\n\n    rv = client.get("/")\n    assert rv.data == b"/test/"', start: 264, tick: 5, types_hash: '95304b3d97188d9c', _vid: 801}),
  (:Symbol {body_hash: '36d5eee93178463a', deleted: false, end: 292, key: 'tests/test_blueprints.py::test_empty_url_defaults', kind: 'function', name: 'test_empty_url_defaults', path: 'tests/test_blueprints.py', qualname: 'test_empty_url_defaults', sig_hash: 'df6ec3162cad163f', signature: 'test_empty_url_defaults(app, client)', source: 'def test_empty_url_defaults(app, client):\n    bp = flask.Blueprint("bp", __name__)\n\n    @bp.route("/", defaults={"page": 1})\n    @bp.route("/page/<int:page>")\n    def something(page):\n        return str(page)\n\n    app.register_blueprint(bp)\n\n    assert client.get("/").data == b"1"\n    assert client.get("/page/2").data == b"2"', start: 281, tick: 5, types_hash: '95304b3d97188d9c', _vid: 802}),
  (:Symbol {body_hash: '01352f003cfc09c0', deleted: false, end: 324, key: 'tests/test_blueprints.py::test_route_decorator_custom_endpoint', kind: 'function', name: 'test_route_decorator_custom_endpoint', path: 'tests/test_blueprints.py', qualname: 'test_route_decorator_custom_endpoint', sig_hash: 'df6ec3162cad163f', signature: 'test_route_decorator_custom_endpoint(app, client)', source: 'def test_route_decorator_custom_endpoint(app, client):\n    bp = flask.Blueprint("bp", __name__)\n\n    @bp.route("/foo")\n    def foo():\n        return flask.request.endpoint\n\n    @bp.route("/bar", endpoint="bar")\n    def foo_bar():\n        return flask.request.endpoint\n\n    @bp.route("/bar/123", endpoint="123")\n    def foo_bar_foo():\n        return flask.request.endpoint\n\n    @bp.route("/bar/foo")\n    def bar_foo():\n        return flask.request.endpoint\n\n    app.register_blueprint(bp, url_prefix="/py")\n\n    @app.route("/")\n    def index():\n        return flask.request.endpoint\n\n    assert client.get("/").data == b"index"\n    assert client.get("/py/foo").data == b"bp.foo"\n    assert client.get("/py/bar").data == b"bp.bar"\n    assert client.get("/py/bar/123").data == b"bp.123"\n    assert client.get("/py/bar/foo").data == b"bp.bar_foo"', start: 295, tick: 5, types_hash: '95304b3d97188d9c', _vid: 803}),
  (:Symbol {body_hash: 'e61e8053aa52f39a', deleted: false, end: 342, key: 'tests/test_blueprints.py::test_route_decorator_custom_endpoint_with_dots', kind: 'function', name: 'test_route_decorator_custom_endpoint_with_dots', path: 'tests/test_blueprints.py', qualname: 'test_route_decorator_custom_endpoint_with_dots', sig_hash: 'df6ec3162cad163f', signature: 'test_route_decorator_custom_endpoint_with_dots(app, client)', source: 'def test_route_decorator_custom_endpoint_with_dots(app, client):\n    bp = flask.Blueprint("bp", __name__)\n\n    with pytest.raises(ValueError):\n        bp.route("/", endpoint="a.b")(lambda: "")\n\n    with pytest.raises(ValueError):\n        bp.add_url_rule("/", endpoint="a.b")\n\n    def view():\n        return ""\n\n    view.__name__ = "a.b"\n\n    with pytest.raises(ValueError):\n        bp.add_url_rule("/", view_func=view)', start: 327, tick: 5, types_hash: '95304b3d97188d9c', _vid: 804}),
  (:Symbol {body_hash: 'c1128e6724e9c682', deleted: false, end: 359, key: 'tests/test_blueprints.py::test_endpoint_decorator', kind: 'function', name: 'test_endpoint_decorator', path: 'tests/test_blueprints.py', qualname: 'test_endpoint_decorator', sig_hash: 'df6ec3162cad163f', signature: 'test_endpoint_decorator(app, client)', source: 'def test_endpoint_decorator(app, client):\n    from werkzeug.routing import Rule\n\n    app.url_map.add(Rule("/foo", endpoint="bar"))\n\n    bp = flask.Blueprint("bp", __name__)\n\n    @bp.endpoint("bar")\n    def foobar():\n        return flask.request.endpoint\n\n    app.register_blueprint(bp, url_prefix="/bp_prefix")\n\n    assert client.get("/foo").data == b"bar"\n    assert client.get("/bp_prefix/bar").status_code == 404', start: 345, tick: 5, types_hash: '95304b3d97188d9c', _vid: 805}),
  (:Symbol {body_hash: '23709cbb7b8aec4e', deleted: false, end: 372, key: 'tests/test_blueprints.py::test_template_filter', kind: 'function', name: 'test_template_filter', path: 'tests/test_blueprints.py', qualname: 'test_template_filter', sig_hash: '462ce794eb370ded', signature: 'test_template_filter(app)', source: 'def test_template_filter(app):\n    bp = flask.Blueprint("bp", __name__)\n\n    @bp.app_template_filter()\n    def my_reverse(s):\n        return s[::-1]\n\n    app.register_blueprint(bp, url_prefix="/py")\n    assert "my_reverse" in app.jinja_env.filters.keys()\n    assert app.jinja_env.filters["my_reverse"] == my_reverse\n    assert app.jinja_env.filters["my_reverse"]("abcd") == "dcba"', start: 362, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 806}),
  (:Symbol {body_hash: 'cd6e9307223085f2', deleted: false, end: 385, key: 'tests/test_blueprints.py::test_add_template_filter', kind: 'function', name: 'test_add_template_filter', path: 'tests/test_blueprints.py', qualname: 'test_add_template_filter', sig_hash: '462ce794eb370ded', signature: 'test_add_template_filter(app)', source: 'def test_add_template_filter(app):\n    bp = flask.Blueprint("bp", __name__)\n\n    def my_reverse(s):\n        return s[::-1]\n\n    bp.add_app_template_filter(my_reverse)\n    app.register_blueprint(bp, url_prefix="/py")\n    assert "my_reverse" in app.jinja_env.filters.keys()\n    assert app.jinja_env.filters["my_reverse"] == my_reverse\n    assert app.jinja_env.filters["my_reverse"]("abcd") == "dcba"', start: 375, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 807}),
  (:Symbol {body_hash: '67c9cf219228ff1c', deleted: false, end: 398, key: 'tests/test_blueprints.py::test_template_filter_with_name', kind: 'function', name: 'test_template_filter_with_name', path: 'tests/test_blueprints.py', qualname: 'test_template_filter_with_name', sig_hash: '462ce794eb370ded', signature: 'test_template_filter_with_name(app)', source: 'def test_template_filter_with_name(app):\n    bp = flask.Blueprint("bp", __name__)\n\n    @bp.app_template_filter("strrev")\n    def my_reverse(s):\n        return s[::-1]\n\n    app.register_blueprint(bp, url_prefix="/py")\n    assert "strrev" in app.jinja_env.filters.keys()\n    assert app.jinja_env.filters["strrev"] == my_reverse\n    assert app.jinja_env.filters["strrev"]("abcd") == "dcba"', start: 388, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 808}),
  (:Symbol {body_hash: '1b6dfef141708c49', deleted: false, end: 411, key: 'tests/test_blueprints.py::test_add_template_filter_with_name', kind: 'function', name: 'test_add_template_filter_with_name', path: 'tests/test_blueprints.py', qualname: 'test_add_template_filter_with_name', sig_hash: '462ce794eb370ded', signature: 'test_add_template_filter_with_name(app)', source: 'def test_add_template_filter_with_name(app):\n    bp = flask.Blueprint("bp", __name__)\n\n    def my_reverse(s):\n        return s[::-1]\n\n    bp.add_app_template_filter(my_reverse, "strrev")\n    app.register_blueprint(bp, url_prefix="/py")\n    assert "strrev" in app.jinja_env.filters.keys()\n    assert app.jinja_env.filters["strrev"] == my_reverse\n    assert app.jinja_env.filters["strrev"]("abcd") == "dcba"', start: 401, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 809}),
  (:Symbol {body_hash: 'ef53432d0ceac2b2', deleted: false, end: 428, key: 'tests/test_blueprints.py::test_template_filter_with_template', kind: 'function', name: 'test_template_filter_with_template', path: 'tests/test_blueprints.py', qualname: 'test_template_filter_with_template', sig_hash: 'df6ec3162cad163f', signature: 'test_template_filter_with_template(app, client)', source: 'def test_template_filter_with_template(app, client):\n    bp = flask.Blueprint("bp", __name__)\n\n    @bp.app_template_filter()\n    def super_reverse(s):\n        return s[::-1]\n\n    app.register_blueprint(bp, url_prefix="/py")\n\n    @app.route("/")\n    def index():\n        return flask.render_template("template_filter.html", value="abcd")\n\n    rv = client.get("/")\n    assert rv.data == b"dcba"', start: 414, tick: 5, types_hash: '95304b3d97188d9c', _vid: 810}),
  (:Symbol {body_hash: '6bd771d7f6ae373a', deleted: false, end: 444, key: 'tests/test_blueprints.py::test_template_filter_after_route_with_template', kind: 'function', name: 'test_template_filter_after_route_with_template', path: 'tests/test_blueprints.py', qualname: 'test_template_filter_after_route_with_template', sig_hash: 'df6ec3162cad163f', signature: 'test_template_filter_after_route_with_template(app, client)', source: 'def test_template_filter_after_route_with_template(app, client):\n    @app.route("/")\n    def index():\n        return flask.render_template("template_filter.html", value="abcd")\n\n    bp = flask.Blueprint("bp", __name__)\n\n    @bp.app_template_filter()\n    def super_reverse(s):\n        return s[::-1]\n\n    app.register_blueprint(bp, url_prefix="/py")\n    rv = client.get("/")\n    assert rv.data == b"dcba"', start: 431, tick: 5, types_hash: '95304b3d97188d9c', _vid: 811}),
  (:Symbol {body_hash: 'a7fe3190339bf26d', deleted: false, end: 461, key: 'tests/test_blueprints.py::test_add_template_filter_with_template', kind: 'function', name: 'test_add_template_filter_with_template', path: 'tests/test_blueprints.py', qualname: 'test_add_template_filter_with_template', sig_hash: 'df6ec3162cad163f', signature: 'test_add_template_filter_with_template(app, client)', source: 'def test_add_template_filter_with_template(app, client):\n    bp = flask.Blueprint("bp", __name__)\n\n    def super_reverse(s):\n        return s[::-1]\n\n    bp.add_app_template_filter(super_reverse)\n    app.register_blueprint(bp, url_prefix="/py")\n\n    @app.route("/")\n    def index():\n        return flask.render_template("template_filter.html", value="abcd")\n\n    rv = client.get("/")\n    assert rv.data == b"dcba"', start: 447, tick: 5, types_hash: '95304b3d97188d9c', _vid: 812}),
  (:Symbol {body_hash: 'a040d63523219e45', deleted: false, end: 478, key: 'tests/test_blueprints.py::test_template_filter_with_name_and_template', kind: 'function', name: 'test_template_filter_with_name_and_template', path: 'tests/test_blueprints.py', qualname: 'test_template_filter_with_name_and_template', sig_hash: 'df6ec3162cad163f', signature: 'test_template_filter_with_name_and_template(app, client)', source: 'def test_template_filter_with_name_and_template(app, client):\n    bp = flask.Blueprint("bp", __name__)\n\n    @bp.app_template_filter("super_reverse")\n    def my_reverse(s):\n        return s[::-1]\n\n    app.register_blueprint(bp, url_prefix="/py")\n\n    @app.route("/")\n    def index():\n        return flask.render_template("template_filter.html", value="abcd")\n\n    rv = client.get("/")\n    assert rv.data == b"dcba"', start: 464, tick: 5, types_hash: '95304b3d97188d9c', _vid: 813}),
  (:Symbol {body_hash: '75a29e07e52d1810', deleted: false, end: 495, key: 'tests/test_blueprints.py::test_add_template_filter_with_name_and_template', kind: 'function', name: 'test_add_template_filter_with_name_and_template', path: 'tests/test_blueprints.py', qualname: 'test_add_template_filter_with_name_and_template', sig_hash: 'df6ec3162cad163f', signature: 'test_add_template_filter_with_name_and_template(app, client)', source: 'def test_add_template_filter_with_name_and_template(app, client):\n    bp = flask.Blueprint("bp", __name__)\n\n    def my_reverse(s):\n        return s[::-1]\n\n    bp.add_app_template_filter(my_reverse, "super_reverse")\n    app.register_blueprint(bp, url_prefix="/py")\n\n    @app.route("/")\n    def index():\n        return flask.render_template("template_filter.html", value="abcd")\n\n    rv = client.get("/")\n    assert rv.data == b"dcba"', start: 481, tick: 5, types_hash: '95304b3d97188d9c', _vid: 814}),
  (:Symbol {body_hash: '4658a5cf28fc0120', deleted: false, end: 508, key: 'tests/test_blueprints.py::test_template_test', kind: 'function', name: 'test_template_test', path: 'tests/test_blueprints.py', qualname: 'test_template_test', sig_hash: '462ce794eb370ded', signature: 'test_template_test(app)', source: 'def test_template_test(app):\n    bp = flask.Blueprint("bp", __name__)\n\n    @bp.app_template_test()\n    def is_boolean(value):\n        return isinstance(value, bool)\n\n    app.register_blueprint(bp, url_prefix="/py")\n    assert "is_boolean" in app.jinja_env.tests.keys()\n    assert app.jinja_env.tests["is_boolean"] == is_boolean\n    assert app.jinja_env.tests["is_boolean"](False)', start: 498, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 815}),
  (:Symbol {body_hash: '00b6ffde0c622bcd', deleted: false, end: 521, key: 'tests/test_blueprints.py::test_add_template_test', kind: 'function', name: 'test_add_template_test', path: 'tests/test_blueprints.py', qualname: 'test_add_template_test', sig_hash: '462ce794eb370ded', signature: 'test_add_template_test(app)', source: 'def test_add_template_test(app):\n    bp = flask.Blueprint("bp", __name__)\n\n    def is_boolean(value):\n        return isinstance(value, bool)\n\n    bp.add_app_template_test(is_boolean)\n    app.register_blueprint(bp, url_prefix="/py")\n    assert "is_boolean" in app.jinja_env.tests.keys()\n    assert app.jinja_env.tests["is_boolean"] == is_boolean\n    assert app.jinja_env.tests["is_boolean"](False)', start: 511, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 816}),
  (:Symbol {body_hash: 'bf0cab6f1fbdaa08', deleted: false, end: 534, key: 'tests/test_blueprints.py::test_template_test_with_name', kind: 'function', name: 'test_template_test_with_name', path: 'tests/test_blueprints.py', qualname: 'test_template_test_with_name', sig_hash: '462ce794eb370ded', signature: 'test_template_test_with_name(app)', source: 'def test_template_test_with_name(app):\n    bp = flask.Blueprint("bp", __name__)\n\n    @bp.app_template_test("boolean")\n    def is_boolean(value):\n        return isinstance(value, bool)\n\n    app.register_blueprint(bp, url_prefix="/py")\n    assert "boolean" in app.jinja_env.tests.keys()\n    assert app.jinja_env.tests["boolean"] == is_boolean\n    assert app.jinja_env.tests["boolean"](False)', start: 524, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 817}),
  (:Symbol {body_hash: '2a0592fa65f1a433', deleted: false, end: 547, key: 'tests/test_blueprints.py::test_add_template_test_with_name', kind: 'function', name: 'test_add_template_test_with_name', path: 'tests/test_blueprints.py', qualname: 'test_add_template_test_with_name', sig_hash: '462ce794eb370ded', signature: 'test_add_template_test_with_name(app)', source: 'def test_add_template_test_with_name(app):\n    bp = flask.Blueprint("bp", __name__)\n\n    def is_boolean(value):\n        return isinstance(value, bool)\n\n    bp.add_app_template_test(is_boolean, "boolean")\n    app.register_blueprint(bp, url_prefix="/py")\n    assert "boolean" in app.jinja_env.tests.keys()\n    assert app.jinja_env.tests["boolean"] == is_boolean\n    assert app.jinja_env.tests["boolean"](False)', start: 537, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 818}),
  (:Symbol {body_hash: '296b63c60db155bc', deleted: false, end: 564, key: 'tests/test_blueprints.py::test_template_test_with_template', kind: 'function', name: 'test_template_test_with_template', path: 'tests/test_blueprints.py', qualname: 'test_template_test_with_template', sig_hash: 'df6ec3162cad163f', signature: 'test_template_test_with_template(app, client)', source: 'def test_template_test_with_template(app, client):\n    bp = flask.Blueprint("bp", __name__)\n\n    @bp.app_template_test()\n    def boolean(value):\n        return isinstance(value, bool)\n\n    app.register_blueprint(bp, url_prefix="/py")\n\n    @app.route("/")\n    def index():\n        return flask.render_template("template_test.html", value=False)\n\n    rv = client.get("/")\n    assert b"Success!" in rv.data', start: 550, tick: 5, types_hash: '95304b3d97188d9c', _vid: 819}),
  (:Symbol {body_hash: '49ff4667c7729129', deleted: false, end: 580, key: 'tests/test_blueprints.py::test_template_test_after_route_with_template', kind: 'function', name: 'test_template_test_after_route_with_template', path: 'tests/test_blueprints.py', qualname: 'test_template_test_after_route_with_template', sig_hash: 'df6ec3162cad163f', signature: 'test_template_test_after_route_with_template(app, client)', source: 'def test_template_test_after_route_with_template(app, client):\n    @app.route("/")\n    def index():\n        return flask.render_template("template_test.html", value=False)\n\n    bp = flask.Blueprint("bp", __name__)\n\n    @bp.app_template_test()\n    def boolean(value):\n        return isinstance(value, bool)\n\n    app.register_blueprint(bp, url_prefix="/py")\n    rv = client.get("/")\n    assert b"Success!" in rv.data', start: 567, tick: 5, types_hash: '95304b3d97188d9c', _vid: 820}),
  (:Symbol {body_hash: '66eb57989aa65b80', deleted: false, end: 597, key: 'tests/test_blueprints.py::test_add_template_test_with_template', kind: 'function', name: 'test_add_template_test_with_template', path: 'tests/test_blueprints.py', qualname: 'test_add_template_test_with_template', sig_hash: 'df6ec3162cad163f', signature: 'test_add_template_test_with_template(app, client)', source: 'def test_add_template_test_with_template(app, client):\n    bp = flask.Blueprint("bp", __name__)\n\n    def boolean(value):\n        return isinstance(value, bool)\n\n    bp.add_app_template_test(boolean)\n    app.register_blueprint(bp, url_prefix="/py")\n\n    @app.route("/")\n    def index():\n        return flask.render_template("template_test.html", value=False)\n\n    rv = client.get("/")\n    assert b"Success!" in rv.data', start: 583, tick: 5, types_hash: '95304b3d97188d9c', _vid: 821}),
  (:Symbol {body_hash: '843ab25cc62bc8cf', deleted: false, end: 614, key: 'tests/test_blueprints.py::test_template_test_with_name_and_template', kind: 'function', name: 'test_template_test_with_name_and_template', path: 'tests/test_blueprints.py', qualname: 'test_template_test_with_name_and_template', sig_hash: 'df6ec3162cad163f', signature: 'test_template_test_with_name_and_template(app, client)', source: 'def test_template_test_with_name_and_template(app, client):\n    bp = flask.Blueprint("bp", __name__)\n\n    @bp.app_template_test("boolean")\n    def is_boolean(value):\n        return isinstance(value, bool)\n\n    app.register_blueprint(bp, url_prefix="/py")\n\n    @app.route("/")\n    def index():\n        return flask.render_template("template_test.html", value=False)\n\n    rv = client.get("/")\n    assert b"Success!" in rv.data', start: 600, tick: 5, types_hash: '95304b3d97188d9c', _vid: 822}),
  (:Symbol {body_hash: 'b3c938aaed5f8c49', deleted: false, end: 631, key: 'tests/test_blueprints.py::test_add_template_test_with_name_and_template', kind: 'function', name: 'test_add_template_test_with_name_and_template', path: 'tests/test_blueprints.py', qualname: 'test_add_template_test_with_name_and_template', sig_hash: 'df6ec3162cad163f', signature: 'test_add_template_test_with_name_and_template(app, client)', source: 'def test_add_template_test_with_name_and_template(app, client):\n    bp = flask.Blueprint("bp", __name__)\n\n    def is_boolean(value):\n        return isinstance(value, bool)\n\n    bp.add_app_template_test(is_boolean, "boolean")\n    app.register_blueprint(bp, url_prefix="/py")\n\n    @app.route("/")\n    def index():\n        return flask.render_template("template_test.html", value=False)\n\n    rv = client.get("/")\n    assert b"Success!" in rv.data', start: 617, tick: 5, types_hash: '95304b3d97188d9c', _vid: 823}),
  (:Symbol {body_hash: '81743792dd8ae3d0', deleted: false, end: 672, key: 'tests/test_blueprints.py::test_context_processing', kind: 'function', name: 'test_context_processing', path: 'tests/test_blueprints.py', qualname: 'test_context_processing', sig_hash: 'df6ec3162cad163f', signature: 'test_context_processing(app, client)', source: 'def test_context_processing(app, client):\n    answer_bp = flask.Blueprint("answer_bp", __name__)\n\n    def template_string():\n        return flask.render_template_string(\n            "{% if notanswer %}{{ notanswer }} is not the answer. {% endif %}"\n            "{% if answer %}{{ answer }} is the answer.{% endif %}"\n        )\n\n    # App global context processor\n    @answer_bp.app_context_processor\n    def not_answer_context_processor():\n        return {"notanswer": 43}\n\n    # Blueprint local context processor\n    @answer_bp.context_processor\n    def answer_context_processor():\n        return {"answer": 42}\n\n    # Setup endpoints for testing\n    @answer_bp.route("/bp")\n    def bp_page():\n        return template_string()\n\n    @app.route("/")\n    def app_page():\n        return template_string()\n\n    # Register the blueprint\n    app.register_blueprint(answer_bp)\n\n    app_page_bytes = client.get("/").data\n    answer_page_bytes = client.get("/bp").data\n\n    assert b"43" in app_page_bytes\n    assert b"42" not in app_page_bytes\n\n    assert b"42" in answer_page_bytes\n    assert b"43" in answer_page_bytes', start: 634, tick: 5, types_hash: '95304b3d97188d9c', _vid: 824}),
  (:Symbol {body_hash: 'fd830676d5503db0', deleted: false, end: 693, key: 'tests/test_blueprints.py::test_template_global', kind: 'function', name: 'test_template_global', path: 'tests/test_blueprints.py', qualname: 'test_template_global', sig_hash: '462ce794eb370ded', signature: 'test_template_global(app)', source: 'def test_template_global(app):\n    bp = flask.Blueprint("bp", __name__)\n\n    @bp.app_template_global()\n    def get_answer():\n        return 42\n\n    # Make sure the function is not in the jinja_env already\n    assert "get_answer" not in app.jinja_env.globals.keys()\n    app.register_blueprint(bp)\n\n    # Tests\n    assert "get_answer" in app.jinja_env.globals.keys()\n    assert app.jinja_env.globals["get_answer"] is get_answer\n    assert app.jinja_env.globals["get_answer"]() == 42\n\n    with app.app_context():\n        rv = flask.render_template_string("{{ get_answer() }}")\n        assert rv == "42"', start: 675, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 825}),
  (:Symbol {body_hash: 'cc0360bec61cce2b', deleted: false, end: 724, key: 'tests/test_blueprints.py::test_request_processing', kind: 'function', name: 'test_request_processing', path: 'tests/test_blueprints.py', qualname: 'test_request_processing', sig_hash: 'df6ec3162cad163f', signature: 'test_request_processing(app, client)', source: 'def test_request_processing(app, client):\n    bp = flask.Blueprint("bp", __name__)\n    evts = []\n\n    @bp.before_request\n    def before_bp():\n        evts.append("before")\n\n    @bp.after_request\n    def after_bp(response):\n        response.data += b"|after"\n        evts.append("after")\n        return response\n\n    @bp.teardown_request\n    def teardown_bp(exc):\n        evts.append("teardown")\n\n    # Setup routes for testing\n    @bp.route("/bp")\n    def bp_endpoint():\n        return "request"\n\n    app.register_blueprint(bp)\n\n    assert evts == []\n    rv = client.get("/bp")\n    assert rv.data == b"request|after"\n    assert evts == ["before", "after", "teardown"]', start: 696, tick: 5, types_hash: '95304b3d97188d9c', _vid: 826}),
  (:Symbol {body_hash: 'd4a58ffca32a407b', deleted: false, end: 763, key: 'tests/test_blueprints.py::test_app_request_processing', kind: 'function', name: 'test_app_request_processing', path: 'tests/test_blueprints.py', qualname: 'test_app_request_processing', sig_hash: 'df6ec3162cad163f', signature: 'test_app_request_processing(app, client)', source: 'def test_app_request_processing(app, client):\n    bp = flask.Blueprint("bp", __name__)\n    evts = []\n\n    @bp.before_app_request\n    def before_app():\n        evts.append("before")\n\n    @bp.after_app_request\n    def after_app(response):\n        response.data += b"|after"\n        evts.append("after")\n        return response\n\n    @bp.teardown_app_request\n    def teardown_app(exc):\n        evts.append("teardown")\n\n    app.register_blueprint(bp)\n\n    # Setup routes for testing\n    @app.route("/")\n    def bp_endpoint():\n        return "request"\n\n    # before first request\n    assert evts == []\n\n    # first request\n    resp = client.get("/").data\n    assert resp == b"request|after"\n    assert evts == ["before", "after", "teardown"]\n\n    # second request\n    resp = client.get("/").data\n    assert resp == b"request|after"\n    assert evts == ["before", "after", "teardown"] * 2', start: 727, tick: 5, types_hash: '95304b3d97188d9c', _vid: 827}),
  (:Symbol {body_hash: '24bef3f5ffb4cd33', deleted: false, end: 790, key: 'tests/test_blueprints.py::test_app_url_processors', kind: 'function', name: 'test_app_url_processors', path: 'tests/test_blueprints.py', qualname: 'test_app_url_processors', sig_hash: 'df6ec3162cad163f', signature: 'test_app_url_processors(app, client)', source: 'def test_app_url_processors(app, client):\n    bp = flask.Blueprint("bp", __name__)\n\n    # Register app-wide url defaults and preprocessor on blueprint\n    @bp.app_url_defaults\n    def add_language_code(endpoint, values):\n        values.setdefault("lang_code", flask.g.lang_code)\n\n    @bp.app_url_value_preprocessor\n    def pull_lang_code(endpoint, values):\n        flask.g.lang_code = values.pop("lang_code")\n\n    # Register route rules at the app level\n    @app.route("/<lang_code>/")\n    def index():\n        return flask.url_for("about")\n\n    @app.route("/<lang_code>/about")\n    def about():\n        return flask.url_for("index")\n\n    app.register_blueprint(bp)\n\n    assert client.get("/de/").data == b"/de/about"\n    assert client.get("/de/about").data == b"/de/"', start: 766, tick: 5, types_hash: '95304b3d97188d9c', _vid: 828}),
  (:Symbol {body_hash: '4ebd8bac9de6eb7d', deleted: false, end: 839, key: 'tests/test_blueprints.py::test_nested_blueprint', kind: 'function', name: 'test_nested_blueprint', path: 'tests/test_blueprints.py', qualname: 'test_nested_blueprint', sig_hash: 'df6ec3162cad163f', signature: 'test_nested_blueprint(app, client)', source: 'def test_nested_blueprint(app, client):\n    parent = flask.Blueprint("parent", __name__)\n    child = flask.Blueprint("child", __name__)\n    grandchild = flask.Blueprint("grandchild", __name__)\n\n    @parent.errorhandler(403)\n    def forbidden(e):\n        return "Parent no", 403\n\n    @parent.route("/")\n    def parent_index():\n        return "Parent yes"\n\n    @parent.route("/no")\n    def parent_no():\n        flask.abort(403)\n\n    @child.route("/")\n    def child_index():\n        return "Child yes"\n\n    @child.route("/no")\n    def child_no():\n        flask.abort(403)\n\n    @grandchild.errorhandler(403)\n    def grandchild_forbidden(e):\n        return "Grandchild no", 403\n\n    @grandchild.route("/")\n    def grandchild_index():\n        return "Grandchild yes"\n\n    @grandchild.route("/no")\n    def grandchild_no():\n        flask.abort(403)\n\n    child.register_blueprint(grandchild, url_prefix="/grandchild")\n    parent.register_blueprint(child, url_prefix="/child")\n    app.register_blueprint(parent, url_prefix="/parent")\n\n    assert client.get("/parent/").data == b"Parent yes"\n    assert client.get("/parent/child/").data == b"Child yes"\n    assert client.get("/parent/child/grandchild/").data == b"Grandchild yes"\n    assert client.get("/parent/no").data == b"Parent no"\n    assert client.get("/parent/child/no").data == b"Parent no"\n    assert client.get("/parent/child/grandchild/no").data == b"Grandchild no"', start: 793, tick: 5, types_hash: '95304b3d97188d9c', _vid: 829}),
  (:Symbol {body_hash: 'ac42a853b099d403', deleted: false, end: 919, key: 'tests/test_blueprints.py::test_nested_callback_order', kind: 'function', name: 'test_nested_callback_order', path: 'tests/test_blueprints.py', qualname: 'test_nested_callback_order', sig_hash: 'df6ec3162cad163f', signature: 'test_nested_callback_order(app, client)', source: 'def test_nested_callback_order(app, client):\n    parent = flask.Blueprint("parent", __name__)\n    child = flask.Blueprint("child", __name__)\n\n    @app.before_request\n    def app_before1():\n        flask.g.setdefault("seen", []).append("app_1")\n\n    @app.teardown_request\n    def app_teardown1(e=None):\n        assert flask.g.seen.pop() == "app_1"\n\n    @app.before_request\n    def app_before2():\n        flask.g.setdefault("seen", []).append("app_2")\n\n    @app.teardown_request\n    def app_teardown2(e=None):\n        assert flask.g.seen.pop() == "app_2"\n\n    @app.context_processor\n    def app_ctx():\n        return dict(key="app")\n\n    @parent.before_request\n    def parent_before1():\n        flask.g.setdefault("seen", []).append("parent_1")\n\n    @parent.teardown_request\n    def parent_teardown1(e=None):\n        assert flask.g.seen.pop() == "parent_1"\n\n    @parent.before_request\n    def parent_before2():\n        flask.g.setdefault("seen", []).append("parent_2")\n\n    @parent.teardown_request\n    def parent_teardown2(e=None):\n        assert flask.g.seen.pop() == "parent_2"\n\n    @parent.context_processor\n    def parent_ctx():\n        return dict(key="parent")\n\n    @child.before_request\n    def child_before1():\n        flask.g.setdefault("seen", []).append("child_1")\n\n    @child.teardown_request\n    def child_teardown1(e=None):\n        assert flask.g.seen.pop() == "child_1"\n\n    @child.before_request\n    def child_before2():\n        flask.g.setdefault("seen", []).append("child_2")\n\n    @c\n…', start: 842, tick: 5, types_hash: '95304b3d97188d9c', _vid: 830}),
  (:Symbol {body_hash: '82ef7f91968ee98b', deleted: false, end: 950, key: 'tests/test_blueprints.py::test_nesting_url_prefixes', kind: 'function', name: 'test_nesting_url_prefixes', path: 'tests/test_blueprints.py', qualname: 'test_nesting_url_prefixes', sig_hash: '09f71f20ebd3870e', signature: 'test_nesting_url_prefixes(parent_init, child_init, parent_registration, child_registration, app, client) -> None', source: '@pytest.mark.parametrize(\n    "parent_init, child_init, parent_registration, child_registration",\n    [\n        ("/parent", "/child", None, None),\n        ("/parent", None, None, "/child"),\n        (None, None, "/parent", "/child"),\n        ("/other", "/something", "/parent", "/child"),\n    ],\n)\ndef test_nesting_url_prefixes(\n    parent_init,\n    child_init,\n    parent_registration,\n    child_registration,\n    app,\n    client,\n) -> None:\n    parent = flask.Blueprint("parent", __name__, url_prefix=parent_init)\n    child = flask.Blueprint("child", __name__, url_prefix=child_init)\n\n    @child.route("/")\n    def index():\n        return "index"\n\n    parent.register_blueprint(child, url_prefix=child_registration)\n    app.register_blueprint(parent, url_prefix=parent_registration)\n\n    response = client.get("/parent/child/")\n    assert response.status_code == 200', start: 931, tick: 5, types_hash: '3e2e5bdec35719cf', _vid: 831}),
  (:Symbol {body_hash: '6b5043a2ba2dd302', deleted: false, end: 969, key: 'tests/test_blueprints.py::test_nesting_subdomains', kind: 'function', name: 'test_nesting_subdomains', path: 'tests/test_blueprints.py', qualname: 'test_nesting_subdomains', sig_hash: 'df6ec3162cad163f', signature: 'test_nesting_subdomains(app, client) -> None', source: 'def test_nesting_subdomains(app, client) -> None:\n    app.subdomain_matching = True\n    app.config["SERVER_NAME"] = "example.test"\n    client.allow_subdomain_redirects = True\n\n    parent = flask.Blueprint("parent", __name__)\n    child = flask.Blueprint("child", __name__)\n\n    @child.route("/child/")\n    def index():\n        return "child"\n\n    parent.register_blueprint(child)\n    app.register_blueprint(parent, subdomain="api")\n\n    response = client.get("/child/", base_url="http://api.example.test")\n    assert response.status_code == 200', start: 953, tick: 5, types_hash: '28ec2edd45ba25c1', _vid: 832}),
  (:Symbol {body_hash: 'ad0f2d45b0f37c68', deleted: false, end: 991, key: 'tests/test_blueprints.py::test_child_and_parent_subdomain', kind: 'function', name: 'test_child_and_parent_subdomain', path: 'tests/test_blueprints.py', qualname: 'test_child_and_parent_subdomain', sig_hash: 'df6ec3162cad163f', signature: 'test_child_and_parent_subdomain(app, client) -> None', source: 'def test_child_and_parent_subdomain(app, client) -> None:\n    app.subdomain_matching = True\n    app.config["SERVER_NAME"] = "example.test"\n    client.allow_subdomain_redirects = True\n\n    parent = flask.Blueprint("parent", __name__)\n    child = flask.Blueprint("child", __name__, subdomain="api")\n\n    @child.route("/")\n    def index():\n        return "child"\n\n    parent.register_blueprint(child)\n    app.register_blueprint(parent, subdomain="parent")\n\n    response = client.get("/", base_url="http://api.parent.example.test")\n    assert response.status_code == 200\n\n    response = client.get("/", base_url="http://parent.example.test")\n    assert response.status_code == 404', start: 972, tick: 5, types_hash: '28ec2edd45ba25c1', _vid: 833}),
  (:Symbol {body_hash: '8a7fd138bf9029d1', deleted: false, end: 1008, key: 'tests/test_blueprints.py::test_unique_blueprint_names', kind: 'function', name: 'test_unique_blueprint_names', path: 'tests/test_blueprints.py', qualname: 'test_unique_blueprint_names', sig_hash: 'df6ec3162cad163f', signature: 'test_unique_blueprint_names(app, client) -> None', source: 'def test_unique_blueprint_names(app, client) -> None:\n    bp = flask.Blueprint("bp", __name__)\n    bp2 = flask.Blueprint("bp", __name__)\n\n    app.register_blueprint(bp)\n\n    with pytest.raises(ValueError):\n        app.register_blueprint(bp)  # same bp, same name, error\n\n    app.register_blueprint(bp, name="again")  # same bp, different name, ok\n\n    with pytest.raises(ValueError):\n        app.register_blueprint(bp2)  # different bp, same name, error\n\n    app.register_blueprint(bp2, name="alt")  # different bp, different name, ok', start: 994, tick: 5, types_hash: '28ec2edd45ba25c1', _vid: 834}),
  (:Symbol {body_hash: '42bab72734647db6', deleted: false, end: 1014, key: 'tests/test_blueprints.py::test_self_registration', kind: 'function', name: 'test_self_registration', path: 'tests/test_blueprints.py', qualname: 'test_self_registration', sig_hash: 'df6ec3162cad163f', signature: 'test_self_registration(app, client) -> None', source: 'def test_self_registration(app, client) -> None:\n    bp = flask.Blueprint("bp", __name__)\n    with pytest.raises(ValueError):\n        bp.register_blueprint(bp)', start: 1011, tick: 5, types_hash: '28ec2edd45ba25c1', _vid: 835}),
  (:Symbol {body_hash: '0df68b81f78de3dc', deleted: false, end: 1046, key: 'tests/test_blueprints.py::test_blueprint_renaming', kind: 'function', name: 'test_blueprint_renaming', path: 'tests/test_blueprints.py', qualname: 'test_blueprint_renaming', sig_hash: 'df6ec3162cad163f', signature: 'test_blueprint_renaming(app, client) -> None', source: 'def test_blueprint_renaming(app, client) -> None:\n    bp = flask.Blueprint("bp", __name__)\n    bp2 = flask.Blueprint("bp2", __name__)\n\n    @bp.get("/")\n    def index():\n        return flask.request.endpoint\n\n    @bp.get("/error")\n    def error():\n        flask.abort(403)\n\n    @bp.errorhandler(403)\n    def forbidden(_: Exception):\n        return "Error", 403\n\n    @bp2.get("/")\n    def index2():\n        return flask.request.endpoint\n\n    bp.register_blueprint(bp2, url_prefix="/a", name="sub")\n    app.register_blueprint(bp, url_prefix="/a")\n    app.register_blueprint(bp, url_prefix="/b", name="alt")\n\n    assert client.get("/a/").data == b"bp.index"\n    assert client.get("/b/").data == b"alt.index"\n    assert client.get("/a/a/").data == b"bp.sub.index2"\n    assert client.get("/b/a/").data == b"alt.sub.index2"\n    assert client.get("/a/error").data == b"Error"\n    assert client.get("/b/error").data == b"Error"', start: 1017, tick: 5, types_hash: '28ec2edd45ba25c1', _vid: 836}),
  (:Symbol {body_hash: '3f081f1f741b475d', deleted: false, end: 38, key: 'tests/test_cli.py::runner', kind: 'function', name: 'runner', path: 'tests/test_cli.py', qualname: 'runner', sig_hash: '4943fbd3d489f4fa', signature: 'runner()', source: '@pytest.fixture\ndef runner():\n    return CliRunner()', start: 37, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 837}),
  (:Symbol {body_hash: 'f66f1eb356a21345', deleted: false, end: 45, key: 'tests/test_cli.py::test_cli_name', kind: 'function', name: 'test_cli_name', path: 'tests/test_cli.py', qualname: 'test_cli_name', sig_hash: '937937a61f63cb91', signature: 'test_cli_name(test_apps)', source: 'def test_cli_name(test_apps):\n    """Make sure the CLI object\'s name is the app\'s name and not the app itself"""\n    from cliapp.app import testapp\n\n    assert testapp.cli.name == testapp.name', start: 41, tick: 5, types_hash: '56a10b38091a5073', _vid: 838}),
  (:Symbol {body_hash: '8eb992da0687fe2a', deleted: false, end: 132, key: 'tests/test_cli.py::test_find_best_app', kind: 'function', name: 'test_find_best_app', path: 'tests/test_cli.py', qualname: 'test_find_best_app', sig_hash: '937937a61f63cb91', signature: 'test_find_best_app(test_apps)', source: 'def test_find_best_app(test_apps):\n    class Module:\n        app = Flask("appname")\n\n    assert find_best_app(Module) == Module.app\n\n    class Module:\n        application = Flask("appname")\n\n    assert find_best_app(Module) == Module.application\n\n    class Module:\n        myapp = Flask("appname")\n\n    assert find_best_app(Module) == Module.myapp\n\n    class Module:\n        @staticmethod\n        def create_app():\n            return Flask("appname")\n\n    app = find_best_app(Module)\n    assert isinstance(app, Flask)\n    assert app.name == "appname"\n\n    class Module:\n        @staticmethod\n        def create_app(**kwargs):\n            return Flask("appname")\n\n    app = find_best_app(Module)\n    assert isinstance(app, Flask)\n    assert app.name == "appname"\n\n    class Module:\n        @staticmethod\n        def make_app():\n            return Flask("appname")\n\n    app = find_best_app(Module)\n    assert isinstance(app, Flask)\n    assert app.name == "appname"\n\n    class Module:\n        myapp = Flask("appname1")\n\n        @staticmethod\n        def create_app():\n            return Flask("appname2")\n\n    assert find_best_app(Module) == Module.myapp\n\n    class Module:\n        myapp = Flask("appname1")\n\n        @staticmethod\n        def create_app():\n            return Flask("appname2")\n\n    assert find_best_app(Module) == Module.myapp\n\n    class Module:\n        pass\n\n    pytest.raises(NoAppException, find_best_app, Module)\n\n    class Module:\n        myapp1 = Flask("appname1")\n        myapp2 \n…', start: 48, tick: 5, types_hash: '56a10b38091a5073', _vid: 839}),
  (:Symbol {body_hash: '68f74ace0dbdd177', deleted: false, end: 177, key: 'tests/test_cli.py::test_prepare_import', kind: 'function', name: 'test_prepare_import', path: 'tests/test_cli.py', qualname: 'test_prepare_import', sig_hash: 'a79baac2d50be4dc', signature: 'test_prepare_import(request, value, path, result)', source: '@pytest.mark.parametrize(\n    "value,path,result",\n    (\n        ("test", cwd, "test"),\n        ("test.py", cwd, "test"),\n        ("a/test", cwd / "a", "test"),\n        ("test/__init__.py", cwd, "test"),\n        ("test/__init__", cwd, "test"),\n        # nested package\n        (\n            test_path / "cliapp" / "inner1" / "__init__",\n            test_path,\n            "cliapp.inner1",\n        ),\n        (\n            test_path / "cliapp" / "inner1" / "inner2",\n            test_path,\n            "cliapp.inner1.inner2",\n        ),\n        # dotted name\n        ("test.a.b", cwd, "test.a.b"),\n        (test_path / "cliapp.app", test_path, "cliapp.app"),\n        # not a Python file, will be caught during import\n        (test_path / "cliapp" / "message.txt", test_path, "cliapp.message.txt"),\n    ),\n)\ndef test_prepare_import(request, value, path, result):\n    """Expect the correct path to be set and the correct import and app names\n    to be returned.\n\n    :func:`prepare_exec_for_file` has a side effect where the parent directory\n    of the given import is added to :data:`sys.path`. This is reset after the\n    test runs.\n    """\n    original_path = sys.path[:]\n\n    def reset_path():\n        sys.path[:] = original_path\n\n    request.addfinalizer(reset_path)\n\n    assert prepare_import(value) == result\n    assert sys.path[0] == str(path)', start: 161, tick: 5, types_hash: 'e536393bee57c04d', _vid: 840}),
  (:Symbol {body_hash: '8fb3777112392ee3', deleted: false, end: 196, key: 'tests/test_cli.py::test_locate_app', kind: 'function', name: 'test_locate_app', path: 'tests/test_cli.py', qualname: 'test_locate_app', sig_hash: '89615bc6d9148373', signature: 'test_locate_app(test_apps, iname, aname, result)', source: '@pytest.mark.parametrize(\n    "iname,aname,result",\n    (\n        ("cliapp.app", None, "testapp"),\n        ("cliapp.app", "testapp", "testapp"),\n        ("cliapp.factory", None, "app"),\n        ("cliapp.factory", "create_app", "app"),\n        ("cliapp.factory", "create_app()", "app"),\n        ("cliapp.factory", \'create_app2("foo", "bar")\', "app2_foo_bar"),\n        # trailing comma space\n        ("cliapp.factory", \'create_app2("foo", "bar", )\', "app2_foo_bar"),\n        # strip whitespace\n        ("cliapp.factory", " create_app () ", "app"),\n    ),\n)\ndef test_locate_app(test_apps, iname, aname, result):\n    assert locate_app(iname, aname).name == result', start: 195, tick: 5, types_hash: '730ca07848c9fb13', _vid: 841}),
  (:Symbol {body_hash: 'a769e118dd661338', deleted: false, end: 219, key: 'tests/test_cli.py::test_locate_app_raises', kind: 'function', name: 'test_locate_app_raises', path: 'tests/test_cli.py', qualname: 'test_locate_app_raises', sig_hash: '2034eb976f171156', signature: 'test_locate_app_raises(test_apps, iname, aname)', source: '@pytest.mark.parametrize(\n    "iname,aname",\n    (\n        ("notanapp.py", None),\n        ("cliapp/app", None),\n        ("cliapp.app", "notanapp"),\n        # not enough arguments\n        ("cliapp.factory", \'create_app2("foo")\'),\n        # invalid identifier\n        ("cliapp.factory", "create_app("),\n        # no app returned\n        ("cliapp.factory", "no_app"),\n        # nested import error\n        ("cliapp.importerrorapp", None),\n        # not a Python file\n        ("cliapp.message.txt", None),\n    ),\n)\ndef test_locate_app_raises(test_apps, iname, aname):\n    with pytest.raises(NoAppException):\n        locate_app(iname, aname)', start: 217, tick: 5, types_hash: '1b5cf4ac14e902c5', _vid: 842}),
  (:Symbol {body_hash: '9a7e25c8cd7c353e', deleted: false, end: 228, key: 'tests/test_cli.py::test_locate_app_suppress_raise', kind: 'function', name: 'test_locate_app_suppress_raise', path: 'tests/test_cli.py', qualname: 'test_locate_app_suppress_raise', sig_hash: '937937a61f63cb91', signature: 'test_locate_app_suppress_raise(test_apps)', source: 'def test_locate_app_suppress_raise(test_apps):\n    app = locate_app("notanapp.py", None, raise_if_not_found=False)\n    assert app is None\n\n    # only direct import error is suppressed\n    with pytest.raises(NoAppException):\n        locate_app("cliapp.importerrorapp", None, raise_if_not_found=False)', start: 222, tick: 5, types_hash: '56a10b38091a5073', _vid: 843}),
  (:Symbol {body_hash: '4a22cdf4cb16ac18', deleted: false, end: 244, key: 'tests/test_cli.py::test_get_version', kind: 'function', name: 'test_get_version', path: 'tests/test_cli.py', qualname: 'test_get_version', sig_hash: 'b4f9cde321ac4ef6', signature: 'test_get_version(test_apps, capsys)', source: 'def test_get_version(test_apps, capsys):\n    class MockCtx:\n        resilient_parsing = False\n        color = None\n\n        def exit(self):\n            return\n\n    ctx = MockCtx()\n    get_version(ctx, None, "test")\n    out, err = capsys.readouterr()\n    assert f"Python {platform.python_version()}" in out\n    assert f"Flask {importlib.metadata.version(\'flask\')}" in out\n    assert f"Werkzeug {importlib.metadata.version(\'werkzeug\')}" in out', start: 231, tick: 5, types_hash: 'cf9345ce1625ba60', _vid: 844}),
  (:Symbol {body_hash: 'a523d6a8971a7e83', deleted: false, end: 286, key: 'tests/test_cli.py::test_scriptinfo', kind: 'function', name: 'test_scriptinfo', path: 'tests/test_cli.py', qualname: 'test_scriptinfo', sig_hash: 'da93bf1148c97482', signature: 'test_scriptinfo(test_apps, monkeypatch)', source: 'def test_scriptinfo(test_apps, monkeypatch):\n    obj = ScriptInfo(app_import_path="cliapp.app:testapp")\n    app = obj.load_app()\n    assert app.name == "testapp"\n    assert obj.load_app() is app\n\n    # import app with module\'s absolute path\n    cli_app_path = str(test_path / "cliapp" / "app.py")\n\n    obj = ScriptInfo(app_import_path=cli_app_path)\n    app = obj.load_app()\n    assert app.name == "testapp"\n    assert obj.load_app() is app\n    obj = ScriptInfo(app_import_path=f"{cli_app_path}:testapp")\n    app = obj.load_app()\n    assert app.name == "testapp"\n    assert obj.load_app() is app\n\n    def create_app():\n        return Flask("createapp")\n\n    obj = ScriptInfo(create_app=create_app)\n    app = obj.load_app()\n    assert app.name == "createapp"\n    assert obj.load_app() is app\n\n    obj = ScriptInfo()\n    pytest.raises(NoAppException, obj.load_app)\n\n    # import app from wsgi.py in current directory\n    monkeypatch.chdir(test_path / "helloworld")\n    obj = ScriptInfo()\n    app = obj.load_app()\n    assert app.name == "hello"\n\n    # import app from app.py in current directory\n    monkeypatch.chdir(test_path / "cliapp")\n    obj = ScriptInfo()\n    app = obj.load_app()\n    assert app.name == "testapp"', start: 247, tick: 5, types_hash: '754b832c9da8a48f', _vid: 845}),
  (:Symbol {body_hash: '22309b1e877567f9', deleted: false, end: 304, key: 'tests/test_cli.py::test_app_cli_has_app_context', kind: 'function', name: 'test_app_cli_has_app_context', path: 'tests/test_cli.py', qualname: 'test_app_cli_has_app_context', sig_hash: '0aa5fe051429be5d', signature: 'test_app_cli_has_app_context(app, runner)', source: 'def test_app_cli_has_app_context(app, runner):\n    def _param_cb(ctx, param, value):\n        # current_app should be available in parameter callbacks\n        return bool(current_app)\n\n    @app.cli.command()\n    @click.argument("value", callback=_param_cb)\n    def check(value):\n        app = click.get_current_context().obj.load_app()\n        # the loaded app should be the same as current_app\n        same_app = current_app._get_current_object() is app\n        return same_app, value\n\n    cli = FlaskGroup(create_app=lambda: app)\n    result = runner.invoke(cli, ["check", "x"], standalone_mode=False)\n    assert result.return_value == (True, True)', start: 289, tick: 5, types_hash: '297b1fa15ad7e3a8', _vid: 846}),
  (:Symbol {body_hash: 'fb7814a95642ffae', deleted: false, end: 317, key: 'tests/test_cli.py::test_with_appcontext', kind: 'function', name: 'test_with_appcontext', path: 'tests/test_cli.py', qualname: 'test_with_appcontext', sig_hash: 'daae0a9f335af839', signature: 'test_with_appcontext(runner)', source: 'def test_with_appcontext(runner):\n    @click.command()\n    @with_appcontext\n    def testcmd():\n        click.echo(current_app.name)\n\n    obj = ScriptInfo(create_app=lambda: Flask("testapp"))\n\n    result = runner.invoke(testcmd, obj=obj)\n    assert result.exit_code == 0\n    assert result.output == "testapp\\n"', start: 307, tick: 5, types_hash: '23b915be966ca1bb', _vid: 847}),
  (:Symbol {body_hash: '72b4e340899996be', deleted: false, end: 345, key: 'tests/test_cli.py::test_appgroup_app_context', kind: 'function', name: 'test_appgroup_app_context', path: 'tests/test_cli.py', qualname: 'test_appgroup_app_context', sig_hash: 'daae0a9f335af839', signature: 'test_appgroup_app_context(runner)', source: 'def test_appgroup_app_context(runner):\n    @click.group(cls=AppGroup)\n    def cli():\n        pass\n\n    @cli.command()\n    def test():\n        click.echo(current_app.name)\n\n    @cli.group()\n    def subgroup():\n        pass\n\n    @subgroup.command()\n    def test2():\n        click.echo(current_app.name)\n\n    obj = ScriptInfo(create_app=lambda: Flask("testappgroup"))\n\n    result = runner.invoke(cli, ["test"], obj=obj)\n    assert result.exit_code == 0\n    assert result.output == "testappgroup\\n"\n\n    result = runner.invoke(cli, ["subgroup", "test2"], obj=obj)\n    assert result.exit_code == 0\n    assert result.output == "testappgroup\\n"', start: 320, tick: 5, types_hash: '23b915be966ca1bb', _vid: 848}),
  (:Symbol {body_hash: 'ffd0665dd48729ac', deleted: false, end: 362, key: 'tests/test_cli.py::test_flaskgroup_app_context', kind: 'function', name: 'test_flaskgroup_app_context', path: 'tests/test_cli.py', qualname: 'test_flaskgroup_app_context', sig_hash: 'daae0a9f335af839', signature: 'test_flaskgroup_app_context(runner)', source: 'def test_flaskgroup_app_context(runner):\n    def create_app():\n        return Flask("flaskgroup")\n\n    @click.group(cls=FlaskGroup, create_app=create_app)\n    def cli(**params):\n        pass\n\n    @cli.command()\n    def test():\n        click.echo(current_app.name)\n\n    result = runner.invoke(cli, ["test"])\n    assert result.exit_code == 0\n    assert result.output == "flaskgroup\\n"', start: 348, tick: 5, types_hash: '23b915be966ca1bb', _vid: 849}),
  (:Symbol {body_hash: '5a93bb050c178aa1', deleted: false, end: 382, key: 'tests/test_cli.py::test_flaskgroup_debug', kind: 'function', name: 'test_flaskgroup_debug', path: 'tests/test_cli.py', qualname: 'test_flaskgroup_debug', sig_hash: '1bc794906858858e', signature: 'test_flaskgroup_debug(runner, set_debug_flag)', source: '@pytest.mark.parametrize("set_debug_flag", (True, False))\ndef test_flaskgroup_debug(runner, set_debug_flag):\n    def create_app():\n        app = Flask("flaskgroup")\n        app.debug = True\n        return app\n\n    @click.group(cls=FlaskGroup, create_app=create_app, set_debug_flag=set_debug_flag)\n    def cli(**params):\n        pass\n\n    @cli.command()\n    def test():\n        click.echo(str(current_app.debug))\n\n    result = runner.invoke(cli, ["test"])\n    assert result.exit_code == 0\n    assert result.output == f"{not set_debug_flag}\\n"', start: 366, tick: 5, types_hash: '64902d1ecd67ecdc', _vid: 850}),
  (:Symbol {body_hash: 'a8f200e77cd353a0', deleted: false, end: 395, key: 'tests/test_cli.py::test_flaskgroup_nested', kind: 'function', name: 'test_flaskgroup_nested', path: 'tests/test_cli.py', qualname: 'test_flaskgroup_nested', sig_hash: '0aa5fe051429be5d', signature: 'test_flaskgroup_nested(app, runner)', source: 'def test_flaskgroup_nested(app, runner):\n    cli = click.Group("cli")\n    flask_group = FlaskGroup(name="flask", create_app=lambda: app)\n    cli.add_command(flask_group)\n\n    @flask_group.command()\n    def show():\n        click.echo(current_app.name)\n\n    result = runner.invoke(cli, ["flask", "show"])\n    assert result.output == "flask_test\\n"', start: 385, tick: 5, types_hash: '297b1fa15ad7e3a8', _vid: 851}),
  (:Symbol {body_hash: '9c759ed930b66ad3', deleted: false, end: 410, key: 'tests/test_cli.py::test_no_command_echo_loading_error', kind: 'function', name: 'test_no_command_echo_loading_error', path: 'tests/test_cli.py', qualname: 'test_no_command_echo_loading_error', sig_hash: '4943fbd3d489f4fa', signature: 'test_no_command_echo_loading_error()', source: 'def test_no_command_echo_loading_error():\n    from flask.cli import cli\n\n    try:\n        runner = CliRunner(mix_stderr=False)\n    except (DeprecationWarning, TypeError):\n        # Click >= 8.2\n        runner = CliRunner()\n\n    result = runner.invoke(cli, ["missing"])\n    assert result.exit_code == 2\n    assert "FLASK_APP" in result.stderr\n    assert "Usage:" in result.stderr', start: 398, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 852}),
  (:Symbol {body_hash: '7b207944f31c5981', deleted: false, end: 425, key: 'tests/test_cli.py::test_help_echo_loading_error', kind: 'function', name: 'test_help_echo_loading_error', path: 'tests/test_cli.py', qualname: 'test_help_echo_loading_error', sig_hash: '4943fbd3d489f4fa', signature: 'test_help_echo_loading_error()', source: 'def test_help_echo_loading_error():\n    from flask.cli import cli\n\n    try:\n        runner = CliRunner(mix_stderr=False)\n    except (DeprecationWarning, TypeError):\n        # Click >= 8.2\n        runner = CliRunner()\n\n    result = runner.invoke(cli, ["--help"])\n    assert result.exit_code == 0\n    assert "FLASK_APP" in result.stderr\n    assert "Usage:" in result.stdout', start: 413, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 853}),
  (:Symbol {body_hash: '7bb32278ca0ec94f', deleted: false, end: 443, key: 'tests/test_cli.py::test_help_echo_exception', kind: 'function', name: 'test_help_echo_exception', path: 'tests/test_cli.py', qualname: 'test_help_echo_exception', sig_hash: '4943fbd3d489f4fa', signature: 'test_help_echo_exception()', source: 'def test_help_echo_exception():\n    def create_app():\n        raise Exception("oh no")\n\n    cli = FlaskGroup(create_app=create_app)\n\n    try:\n        runner = CliRunner(mix_stderr=False)\n    except (DeprecationWarning, TypeError):\n        # Click >= 8.2\n        runner = CliRunner()\n\n    result = runner.invoke(cli, ["--help"])\n    assert result.exit_code == 0\n    assert "Exception: oh no" in result.stderr\n    assert "Usage:" in result.stdout', start: 428, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 854}),
  (:Symbol {body_hash: '1c7ed00c64d58459', deleted: false, end: 518, key: 'tests/test_cli.py::TestRoutes', kind: 'class', name: 'TestRoutes', path: 'tests/test_cli.py', qualname: 'TestRoutes', sig_hash: '42ba610a86d15094', signature: 'class TestRoutes', source: 'class TestRoutes:\n    @pytest.fixture\n    def app(self):\n        app = Flask(__name__)\n        app.add_url_rule(\n            "/get_post/<int:x>/<int:y>",\n            methods=["GET", "POST"],\n            endpoint="yyy_get_post",\n        )\n        app.add_url_rule("/zzz_post", methods=["POST"], endpoint="aaa_post")\n        return app\n\n    @pytest.fixture\n    def invoke(self, app, runner):\n        cli = FlaskGroup(create_app=lambda: app)\n        return partial(runner.invoke, cli)\n\n    def expect_order(self, order, output):\n        # skip the header and match the start of each row\n        for expect, line in zip(order, output.splitlines()[2:]):\n            # do this instead of startswith for nicer pytest output\n            assert line[: len(expect)] == expect\n\n    def test_simple(self, invoke):\n        result = invoke(["routes"])\n        assert result.exit_code == 0\n        self.expect_order(["aaa_post", "static", "yyy_get_post"], result.output)\n\n    def test_sort(self, app, invoke):\n        default_output = invoke(["routes"]).output\n        endpoint_output = invoke(["routes", "-s", "endpoint"]).output\n        assert default_output == endpoint_output\n        self.expect_order(\n            ["static", "yyy_get_post", "aaa_post"],\n            invoke(["routes", "-s", "methods"]).output,\n        )\n        self.expect_order(\n            ["yyy_get_post", "static", "aaa_post"],\n            invoke(["routes", "-s", "rule"]).output,\n        )\n        match_order = [r.endpoint for r in app.u\n…', start: 446, tick: 5, types_hash: '', _vid: 855}),
  (:Symbol {body_hash: '0c4926b538d9a8a9', deleted: false, end: 456, key: 'tests/test_cli.py::TestRoutes.app', kind: 'method', name: 'app', path: 'tests/test_cli.py', qualname: 'TestRoutes.app', sig_hash: '9626d105938f0039', signature: 'app(self)', source: '    @pytest.fixture\n    def app(self):\n        app = Flask(__name__)\n        app.add_url_rule(\n            "/get_post/<int:x>/<int:y>",\n            methods=["GET", "POST"],\n            endpoint="yyy_get_post",\n        )\n        app.add_url_rule("/zzz_post", methods=["POST"], endpoint="aaa_post")\n        return app', start: 448, tick: 5, types_hash: '10a585bd39808d65', _vid: 856}),
  (:Symbol {body_hash: '52a88c83a4bc446b', deleted: false, end: 461, key: 'tests/test_cli.py::TestRoutes.invoke', kind: 'method', name: 'invoke', path: 'tests/test_cli.py', qualname: 'TestRoutes.invoke', sig_hash: '6e78083c74d498ac', signature: 'invoke(self, app, runner)', source: '    @pytest.fixture\n    def invoke(self, app, runner):\n        cli = FlaskGroup(create_app=lambda: app)\n        return partial(runner.invoke, cli)', start: 459, tick: 5, types_hash: '431c4f94098a9977', _vid: 857}),
  (:Symbol {body_hash: 'd3f6ff78673ce5a2', deleted: false, end: 467, key: 'tests/test_cli.py::TestRoutes.expect_order', kind: 'method', name: 'expect_order', path: 'tests/test_cli.py', qualname: 'TestRoutes.expect_order', sig_hash: '7a4c5203618aaa3d', signature: 'expect_order(self, order, output)', source: '    def expect_order(self, order, output):\n        # skip the header and match the start of each row\n        for expect, line in zip(order, output.splitlines()[2:]):\n            # do this instead of startswith for nicer pytest output\n            assert line[: len(expect)] == expect', start: 463, tick: 5, types_hash: '44d68e6d00c7a1c6', _vid: 858}),
  (:Symbol {body_hash: '36d0fe19de67bc85', deleted: false, end: 472, key: 'tests/test_cli.py::TestRoutes.test_simple', kind: 'method', name: 'test_simple', path: 'tests/test_cli.py', qualname: 'TestRoutes.test_simple', sig_hash: '142ff5c0d4ab2cbf', signature: 'test_simple(self, invoke)', source: '    def test_simple(self, invoke):\n        result = invoke(["routes"])\n        assert result.exit_code == 0\n        self.expect_order(["aaa_post", "static", "yyy_get_post"], result.output)', start: 469, tick: 5, types_hash: 'be4b389d3da4c3b5', _vid: 859}),
  (:Symbol {body_hash: '7b834826fae0c2d1', deleted: false, end: 487, key: 'tests/test_cli.py::TestRoutes.test_sort', kind: 'method', name: 'test_sort', path: 'tests/test_cli.py', qualname: 'TestRoutes.test_sort', sig_hash: '03d8b896407dc9d3', signature: 'test_sort(self, app, invoke)', source: '    def test_sort(self, app, invoke):\n        default_output = invoke(["routes"]).output\n        endpoint_output = invoke(["routes", "-s", "endpoint"]).output\n        assert default_output == endpoint_output\n        self.expect_order(\n            ["static", "yyy_get_post", "aaa_post"],\n            invoke(["routes", "-s", "methods"]).output,\n        )\n        self.expect_order(\n            ["yyy_get_post", "static", "aaa_post"],\n            invoke(["routes", "-s", "rule"]).output,\n        )\n        match_order = [r.endpoint for r in app.url_map.iter_rules()]\n        self.expect_order(match_order, invoke(["routes", "-s", "match"]).output)', start: 474, tick: 5, types_hash: '4c117dba4f317c3e', _vid: 860}),
  (:Symbol {body_hash: '09d2b66c6b264e61', deleted: false, end: 493, key: 'tests/test_cli.py::TestRoutes.test_all_methods', kind: 'method', name: 'test_all_methods', path: 'tests/test_cli.py', qualname: 'TestRoutes.test_all_methods', sig_hash: '142ff5c0d4ab2cbf', signature: 'test_all_methods(self, invoke)', source: '    def test_all_methods(self, invoke):\n        output = invoke(["routes"]).output\n        assert "GET, HEAD, OPTIONS, POST" not in output\n        output = invoke(["routes", "--all-methods"]).output\n        assert "GET, HEAD, OPTIONS, POST" in output', start: 489, tick: 5, types_hash: 'be4b389d3da4c3b5', _vid: 861}),
  (:Symbol {body_hash: 'cc7f9aef672bd31a', deleted: false, end: 500, key: 'tests/test_cli.py::TestRoutes.test_no_routes', kind: 'method', name: 'test_no_routes', path: 'tests/test_cli.py', qualname: 'TestRoutes.test_no_routes', sig_hash: '341d57690054badf', signature: 'test_no_routes(self, runner)', source: '    def test_no_routes(self, runner):\n        app = Flask(__name__, static_folder=None)\n        cli = FlaskGroup(create_app=lambda: app)\n        result = runner.invoke(cli, ["routes"])\n        assert result.exit_code == 0\n        assert "No routes were registered." in result.output', start: 495, tick: 5, types_hash: '55862d53e1decaf3', _vid: 862}),
  (:Symbol {body_hash: 'e1a7412b0d2c0877', deleted: false, end: 509, key: 'tests/test_cli.py::TestRoutes.test_subdomain', kind: 'method', name: 'test_subdomain', path: 'tests/test_cli.py', qualname: 'TestRoutes.test_subdomain', sig_hash: '341d57690054badf', signature: 'test_subdomain(self, runner)', source: '    def test_subdomain(self, runner):\n        app = Flask(__name__, static_folder=None)\n        app.add_url_rule("/a", subdomain="a", endpoint="a")\n        app.add_url_rule("/b", subdomain="b", endpoint="b")\n        cli = FlaskGroup(create_app=lambda: app)\n        result = runner.invoke(cli, ["routes"])\n        assert result.exit_code == 0\n        assert "Subdomain" in result.output', start: 502, tick: 5, types_hash: '55862d53e1decaf3', _vid: 863}),
  (:Symbol {body_hash: 'c464a7c94bb50c1d', deleted: false, end: 518, key: 'tests/test_cli.py::TestRoutes.test_host', kind: 'method', name: 'test_host', path: 'tests/test_cli.py', qualname: 'TestRoutes.test_host', sig_hash: '341d57690054badf', signature: 'test_host(self, runner)', source: '    def test_host(self, runner):\n        app = Flask(__name__, static_folder=None, host_matching=True)\n        app.add_url_rule("/a", host="a", endpoint="a")\n        app.add_url_rule("/b", host="b", endpoint="b")\n        cli = FlaskGroup(create_app=lambda: app)\n        result = runner.invoke(cli, ["routes"])\n        assert result.exit_code == 0\n        assert "Host" in result.output', start: 511, tick: 5, types_hash: '55862d53e1decaf3', _vid: 864}),
  (:Symbol {body_hash: 'ea70c76d27bde9f0', deleted: false, end: 527, key: 'tests/test_cli.py::dotenv_not_available', kind: 'function', name: 'dotenv_not_available', path: 'tests/test_cli.py', qualname: 'dotenv_not_available', sig_hash: '4943fbd3d489f4fa', signature: 'dotenv_not_available()', source: 'def dotenv_not_available():\n    try:\n        import dotenv  # noqa: F401\n    except ImportError:\n        return True\n\n    return False', start: 521, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 865}),
  (:Symbol {body_hash: '49145cfc3de36c31', deleted: false, end: 556, key: 'tests/test_cli.py::test_load_dotenv', kind: 'function', name: 'test_load_dotenv', path: 'tests/test_cli.py', qualname: 'test_load_dotenv', sig_hash: '9425c7af8ac344a2', signature: 'test_load_dotenv(monkeypatch)', source: '@need_dotenv\ndef test_load_dotenv(monkeypatch):\n    # can\'t use monkeypatch.delitem since the keys don\'t exist yet\n    for item in ("FOO", "BAR", "SPAM", "HAM"):\n        monkeypatch._setitem.append((os.environ, item, notset))\n\n    monkeypatch.setenv("EGGS", "3")\n    monkeypatch.chdir(test_path)\n    assert load_dotenv()\n    assert Path.cwd() == test_path\n    # .flaskenv doesn\'t overwrite .env\n    assert os.environ["FOO"] == "env"\n    # set only in .flaskenv\n    assert os.environ["BAR"] == "bar"\n    # set only in .env\n    assert os.environ["SPAM"] == "1"\n    # set manually, files don\'t overwrite\n    assert os.environ["EGGS"] == "3"\n    # test env file encoding\n    assert os.environ["HAM"] == "火腿"\n    # Non existent file should not load\n    assert not load_dotenv("non-existent-file", load_defaults=False)', start: 536, tick: 5, types_hash: 'be76cb0cf36c6384', _vid: 866}),
  (:Symbol {body_hash: 'c251925f5c967011', deleted: false, end: 566, key: 'tests/test_cli.py::test_dotenv_path', kind: 'function', name: 'test_dotenv_path', path: 'tests/test_cli.py', qualname: 'test_dotenv_path', sig_hash: '9425c7af8ac344a2', signature: 'test_dotenv_path(monkeypatch)', source: '@need_dotenv\ndef test_dotenv_path(monkeypatch):\n    for item in ("FOO", "BAR", "EGGS"):\n        monkeypatch._setitem.append((os.environ, item, notset))\n\n    load_dotenv(test_path / ".flaskenv")\n    assert Path.cwd() == cwd\n    assert "FOO" in os.environ', start: 560, tick: 5, types_hash: 'be76cb0cf36c6384', _vid: 867}),
  (:Symbol {body_hash: '8d9c3f7d0121b771', deleted: false, end: 573, key: 'tests/test_cli.py::test_dotenv_optional', kind: 'function', name: 'test_dotenv_optional', path: 'tests/test_cli.py', qualname: 'test_dotenv_optional', sig_hash: '9425c7af8ac344a2', signature: 'test_dotenv_optional(monkeypatch)', source: 'def test_dotenv_optional(monkeypatch):\n    monkeypatch.setitem(sys.modules, "dotenv", None)\n    monkeypatch.chdir(test_path)\n    load_dotenv()\n    assert "FOO" not in os.environ', start: 569, tick: 5, types_hash: 'be76cb0cf36c6384', _vid: 868}),
  (:Symbol {body_hash: '53b8afb884104437', deleted: false, end: 581, key: 'tests/test_cli.py::test_disable_dotenv_from_env', kind: 'function', name: 'test_disable_dotenv_from_env', path: 'tests/test_cli.py', qualname: 'test_disable_dotenv_from_env', sig_hash: '28b464f269201cbf', signature: 'test_disable_dotenv_from_env(monkeypatch, runner)', source: '@need_dotenv\ndef test_disable_dotenv_from_env(monkeypatch, runner):\n    monkeypatch.chdir(test_path)\n    monkeypatch.setitem(os.environ, "FLASK_SKIP_DOTENV", "1")\n    runner.invoke(FlaskGroup())\n    assert "FOO" not in os.environ', start: 577, tick: 5, types_hash: 'f1f477a09508dfd5', _vid: 869}),
  (:Symbol {body_hash: '318abea4637a9d4f', deleted: false, end: 599, key: 'tests/test_cli.py::test_run_cert_path', kind: 'function', name: 'test_run_cert_path', path: 'tests/test_cli.py', qualname: 'test_run_cert_path', sig_hash: '4943fbd3d489f4fa', signature: 'test_run_cert_path()', source: 'def test_run_cert_path():\n    # no key\n    with pytest.raises(click.BadParameter):\n        run_command.make_context("run", ["--cert", __file__])\n\n    # no cert\n    with pytest.raises(click.BadParameter):\n        run_command.make_context("run", ["--key", __file__])\n\n    # cert specified first\n    ctx = run_command.make_context("run", ["--cert", __file__, "--key", __file__])\n    assert ctx.params["cert"] == (__file__, __file__)\n\n    # key specified first\n    ctx = run_command.make_context("run", ["--key", __file__, "--cert", __file__])\n    assert ctx.params["cert"] == (__file__, __file__)', start: 584, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 870}),
  (:Symbol {body_hash: '0b7334e65a6bbfc1', deleted: false, end: 616, key: 'tests/test_cli.py::test_run_cert_adhoc', kind: 'function', name: 'test_run_cert_adhoc', path: 'tests/test_cli.py', qualname: 'test_run_cert_adhoc', sig_hash: '9425c7af8ac344a2', signature: 'test_run_cert_adhoc(monkeypatch)', source: 'def test_run_cert_adhoc(monkeypatch):\n    monkeypatch.setitem(sys.modules, "cryptography", None)\n\n    # cryptography not installed\n    with pytest.raises(click.BadParameter):\n        run_command.make_context("run", ["--cert", "adhoc"])\n\n    # cryptography installed\n    monkeypatch.setitem(sys.modules, "cryptography", types.ModuleType("cryptography"))\n    ctx = run_command.make_context("run", ["--cert", "adhoc"])\n    assert ctx.params["cert"] == "adhoc"\n\n    # no key with adhoc\n    with pytest.raises(click.BadParameter):\n        run_command.make_context("run", ["--cert", "adhoc", "--key", __file__])', start: 602, tick: 5, types_hash: 'be76cb0cf36c6384', _vid: 871}),
  (:Symbol {body_hash: 'dd086d175041d4ac', deleted: false, end: 638, key: 'tests/test_cli.py::test_run_cert_import', kind: 'function', name: 'test_run_cert_import', path: 'tests/test_cli.py', qualname: 'test_run_cert_import', sig_hash: '9425c7af8ac344a2', signature: 'test_run_cert_import(monkeypatch)', source: 'def test_run_cert_import(monkeypatch):\n    monkeypatch.setitem(sys.modules, "not_here", None)\n\n    # ImportError\n    with pytest.raises(click.BadParameter):\n        run_command.make_context("run", ["--cert", "not_here"])\n\n    with pytest.raises(click.BadParameter):\n        run_command.make_context("run", ["--cert", "flask"])\n\n    # SSLContext\n    ssl_context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)\n\n    monkeypatch.setitem(sys.modules, "ssl_context", ssl_context)\n    ctx = run_command.make_context("run", ["--cert", "ssl_context"])\n    assert ctx.params["cert"] is ssl_context\n\n    # no --key with SSLContext\n    with pytest.raises(click.BadParameter):\n        run_command.make_context("run", ["--cert", "ssl_context", "--key", __file__])', start: 619, tick: 5, types_hash: 'be76cb0cf36c6384', _vid: 872}),
  (:Symbol {body_hash: '7ba9a4d57249a01d', deleted: false, end: 645, key: 'tests/test_cli.py::test_run_cert_no_ssl', kind: 'function', name: 'test_run_cert_no_ssl', path: 'tests/test_cli.py', qualname: 'test_run_cert_no_ssl', sig_hash: '9425c7af8ac344a2', signature: 'test_run_cert_no_ssl(monkeypatch)', source: 'def test_run_cert_no_ssl(monkeypatch):\n    monkeypatch.setitem(sys.modules, "ssl", None)\n\n    with pytest.raises(click.BadParameter):\n        run_command.make_context("run", ["--cert", "not_here"])', start: 641, tick: 5, types_hash: 'be76cb0cf36c6384', _vid: 873}),
  (:Symbol {body_hash: 'f18d43f485c7ee80', deleted: false, end: 688, key: 'tests/test_cli.py::test_cli_blueprints', kind: 'function', name: 'test_cli_blueprints', path: 'tests/test_cli.py', qualname: 'test_cli_blueprints', sig_hash: '462ce794eb370ded', signature: 'test_cli_blueprints(app)', source: 'def test_cli_blueprints(app):\n    """Test blueprint commands register correctly to the application"""\n    custom = Blueprint("custom", __name__, cli_group="customized")\n    nested = Blueprint("nested", __name__)\n    merged = Blueprint("merged", __name__, cli_group=None)\n    late = Blueprint("late", __name__)\n\n    @custom.cli.command("custom")\n    def custom_command():\n        click.echo("custom_result")\n\n    @nested.cli.command("nested")\n    def nested_command():\n        click.echo("nested_result")\n\n    @merged.cli.command("merged")\n    def merged_command():\n        click.echo("merged_result")\n\n    @late.cli.command("late")\n    def late_command():\n        click.echo("late_result")\n\n    app.register_blueprint(custom)\n    app.register_blueprint(nested)\n    app.register_blueprint(merged)\n    app.register_blueprint(late, cli_group="late_registration")\n\n    app_runner = app.test_cli_runner()\n\n    result = app_runner.invoke(args=["customized", "custom"])\n    assert "custom_result" in result.output\n\n    result = app_runner.invoke(args=["nested", "nested"])\n    assert "nested_result" in result.output\n\n    result = app_runner.invoke(args=["merged"])\n    assert "merged_result" in result.output\n\n    result = app_runner.invoke(args=["late_registration", "late"])\n    assert "late_result" in result.output', start: 648, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 874}),
  (:Symbol {body_hash: '4b68325f97aaede5', deleted: false, end: 697, key: 'tests/test_cli.py::test_cli_empty', kind: 'function', name: 'test_cli_empty', path: 'tests/test_cli.py', qualname: 'test_cli_empty', sig_hash: '462ce794eb370ded', signature: 'test_cli_empty(app)', source: 'def test_cli_empty(app):\n    """If a Blueprint\'s CLI group is empty, do not register it."""\n    bp = Blueprint("blue", __name__, cli_group="blue")\n    app.register_blueprint(bp)\n\n    result = app.test_cli_runner().invoke(args=["blue", "--help"])\n    assert result.exit_code == 2, f"Unexpected success:\\n\\n{result.output}"', start: 691, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 875}),
  (:Symbol {body_hash: '4616283f908da287', deleted: false, end: 9, key: 'tests/test_config.py::TEST_KEY', kind: 'constant', name: 'TEST_KEY', path: 'tests/test_config.py', qualname: 'TEST_KEY', sig_hash: '4616283f908da287', signature: 'TEST_KEY = "foo"', source: 'TEST_KEY = "foo"', start: 9, tick: 5, types_hash: '', _vid: 876}),
  (:Symbol {body_hash: 'b3a9567914178160', deleted: false, end: 10, key: 'tests/test_config.py::SECRET_KEY', kind: 'constant', name: 'SECRET_KEY', path: 'tests/test_config.py', qualname: 'SECRET_KEY', sig_hash: 'b3a9567914178160', signature: 'SECRET_KEY = "config"', source: 'SECRET_KEY = "config"', start: 10, tick: 5, types_hash: '', _vid: 877}),
  (:Symbol {body_hash: 'd13605e57f98b768', deleted: false, end: 16, key: 'tests/test_config.py::common_object_test', kind: 'function', name: 'common_object_test', path: 'tests/test_config.py', qualname: 'common_object_test', sig_hash: '462ce794eb370ded', signature: 'common_object_test(app)', source: 'def common_object_test(app):\n    assert app.secret_key == "config"\n    assert app.config["TEST_KEY"] == "foo"\n    assert "TestConfig" not in app.config', start: 13, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 878}),
  (:Symbol {body_hash: 'e81b2167b516a626', deleted: false, end: 22, key: 'tests/test_config.py::test_config_from_pyfile', kind: 'function', name: 'test_config_from_pyfile', path: 'tests/test_config.py', qualname: 'test_config_from_pyfile', sig_hash: '4943fbd3d489f4fa', signature: 'test_config_from_pyfile()', source: 'def test_config_from_pyfile():\n    app = flask.Flask(__name__)\n    app.config.from_pyfile(f"{__file__.rsplit(\'.\', 1)[0]}.py")\n    common_object_test(app)', start: 19, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 879}),
  (:Symbol {body_hash: 'd7bf1cec48dcaba7', deleted: false, end: 28, key: 'tests/test_config.py::test_config_from_object', kind: 'function', name: 'test_config_from_object', path: 'tests/test_config.py', qualname: 'test_config_from_object', sig_hash: '4943fbd3d489f4fa', signature: 'test_config_from_object()', source: 'def test_config_from_object():\n    app = flask.Flask(__name__)\n    app.config.from_object(__name__)\n    common_object_test(app)', start: 25, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 880}),
  (:Symbol {body_hash: 'a0ec1a7569605f2b', deleted: false, end: 35, key: 'tests/test_config.py::test_config_from_file_json', kind: 'function', name: 'test_config_from_file_json', path: 'tests/test_config.py', qualname: 'test_config_from_file_json', sig_hash: '4943fbd3d489f4fa', signature: 'test_config_from_file_json()', source: 'def test_config_from_file_json():\n    app = flask.Flask(__name__)\n    current_dir = os.path.dirname(os.path.abspath(__file__))\n    app.config.from_file(os.path.join(current_dir, "static", "config.json"), json.load)\n    common_object_test(app)', start: 31, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 881}),
  (:Symbol {body_hash: '5d8872ee1a8485d9', deleted: false, end: 45, key: 'tests/test_config.py::test_config_from_file_toml', kind: 'function', name: 'test_config_from_file_toml', path: 'tests/test_config.py', qualname: 'test_config_from_file_toml', sig_hash: '4943fbd3d489f4fa', signature: 'test_config_from_file_toml()', source: 'def test_config_from_file_toml():\n    tomllib = pytest.importorskip("tomllib", reason="tomllib added in 3.11")\n    app = flask.Flask(__name__)\n    current_dir = os.path.dirname(os.path.abspath(__file__))\n    app.config.from_file(\n        os.path.join(current_dir, "static", "config.toml"), tomllib.load, text=False\n    )\n    common_object_test(app)', start: 38, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 882}),
  (:Symbol {body_hash: '6fdd7083ee16eb92', deleted: false, end: 66, key: 'tests/test_config.py::test_from_prefixed_env', kind: 'function', name: 'test_from_prefixed_env', path: 'tests/test_config.py', qualname: 'test_from_prefixed_env', sig_hash: '9425c7af8ac344a2', signature: 'test_from_prefixed_env(monkeypatch)', source: 'def test_from_prefixed_env(monkeypatch):\n    monkeypatch.setenv("FLASK_STRING", "value")\n    monkeypatch.setenv("FLASK_BOOL", "true")\n    monkeypatch.setenv("FLASK_INT", "1")\n    monkeypatch.setenv("FLASK_FLOAT", "1.2")\n    monkeypatch.setenv("FLASK_LIST", "[1, 2]")\n    monkeypatch.setenv("FLASK_DICT", \'{"k": "v"}\')\n    monkeypatch.setenv("NOT_FLASK_OTHER", "other")\n\n    app = flask.Flask(__name__)\n    app.config.from_prefixed_env()\n\n    assert app.config["STRING"] == "value"\n    assert app.config["BOOL"] is True\n    assert app.config["INT"] == 1\n    assert app.config["FLOAT"] == 1.2\n    assert app.config["LIST"] == [1, 2]\n    assert app.config["DICT"] == {"k": "v"}\n    assert "OTHER" not in app.config', start: 48, tick: 5, types_hash: 'be76cb0cf36c6384', _vid: 883}),
  (:Symbol {body_hash: '0ab76e52d52a571e', deleted: false, end: 76, key: 'tests/test_config.py::test_from_prefixed_env_custom_prefix', kind: 'function', name: 'test_from_prefixed_env_custom_prefix', path: 'tests/test_config.py', qualname: 'test_from_prefixed_env_custom_prefix', sig_hash: '9425c7af8ac344a2', signature: 'test_from_prefixed_env_custom_prefix(monkeypatch)', source: 'def test_from_prefixed_env_custom_prefix(monkeypatch):\n    monkeypatch.setenv("FLASK_A", "a")\n    monkeypatch.setenv("NOT_FLASK_A", "b")\n\n    app = flask.Flask(__name__)\n    app.config.from_prefixed_env("NOT_FLASK")\n\n    assert app.config["A"] == "b"', start: 69, tick: 5, types_hash: 'be76cb0cf36c6384', _vid: 884}),
  (:Symbol {body_hash: '99cafdb45116d8f3', deleted: false, end: 107, key: 'tests/test_config.py::test_from_prefixed_env_nested', kind: 'function', name: 'test_from_prefixed_env_nested', path: 'tests/test_config.py', qualname: 'test_from_prefixed_env_nested', sig_hash: '9425c7af8ac344a2', signature: 'test_from_prefixed_env_nested(monkeypatch)', source: 'def test_from_prefixed_env_nested(monkeypatch):\n    monkeypatch.setenv("FLASK_EXIST__ok", "other")\n    monkeypatch.setenv("FLASK_EXIST__inner__ik", "2")\n    monkeypatch.setenv("FLASK_EXIST__new__more", \'{"k": false}\')\n    monkeypatch.setenv("FLASK_NEW__K", "v")\n\n    app = flask.Flask(__name__)\n    app.config["EXIST"] = {"ok": "value", "flag": True, "inner": {"ik": 1}}\n    app.config.from_prefixed_env()\n\n    if os.name != "nt":\n        assert app.config["EXIST"] == {\n            "ok": "other",\n            "flag": True,\n            "inner": {"ik": 2},\n            "new": {"more": {"k": False}},\n        }\n    else:\n        # Windows env var keys are always uppercase.\n        assert app.config["EXIST"] == {\n            "ok": "value",\n            "OK": "other",\n            "flag": True,\n            "inner": {"ik": 1},\n            "INNER": {"IK": 2},\n            "NEW": {"MORE": {"k": False}},\n        }\n\n    assert app.config["NEW"] == {"K": "v"}', start: 79, tick: 5, types_hash: 'be76cb0cf36c6384', _vid: 885}),
  (:Symbol {body_hash: 'f61bfe921889ef4f', deleted: false, end: 129, key: 'tests/test_config.py::test_config_from_mapping', kind: 'function', name: 'test_config_from_mapping', path: 'tests/test_config.py', qualname: 'test_config_from_mapping', sig_hash: '4943fbd3d489f4fa', signature: 'test_config_from_mapping()', source: 'def test_config_from_mapping():\n    app = flask.Flask(__name__)\n    app.config.from_mapping({"SECRET_KEY": "config", "TEST_KEY": "foo"})\n    common_object_test(app)\n\n    app = flask.Flask(__name__)\n    app.config.from_mapping([("SECRET_KEY", "config"), ("TEST_KEY", "foo")])\n    common_object_test(app)\n\n    app = flask.Flask(__name__)\n    app.config.from_mapping(SECRET_KEY="config", TEST_KEY="foo")\n    common_object_test(app)\n\n    app = flask.Flask(__name__)\n    app.config.from_mapping(SECRET_KEY="config", TEST_KEY="foo", skip_key="skip")\n    common_object_test(app)\n\n    app = flask.Flask(__name__)\n    with pytest.raises(TypeError):\n        app.config.from_mapping({}, {})', start: 110, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 886}),
  (:Symbol {body_hash: 'c45e1cc2febf71c8', deleted: false, end: 141, key: 'tests/test_config.py::test_config_from_class', kind: 'function', name: 'test_config_from_class', path: 'tests/test_config.py', qualname: 'test_config_from_class', sig_hash: '4943fbd3d489f4fa', signature: 'test_config_from_class()', source: 'def test_config_from_class():\n    class Base:\n        TEST_KEY = "foo"\n\n    class Test(Base):\n        SECRET_KEY = "config"\n\n    app = flask.Flask(__name__)\n    app.config.from_object(Test)\n    common_object_test(app)', start: 132, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 887}),
  (:Symbol {body_hash: '4aba17d8cee7ca46', deleted: false, end: 158, key: 'tests/test_config.py::test_config_from_envvar', kind: 'function', name: 'test_config_from_envvar', path: 'tests/test_config.py', qualname: 'test_config_from_envvar', sig_hash: '9425c7af8ac344a2', signature: 'test_config_from_envvar(monkeypatch)', source: 'def test_config_from_envvar(monkeypatch):\n    monkeypatch.setattr("os.environ", {})\n    app = flask.Flask(__name__)\n\n    with pytest.raises(RuntimeError) as e:\n        app.config.from_envvar("FOO_SETTINGS")\n\n    assert "\'FOO_SETTINGS\' is not set" in str(e.value)\n    assert not app.config.from_envvar("FOO_SETTINGS", silent=True)\n\n    monkeypatch.setattr(\n        "os.environ", {"FOO_SETTINGS": f"{__file__.rsplit(\'.\', 1)[0]}.py"}\n    )\n    assert app.config.from_envvar("FOO_SETTINGS")\n    common_object_test(app)', start: 144, tick: 5, types_hash: 'be76cb0cf36c6384', _vid: 888}),
  (:Symbol {body_hash: 'a416630a4ee40e73', deleted: false, end: 171, key: 'tests/test_config.py::test_config_from_envvar_missing', kind: 'function', name: 'test_config_from_envvar_missing', path: 'tests/test_config.py', qualname: 'test_config_from_envvar_missing', sig_hash: '9425c7af8ac344a2', signature: 'test_config_from_envvar_missing(monkeypatch)', source: 'def test_config_from_envvar_missing(monkeypatch):\n    monkeypatch.setattr("os.environ", {"FOO_SETTINGS": "missing.cfg"})\n    app = flask.Flask(__name__)\n    with pytest.raises(IOError) as e:\n        app.config.from_envvar("FOO_SETTINGS")\n    msg = str(e.value)\n    assert msg.startswith(\n        "[Errno 2] Unable to load configuration file (No such file or directory):"\n    )\n    assert msg.endswith("missing.cfg\'")\n    assert not app.config.from_envvar("FOO_SETTINGS", silent=True)', start: 161, tick: 5, types_hash: 'be76cb0cf36c6384', _vid: 889}),
  (:Symbol {body_hash: '545fee567db0755f', deleted: false, end: 183, key: 'tests/test_config.py::test_config_missing', kind: 'function', name: 'test_config_missing', path: 'tests/test_config.py', qualname: 'test_config_missing', sig_hash: '4943fbd3d489f4fa', signature: 'test_config_missing()', source: 'def test_config_missing():\n    app = flask.Flask(__name__)\n    with pytest.raises(IOError) as e:\n        app.config.from_pyfile("missing.cfg")\n    msg = str(e.value)\n    assert msg.startswith(\n        "[Errno 2] Unable to load configuration file (No such file or directory):"\n    )\n    assert msg.endswith("missing.cfg\'")\n    assert not app.config.from_pyfile("missing.cfg", silent=True)', start: 174, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 890}),
  (:Symbol {body_hash: '92c25a71dc669aa7', deleted: false, end: 195, key: 'tests/test_config.py::test_config_missing_file', kind: 'function', name: 'test_config_missing_file', path: 'tests/test_config.py', qualname: 'test_config_missing_file', sig_hash: '4943fbd3d489f4fa', signature: 'test_config_missing_file()', source: 'def test_config_missing_file():\n    app = flask.Flask(__name__)\n    with pytest.raises(IOError) as e:\n        app.config.from_file("missing.json", load=json.load)\n    msg = str(e.value)\n    assert msg.startswith(\n        "[Errno 2] Unable to load configuration file (No such file or directory):"\n    )\n    assert msg.endswith("missing.json\'")\n    assert not app.config.from_file("missing.json", load=json.load, silent=True)', start: 186, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 891}),
  (:Symbol {body_hash: '8dd14af5771550fb', deleted: false, end: 208, key: 'tests/test_config.py::test_custom_config_class', kind: 'function', name: 'test_custom_config_class', path: 'tests/test_config.py', qualname: 'test_custom_config_class', sig_hash: '4943fbd3d489f4fa', signature: 'test_custom_config_class()', source: 'def test_custom_config_class():\n    class Config(flask.Config):\n        pass\n\n    class Flask(flask.Flask):\n        config_class = Config\n\n    app = Flask(__name__)\n    assert isinstance(app.config, Config)\n    app.config.from_object(__name__)\n    common_object_test(app)', start: 198, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 892}),
  (:Symbol {body_hash: '89942164010b0cb1', deleted: false, end: 214, key: 'tests/test_config.py::test_session_lifetime', kind: 'function', name: 'test_session_lifetime', path: 'tests/test_config.py', qualname: 'test_session_lifetime', sig_hash: '4943fbd3d489f4fa', signature: 'test_session_lifetime()', source: 'def test_session_lifetime():\n    app = flask.Flask(__name__)\n    app.config["PERMANENT_SESSION_LIFETIME"] = 42\n    assert app.permanent_session_lifetime.seconds == 42', start: 211, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 893}),
  (:Symbol {body_hash: '57972a62f1dc76b7', deleted: false, end: 240, key: 'tests/test_config.py::test_get_namespace', kind: 'function', name: 'test_get_namespace', path: 'tests/test_config.py', qualname: 'test_get_namespace', sig_hash: '4943fbd3d489f4fa', signature: 'test_get_namespace()', source: 'def test_get_namespace():\n    app = flask.Flask(__name__)\n    app.config["FOO_OPTION_1"] = "foo option 1"\n    app.config["FOO_OPTION_2"] = "foo option 2"\n    app.config["BAR_STUFF_1"] = "bar stuff 1"\n    app.config["BAR_STUFF_2"] = "bar stuff 2"\n    foo_options = app.config.get_namespace("FOO_")\n    assert 2 == len(foo_options)\n    assert "foo option 1" == foo_options["option_1"]\n    assert "foo option 2" == foo_options["option_2"]\n    bar_options = app.config.get_namespace("BAR_", lowercase=False)\n    assert 2 == len(bar_options)\n    assert "bar stuff 1" == bar_options["STUFF_1"]\n    assert "bar stuff 2" == bar_options["STUFF_2"]\n    foo_options = app.config.get_namespace("FOO_", trim_namespace=False)\n    assert 2 == len(foo_options)\n    assert "foo option 1" == foo_options["foo_option_1"]\n    assert "foo option 2" == foo_options["foo_option_2"]\n    bar_options = app.config.get_namespace(\n        "BAR_", lowercase=False, trim_namespace=False\n    )\n    assert 2 == len(bar_options)\n    assert "bar stuff 1" == bar_options["BAR_STUFF_1"]\n    assert "bar stuff 2" == bar_options["BAR_STUFF_2"]', start: 217, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 894}),
  (:Symbol {body_hash: '655817758506efab', deleted: false, end: 250, key: 'tests/test_config.py::test_from_pyfile_weird_encoding', kind: 'function', name: 'test_from_pyfile_weird_encoding', path: 'tests/test_config.py', qualname: 'test_from_pyfile_weird_encoding', sig_hash: 'd561642330f8579e', signature: 'test_from_pyfile_weird_encoding(tmp_path, encoding)', source: '@pytest.mark.parametrize("encoding", ["utf-8", "iso-8859-15", "latin-1"])\ndef test_from_pyfile_weird_encoding(tmp_path, encoding):\n    f = tmp_path / "my_config.py"\n    f.write_text(f\'# -*- coding: {encoding} -*-\\nTEST_VALUE = "föö"\\n\', encoding)\n    app = flask.Flask(__name__)\n    app.config.from_pyfile(os.fspath(f))\n    value = app.config["TEST_VALUE"]\n    assert value == "föö"', start: 244, tick: 5, types_hash: 'ec4fadf06a49645c', _vid: 895}),
  (:Symbol {body_hash: 'd860577175c9ed62', deleted: false, end: 26, key: 'tests/test_converters.py::test_custom_converters', kind: 'function', name: 'test_custom_converters', path: 'tests/test_converters.py', qualname: 'test_custom_converters', sig_hash: 'df6ec3162cad163f', signature: 'test_custom_converters(app, client)', source: 'def test_custom_converters(app, client):\n    class ListConverter(BaseConverter):\n        def to_python(self, value):\n            return value.split(",")\n\n        def to_url(self, value):\n            base_to_url = super().to_url\n            return ",".join(base_to_url(x) for x in value)\n\n    app.url_map.converters["list"] = ListConverter\n\n    @app.route("/<list:args>")\n    def index(args):\n        return "|".join(args)\n\n    assert client.get("/1,2,3").data == b"1|2|3"\n\n    with app.test_request_context():\n        assert url_for("index", args=[4, 5, 6]) == "/4,5,6"', start: 8, tick: 1, types_hash: '95304b3d97188d9c', _vid: 896}),
  (:Symbol {body_hash: '86f4acbde2d19411', deleted: false, end: 42, key: 'tests/test_converters.py::test_context_available', kind: 'function', name: 'test_context_available', path: 'tests/test_converters.py', qualname: 'test_context_available', sig_hash: 'df6ec3162cad163f', signature: 'test_context_available(app, client)', source: 'def test_context_available(app, client):\n    class ContextConverter(BaseConverter):\n        def to_python(self, value):\n            assert request is not None\n            assert session is not None\n            return value\n\n    app.url_map.converters["ctx"] = ContextConverter\n\n    @app.get("/<ctx:name>")\n    def index(name):\n        return name\n\n    assert client.get("/admin").data == b"admin"', start: 29, tick: 1, types_hash: '95304b3d97188d9c', _vid: 897}),
  (:Symbol {body_hash: '42edcf929d3e4a17', deleted: false, end: 22, key: 'tests/test_helpers.py::FakePath', kind: 'class', name: 'FakePath', path: 'tests/test_helpers.py', qualname: 'FakePath', sig_hash: '42ba610a86d15094', signature: 'class FakePath', source: 'class FakePath:\n    """Fake object to represent a ``PathLike object``.\n\n    This represents a ``pathlib.Path`` object in python 3.\n    See: https://www.python.org/dev/peps/pep-0519/\n    """\n\n    def __init__(self, path):\n        self.path = path\n\n    def __fspath__(self):\n        return self.path', start: 11, tick: 5, types_hash: '', _vid: 898}),
  (:Symbol {body_hash: '35391a1045ce6b93', deleted: false, end: 19, key: 'tests/test_helpers.py::FakePath.__init__', kind: 'method', name: '__init__', path: 'tests/test_helpers.py', qualname: 'FakePath.__init__', sig_hash: 'dad73af2c8bc2f8a', signature: '__init__(self, path)', source: '    def __init__(self, path):\n        self.path = path', start: 18, tick: 5, types_hash: 'abb40d14140533f6', _vid: 899}),
