  (:Symbol {body_hash: '49388e19575419bd', deleted: false, end: 141, key: 'tests/test_helpers.py::TestUrlFor.test_url_for_with_alternating_schemes', kind: 'method', name: 'test_url_for_with_alternating_schemes', path: 'tests/test_helpers.py', qualname: 'TestUrlFor.test_url_for_with_alternating_schemes', sig_hash: 'b277783819d26a03', signature: 'test_url_for_with_alternating_schemes(self, app, req_ctx)', source: '    def test_url_for_with_alternating_schemes(self, app, req_ctx):\n        @app.route("/")\n        def index():\n            return "42"\n\n        assert flask.url_for("index", _external=True) == "http://localhost/"\n        assert (\n            flask.url_for("index", _external=True, _scheme="https")\n            == "https://localhost/"\n        )\n        assert flask.url_for("index", _external=True) == "http://localhost/"', start: 131, tick: 5, types_hash: '0dd1f85cbc066703', _vid: 912}),
  (:Symbol {body_hash: 'd4ae33f66365337f', deleted: false, end: 162, key: 'tests/test_helpers.py::TestUrlFor.test_url_with_method', kind: 'method', name: 'test_url_with_method', path: 'tests/test_helpers.py', qualname: 'TestUrlFor.test_url_with_method', sig_hash: 'b277783819d26a03', signature: 'test_url_with_method(self, app, req_ctx)', source: '    def test_url_with_method(self, app, req_ctx):\n        from flask.views import MethodView\n\n        class MyView(MethodView):\n            def get(self, id=None):\n                if id is None:\n                    return "List"\n                return f"Get {id:d}"\n\n            def post(self):\n                return "Create"\n\n        myview = MyView.as_view("myview")\n        app.add_url_rule("/myview/", methods=["GET"], view_func=myview)\n        app.add_url_rule("/myview/<int:id>", methods=["GET"], view_func=myview)\n        app.add_url_rule("/myview/create", methods=["POST"], view_func=myview)\n\n        assert flask.url_for("myview", _method="GET") == "/myview/"\n        assert flask.url_for("myview", id=42, _method="GET") == "/myview/42"\n        assert flask.url_for("myview", _method="POST") == "/myview/create"', start: 143, tick: 5, types_hash: '0dd1f85cbc066703', _vid: 913}),
  (:Symbol {body_hash: '5d71d83fcbb858e5', deleted: false, end: 175, key: 'tests/test_helpers.py::test_redirect_no_app', kind: 'function', name: 'test_redirect_no_app', path: 'tests/test_helpers.py', qualname: 'test_redirect_no_app', sig_hash: '4943fbd3d489f4fa', signature: 'test_redirect_no_app()', source: 'def test_redirect_no_app():\n    response = flask.redirect("https://localhost", 307)\n    assert response.location == "https://localhost"\n    assert response.status_code == 307', start: 172, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 914}),
  (:Symbol {body_hash: '53d762445cd9481d', deleted: false, end: 185, key: 'tests/test_helpers.py::test_redirect_with_app', kind: 'function', name: 'test_redirect_with_app', path: 'tests/test_helpers.py', qualname: 'test_redirect_with_app', sig_hash: '462ce794eb370ded', signature: 'test_redirect_with_app(app)', source: 'def test_redirect_with_app(app):\n    def redirect(location, code=302):\n        raise ValueError\n\n    app.redirect = redirect\n\n    with app.app_context(), pytest.raises(ValueError):\n        flask.redirect("other")', start: 178, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 915}),
  (:Symbol {body_hash: '4e03f3c4e8708404', deleted: false, end: 193, key: 'tests/test_helpers.py::test_abort_no_app', kind: 'function', name: 'test_abort_no_app', path: 'tests/test_helpers.py', qualname: 'test_abort_no_app', sig_hash: '4943fbd3d489f4fa', signature: 'test_abort_no_app()', source: 'def test_abort_no_app():\n    with pytest.raises(werkzeug.exceptions.Unauthorized):\n        flask.abort(401)\n\n    with pytest.raises(LookupError):\n        flask.abort(900)', start: 188, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 916}),
  (:Symbol {body_hash: '20618c0aee934bc6', deleted: false, end: 204, key: 'tests/test_helpers.py::test_app_aborter_class', kind: 'function', name: 'test_app_aborter_class', path: 'tests/test_helpers.py', qualname: 'test_app_aborter_class', sig_hash: '4943fbd3d489f4fa', signature: 'test_app_aborter_class()', source: 'def test_app_aborter_class():\n    class MyAborter(werkzeug.exceptions.Aborter):\n        pass\n\n    class MyFlask(flask.Flask):\n        aborter_class = MyAborter\n\n    app = MyFlask(__name__)\n    assert isinstance(app.aborter, MyAborter)', start: 196, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 917}),
  (:Symbol {body_hash: 'b818c38257167b98', deleted: false, end: 214, key: 'tests/test_helpers.py::test_abort_with_app', kind: 'function', name: 'test_abort_with_app', path: 'tests/test_helpers.py', qualname: 'test_abort_with_app', sig_hash: '462ce794eb370ded', signature: 'test_abort_with_app(app)', source: 'def test_abort_with_app(app):\n    class My900Error(werkzeug.exceptions.HTTPException):\n        code = 900\n\n    app.aborter.mapping[900] = My900Error\n\n    with app.app_context(), pytest.raises(My900Error):\n        flask.abort(900)', start: 207, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 918}),
  (:Symbol {body_hash: '9a29dc68b980aa4d', deleted: false, end: 233, key: 'tests/test_helpers.py::TestNoImports', kind: 'class', name: 'TestNoImports', path: 'tests/test_helpers.py', qualname: 'TestNoImports', sig_hash: '42ba610a86d15094', signature: 'class TestNoImports', source: 'class TestNoImports:\n    """Test Flasks are created without import.\n\n    Avoiding ``__import__`` helps create Flask instances where there are errors\n    at import time.  Those runtime errors will be apparent to the user soon\n    enough, but tools which build Flask instances meta-programmatically benefit\n    from a Flask which does not ``__import__``.  Instead of importing to\n    retrieve file paths or metadata on a module or package, use the pkgutil and\n    imp modules in the Python standard library.\n    """\n\n    def test_name_with_import_error(self, modules_tmp_path):\n        (modules_tmp_path / "importerror.py").write_text("raise NotImplementedError()")\n        try:\n            flask.Flask("importerror")\n        except NotImplementedError:\n            AssertionError("Flask(import_name) is importing import_name.")', start: 217, tick: 5, types_hash: '', _vid: 919}),
  (:Symbol {body_hash: '2952ddf9c2e8f247', deleted: false, end: 233, key: 'tests/test_helpers.py::TestNoImports.test_name_with_import_error', kind: 'method', name: 'test_name_with_import_error', path: 'tests/test_helpers.py', qualname: 'TestNoImports.test_name_with_import_error', sig_hash: '33c6674765129cd8', signature: 'test_name_with_import_error(self, modules_tmp_path)', source: '    def test_name_with_import_error(self, modules_tmp_path):\n        (modules_tmp_path / "importerror.py").write_text("raise NotImplementedError()")\n        try:\n            flask.Flask("importerror")\n        except NotImplementedError:\n            AssertionError("Flask(import_name) is importing import_name.")', start: 228, tick: 5, types_hash: '63be09331cc9b3ee', _vid: 920}),
  (:Symbol {body_hash: 'be20fc66f60af288', deleted: false, end: 307, key: 'tests/test_helpers.py::TestStreaming', kind: 'class', name: 'TestStreaming', path: 'tests/test_helpers.py', qualname: 'TestStreaming', sig_hash: '42ba610a86d15094', signature: 'class TestStreaming', source: 'class TestStreaming:\n    def test_streaming_with_context(self, app, client):\n        @app.route("/")\n        def index():\n            def generate():\n                yield "Hello "\n                yield flask.request.args["name"]\n                yield "!"\n\n            return flask.Response(flask.stream_with_context(generate()))\n\n        rv = client.get("/?name=World")\n        assert rv.data == b"Hello World!"\n\n    def test_streaming_with_context_as_decorator(self, app, client):\n        @app.route("/")\n        def index():\n            @flask.stream_with_context\n            def generate(hello):\n                yield hello\n                yield flask.request.args["name"]\n                yield "!"\n\n            return flask.Response(generate("Hello "))\n\n        rv = client.get("/?name=World")\n        assert rv.data == b"Hello World!"\n\n    def test_streaming_with_context_and_custom_close(self, app, client):\n        called = []\n\n        class Wrapper:\n            def __init__(self, gen):\n                self._gen = gen\n\n            def __iter__(self):\n                return self\n\n            def close(self):\n                called.append(42)\n\n            def __next__(self):\n                return next(self._gen)\n\n            next = __next__\n\n        @app.route("/")\n        def index():\n            def generate():\n                yield "Hello "\n                yield flask.request.args["name"]\n                yield "!"\n\n            return flask.Response(flask.stream_with_context(Wrapp\n…', start: 236, tick: 5, types_hash: '', _vid: 921}),
  (:Symbol {body_hash: '1e437c234e4c0d28', deleted: false, end: 248, key: 'tests/test_helpers.py::TestStreaming.test_streaming_with_context', kind: 'method', name: 'test_streaming_with_context', path: 'tests/test_helpers.py', qualname: 'TestStreaming.test_streaming_with_context', sig_hash: '42f384d1dcac74c7', signature: 'test_streaming_with_context(self, app, client)', source: '    def test_streaming_with_context(self, app, client):\n        @app.route("/")\n        def index():\n            def generate():\n                yield "Hello "\n                yield flask.request.args["name"]\n                yield "!"\n\n            return flask.Response(flask.stream_with_context(generate()))\n\n        rv = client.get("/?name=World")\n        assert rv.data == b"Hello World!"', start: 237, tick: 5, types_hash: 'e7e6568a5bdd7b03', _vid: 922}),
  (:Symbol {body_hash: '5a7d3c5230188889', deleted: false, end: 262, key: 'tests/test_helpers.py::TestStreaming.test_streaming_with_context_as_decorator', kind: 'method', name: 'test_streaming_with_context_as_decorator', path: 'tests/test_helpers.py', qualname: 'TestStreaming.test_streaming_with_context_as_decorator', sig_hash: '42f384d1dcac74c7', signature: 'test_streaming_with_context_as_decorator(self, app, client)', source: '    def test_streaming_with_context_as_decorator(self, app, client):\n        @app.route("/")\n        def index():\n            @flask.stream_with_context\n            def generate(hello):\n                yield hello\n                yield flask.request.args["name"]\n                yield "!"\n\n            return flask.Response(generate("Hello "))\n\n        rv = client.get("/?name=World")\n        assert rv.data == b"Hello World!"', start: 250, tick: 5, types_hash: 'e7e6568a5bdd7b03', _vid: 923}),
  (:Symbol {body_hash: '67f5b175699abd72', deleted: false, end: 293, key: 'tests/test_helpers.py::TestStreaming.test_streaming_with_context_and_custom_close', kind: 'method', name: 'test_streaming_with_context_and_custom_close', path: 'tests/test_helpers.py', qualname: 'TestStreaming.test_streaming_with_context_and_custom_close', sig_hash: '42f384d1dcac74c7', signature: 'test_streaming_with_context_and_custom_close(self, app, client)', source: '    def test_streaming_with_context_and_custom_close(self, app, client):\n        called = []\n\n        class Wrapper:\n            def __init__(self, gen):\n                self._gen = gen\n\n            def __iter__(self):\n                return self\n\n            def close(self):\n                called.append(42)\n\n            def __next__(self):\n                return next(self._gen)\n\n            next = __next__\n\n        @app.route("/")\n        def index():\n            def generate():\n                yield "Hello "\n                yield flask.request.args["name"]\n                yield "!"\n\n            return flask.Response(flask.stream_with_context(Wrapper(generate())))\n\n        rv = client.get("/?name=World")\n        assert rv.data == b"Hello World!"\n        assert called == [42]', start: 264, tick: 5, types_hash: 'e7e6568a5bdd7b03', _vid: 924}),
  (:Symbol {body_hash: '6e5fc62dec29809a', deleted: false, end: 307, key: 'tests/test_helpers.py::TestStreaming.test_stream_keeps_session', kind: 'method', name: 'test_stream_keeps_session', path: 'tests/test_helpers.py', qualname: 'TestStreaming.test_stream_keeps_session', sig_hash: '42f384d1dcac74c7', signature: 'test_stream_keeps_session(self, app, client)', source: '    def test_stream_keeps_session(self, app, client):\n        @app.route("/")\n        def index():\n            flask.session["test"] = "flask"\n\n            @flask.stream_with_context\n            def gen():\n                yield flask.session["test"]\n\n            return flask.Response(gen())\n\n        rv = client.get("/")\n        assert rv.data == b"flask"', start: 295, tick: 5, types_hash: 'e7e6568a5bdd7b03', _vid: 925}),
  (:Symbol {body_hash: '3df68fd3b38ef63d', deleted: false, end: 335, key: 'tests/test_helpers.py::TestHelpers', kind: 'class', name: 'TestHelpers', path: 'tests/test_helpers.py', qualname: 'TestHelpers', sig_hash: '42ba610a86d15094', signature: 'class TestHelpers', source: 'class TestHelpers:\n    @pytest.mark.parametrize(\n        ("debug", "expect"),\n        [\n            ("", False),\n            ("0", False),\n            ("False", False),\n            ("No", False),\n            ("True", True),\n        ],\n    )\n    def test_get_debug_flag(self, monkeypatch, debug, expect):\n        monkeypatch.setenv("FLASK_DEBUG", debug)\n        assert get_debug_flag() == expect\n\n    def test_make_response(self):\n        app = flask.Flask(__name__)\n        with app.test_request_context():\n            rv = flask.helpers.make_response()\n            assert rv.status_code == 200\n            assert rv.mimetype == "text/html"\n\n            rv = flask.helpers.make_response("Hello")\n            assert rv.status_code == 200\n            assert rv.data == b"Hello"\n            assert rv.mimetype == "text/html"', start: 310, tick: 5, types_hash: '', _vid: 926}),
  (:Symbol {body_hash: 'a80c930bff551e35', deleted: false, end: 323, key: 'tests/test_helpers.py::TestHelpers.test_get_debug_flag', kind: 'method', name: 'test_get_debug_flag', path: 'tests/test_helpers.py', qualname: 'TestHelpers.test_get_debug_flag', sig_hash: '1d40b49bb120623e', signature: 'test_get_debug_flag(self, monkeypatch, debug, expect)', source: '    @pytest.mark.parametrize(\n        ("debug", "expect"),\n        [\n            ("", False),\n            ("0", False),\n            ("False", False),\n            ("No", False),\n            ("True", True),\n        ],\n    )\n    def test_get_debug_flag(self, monkeypatch, debug, expect):\n        monkeypatch.setenv("FLASK_DEBUG", debug)\n        assert get_debug_flag() == expect', start: 321, tick: 5, types_hash: 'cafe31b6137fa5eb', _vid: 927}),
  (:Symbol {body_hash: '1f2c1fdf8e14827f', deleted: false, end: 335, key: 'tests/test_helpers.py::TestHelpers.test_make_response', kind: 'method', name: 'test_make_response', path: 'tests/test_helpers.py', qualname: 'TestHelpers.test_make_response', sig_hash: '9626d105938f0039', signature: 'test_make_response(self)', source: '    def test_make_response(self):\n        app = flask.Flask(__name__)\n        with app.test_request_context():\n            rv = flask.helpers.make_response()\n            assert rv.status_code == 200\n            assert rv.mimetype == "text/html"\n\n            rv = flask.helpers.make_response("Hello")\n            assert rv.status_code == 200\n            assert rv.data == b"Hello"\n            assert rv.mimetype == "text/html"', start: 325, tick: 5, types_hash: '10a585bd39808d65', _vid: 928}),
  (:Symbol {body_hash: '67de868e1f2675fd', deleted: true, deleted_tick: 5, end: 335, key: 'tests/test_helpers.py::TestHelpers.test_open_resource', kind: 'method', name: 'test_open_resource', path: 'tests/test_helpers.py', qualname: 'TestHelpers.test_open_resource', sig_hash: '80e351da28872ad0', signature: 'test_open_resource(self, mode)', source: '    @pytest.mark.parametrize("mode", ("r", "rb", "rt"))\n    def test_open_resource(self, mode):\n        app = flask.Flask(__name__)\n\n        with app.open_resource("static/index.html", mode) as f:\n            assert "<h1>Hello World!</h1>" in str(f.read())', start: 331, tick: 1, types_hash: 'ba2ced196f6255b3', _vid: 929}),
  (:Symbol {body_hash: '61c6a3face44740f', deleted: true, deleted_tick: 5, end: 342, key: 'tests/test_helpers.py::TestHelpers.test_open_resource_exceptions', kind: 'method', name: 'test_open_resource_exceptions', path: 'tests/test_helpers.py', qualname: 'TestHelpers.test_open_resource_exceptions', sig_hash: '80e351da28872ad0', signature: 'test_open_resource_exceptions(self, mode)', source: '    @pytest.mark.parametrize("mode", ("w", "x", "a", "r+"))\n    def test_open_resource_exceptions(self, mode):\n        app = flask.Flask(__name__)\n\n        with pytest.raises(ValueError):\n            app.open_resource("static/index.html", mode)', start: 338, tick: 1, types_hash: 'ba2ced196f6255b3', _vid: 930}),
  (:Symbol {body_hash: 'd47b69d41d07fd09', deleted: false, end: 13, key: 'tests/test_instance_config.py::test_explicit_instance_paths', kind: 'function', name: 'test_explicit_instance_paths', path: 'tests/test_instance_config.py', qualname: 'test_explicit_instance_paths', sig_hash: 'ee6acd0c2d00902c', signature: 'test_explicit_instance_paths(modules_tmp_path)', source: 'def test_explicit_instance_paths(modules_tmp_path):\n    with pytest.raises(ValueError, match=".*must be absolute"):\n        flask.Flask(__name__, instance_path="instance")\n\n    app = flask.Flask(__name__, instance_path=os.fspath(modules_tmp_path))\n    assert app.instance_path == os.fspath(modules_tmp_path)', start: 8, tick: 5, types_hash: '74e3107ec8901447', _vid: 931}),
  (:Symbol {body_hash: '5d2687eb79b0605b', deleted: false, end: 27, key: 'tests/test_instance_config.py::test_uninstalled_module_paths', kind: 'function', name: 'test_uninstalled_module_paths', path: 'tests/test_instance_config.py', qualname: 'test_uninstalled_module_paths', sig_hash: '70da557406e35ee1', signature: 'test_uninstalled_module_paths(modules_tmp_path, purge_module)', source: 'def test_uninstalled_module_paths(modules_tmp_path, purge_module):\n    (modules_tmp_path / "config_module_app.py").write_text(\n        "import os\\n"\n        "import flask\\n"\n        "here = os.path.abspath(os.path.dirname(__file__))\\n"\n        "app = flask.Flask(__name__)\\n"\n    )\n    purge_module("config_module_app")\n\n    from config_module_app import app\n\n    assert app.instance_path == os.fspath(modules_tmp_path / "instance")', start: 16, tick: 5, types_hash: '3de8f4706be7f590', _vid: 932}),
  (:Symbol {body_hash: '5834862c8e0bf94e', deleted: false, end: 43, key: 'tests/test_instance_config.py::test_uninstalled_package_paths', kind: 'function', name: 'test_uninstalled_package_paths', path: 'tests/test_instance_config.py', qualname: 'test_uninstalled_package_paths', sig_hash: '70da557406e35ee1', signature: 'test_uninstalled_package_paths(modules_tmp_path, purge_module)', source: 'def test_uninstalled_package_paths(modules_tmp_path, purge_module):\n    app = modules_tmp_path / "config_package_app"\n    app.mkdir()\n    (app / "__init__.py").write_text(\n        "import os\\n"\n        "import flask\\n"\n        "here = os.path.abspath(os.path.dirname(__file__))\\n"\n        "app = flask.Flask(__name__)\\n"\n    )\n    purge_module("config_package_app")\n\n    from config_package_app import app\n\n    assert app.instance_path == os.fspath(modules_tmp_path / "instance")', start: 30, tick: 5, types_hash: '3de8f4706be7f590', _vid: 933}),
  (:Symbol {body_hash: '64ccdbeff8484e2f', deleted: false, end: 62, key: 'tests/test_instance_config.py::test_uninstalled_namespace_paths', kind: 'function', name: 'test_uninstalled_namespace_paths', path: 'tests/test_instance_config.py', qualname: 'test_uninstalled_namespace_paths', sig_hash: 'ebb1bada24f428ed', signature: 'test_uninstalled_namespace_paths(tmp_path, monkeypatch, purge_module)', source: 'def test_uninstalled_namespace_paths(tmp_path, monkeypatch, purge_module):\n    def create_namespace(package):\n        project = tmp_path / f"project-{package}"\n        monkeypatch.syspath_prepend(os.fspath(project))\n        ns = project / "namespace" / package\n        ns.mkdir(parents=True)\n        (ns / "__init__.py").write_text("import flask\\napp = flask.Flask(__name__)\\n")\n        return project\n\n    _ = create_namespace("package1")\n    project2 = create_namespace("package2")\n    purge_module("namespace.package2")\n    purge_module("namespace")\n\n    from namespace.package2 import app\n\n    assert app.instance_path == os.fspath(project2 / "instance")', start: 46, tick: 5, types_hash: '02ed6368058b92f2', _vid: 934}),
  (:Symbol {body_hash: '5328323b7389b88c', deleted: false, end: 77, key: 'tests/test_instance_config.py::test_installed_module_paths', kind: 'function', name: 'test_installed_module_paths', path: 'tests/test_instance_config.py', qualname: 'test_installed_module_paths', sig_hash: 'ba3e66aa5dfb7c58', signature: 'test_installed_module_paths(modules_tmp_path, modules_tmp_path_prefix, purge_module, site_packages, limit_loader)', source: 'def test_installed_module_paths(\n    modules_tmp_path, modules_tmp_path_prefix, purge_module, site_packages, limit_loader\n):\n    (site_packages / "site_app.py").write_text(\n        "import flask\\napp = flask.Flask(__name__)\\n"\n    )\n    purge_module("site_app")\n\n    from site_app import app\n\n    assert app.instance_path == os.fspath(\n        modules_tmp_path / "var" / "site_app-instance"\n    )', start: 65, tick: 5, types_hash: 'baba03fe26943b3b', _vid: 935}),
  (:Symbol {body_hash: '613203ce08964af8', deleted: false, end: 96, key: 'tests/test_instance_config.py::test_installed_package_paths', kind: 'function', name: 'test_installed_package_paths', path: 'tests/test_instance_config.py', qualname: 'test_installed_package_paths', sig_hash: '18de1a987688891e', signature: 'test_installed_package_paths(limit_loader, modules_tmp_path, modules_tmp_path_prefix, purge_module, monkeypatch)', source: 'def test_installed_package_paths(\n    limit_loader, modules_tmp_path, modules_tmp_path_prefix, purge_module, monkeypatch\n):\n    installed_path = modules_tmp_path / "path"\n    installed_path.mkdir()\n    monkeypatch.syspath_prepend(installed_path)\n\n    app = installed_path / "installed_package"\n    app.mkdir()\n    (app / "__init__.py").write_text("import flask\\napp = flask.Flask(__name__)\\n")\n    purge_module("installed_package")\n\n    from installed_package import app\n\n    assert app.instance_path == os.fspath(\n        modules_tmp_path / "var" / "installed_package-instance"\n    )', start: 80, tick: 5, types_hash: '410750fc11e54847', _vid: 936}),
  (:Symbol {body_hash: '41bd569250678695', deleted: false, end: 111, key: 'tests/test_instance_config.py::test_prefix_package_paths', kind: 'function', name: 'test_prefix_package_paths', path: 'tests/test_instance_config.py', qualname: 'test_prefix_package_paths', sig_hash: '9f1e7ad909ecc37d', signature: 'test_prefix_package_paths(limit_loader, modules_tmp_path, modules_tmp_path_prefix, purge_module, site_packages)', source: 'def test_prefix_package_paths(\n    limit_loader, modules_tmp_path, modules_tmp_path_prefix, purge_module, site_packages\n):\n    app = site_packages / "site_package"\n    app.mkdir()\n    (app / "__init__.py").write_text("import flask\\napp = flask.Flask(__name__)\\n")\n    purge_module("site_package")\n\n    import site_package\n\n    assert site_package.app.instance_path == os.fspath(\n        modules_tmp_path / "var" / "site_package-instance"\n    )', start: 99, tick: 5, types_hash: 'b1adedee9f49c6fc', _vid: 937}),
  (:Symbol {body_hash: 'be6eabfb34658592', deleted: true, deleted_tick: 5, end: 125, key: 'tests/test_instance_config.py::test_egg_installed_paths', kind: 'function', name: 'test_egg_installed_paths', path: 'tests/test_instance_config.py', qualname: 'test_egg_installed_paths', sig_hash: '5f7ba308d4b6423d', signature: 'test_egg_installed_paths(install_egg, modules_tmpdir, modules_tmpdir_prefix)', source: 'def test_egg_installed_paths(install_egg, modules_tmpdir, modules_tmpdir_prefix):\n    modules_tmpdir.mkdir("site_egg").join("__init__.py").write(\n        "import flask\\n\\napp = flask.Flask(__name__)"\n    )\n    install_egg("site_egg")\n    try:\n        import site_egg\n\n        assert site_egg.app.instance_path == str(\n            modules_tmpdir.join("var/").join("site_egg-instance")\n        )\n    finally:\n        if "site_egg" in sys.modules:\n            del sys.modules["site_egg"]', start: 112, tick: 1, types_hash: '2dad515301ae352a', _vid: 938}),
  (:Symbol {body_hash: '3e0a86892714288c', deleted: false, end: 27, key: 'tests/test_json.py::test_bad_request_debug_message', kind: 'function', name: 'test_bad_request_debug_message', path: 'tests/test_json.py', qualname: 'test_bad_request_debug_message', sig_hash: 'abc026480a364389', signature: 'test_bad_request_debug_message(app, client, debug)', source: '@pytest.mark.parametrize("debug", (True, False))\ndef test_bad_request_debug_message(app, client, debug):\n    app.config["DEBUG"] = debug\n    app.config["TRAP_BAD_REQUEST_ERRORS"] = False\n\n    @app.route("/json", methods=["POST"])\n    def post_json():\n        flask.request.get_json()\n        return None\n\n    rv = client.post("/json", data=None, content_type="application/json")\n    assert rv.status_code == 400\n    contains = b"Failed to decode JSON object" in rv.data\n    assert contains == debug', start: 15, tick: 5, types_hash: '81df1d3865b37b00', _vid: 939}),
  (:Symbol {body_hash: '6109920e735a49b3', deleted: false, end: 36, key: 'tests/test_json.py::test_json_bad_requests', kind: 'function', name: 'test_json_bad_requests', path: 'tests/test_json.py', qualname: 'test_json_bad_requests', sig_hash: 'df6ec3162cad163f', signature: 'test_json_bad_requests(app, client)', source: 'def test_json_bad_requests(app, client):\n    @app.route("/json", methods=["POST"])\n    def return_json():\n        return flask.jsonify(foo=str(flask.request.get_json()))\n\n    rv = client.post("/json", data="malformed", content_type="application/json")\n    assert rv.status_code == 400', start: 30, tick: 5, types_hash: '95304b3d97188d9c', _vid: 940}),
  (:Symbol {body_hash: '2fd6f6ea9f4b7af8', deleted: false, end: 45, key: 'tests/test_json.py::test_json_custom_mimetypes', kind: 'function', name: 'test_json_custom_mimetypes', path: 'tests/test_json.py', qualname: 'test_json_custom_mimetypes', sig_hash: 'df6ec3162cad163f', signature: 'test_json_custom_mimetypes(app, client)', source: 'def test_json_custom_mimetypes(app, client):\n    @app.route("/json", methods=["POST"])\n    def return_json():\n        return flask.request.get_json()\n\n    rv = client.post("/json", data=\'"foo"\', content_type="application/x+json")\n    assert rv.data == b"foo"', start: 39, tick: 5, types_hash: '95304b3d97188d9c', _vid: 941}),
  (:Symbol {body_hash: '5a9956ccea4acd8d', deleted: false, end: 54, key: 'tests/test_json.py::test_json_as_unicode', kind: 'function', name: 'test_json_as_unicode', path: 'tests/test_json.py', qualname: 'test_json_as_unicode', sig_hash: '2730050d94e70912', signature: 'test_json_as_unicode(test_value, expected, app, app_ctx)', source: '@pytest.mark.parametrize(\n    "test_value,expected", [(True, \'"\\\\u2603"\'), (False, \'"\\u2603"\')]\n)\ndef test_json_as_unicode(test_value, expected, app, app_ctx):\n    app.json.ensure_ascii = test_value\n    rv = app.json.dumps("\\N{SNOWMAN}")\n    assert rv == expected', start: 51, tick: 5, types_hash: 'e0492eaeebf7f1a7', _vid: 942}),
  (:Symbol {body_hash: 'c91659bfa5591587', deleted: false, end: 64, key: 'tests/test_json.py::test_json_dump_to_file', kind: 'function', name: 'test_json_dump_to_file', path: 'tests/test_json.py', qualname: 'test_json_dump_to_file', sig_hash: '3acf5b76887f15f2', signature: 'test_json_dump_to_file(app, app_ctx)', source: 'def test_json_dump_to_file(app, app_ctx):\n    test_data = {"name": "Flask"}\n    out = io.StringIO()\n\n    flask.json.dump(test_data, out)\n    out.seek(0)\n    rv = flask.json.load(out)\n    assert rv == test_data', start: 57, tick: 5, types_hash: '45f7071ec66cb28f', _vid: 943}),
  (:Symbol {body_hash: '5cddf7cf86ae8109', deleted: false, end: 75, key: 'tests/test_json.py::test_jsonify_basic_types', kind: 'function', name: 'test_jsonify_basic_types', path: 'tests/test_json.py', qualname: 'test_jsonify_basic_types', sig_hash: 'e0706261584ebb3e', signature: 'test_jsonify_basic_types(test_value, app, client)', source: '@pytest.mark.parametrize(\n    "test_value", [0, -1, 1, 23, 3.14, "s", "longer string", True, False, None]\n)\ndef test_jsonify_basic_types(test_value, app, client):\n    url = "/jsonify_basic_types"\n    app.add_url_rule(url, url, lambda x=test_value: flask.jsonify(x))\n    rv = client.get(url)\n    assert rv.mimetype == "application/json"\n    assert flask.json.loads(rv.data) == test_value', start: 70, tick: 5, types_hash: '552a2a9a8cdb5723', _vid: 944}),
  (:Symbol {body_hash: '40de99e8f106005d', deleted: false, end: 102, key: 'tests/test_json.py::test_jsonify_dicts', kind: 'function', name: 'test_jsonify_dicts', path: 'tests/test_json.py', qualname: 'test_jsonify_dicts', sig_hash: 'df6ec3162cad163f', signature: 'test_jsonify_dicts(app, client)', source: 'def test_jsonify_dicts(app, client):\n    d = {\n        "a": 0,\n        "b": 23,\n        "c": 3.14,\n        "d": "t",\n        "e": "Hi",\n        "f": True,\n        "g": False,\n        "h": ["test list", 10, False],\n        "i": {"test": "dict"},\n    }\n\n    @app.route("/kw")\n    def return_kwargs():\n        return flask.jsonify(**d)\n\n    @app.route("/dict")\n    def return_dict():\n        return flask.jsonify(d)\n\n    for url in "/kw", "/dict":\n        rv = client.get(url)\n        assert rv.mimetype == "application/json"\n        assert flask.json.loads(rv.data) == d', start: 78, tick: 5, types_hash: '95304b3d97188d9c', _vid: 945}),
  (:Symbol {body_hash: '7bdcf080d8f4435f', deleted: false, end: 130, key: 'tests/test_json.py::test_jsonify_arrays', kind: 'function', name: 'test_jsonify_arrays', path: 'tests/test_json.py', qualname: 'test_jsonify_arrays', sig_hash: 'df6ec3162cad163f', signature: 'test_jsonify_arrays(app, client)', source: 'def test_jsonify_arrays(app, client):\n    """Test jsonify of lists and args unpacking."""\n    a_list = [\n        0,\n        42,\n        3.14,\n        "t",\n        "hello",\n        True,\n        False,\n        ["test list", 2, False],\n        {"test": "dict"},\n    ]\n\n    @app.route("/args_unpack")\n    def return_args_unpack():\n        return flask.jsonify(*a_list)\n\n    @app.route("/array")\n    def return_array():\n        return flask.jsonify(a_list)\n\n    for url in "/args_unpack", "/array":\n        rv = client.get(url)\n        assert rv.mimetype == "application/json"\n        assert flask.json.loads(rv.data) == a_list', start: 105, tick: 5, types_hash: '95304b3d97188d9c', _vid: 946}),
  (:Symbol {body_hash: 'b94d34482b64605b', deleted: false, end: 142, key: 'tests/test_json.py::test_jsonify_datetime', kind: 'function', name: 'test_jsonify_datetime', path: 'tests/test_json.py', qualname: 'test_jsonify_datetime', sig_hash: '98250cfd3ba7dbf0', signature: 'test_jsonify_datetime(app, client, value)', source: '@pytest.mark.parametrize(\n    "value", [datetime.datetime(1973, 3, 11, 6, 30, 45), datetime.date(1975, 1, 5)]\n)\ndef test_jsonify_datetime(app, client, value):\n    @app.route("/")\n    def index():\n        return flask.jsonify(value=value)\n\n    r = client.get()\n    assert r.json["value"] == http_date(value)', start: 136, tick: 5, types_hash: 'd17f5a7df617ec8a', _vid: 947}),
  (:Symbol {body_hash: '6a08fc5fe8e8f6cd', deleted: false, end: 163, key: 'tests/test_json.py::FixedOffset', kind: 'class', name: 'FixedOffset', path: 'tests/test_json.py', qualname: 'FixedOffset', sig_hash: '9dd91911733207c7', signature: 'class FixedOffset(datetime.tzinfo)', source: 'class FixedOffset(datetime.tzinfo):\n    """Fixed offset in hours east from UTC.\n\n    This is a slight adaptation of the ``FixedOffset`` example found in\n    https://docs.python.org/2.7/library/datetime.html.\n    """\n\n    def __init__(self, hours, name):\n        self.__offset = datetime.timedelta(hours=hours)\n        self.__name = name\n\n    def utcoffset(self, dt):\n        return self.__offset\n\n    def tzname(self, dt):\n        return self.__name\n\n    def dst(self, dt):\n        return datetime.timedelta()', start: 145, tick: 5, types_hash: '', _vid: 948}),
  (:Symbol {body_hash: '60179a0c8ed45bab', deleted: false, end: 154, key: 'tests/test_json.py::FixedOffset.__init__', kind: 'method', name: '__init__', path: 'tests/test_json.py', qualname: 'FixedOffset.__init__', sig_hash: '25155d2d875104d5', signature: '__init__(self, hours, name)', source: '    def __init__(self, hours, name):\n        self.__offset = datetime.timedelta(hours=hours)\n        self.__name = name', start: 152, tick: 5, types_hash: 'a92cd835d1fa25f2', _vid: 949}),
  (:Symbol {body_hash: '2d8649d18f6af16f', deleted: false, end: 157, key: 'tests/test_json.py::FixedOffset.utcoffset', kind: 'method', name: 'utcoffset', path: 'tests/test_json.py', qualname: 'FixedOffset.utcoffset', sig_hash: 'a65e3d30d06d23b5', signature: 'utcoffset(self, dt)', source: '    def utcoffset(self, dt):\n        return self.__offset', start: 156, tick: 5, types_hash: '19189f599076c815', _vid: 950}),
  (:Symbol {body_hash: '195d3b8ccfe1e5d3', deleted: false, end: 160, key: 'tests/test_json.py::FixedOffset.tzname', kind: 'method', name: 'tzname', path: 'tests/test_json.py', qualname: 'FixedOffset.tzname', sig_hash: 'a65e3d30d06d23b5', signature: 'tzname(self, dt)', source: '    def tzname(self, dt):\n        return self.__name', start: 159, tick: 5, types_hash: '19189f599076c815', _vid: 951}),
  (:Symbol {body_hash: 'e233e3b0a1201caf', deleted: false, end: 163, key: 'tests/test_json.py::FixedOffset.dst', kind: 'method', name: 'dst', path: 'tests/test_json.py', qualname: 'FixedOffset.dst', sig_hash: 'a65e3d30d06d23b5', signature: 'dst(self, dt)', source: '    def dst(self, dt):\n        return datetime.timedelta()', start: 162, tick: 5, types_hash: '19189f599076c815', _vid: 952}),
  (:Symbol {body_hash: 'f33435ae5ca7a465', deleted: false, end: 173, key: 'tests/test_json.py::test_jsonify_aware_datetimes', kind: 'function', name: 'test_jsonify_aware_datetimes', path: 'tests/test_json.py', qualname: 'test_jsonify_aware_datetimes', sig_hash: '5887bbb0bbf7af73', signature: 'test_jsonify_aware_datetimes(tz)', source: '@pytest.mark.parametrize("tz", (("UTC", 0), ("PST", -8), ("KST", 9)))\ndef test_jsonify_aware_datetimes(tz):\n    """Test if aware datetime.datetime objects are converted into GMT."""\n    tzinfo = FixedOffset(hours=tz[1], name=tz[0])\n    dt = datetime.datetime(2017, 1, 1, 12, 34, 56, tzinfo=tzinfo)\n    gmt = FixedOffset(hours=0, name="GMT")\n    expected = dt.astimezone(gmt).strftime(\'"%a, %d %b %Y %H:%M:%S %Z"\')\n    assert flask.json.dumps(dt) == expected', start: 167, tick: 5, types_hash: '64a022142b1d987c', _vid: 953}),
  (:Symbol {body_hash: '0fc75a44c00eb8fb', deleted: false, end: 188, key: 'tests/test_json.py::test_jsonify_uuid_types', kind: 'function', name: 'test_jsonify_uuid_types', path: 'tests/test_json.py', qualname: 'test_jsonify_uuid_types', sig_hash: 'df6ec3162cad163f', signature: 'test_jsonify_uuid_types(app, client)', source: 'def test_jsonify_uuid_types(app, client):\n    """Test jsonify with uuid.UUID types"""\n\n    test_uuid = uuid.UUID(bytes=b"\\xde\\xad\\xbe\\xef" * 4)\n    url = "/uuid_test"\n    app.add_url_rule(url, url, lambda: flask.jsonify(x=test_uuid))\n\n    rv = client.get(url)\n\n    rv_x = flask.json.loads(rv.data)["x"]\n    assert rv_x == str(test_uuid)\n    rv_uuid = uuid.UUID(rv_x)\n    assert rv_uuid == test_uuid', start: 176, tick: 5, types_hash: '95304b3d97188d9c', _vid: 954}),
  (:Symbol {body_hash: '25cdd592dc656b54', deleted: false, end: 193, key: 'tests/test_json.py::test_json_decimal', kind: 'function', name: 'test_json_decimal', path: 'tests/test_json.py', qualname: 'test_json_decimal', sig_hash: '4943fbd3d489f4fa', signature: 'test_json_decimal()', source: 'def test_json_decimal():\n    rv = flask.json.dumps(decimal.Decimal("0.003"))\n    assert rv == \'"0.003"\'', start: 191, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 955}),
  (:Symbol {body_hash: '91b2990bb2f2d9e4', deleted: false, end: 207, key: 'tests/test_json.py::test_json_attr', kind: 'function', name: 'test_json_attr', path: 'tests/test_json.py', qualname: 'test_json_attr', sig_hash: 'df6ec3162cad163f', signature: 'test_json_attr(app, client)', source: 'def test_json_attr(app, client):\n    @app.route("/add", methods=["POST"])\n    def add():\n        json = flask.request.get_json()\n        return str(json["a"] + json["b"])\n\n    rv = client.post(\n        "/add",\n        data=flask.json.dumps({"a": 1, "b": 2}),\n        content_type="application/json",\n    )\n    assert rv.data == b"3"', start: 196, tick: 5, types_hash: '95304b3d97188d9c', _vid: 956}),
  (:Symbol {body_hash: 'bccde0ecd26d7abc', deleted: false, end: 220, key: 'tests/test_json.py::test_tojson_filter', kind: 'function', name: 'test_tojson_filter', path: 'tests/test_json.py', qualname: 'test_tojson_filter', sig_hash: '2714d7bd06e83efe', signature: 'test_tojson_filter(app, req_ctx)', source: 'def test_tojson_filter(app, req_ctx):\n    # The tojson filter is tested in Jinja, this confirms that it\'s\n    # using Flask\'s dumps.\n    rv = flask.render_template_string(\n        "const data = {{ data|tojson }};",\n        data={"name": "</script>", "time": datetime.datetime(2021, 2, 1, 7, 15)},\n    )\n    assert rv == (\n        \'const data = {"name": "\\\\u003c/script\\\\u003e",\'\n        \' "time": "Mon, 01 Feb 2021 07:15:00 GMT"};\'\n    )', start: 210, tick: 5, types_hash: '8515d83b8719fd6b', _vid: 957}),
  (:Symbol {body_hash: '55aade63923b96f7', deleted: false, end: 257, key: 'tests/test_json.py::test_json_customization', kind: 'function', name: 'test_json_customization', path: 'tests/test_json.py', qualname: 'test_json_customization', sig_hash: 'df6ec3162cad163f', signature: 'test_json_customization(app, client)', source: 'def test_json_customization(app, client):\n    class X:  # noqa: B903, for Python2 compatibility\n        def __init__(self, val):\n            self.val = val\n\n    def default(o):\n        if isinstance(o, X):\n            return f"<{o.val}>"\n\n        return DefaultJSONProvider.default(o)\n\n    class CustomProvider(DefaultJSONProvider):\n        def object_hook(self, obj):\n            if len(obj) == 1 and "_foo" in obj:\n                return X(obj["_foo"])\n\n            return obj\n\n        def loads(self, s, **kwargs):\n            kwargs.setdefault("object_hook", self.object_hook)\n            return super().loads(s, **kwargs)\n\n    app.json = CustomProvider(app)\n    app.json.default = default\n\n    @app.route("/", methods=["POST"])\n    def index():\n        return flask.json.dumps(flask.request.get_json()["x"])\n\n    rv = client.post(\n        "/",\n        data=flask.json.dumps({"x": {"_foo": 42}}),\n        content_type="application/json",\n    )\n    assert rv.data == b\'"<42>"\'', start: 223, tick: 5, types_hash: '95304b3d97188d9c', _vid: 958}),
  (:Symbol {body_hash: '227987dd6d1fb511', deleted: false, end: 267, key: 'tests/test_json.py::_has_encoding', kind: 'function', name: '_has_encoding', path: 'tests/test_json.py', qualname: '_has_encoding', sig_hash: '7e99456a26cf0784', signature: '_has_encoding(name)', source: 'def _has_encoding(name):\n    try:\n        import codecs\n\n        codecs.lookup(name)\n        return True\n    except LookupError:\n        return False', start: 260, tick: 5, types_hash: '14b63a1f3dc89cd8', _vid: 959}),
  (:Symbol {body_hash: '4b6ac7fe45c4071a', deleted: false, end: 337, key: 'tests/test_json.py::test_json_key_sorting', kind: 'function', name: 'test_json_key_sorting', path: 'tests/test_json.py', qualname: 'test_json_key_sorting', sig_hash: 'df6ec3162cad163f', signature: 'test_json_key_sorting(app, client)', source: 'def test_json_key_sorting(app, client):\n    app.debug = True\n    assert app.json.sort_keys\n    d = dict.fromkeys(range(20), "foo")\n\n    @app.route("/")\n    def index():\n        return flask.jsonify(values=d)\n\n    rv = client.get("/")\n    lines = [x.strip() for x in rv.data.strip().decode("utf-8").splitlines()]\n    sorted_by_str = [\n        "{",\n        \'"values": {\',\n        \'"0": "foo",\',\n        \'"1": "foo",\',\n        \'"10": "foo",\',\n        \'"11": "foo",\',\n        \'"12": "foo",\',\n        \'"13": "foo",\',\n        \'"14": "foo",\',\n        \'"15": "foo",\',\n        \'"16": "foo",\',\n        \'"17": "foo",\',\n        \'"18": "foo",\',\n        \'"19": "foo",\',\n        \'"2": "foo",\',\n        \'"3": "foo",\',\n        \'"4": "foo",\',\n        \'"5": "foo",\',\n        \'"6": "foo",\',\n        \'"7": "foo",\',\n        \'"8": "foo",\',\n        \'"9": "foo"\',\n        "}",\n        "}",\n    ]\n    sorted_by_int = [\n        "{",\n        \'"values": {\',\n        \'"0": "foo",\',\n        \'"1": "foo",\',\n        \'"2": "foo",\',\n        \'"3": "foo",\',\n        \'"4": "foo",\',\n        \'"5": "foo",\',\n        \'"6": "foo",\',\n        \'"7": "foo",\',\n        \'"8": "foo",\',\n        \'"9": "foo",\',\n        \'"10": "foo",\',\n        \'"11": "foo",\',\n        \'"12": "foo",\',\n        \'"13": "foo",\',\n        \'"14": "foo",\',\n        \'"15": "foo",\',\n        \'"16": "foo",\',\n        \'"17": "foo",\',\n        \'"18": "foo",\',\n        \'"19": "foo"\',\n        "}",\n        "}",\n    ]\n\n    try:\n        assert lines == sorted_by_int\n    except AssertionEr\n…', start: 270, tick: 5, types_hash: '95304b3d97188d9c', _vid: 960}),
  (:Symbol {body_hash: '23742b2fa835b3f2', deleted: false, end: 346, key: 'tests/test_json.py::test_html_method', kind: 'function', name: 'test_html_method', path: 'tests/test_json.py', qualname: 'test_html_method', sig_hash: '4943fbd3d489f4fa', signature: 'test_html_method()', source: 'def test_html_method():\n    class ObjectWithHTML:\n        def __html__(self):\n            return "<p>test</p>"\n\n    result = json.dumps(ObjectWithHTML())\n    assert result == \'"<p>test</p>"\'', start: 340, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 961}),
  (:Symbol {body_hash: '30de22f1871b0d39', deleted: false, end: 29, key: 'tests/test_json_tag.py::test_dump_load_unchanged', kind: 'function', name: 'test_dump_load_unchanged', path: 'tests/test_json_tag.py', qualname: 'test_dump_load_unchanged', sig_hash: '67e0a898e1188c04', signature: 'test_dump_load_unchanged(data)', source: '@pytest.mark.parametrize(\n    "data",\n    (\n        {" t": (1, 2, 3)},\n        {" t__": b"a"},\n        {" di": " di"},\n        {"x": (1, 2, 3), "y": 4},\n        (1, 2, 3),\n        [(1, 2, 3)],\n        b"\\xff",\n        Markup("<html>"),\n        uuid4(),\n        datetime.now(tz=timezone.utc).replace(microsecond=0),\n    ),\n)\ndef test_dump_load_unchanged(data):\n    s = TaggedJSONSerializer()\n    assert s.loads(s.dumps(data)) == data', start: 27, tick: 1, types_hash: 'd21b4978fdc741f9', _vid: 962}),
  (:Symbol {body_hash: 'cdba3ecf71c57dd3', deleted: false, end: 40, key: 'tests/test_json_tag.py::test_duplicate_tag', kind: 'function', name: 'test_duplicate_tag', path: 'tests/test_json_tag.py', qualname: 'test_duplicate_tag', sig_hash: '4943fbd3d489f4fa', signature: 'test_duplicate_tag()', source: 'def test_duplicate_tag():\n    class TagDict(JSONTag):\n        key = " d"\n\n    s = TaggedJSONSerializer()\n    pytest.raises(KeyError, s.register, TagDict)\n    s.register(TagDict, force=True, index=0)\n    assert isinstance(s.tags[" d"], TagDict)\n    assert isinstance(s.order[0], TagDict)', start: 32, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 963}),
  (:Symbol {body_hash: '1afeefb428fab08d', deleted: false, end: 63, key: 'tests/test_json_tag.py::test_custom_tag', kind: 'function', name: 'test_custom_tag', path: 'tests/test_json_tag.py', qualname: 'test_custom_tag', sig_hash: '4943fbd3d489f4fa', signature: 'test_custom_tag()', source: 'def test_custom_tag():\n    class Foo:  # noqa: B903, for Python2 compatibility\n        def __init__(self, data):\n            self.data = data\n\n    class TagFoo(JSONTag):\n        __slots__ = ()\n        key = " f"\n\n        def check(self, value):\n            return isinstance(value, Foo)\n\n        def to_json(self, value):\n            return self.serializer.tag(value.data)\n\n        def to_python(self, value):\n            return Foo(value)\n\n    s = TaggedJSONSerializer()\n    s.register(TagFoo)\n    assert s.loads(s.dumps(Foo("bar"))).data == "bar"', start: 43, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 964}),
  (:Symbol {body_hash: '54a0808f402fb69e', deleted: false, end: 70, key: 'tests/test_json_tag.py::test_tag_interface', kind: 'function', name: 'test_tag_interface', path: 'tests/test_json_tag.py', qualname: 'test_tag_interface', sig_hash: '4943fbd3d489f4fa', signature: 'test_tag_interface()', source: 'def test_tag_interface():\n    t = JSONTag(None)\n    pytest.raises(NotImplementedError, t.check, None)\n    pytest.raises(NotImplementedError, t.to_json, None)\n    pytest.raises(NotImplementedError, t.to_python, None)', start: 66, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 965}),
  (:Symbol {body_hash: '0e644e6abc45a8f3', deleted: false, end: 86, key: 'tests/test_json_tag.py::test_tag_order', kind: 'function', name: 'test_tag_order', path: 'tests/test_json_tag.py', qualname: 'test_tag_order', sig_hash: '4943fbd3d489f4fa', signature: 'test_tag_order()', source: 'def test_tag_order():\n    class Tag1(JSONTag):\n        key = " 1"\n\n    class Tag2(JSONTag):\n        key = " 2"\n\n    s = TaggedJSONSerializer()\n\n    s.register(Tag1, index=-1)\n    assert isinstance(s.order[-2], Tag1)\n\n    s.register(Tag2, index=None)\n    assert isinstance(s.order[-1], Tag2)', start: 73, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 966}),
  (:Symbol {body_hash: '5e00268324cb8b34', deleted: false, end: 33, key: 'tests/test_logging.py::reset_logging', kind: 'function', name: 'reset_logging', path: 'tests/test_logging.py', qualname: 'reset_logging', sig_hash: '2ae580f944ff9aa3', signature: 'reset_logging(pytestconfig)', source: '@pytest.fixture(autouse=True)\ndef reset_logging(pytestconfig):\n    root_handlers = logging.root.handlers[:]\n    logging.root.handlers = []\n    root_level = logging.root.level\n\n    logger = logging.getLogger("flask_test")\n    logger.handlers = []\n    logger.setLevel(logging.NOTSET)\n\n    logging_plugin = pytestconfig.pluginmanager.unregister(name="logging-plugin")\n\n    yield\n\n    logging.root.handlers[:] = root_handlers\n    logging.root.setLevel(root_level)\n\n    logger.handlers = []\n    logger.setLevel(logging.NOTSET)\n\n    if logging_plugin:\n        pytestconfig.pluginmanager.register(logging_plugin, "logging-plugin")', start: 13, tick: 1, types_hash: 'eb2929bb5d49e2d2', _vid: 967}),
  (:Symbol {body_hash: '103517a471e6461b', deleted: false, end: 39, key: 'tests/test_logging.py::test_logger', kind: 'function', name: 'test_logger', path: 'tests/test_logging.py', qualname: 'test_logger', sig_hash: '462ce794eb370ded', signature: 'test_logger(app)', source: 'def test_logger(app):\n    assert app.logger.name == "flask_test"\n    assert app.logger.level == logging.NOTSET\n    assert app.logger.handlers == [default_handler]', start: 36, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 968}),
  (:Symbol {body_hash: '2e4843dee4be9663', deleted: false, end: 45, key: 'tests/test_logging.py::test_logger_debug', kind: 'function', name: 'test_logger_debug', path: 'tests/test_logging.py', qualname: 'test_logger_debug', sig_hash: '462ce794eb370ded', signature: 'test_logger_debug(app)', source: 'def test_logger_debug(app):\n    app.debug = True\n    assert app.logger.level == logging.DEBUG\n    assert app.logger.handlers == [default_handler]', start: 42, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 969}),
  (:Symbol {body_hash: 'eaabdd7a34a7125a', deleted: false, end: 51, key: 'tests/test_logging.py::test_existing_handler', kind: 'function', name: 'test_existing_handler', path: 'tests/test_logging.py', qualname: 'test_existing_handler', sig_hash: '462ce794eb370ded', signature: 'test_existing_handler(app)', source: 'def test_existing_handler(app):\n    logging.root.addHandler(logging.StreamHandler())\n    assert app.logger.level == logging.NOTSET\n    assert not app.logger.handlers', start: 48, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 970}),
  (:Symbol {body_hash: 'bea403431d685fa9', deleted: false, end: 67, key: 'tests/test_logging.py::test_wsgi_errors_stream', kind: 'function', name: 'test_wsgi_errors_stream', path: 'tests/test_logging.py', qualname: 'test_wsgi_errors_stream', sig_hash: 'df6ec3162cad163f', signature: 'test_wsgi_errors_stream(app, client)', source: 'def test_wsgi_errors_stream(app, client):\n    @app.route("/")\n    def index():\n        app.logger.error("test")\n        return ""\n\n    stream = StringIO()\n    client.get("/", errors_stream=stream)\n    assert "ERROR in test_logging: test" in stream.getvalue()\n\n    assert wsgi_errors_stream._get_current_object() is sys.stderr\n\n    with app.test_request_context(errors_stream=stream):\n        assert wsgi_errors_stream._get_current_object() is stream', start: 54, tick: 1, types_hash: '95304b3d97188d9c', _vid: 971}),
  (:Symbol {body_hash: '9fe1e577bd12a81c', deleted: false, end: 83, key: 'tests/test_logging.py::test_has_level_handler', kind: 'function', name: 'test_has_level_handler', path: 'tests/test_logging.py', qualname: 'test_has_level_handler', sig_hash: '4943fbd3d489f4fa', signature: 'test_has_level_handler()', source: 'def test_has_level_handler():\n    logger = logging.getLogger("flask.app")\n    assert not has_level_handler(logger)\n\n    handler = logging.StreamHandler()\n    logging.root.addHandler(handler)\n    assert has_level_handler(logger)\n\n    logger.propagate = False\n    assert not has_level_handler(logger)\n    logger.propagate = True\n\n    handler.setLevel(logging.ERROR)\n    assert not has_level_handler(logger)', start: 70, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 972}),
  (:Symbol {body_hash: '6c9c815920a95a30', deleted: false, end: 98, key: 'tests/test_logging.py::test_log_view_exception', kind: 'function', name: 'test_log_view_exception', path: 'tests/test_logging.py', qualname: 'test_log_view_exception', sig_hash: 'df6ec3162cad163f', signature: 'test_log_view_exception(app, client)', source: 'def test_log_view_exception(app, client):\n    @app.route("/")\n    def index():\n        raise Exception("test")\n\n    app.testing = False\n    stream = StringIO()\n    rv = client.get("/", errors_stream=stream)\n    assert rv.status_code == 500\n    assert rv.data\n    err = stream.getvalue()\n    assert "Exception on / [GET]" in err\n    assert "Exception: test" in err', start: 86, tick: 1, types_hash: '95304b3d97188d9c', _vid: 973}),
  (:Symbol {body_hash: '4d2f9ada444ddd54', deleted: false, end: 30, key: 'tests/test_regression.py::test_aborting', kind: 'function', name: 'test_aborting', path: 'tests/test_regression.py', qualname: 'test_aborting', sig_hash: '462ce794eb370ded', signature: 'test_aborting(app)', source: 'def test_aborting(app):\n    class Foo(Exception):\n        whatever = 42\n\n    @app.errorhandler(Foo)\n    def handle_foo(e):\n        return str(e.whatever)\n\n    @app.route("/")\n    def index():\n        raise flask.abort(flask.redirect(flask.url_for("test")))\n\n    @app.route("/test")\n    def test():\n        raise Foo()\n\n    with app.test_client() as c:\n        rv = c.get("/")\n        location_parts = rv.headers["Location"].rpartition("/")\n\n        if location_parts[0]:\n            # For older Werkzeug that used absolute redirects.\n            assert location_parts[0] == "http://localhost"\n\n        assert location_parts[2] == "test"\n        rv = c.get("/test")\n        assert rv.data == b"42"', start: 4, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 974}),
  (:Symbol {body_hash: '4e3788964cea52d2', deleted: false, end: 27, key: 'tests/test_reqctx.py::test_teardown_on_pop', kind: 'function', name: 'test_teardown_on_pop', path: 'tests/test_reqctx.py', qualname: 'test_teardown_on_pop', sig_hash: '462ce794eb370ded', signature: 'test_teardown_on_pop(app)', source: 'def test_teardown_on_pop(app):\n    buffer = []\n\n    @app.teardown_request\n    def end_of_request(exception):\n        buffer.append(exception)\n\n    ctx = app.test_request_context()\n    ctx.push()\n    assert buffer == []\n    ctx.pop()\n    assert buffer == [None]', start: 16, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 975}),
  (:Symbol {body_hash: '2f624f2da2bea8ef', deleted: false, end: 44, key: 'tests/test_reqctx.py::test_teardown_with_previous_exception', kind: 'function', name: 'test_teardown_with_previous_exception', path: 'tests/test_reqctx.py', qualname: 'test_teardown_with_previous_exception', sig_hash: '462ce794eb370ded', signature: 'test_teardown_with_previous_exception(app)', source: 'def test_teardown_with_previous_exception(app):\n    buffer = []\n\n    @app.teardown_request\n    def end_of_request(exception):\n        buffer.append(exception)\n\n    try:\n        raise Exception("dummy")\n    except Exception:\n        pass\n\n    with app.test_request_context():\n        assert buffer == []\n    assert buffer == [None]', start: 30, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 976}),
  (:Symbol {body_hash: '35367693c5a66c39', deleted: false, end: 60, key: 'tests/test_reqctx.py::test_teardown_with_handled_exception', kind: 'function', name: 'test_teardown_with_handled_exception', path: 'tests/test_reqctx.py', qualname: 'test_teardown_with_handled_exception', sig_hash: '462ce794eb370ded', signature: 'test_teardown_with_handled_exception(app)', source: 'def test_teardown_with_handled_exception(app):\n    buffer = []\n\n    @app.teardown_request\n    def end_of_request(exception):\n        buffer.append(exception)\n\n    with app.test_request_context():\n        assert buffer == []\n        try:\n            raise Exception("dummy")\n        except Exception:\n            pass\n    assert buffer == [None]', start: 47, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 977}),
  (:Symbol {body_hash: '8fbaa87260a12170', deleted: false, end: 104, key: 'tests/test_reqctx.py::test_proper_test_request_context', kind: 'function', name: 'test_proper_test_request_context', path: 'tests/test_reqctx.py', qualname: 'test_proper_test_request_context', sig_hash: '462ce794eb370ded', signature: 'test_proper_test_request_context(app)', source: 'def test_proper_test_request_context(app):\n    app.config.update(SERVER_NAME="localhost.localdomain:5000")\n\n    @app.route("/")\n    def index():\n        return None\n\n    @app.route("/", subdomain="foo")\n    def sub():\n        return None\n\n    with app.test_request_context("/"):\n        assert (\n            flask.url_for("index", _external=True)\n            == "http://localhost.localdomain:5000/"\n        )\n\n    with app.test_request_context("/"):\n        assert (\n            flask.url_for("sub", _external=True)\n            == "http://foo.localhost.localdomain:5000/"\n        )\n\n    # suppress Werkzeug 0.15 warning about name mismatch\n    with warnings.catch_warnings():\n        warnings.filterwarnings(\n            "ignore", "Current server name", UserWarning, "flask.app"\n        )\n        with app.test_request_context(\n            "/", environ_overrides={"HTTP_HOST": "localhost"}\n        ):\n            pass\n\n    app.config.update(SERVER_NAME="localhost")\n    with app.test_request_context("/", environ_overrides={"SERVER_NAME": "localhost"}):\n        pass\n\n    app.config.update(SERVER_NAME="localhost:80")\n    with app.test_request_context(\n        "/", environ_overrides={"SERVER_NAME": "localhost:80"}\n    ):\n        pass', start: 63, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 978}),
  (:Symbol {body_hash: '2b488ccc98a8e773', deleted: false, end: 120, key: 'tests/test_reqctx.py::test_context_binding', kind: 'function', name: 'test_context_binding', path: 'tests/test_reqctx.py', qualname: 'test_context_binding', sig_hash: '462ce794eb370ded', signature: 'test_context_binding(app)', source: 'def test_context_binding(app):\n    @app.route("/")\n    def index():\n        return f"Hello {flask.request.args[\'name\']}!"\n\n    @app.route("/meh")\n    def meh():\n        return flask.request.url\n\n    with app.test_request_context("/?name=World"):\n        assert index() == "Hello World!"\n    with app.test_request_context("/meh"):\n        assert meh() == "http://localhost/meh"\n    assert not flask.request', start: 107, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 979}),
  (:Symbol {body_hash: 'f0d480c9b951a273', deleted: false, end: 132, key: 'tests/test_reqctx.py::test_context_test', kind: 'function', name: 'test_context_test', path: 'tests/test_reqctx.py', qualname: 'test_context_test', sig_hash: '462ce794eb370ded', signature: 'test_context_test(app)', source: 'def test_context_test(app):\n    assert not flask.request\n    assert not flask.has_request_context()\n    ctx = app.test_request_context()\n    ctx.push()\n    try:\n        assert flask.request\n        assert flask.has_request_context()\n    finally:\n        ctx.pop()', start: 123, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 980}),
  (:Symbol {body_hash: '2531e3e67c98a764', deleted: false, end: 145, key: 'tests/test_reqctx.py::test_manual_context_binding', kind: 'function', name: 'test_manual_context_binding', path: 'tests/test_reqctx.py', qualname: 'test_manual_context_binding', sig_hash: '462ce794eb370ded', signature: 'test_manual_context_binding(app)', source: 'def test_manual_context_binding(app):\n    @app.route("/")\n    def index():\n        return f"Hello {flask.request.args[\'name\']}!"\n\n    ctx = app.test_request_context("/?name=World")\n    ctx.push()\n    assert index() == "Hello World!"\n    ctx.pop()\n    with pytest.raises(RuntimeError):\n        index()', start: 135, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 981}),
  (:Symbol {body_hash: 'ac8513417e0d32b9', deleted: false, end: 202, key: 'tests/test_reqctx.py::TestGreenletContextCopying', kind: 'class', name: 'TestGreenletContextCopying', path: 'tests/test_reqctx.py', qualname: 'TestGreenletContextCopying', sig_hash: '42ba610a86d15094', signature: 'class TestGreenletContextCopying', source: '@pytest.mark.skipif(greenlet is None, reason="greenlet not installed")\nclass TestGreenletContextCopying:\n    def test_greenlet_context_copying(self, app, client):\n        greenlets = []\n\n        @app.route("/")\n        def index():\n            flask.session["fizz"] = "buzz"\n            reqctx = request_ctx.copy()\n\n            def g():\n                assert not flask.request\n                assert not flask.current_app\n                with reqctx:\n                    assert flask.request\n                    assert flask.current_app == app\n                    assert flask.request.path == "/"\n                    assert flask.request.args["foo"] == "bar"\n                    assert flask.session.get("fizz") == "buzz"\n                assert not flask.request\n                return 42\n\n            greenlets.append(greenlet(g))\n            return "Hello World!"\n\n        rv = client.get("/?foo=bar")\n        assert rv.data == b"Hello World!"\n\n        result = greenlets[0].run()\n        assert result == 42\n\n    def test_greenlet_context_copying_api(self, app, client):\n        greenlets = []\n\n        @app.route("/")\n        def index():\n            flask.session["fizz"] = "buzz"\n\n            @flask.copy_current_request_context\n            def g():\n                assert flask.request\n                assert flask.current_app == app\n                assert flask.request.path == "/"\n                assert flask.request.args["foo"] == "bar"\n                assert flask.session.get("fizz") ==\n…', start: 149, tick: 1, types_hash: '', _vid: 982}),
  (:Symbol {body_hash: 'daca83a87b1edeed', deleted: false, end: 177, key: 'tests/test_reqctx.py::TestGreenletContextCopying.test_greenlet_context_copying', kind: 'method', name: 'test_greenlet_context_copying', path: 'tests/test_reqctx.py', qualname: 'TestGreenletContextCopying.test_greenlet_context_copying', sig_hash: '42f384d1dcac74c7', signature: 'test_greenlet_context_copying(self, app, client)', source: '    def test_greenlet_context_copying(self, app, client):\n        greenlets = []\n\n        @app.route("/")\n        def index():\n            flask.session["fizz"] = "buzz"\n            reqctx = request_ctx.copy()\n\n            def g():\n                assert not flask.request\n                assert not flask.current_app\n                with reqctx:\n                    assert flask.request\n                    assert flask.current_app == app\n                    assert flask.request.path == "/"\n                    assert flask.request.args["foo"] == "bar"\n                    assert flask.session.get("fizz") == "buzz"\n                assert not flask.request\n                return 42\n\n            greenlets.append(greenlet(g))\n            return "Hello World!"\n\n        rv = client.get("/?foo=bar")\n        assert rv.data == b"Hello World!"\n\n        result = greenlets[0].run()\n        assert result == 42', start: 150, tick: 1, types_hash: 'e7e6568a5bdd7b03', _vid: 983}),
  (:Symbol {body_hash: 'a3651db35618ef96', deleted: false, end: 202, key: 'tests/test_reqctx.py::TestGreenletContextCopying.test_greenlet_context_copying_api', kind: 'method', name: 'test_greenlet_context_copying_api', path: 'tests/test_reqctx.py', qualname: 'TestGreenletContextCopying.test_greenlet_context_copying_api', sig_hash: '42f384d1dcac74c7', signature: 'test_greenlet_context_copying_api(self, app, client)', source: '    def test_greenlet_context_copying_api(self, app, client):\n        greenlets = []\n\n        @app.route("/")\n        def index():\n            flask.session["fizz"] = "buzz"\n\n            @flask.copy_current_request_context\n            def g():\n                assert flask.request\n                assert flask.current_app == app\n                assert flask.request.path == "/"\n                assert flask.request.args["foo"] == "bar"\n                assert flask.session.get("fizz") == "buzz"\n                return 42\n\n            greenlets.append(greenlet(g))\n            return "Hello World!"\n\n        rv = client.get("/?foo=bar")\n        assert rv.data == b"Hello World!"\n\n        result = greenlets[0].run()\n        assert result == 42', start: 179, tick: 1, types_hash: 'e7e6568a5bdd7b03', _vid: 984}),
  (:Symbol {body_hash: '7fcfe962cced4b59', deleted: false, end: 226, key: 'tests/test_reqctx.py::test_session_error_pops_context', kind: 'function', name: 'test_session_error_pops_context', path: 'tests/test_reqctx.py', qualname: 'test_session_error_pops_context', sig_hash: '4943fbd3d489f4fa', signature: 'test_session_error_pops_context()', source: 'def test_session_error_pops_context():\n    class SessionError(Exception):\n        pass\n\n    class FailingSessionInterface(SessionInterface):\n        def open_session(self, app, request):\n            raise SessionError()\n\n    class CustomFlask(flask.Flask):\n        session_interface = FailingSessionInterface()\n\n    app = CustomFlask(__name__)\n\n    @app.route("/")\n    def index():\n        # shouldn\'t get here\n        AssertionError()\n\n    response = app.test_client().get("/")\n    assert response.status_code == 500\n    assert not flask.request\n    assert not flask.current_app', start: 205, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 985}),
  (:Symbol {body_hash: '56aecbee63a59bdf', deleted: false, end: 277, key: 'tests/test_reqctx.py::test_session_dynamic_cookie_name', kind: 'function', name: 'test_session_dynamic_cookie_name', path: 'tests/test_reqctx.py', qualname: 'test_session_dynamic_cookie_name', sig_hash: '4943fbd3d489f4fa', signature: 'test_session_dynamic_cookie_name()', source: 'def test_session_dynamic_cookie_name():\n    # This session interface will use a cookie with a different name if the\n    # requested url ends with the string "dynamic_cookie"\n    class PathAwareSessionInterface(SecureCookieSessionInterface):\n        def get_cookie_name(self, app):\n            if flask.request.url.endswith("dynamic_cookie"):\n                return "dynamic_cookie_name"\n            else:\n                return super().get_cookie_name(app)\n\n    class CustomFlask(flask.Flask):\n        session_interface = PathAwareSessionInterface()\n\n    app = CustomFlask(__name__)\n    app.secret_key = "secret_key"\n\n    @app.route("/set", methods=["POST"])\n    def set():\n        flask.session["value"] = flask.request.form["value"]\n        return "value set"\n\n    @app.route("/get")\n    def get():\n        v = flask.session.get("value", "None")\n        return v\n\n    @app.route("/set_dynamic_cookie", methods=["POST"])\n    def set_dynamic_cookie():\n        flask.session["value"] = flask.request.form["value"]\n        return "value set"\n\n    @app.route("/get_dynamic_cookie")\n    def get_dynamic_cookie():\n        v = flask.session.get("value", "None")\n        return v\n\n    test_client = app.test_client()\n\n    # first set the cookie in both /set urls but each with a different value\n    assert test_client.post("/set", data={"value": "42"}).data == b"value set"\n    assert (\n        test_client.post("/set_dynamic_cookie", data={"value": "616"}).data\n        == b"value set"\n    )\n\n    # now che\n…', start: 229, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 986}),
  (:Symbol {body_hash: '341a8bd74c776265', deleted: false, end: 293, key: 'tests/test_reqctx.py::test_bad_environ_raises_bad_request', kind: 'function', name: 'test_bad_environ_raises_bad_request', path: 'tests/test_reqctx.py', qualname: 'test_bad_environ_raises_bad_request', sig_hash: '4943fbd3d489f4fa', signature: 'test_bad_environ_raises_bad_request()', source: 'def test_bad_environ_raises_bad_request():\n    app = flask.Flask(__name__)\n\n    from flask.testing import EnvironBuilder\n\n    builder = EnvironBuilder(app)\n    environ = builder.get_environ()\n\n    # use a non-printable character in the Host - this is key to this test\n    environ["HTTP_HOST"] = "\\x8a"\n\n    with app.request_context(environ):\n        response = app.full_dispatch_request()\n    assert response.status_code == 400', start: 280, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 987}),
  (:Symbol {body_hash: '27380dafbbd9d13d', deleted: false, end: 314, key: 'tests/test_reqctx.py::test_environ_for_valid_idna_completes', kind: 'function', name: 'test_environ_for_valid_idna_completes', path: 'tests/test_reqctx.py', qualname: 'test_environ_for_valid_idna_completes', sig_hash: '4943fbd3d489f4fa', signature: 'test_environ_for_valid_idna_completes()', source: 'def test_environ_for_valid_idna_completes():\n    app = flask.Flask(__name__)\n\n    @app.route("/")\n    def index():\n        return "Hello World!"\n\n    from flask.testing import EnvironBuilder\n\n    builder = EnvironBuilder(app)\n    environ = builder.get_environ()\n\n    # these characters are all IDNA-compatible\n    environ["HTTP_HOST"] = "ąśźäüжŠßя.com"\n\n    with app.request_context(environ):\n        response = app.full_dispatch_request()\n\n    assert response.status_code == 200', start: 296, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 988}),
  (:Symbol {body_hash: 'abfaf90d9f31b200', deleted: false, end: 325, key: 'tests/test_reqctx.py::test_normal_environ_completes', kind: 'function', name: 'test_normal_environ_completes', path: 'tests/test_reqctx.py', qualname: 'test_normal_environ_completes', sig_hash: '4943fbd3d489f4fa', signature: 'test_normal_environ_completes()', source: 'def test_normal_environ_completes():\n    app = flask.Flask(__name__)\n\n    @app.route("/")\n    def index():\n        return "Hello World!"\n\n    response = app.test_client().get("/", headers={"host": "xn--on-0ia.com"})\n    assert response.status_code == 200', start: 317, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 989}),
  (:Symbol {body_hash: '15c4799cc0d20dc6', deleted: false, end: 28, key: 'tests/test_session_interface.py::test_open_session_with_endpoint', kind: 'function', name: 'test_open_session_with_endpoint', path: 'tests/test_session_interface.py', qualname: 'test_open_session_with_endpoint', sig_hash: '4943fbd3d489f4fa', signature: 'test_open_session_with_endpoint()', source: 'def test_open_session_with_endpoint():\n    """If request.endpoint (or other URL matching behavior) is needed\n    while loading the session, RequestContext.match_request() can be\n    called manually.\n    """\n\n    class MySessionInterface(SessionInterface):\n        def save_session(self, app, session, response):\n            pass\n\n        def open_session(self, app, request):\n            request_ctx.match_request()\n            assert request.endpoint is not None\n\n    app = flask.Flask(__name__)\n    app.session_interface = MySessionInterface()\n\n    @app.get("/")\n    def index():\n        return "Hello, World!"\n\n    response = app.test_client().get("/")\n    assert response.status_code == 200', start: 6, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 990}),
  (:Symbol {body_hash: 'a734d3a2870c31b3', deleted: false, end: 22, key: 'tests/test_signals.py::test_template_rendered', kind: 'function', name: 'test_template_rendered', path: 'tests/test_signals.py', qualname: 'test_template_rendered', sig_hash: 'df6ec3162cad163f', signature: 'test_template_rendered(app, client)', source: 'def test_template_rendered(app, client):\n    @app.route("/")\n    def index():\n        return flask.render_template("simple_template.html", whiskey=42)\n\n    recorded = []\n\n    def record(sender, template, context):\n        recorded.append((template, context))\n\n    flask.template_rendered.connect(record, app)\n    try:\n        client.get("/")\n        assert len(recorded) == 1\n        template, context = recorded[0]\n        assert template.name == "simple_template.html"\n        assert context["whiskey"] == 42\n    finally:\n        flask.template_rendered.disconnect(record, app)', start: 4, tick: 5, types_hash: '95304b3d97188d9c', _vid: 991}),
  (:Symbol {body_hash: '1e50d07f01c43cd0', deleted: false, end: 47, key: 'tests/test_signals.py::test_before_render_template', kind: 'function', name: 'test_before_render_template', path: 'tests/test_signals.py', qualname: 'test_before_render_template', sig_hash: '4943fbd3d489f4fa', signature: 'test_before_render_template()', source: 'def test_before_render_template():\n    app = flask.Flask(__name__)\n\n    @app.route("/")\n    def index():\n        return flask.render_template("simple_template.html", whiskey=42)\n\n    recorded = []\n\n    def record(sender, template, context):\n        context["whiskey"] = 43\n        recorded.append((template, context))\n\n    flask.before_render_template.connect(record, app)\n    try:\n        rv = app.test_client().get("/")\n        assert len(recorded) == 1\n        template, context = recorded[0]\n        assert template.name == "simple_template.html"\n        assert context["whiskey"] == 43\n        assert rv.data == b"<h1>43</h1>"\n    finally:\n        flask.before_render_template.disconnect(record, app)', start: 25, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 992}),
  (:Symbol {body_hash: '58768d677a05b62a', deleted: false, end: 92, key: 'tests/test_signals.py::test_request_signals', kind: 'function', name: 'test_request_signals', path: 'tests/test_signals.py', qualname: 'test_request_signals', sig_hash: '4943fbd3d489f4fa', signature: 'test_request_signals()', source: 'def test_request_signals():\n    app = flask.Flask(__name__)\n    calls = []\n\n    def before_request_signal(sender):\n        calls.append("before-signal")\n\n    def after_request_signal(sender, response):\n        assert response.data == b"stuff"\n        calls.append("after-signal")\n\n    @app.before_request\n    def before_request_handler():\n        calls.append("before-handler")\n\n    @app.after_request\n    def after_request_handler(response):\n        calls.append("after-handler")\n        response.data = "stuff"\n        return response\n\n    @app.route("/")\n    def index():\n        calls.append("handler")\n        return "ignored anyway"\n\n    flask.request_started.connect(before_request_signal, app)\n    flask.request_finished.connect(after_request_signal, app)\n\n    try:\n        rv = app.test_client().get("/")\n        assert rv.data == b"stuff"\n\n        assert calls == [\n            "before-signal",\n            "before-handler",\n            "handler",\n            "after-handler",\n            "after-signal",\n        ]\n    finally:\n        flask.request_started.disconnect(before_request_signal, app)\n        flask.request_finished.disconnect(after_request_signal, app)', start: 50, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 993}),
  (:Symbol {body_hash: 'a920d6c5df10bbd8', deleted: false, end: 112, key: 'tests/test_signals.py::test_request_exception_signal', kind: 'function', name: 'test_request_exception_signal', path: 'tests/test_signals.py', qualname: 'test_request_exception_signal', sig_hash: '4943fbd3d489f4fa', signature: 'test_request_exception_signal()', source: 'def test_request_exception_signal():\n    app = flask.Flask(__name__)\n    recorded = []\n\n    @app.route("/")\n    def index():\n        raise ZeroDivisionError\n\n    def record(sender, exception):\n        recorded.append(exception)\n\n    flask.got_request_exception.connect(record, app)\n    try:\n        assert app.test_client().get("/").status_code == 500\n        assert len(recorded) == 1\n        assert isinstance(recorded[0], ZeroDivisionError)\n    finally:\n        flask.got_request_exception.disconnect(record, app)', start: 95, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 994}),
  (:Symbol {body_hash: '5df841f96c268637', deleted: false, end: 136, key: 'tests/test_signals.py::test_appcontext_signals', kind: 'function', name: 'test_appcontext_signals', path: 'tests/test_signals.py', qualname: 'test_appcontext_signals', sig_hash: 'df6ec3162cad163f', signature: 'test_appcontext_signals(app, client)', source: 'def test_appcontext_signals(app, client):\n    recorded = []\n\n    def record_push(sender, **kwargs):\n        recorded.append("push")\n\n    def record_pop(sender, **kwargs):\n        recorded.append("pop")\n\n    @app.route("/")\n    def index():\n        return "Hello"\n\n    flask.appcontext_pushed.connect(record_push, app)\n    flask.appcontext_popped.connect(record_pop, app)\n    try:\n        rv = client.get("/")\n        assert rv.data == b"Hello"\n        assert recorded == ["push", "pop"]\n    finally:\n        flask.appcontext_pushed.disconnect(record_push, app)\n        flask.appcontext_popped.disconnect(record_pop, app)', start: 115, tick: 5, types_hash: '95304b3d97188d9c', _vid: 995}),
  (:Symbol {body_hash: '533c4e8814359699', deleted: false, end: 160, key: 'tests/test_signals.py::test_flash_signal', kind: 'function', name: 'test_flash_signal', path: 'tests/test_signals.py', qualname: 'test_flash_signal', sig_hash: '462ce794eb370ded', signature: 'test_flash_signal(app)', source: 'def test_flash_signal(app):\n    @app.route("/")\n    def index():\n        flask.flash("This is a flash message", category="notice")\n        return flask.redirect("/other")\n\n    recorded = []\n\n    def record(sender, message, category):\n        recorded.append((message, category))\n\n    flask.message_flashed.connect(record, app)\n    try:\n        client = app.test_client()\n        with client.session_transaction():\n            client.get("/")\n            assert len(recorded) == 1\n            message, category = recorded[0]\n            assert message == "This is a flash message"\n            assert category == "notice"\n    finally:\n        flask.message_flashed.disconnect(record, app)', start: 139, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 996}),
  (:Symbol {body_hash: '799ce1e781bb07ad', deleted: false, end: 181, key: 'tests/test_signals.py::test_appcontext_tearing_down_signal', kind: 'function', name: 'test_appcontext_tearing_down_signal', path: 'tests/test_signals.py', qualname: 'test_appcontext_tearing_down_signal', sig_hash: 'df6ec3162cad163f', signature: 'test_appcontext_tearing_down_signal(app, client)', source: 'def test_appcontext_tearing_down_signal(app, client):\n    app.testing = False\n    recorded = []\n\n    def record_teardown(sender, exc):\n        recorded.append(exc)\n\n    @app.route("/")\n    def index():\n        raise ZeroDivisionError\n\n    flask.appcontext_tearing_down.connect(record_teardown, app)\n    try:\n        rv = client.get("/")\n        assert rv.status_code == 500\n        assert len(recorded) == 1\n        assert isinstance(recorded[0], ZeroDivisionError)\n    finally:\n        flask.appcontext_tearing_down.disconnect(record_teardown, app)', start: 163, tick: 5, types_hash: '95304b3d97188d9c', _vid: 997}),
  (:Symbol {body_hash: '6a534e4628b7c047', deleted: false, end: 21, key: 'tests/test_subclassing.py::test_suppressed_exception_logging', kind: 'function', name: 'test_suppressed_exception_logging', path: 'tests/test_subclassing.py', qualname: 'test_suppressed_exception_logging', sig_hash: '4943fbd3d489f4fa', signature: 'test_suppressed_exception_logging()', source: 'def test_suppressed_exception_logging():\n    class SuppressedFlask(flask.Flask):\n        def log_exception(self, exc_info):\n            pass\n\n    out = StringIO()\n    app = SuppressedFlask(__name__)\n\n    @app.route("/")\n    def index():\n        raise Exception("test")\n\n    rv = app.test_client().get("/", errors_stream=out)\n    assert rv.status_code == 500\n    assert b"Internal Server Error" in rv.data\n    assert not out.getvalue()', start: 6, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 998}),
  (:Symbol {body_hash: '32a56663c79491df', deleted: false, end: 21, key: 'tests/test_templating.py::test_context_processing', kind: 'function', name: 'test_context_processing', path: 'tests/test_templating.py', qualname: 'test_context_processing', sig_hash: 'df6ec3162cad163f', signature: 'test_context_processing(app, client)', source: 'def test_context_processing(app, client):\n    @app.context_processor\n    def context_processor():\n        return {"injected_value": 42}\n\n    @app.route("/")\n    def index():\n        return flask.render_template("context_template.html", value=23)\n\n    rv = client.get("/")\n    assert rv.data == b"<p>23|42"', start: 11, tick: 1, types_hash: '95304b3d97188d9c', _vid: 999});
CREATE (:Symbol {body_hash: '53137194501dbc4b', deleted: false, end: 30, key: 'tests/test_templating.py::test_original_win', kind: 'function', name: 'test_original_win', path: 'tests/test_templating.py', qualname: 'test_original_win', sig_hash: 'df6ec3162cad163f', signature: 'test_original_win(app, client)', source: 'def test_original_win(app, client):\n    @app.route("/")\n    def index():\n        return flask.render_template_string("{{ config }}", config=42)\n\n    rv = client.get("/")\n    assert rv.data == b"42"', start: 24, tick: 1, types_hash: '95304b3d97188d9c', _vid: 1000}),
  (:Symbol {body_hash: '4e539f005004b445', deleted: false, end: 39, key: 'tests/test_templating.py::test_simple_stream', kind: 'function', name: 'test_simple_stream', path: 'tests/test_templating.py', qualname: 'test_simple_stream', sig_hash: 'df6ec3162cad163f', signature: 'test_simple_stream(app, client)', source: 'def test_simple_stream(app, client):\n    @app.route("/")\n    def index():\n        return flask.stream_template_string("{{ config }}", config=42)\n\n    rv = client.get("/")\n    assert rv.data == b"42"', start: 33, tick: 1, types_hash: '95304b3d97188d9c', _vid: 1001}),
  (:Symbol {body_hash: '79a7dbe52617a774', deleted: false, end: 50, key: 'tests/test_templating.py::test_request_less_rendering', kind: 'function', name: 'test_request_less_rendering', path: 'tests/test_templating.py', qualname: 'test_request_less_rendering', sig_hash: '3acf5b76887f15f2', signature: 'test_request_less_rendering(app, app_ctx)', source: 'def test_request_less_rendering(app, app_ctx):\n    app.config["WORLD_NAME"] = "Special World"\n\n    @app.context_processor\n    def context_processor():\n        return dict(foo=42)\n\n    rv = flask.render_template_string("Hello {{ config.WORLD_NAME }} {{ foo }}")\n    assert rv == "Hello Special World 42"', start: 42, tick: 1, types_hash: '45f7071ec66cb28f', _vid: 1002}),
  (:Symbol {body_hash: 'f0423e4ec55c0ac5', deleted: false, end: 68, key: 'tests/test_templating.py::test_standard_context', kind: 'function', name: 'test_standard_context', path: 'tests/test_templating.py', qualname: 'test_standard_context', sig_hash: 'df6ec3162cad163f', signature: 'test_standard_context(app, client)', source: 'def test_standard_context(app, client):\n    @app.route("/")\n    def index():\n        flask.g.foo = 23\n        flask.session["test"] = "aha"\n        return flask.render_template_string(\n            """\n            {{ request.args.foo }}\n            {{ g.foo }}\n            {{ config.DEBUG }}\n            {{ session.test }}\n        """\n        )\n\n    rv = client.get("/?foo=42")\n    assert rv.data.split() == [b"42", b"23", b"False", b"aha"]', start: 53, tick: 1, types_hash: '95304b3d97188d9c', _vid: 1003}),
  (:Symbol {body_hash: '33765d6a0cc8fa28', deleted: false, end: 88, key: 'tests/test_templating.py::test_escaping', kind: 'function', name: 'test_escaping', path: 'tests/test_templating.py', qualname: 'test_escaping', sig_hash: 'df6ec3162cad163f', signature: 'test_escaping(app, client)', source: 'def test_escaping(app, client):\n    text = "<p>Hello World!"\n\n    @app.route("/")\n    def index():\n        return flask.render_template(\n            "escaping_template.html", text=text, html=Markup(text)\n        )\n\n    lines = client.get("/").data.splitlines()\n    assert lines == [\n        b"&lt;p&gt;Hello World!",\n        b"<p>Hello World!",\n        b"<p>Hello World!",\n        b"<p>Hello World!",\n        b"&lt;p&gt;Hello World!",\n        b"<p>Hello World!",\n    ]', start: 71, tick: 1, types_hash: '95304b3d97188d9c', _vid: 1004}),
  (:Symbol {body_hash: 'e137d3a71a25988f', deleted: false, end: 110, key: 'tests/test_templating.py::test_no_escaping', kind: 'function', name: 'test_no_escaping', path: 'tests/test_templating.py', qualname: 'test_no_escaping', sig_hash: 'df6ec3162cad163f', signature: 'test_no_escaping(app, client)', source: 'def test_no_escaping(app, client):\n    text = "<p>Hello World!"\n\n    @app.route("/")\n    def index():\n        return flask.render_template(\n            "non_escaping_template.txt", text=text, html=Markup(text)\n        )\n\n    lines = client.get("/").data.splitlines()\n    assert lines == [\n        b"<p>Hello World!",\n        b"<p>Hello World!",\n        b"<p>Hello World!",\n        b"<p>Hello World!",\n        b"&lt;p&gt;Hello World!",\n        b"<p>Hello World!",\n        b"<p>Hello World!",\n        b"<p>Hello World!",\n    ]', start: 91, tick: 1, types_hash: '95304b3d97188d9c', _vid: 1005}),
  (:Symbol {body_hash: '47c9764a2cee6ed0', deleted: false, end: 115, key: 'tests/test_templating.py::test_escaping_without_template_filename', kind: 'function', name: 'test_escaping_without_template_filename', path: 'tests/test_templating.py', qualname: 'test_escaping_without_template_filename', sig_hash: '4cd5f2cb40943a25', signature: 'test_escaping_without_template_filename(app, client, req_ctx)', source: 'def test_escaping_without_template_filename(app, client, req_ctx):\n    assert flask.render_template_string("{{ foo }}", foo="<test>") == "&lt;test&gt;"\n    assert flask.render_template("mail.txt", foo="<test>") == "<test> Mail"', start: 113, tick: 1, types_hash: '329742d6bfef3524', _vid: 1006}),
  (:Symbol {body_hash: '3e14900e232cc8e5', deleted: false, end: 120, key: 'tests/test_templating.py::test_macros', kind: 'function', name: 'test_macros', path: 'tests/test_templating.py', qualname: 'test_macros', sig_hash: '2714d7bd06e83efe', signature: 'test_macros(app, req_ctx)', source: 'def test_macros(app, req_ctx):\n    macro = flask.get_template_attribute("_macro.html", "hello")\n    assert macro("World") == "Hello World!"', start: 118, tick: 1, types_hash: '8515d83b8719fd6b', _vid: 1007}),
  (:Symbol {body_hash: 'bb67ece62c50bacf', deleted: false, end: 130, key: 'tests/test_templating.py::test_template_filter', kind: 'function', name: 'test_template_filter', path: 'tests/test_templating.py', qualname: 'test_template_filter', sig_hash: '462ce794eb370ded', signature: 'test_template_filter(app)', source: 'def test_template_filter(app):\n    @app.template_filter()\n    def my_reverse(s):\n        return s[::-1]\n\n    assert "my_reverse" in app.jinja_env.filters.keys()\n    assert app.jinja_env.filters["my_reverse"] == my_reverse\n    assert app.jinja_env.filters["my_reverse"]("abcd") == "dcba"', start: 123, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 1008}),
  (:Symbol {body_hash: '9eaba3db61611577', deleted: false, end: 140, key: 'tests/test_templating.py::test_add_template_filter', kind: 'function', name: 'test_add_template_filter', path: 'tests/test_templating.py', qualname: 'test_add_template_filter', sig_hash: '462ce794eb370ded', signature: 'test_add_template_filter(app)', source: 'def test_add_template_filter(app):\n    def my_reverse(s):\n        return s[::-1]\n\n    app.add_template_filter(my_reverse)\n    assert "my_reverse" in app.jinja_env.filters.keys()\n    assert app.jinja_env.filters["my_reverse"] == my_reverse\n    assert app.jinja_env.filters["my_reverse"]("abcd") == "dcba"', start: 133, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 1009}),
  (:Symbol {body_hash: 'e7c03f44082e9bd4', deleted: false, end: 150, key: 'tests/test_templating.py::test_template_filter_with_name', kind: 'function', name: 'test_template_filter_with_name', path: 'tests/test_templating.py', qualname: 'test_template_filter_with_name', sig_hash: '462ce794eb370ded', signature: 'test_template_filter_with_name(app)', source: 'def test_template_filter_with_name(app):\n    @app.template_filter("strrev")\n    def my_reverse(s):\n        return s[::-1]\n\n    assert "strrev" in app.jinja_env.filters.keys()\n    assert app.jinja_env.filters["strrev"] == my_reverse\n    assert app.jinja_env.filters["strrev"]("abcd") == "dcba"', start: 143, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 1010}),
  (:Symbol {body_hash: '744ce49385cfa381', deleted: false, end: 160, key: 'tests/test_templating.py::test_add_template_filter_with_name', kind: 'function', name: 'test_add_template_filter_with_name', path: 'tests/test_templating.py', qualname: 'test_add_template_filter_with_name', sig_hash: '462ce794eb370ded', signature: 'test_add_template_filter_with_name(app)', source: 'def test_add_template_filter_with_name(app):\n    def my_reverse(s):\n        return s[::-1]\n\n    app.add_template_filter(my_reverse, "strrev")\n    assert "strrev" in app.jinja_env.filters.keys()\n    assert app.jinja_env.filters["strrev"] == my_reverse\n    assert app.jinja_env.filters["strrev"]("abcd") == "dcba"', start: 153, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 1011}),
  (:Symbol {body_hash: '711dc144a77ec8ef', deleted: false, end: 173, key: 'tests/test_templating.py::test_template_filter_with_template', kind: 'function', name: 'test_template_filter_with_template', path: 'tests/test_templating.py', qualname: 'test_template_filter_with_template', sig_hash: 'df6ec3162cad163f', signature: 'test_template_filter_with_template(app, client)', source: 'def test_template_filter_with_template(app, client):\n    @app.template_filter()\n    def super_reverse(s):\n        return s[::-1]\n\n    @app.route("/")\n    def index():\n        return flask.render_template("template_filter.html", value="abcd")\n\n    rv = client.get("/")\n    assert rv.data == b"dcba"', start: 163, tick: 1, types_hash: '95304b3d97188d9c', _vid: 1012}),
  (:Symbol {body_hash: '075b99dcf7952ead', deleted: false, end: 187, key: 'tests/test_templating.py::test_add_template_filter_with_template', kind: 'function', name: 'test_add_template_filter_with_template', path: 'tests/test_templating.py', qualname: 'test_add_template_filter_with_template', sig_hash: 'df6ec3162cad163f', signature: 'test_add_template_filter_with_template(app, client)', source: 'def test_add_template_filter_with_template(app, client):\n    def super_reverse(s):\n        return s[::-1]\n\n    app.add_template_filter(super_reverse)\n\n    @app.route("/")\n    def index():\n        return flask.render_template("template_filter.html", value="abcd")\n\n    rv = client.get("/")\n    assert rv.data == b"dcba"', start: 176, tick: 1, types_hash: '95304b3d97188d9c', _vid: 1013}),
  (:Symbol {body_hash: '71db6cacaf0227c3', deleted: false, end: 200, key: 'tests/test_templating.py::test_template_filter_with_name_and_template', kind: 'function', name: 'test_template_filter_with_name_and_template', path: 'tests/test_templating.py', qualname: 'test_template_filter_with_name_and_template', sig_hash: 'df6ec3162cad163f', signature: 'test_template_filter_with_name_and_template(app, client)', source: 'def test_template_filter_with_name_and_template(app, client):\n    @app.template_filter("super_reverse")\n    def my_reverse(s):\n        return s[::-1]\n\n    @app.route("/")\n    def index():\n        return flask.render_template("template_filter.html", value="abcd")\n\n    rv = client.get("/")\n    assert rv.data == b"dcba"', start: 190, tick: 1, types_hash: '95304b3d97188d9c', _vid: 1014}),
  (:Symbol {body_hash: '217ba9e4ba6e6006', deleted: false, end: 214, key: 'tests/test_templating.py::test_add_template_filter_with_name_and_template', kind: 'function', name: 'test_add_template_filter_with_name_and_template', path: 'tests/test_templating.py', qualname: 'test_add_template_filter_with_name_and_template', sig_hash: 'df6ec3162cad163f', signature: 'test_add_template_filter_with_name_and_template(app, client)', source: 'def test_add_template_filter_with_name_and_template(app, client):\n    def my_reverse(s):\n        return s[::-1]\n\n    app.add_template_filter(my_reverse, "super_reverse")\n\n    @app.route("/")\n    def index():\n        return flask.render_template("template_filter.html", value="abcd")\n\n    rv = client.get("/")\n    assert rv.data == b"dcba"', start: 203, tick: 1, types_hash: '95304b3d97188d9c', _vid: 1015}),
  (:Symbol {body_hash: '264bc1c9630610a0', deleted: false, end: 224, key: 'tests/test_templating.py::test_template_test', kind: 'function', name: 'test_template_test', path: 'tests/test_templating.py', qualname: 'test_template_test', sig_hash: '462ce794eb370ded', signature: 'test_template_test(app)', source: 'def test_template_test(app):\n    @app.template_test()\n    def boolean(value):\n        return isinstance(value, bool)\n\n    assert "boolean" in app.jinja_env.tests.keys()\n    assert app.jinja_env.tests["boolean"] == boolean\n    assert app.jinja_env.tests["boolean"](False)', start: 217, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 1016}),
  (:Symbol {body_hash: '500eeae723d2da8e', deleted: false, end: 234, key: 'tests/test_templating.py::test_add_template_test', kind: 'function', name: 'test_add_template_test', path: 'tests/test_templating.py', qualname: 'test_add_template_test', sig_hash: '462ce794eb370ded', signature: 'test_add_template_test(app)', source: 'def test_add_template_test(app):\n    def boolean(value):\n        return isinstance(value, bool)\n\n    app.add_template_test(boolean)\n    assert "boolean" in app.jinja_env.tests.keys()\n    assert app.jinja_env.tests["boolean"] == boolean\n    assert app.jinja_env.tests["boolean"](False)', start: 227, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 1017}),
  (:Symbol {body_hash: '06b962a35e43f2fb', deleted: false, end: 244, key: 'tests/test_templating.py::test_template_test_with_name', kind: 'function', name: 'test_template_test_with_name', path: 'tests/test_templating.py', qualname: 'test_template_test_with_name', sig_hash: '462ce794eb370ded', signature: 'test_template_test_with_name(app)', source: 'def test_template_test_with_name(app):\n    @app.template_test("boolean")\n    def is_boolean(value):\n        return isinstance(value, bool)\n\n    assert "boolean" in app.jinja_env.tests.keys()\n    assert app.jinja_env.tests["boolean"] == is_boolean\n    assert app.jinja_env.tests["boolean"](False)', start: 237, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 1018}),
  (:Symbol {body_hash: 'e9c1b896db9f49ce', deleted: false, end: 254, key: 'tests/test_templating.py::test_add_template_test_with_name', kind: 'function', name: 'test_add_template_test_with_name', path: 'tests/test_templating.py', qualname: 'test_add_template_test_with_name', sig_hash: '462ce794eb370ded', signature: 'test_add_template_test_with_name(app)', source: 'def test_add_template_test_with_name(app):\n    def is_boolean(value):\n        return isinstance(value, bool)\n\n    app.add_template_test(is_boolean, "boolean")\n    assert "boolean" in app.jinja_env.tests.keys()\n    assert app.jinja_env.tests["boolean"] == is_boolean\n    assert app.jinja_env.tests["boolean"](False)', start: 247, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 1019}),
  (:Symbol {body_hash: 'c71d08b13fe9ad2e', deleted: false, end: 267, key: 'tests/test_templating.py::test_template_test_with_template', kind: 'function', name: 'test_template_test_with_template', path: 'tests/test_templating.py', qualname: 'test_template_test_with_template', sig_hash: 'df6ec3162cad163f', signature: 'test_template_test_with_template(app, client)', source: 'def test_template_test_with_template(app, client):\n    @app.template_test()\n    def boolean(value):\n        return isinstance(value, bool)\n\n    @app.route("/")\n    def index():\n        return flask.render_template("template_test.html", value=False)\n\n    rv = client.get("/")\n    assert b"Success!" in rv.data', start: 257, tick: 1, types_hash: '95304b3d97188d9c', _vid: 1020}),
  (:Symbol {body_hash: '336f938b63949c50', deleted: false, end: 281, key: 'tests/test_templating.py::test_add_template_test_with_template', kind: 'function', name: 'test_add_template_test_with_template', path: 'tests/test_templating.py', qualname: 'test_add_template_test_with_template', sig_hash: 'df6ec3162cad163f', signature: 'test_add_template_test_with_template(app, client)', source: 'def test_add_template_test_with_template(app, client):\n    def boolean(value):\n        return isinstance(value, bool)\n\n    app.add_template_test(boolean)\n\n    @app.route("/")\n    def index():\n        return flask.render_template("template_test.html", value=False)\n\n    rv = client.get("/")\n    assert b"Success!" in rv.data', start: 270, tick: 1, types_hash: '95304b3d97188d9c', _vid: 1021}),
  (:Symbol {body_hash: '4565ad82f84267e4', deleted: false, end: 294, key: 'tests/test_templating.py::test_template_test_with_name_and_template', kind: 'function', name: 'test_template_test_with_name_and_template', path: 'tests/test_templating.py', qualname: 'test_template_test_with_name_and_template', sig_hash: 'df6ec3162cad163f', signature: 'test_template_test_with_name_and_template(app, client)', source: 'def test_template_test_with_name_and_template(app, client):\n    @app.template_test("boolean")\n    def is_boolean(value):\n        return isinstance(value, bool)\n\n    @app.route("/")\n    def index():\n        return flask.render_template("template_test.html", value=False)\n\n    rv = client.get("/")\n    assert b"Success!" in rv.data', start: 284, tick: 1, types_hash: '95304b3d97188d9c', _vid: 1022}),
  (:Symbol {body_hash: '339ded0a1ff0d24b', deleted: false, end: 308, key: 'tests/test_templating.py::test_add_template_test_with_name_and_template', kind: 'function', name: 'test_add_template_test_with_name_and_template', path: 'tests/test_templating.py', qualname: 'test_add_template_test_with_name_and_template', sig_hash: 'df6ec3162cad163f', signature: 'test_add_template_test_with_name_and_template(app, client)', source: 'def test_add_template_test_with_name_and_template(app, client):\n    def is_boolean(value):\n        return isinstance(value, bool)\n\n    app.add_template_test(is_boolean, "boolean")\n\n    @app.route("/")\n    def index():\n        return flask.render_template("template_test.html", value=False)\n\n    rv = client.get("/")\n    assert b"Success!" in rv.data', start: 297, tick: 1, types_hash: '95304b3d97188d9c', _vid: 1023}),
  (:Symbol {body_hash: 'd61da2a5196804df', deleted: false, end: 321, key: 'tests/test_templating.py::test_add_template_global', kind: 'function', name: 'test_add_template_global', path: 'tests/test_templating.py', qualname: 'test_add_template_global', sig_hash: '3acf5b76887f15f2', signature: 'test_add_template_global(app, app_ctx)', source: 'def test_add_template_global(app, app_ctx):\n    @app.template_global()\n    def get_stuff():\n        return 42\n\n    assert "get_stuff" in app.jinja_env.globals.keys()\n    assert app.jinja_env.globals["get_stuff"] == get_stuff\n    assert app.jinja_env.globals["get_stuff"](), 42\n\n    rv = flask.render_template_string("{{ get_stuff() }}")\n    assert rv == "42"', start: 311, tick: 1, types_hash: '45f7071ec66cb28f', _vid: 1024}),
  (:Symbol {body_hash: 'd0d688ecb76cbec9', deleted: false, end: 339, key: 'tests/test_templating.py::test_custom_template_loader', kind: 'function', name: 'test_custom_template_loader', path: 'tests/test_templating.py', qualname: 'test_custom_template_loader', sig_hash: '03ede65b0f6955e2', signature: 'test_custom_template_loader(client)', source: 'def test_custom_template_loader(client):\n    class MyFlask(flask.Flask):\n        def create_global_jinja_loader(self):\n            from jinja2 import DictLoader\n\n            return DictLoader({"index.html": "Hello Custom World!"})\n\n    app = MyFlask(__name__)\n\n    @app.route("/")\n    def index():\n        return flask.render_template("index.html")\n\n    c = app.test_client()\n    rv = c.get("/")\n    assert rv.data == b"Hello Custom World!"', start: 324, tick: 1, types_hash: 'e44c84874e9b5e85', _vid: 1025}),
  (:Symbol {body_hash: 'a9b2acd383046307', deleted: false, end: 359, key: 'tests/test_templating.py::test_iterable_loader', kind: 'function', name: 'test_iterable_loader', path: 'tests/test_templating.py', qualname: 'test_iterable_loader', sig_hash: 'df6ec3162cad163f', signature: 'test_iterable_loader(app, client)', source: 'def test_iterable_loader(app, client):\n    @app.context_processor\n    def context_processor():\n        return {"whiskey": "Jameson"}\n\n    @app.route("/")\n    def index():\n        return flask.render_template(\n            [\n                "no_template.xml",  # should skip this one\n                "simple_template.html",  # should render this\n                "context_template.html",\n            ],\n            value=23,\n        )\n\n    rv = client.get("/")\n    assert rv.data == b"<h1>Jameson</h1>"', start: 342, tick: 1, types_hash: '95304b3d97188d9c', _vid: 1026}),
  (:Symbol {body_hash: '939ce074bf550639', deleted: false, end: 391, key: 'tests/test_templating.py::test_templates_auto_reload', kind: 'function', name: 'test_templates_auto_reload', path: 'tests/test_templating.py', qualname: 'test_templates_auto_reload', sig_hash: '462ce794eb370ded', signature: 'test_templates_auto_reload(app)', source: 'def test_templates_auto_reload(app):\n    # debug is False, config option is None\n    assert app.debug is False\n    assert app.config["TEMPLATES_AUTO_RELOAD"] is None\n    assert app.jinja_env.auto_reload is False\n    # debug is False, config option is False\n    app = flask.Flask(__name__)\n    app.config["TEMPLATES_AUTO_RELOAD"] = False\n    assert app.debug is False\n    assert app.jinja_env.auto_reload is False\n    # debug is False, config option is True\n    app = flask.Flask(__name__)\n    app.config["TEMPLATES_AUTO_RELOAD"] = True\n    assert app.debug is False\n    assert app.jinja_env.auto_reload is True\n    # debug is True, config option is None\n    app = flask.Flask(__name__)\n    app.config["DEBUG"] = True\n    assert app.config["TEMPLATES_AUTO_RELOAD"] is None\n    assert app.jinja_env.auto_reload is True\n    # debug is True, config option is False\n    app = flask.Flask(__name__)\n    app.config["DEBUG"] = True\n    app.config["TEMPLATES_AUTO_RELOAD"] = False\n    assert app.jinja_env.auto_reload is False\n    # debug is True, config option is True\n    app = flask.Flask(__name__)\n    app.config["DEBUG"] = True\n    app.config["TEMPLATES_AUTO_RELOAD"] = True\n    assert app.jinja_env.auto_reload is True', start: 362, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 1027}),
  (:Symbol {body_hash: '388303806d6f18ff', deleted: false, end: 404, key: 'tests/test_templating.py::test_templates_auto_reload_debug_run', kind: 'function', name: 'test_templates_auto_reload_debug_run', path: 'tests/test_templating.py', qualname: 'test_templates_auto_reload_debug_run', sig_hash: '1e80705b2f67fe66', signature: 'test_templates_auto_reload_debug_run(app, monkeypatch)', source: 'def test_templates_auto_reload_debug_run(app, monkeypatch):\n    def run_simple_mock(*args, **kwargs):\n        pass\n\n    monkeypatch.setattr(werkzeug.serving, "run_simple", run_simple_mock)\n\n    app.run()\n    assert not app.jinja_env.auto_reload\n\n    app.run(debug=True)\n    assert app.jinja_env.auto_reload', start: 394, tick: 1, types_hash: 'c3000a955b273ffb', _vid: 1028}),
  (:Symbol {body_hash: '4e5621ddb000c3ed', deleted: false, end: 440, key: 'tests/test_templating.py::test_template_loader_debugging', kind: 'function', name: 'test_template_loader_debugging', path: 'tests/test_templating.py', qualname: 'test_template_loader_debugging', sig_hash: 'da93bf1148c97482', signature: 'test_template_loader_debugging(test_apps, monkeypatch)', source: 'def test_template_loader_debugging(test_apps, monkeypatch):\n    from blueprintapp import app\n\n    called = []\n\n    class _TestHandler(logging.Handler):\n        def handle(self, record):\n            called.append(True)\n            text = str(record.msg)\n            assert "1: trying loader of application \'blueprintapp\'" in text\n            assert (\n                "2: trying loader of blueprint \'admin\' (blueprintapp.apps.admin)"\n            ) in text\n            assert (\n                "trying loader of blueprint \'frontend\' (blueprintapp.apps.frontend)"\n            ) in text\n            assert "Error: the template could not be found" in text\n            assert (\n                "looked up from an endpoint that belongs to the blueprint \'frontend\'"\n            ) in text\n            assert "See https://flask.palletsprojects.com/blueprints/#templates" in text\n\n    with app.test_client() as c:\n        monkeypatch.setitem(app.config, "EXPLAIN_TEMPLATE_LOADING", True)\n        monkeypatch.setattr(\n            logging.getLogger("blueprintapp"), "handlers", [_TestHandler()]\n        )\n\n        with pytest.raises(TemplateNotFound) as excinfo:\n            c.get("/missing")\n\n        assert "missing_template.html" in str(excinfo.value)\n\n    assert len(called) == 1', start: 407, tick: 1, types_hash: '754b832c9da8a48f', _vid: 1029}),
  (:Symbol {body_hash: '860417b55d73fb5e', deleted: false, end: 451, key: 'tests/test_templating.py::test_custom_jinja_env', kind: 'function', name: 'test_custom_jinja_env', path: 'tests/test_templating.py', qualname: 'test_custom_jinja_env', sig_hash: '4943fbd3d489f4fa', signature: 'test_custom_jinja_env()', source: 'def test_custom_jinja_env():\n    class CustomEnvironment(flask.templating.Environment):\n        pass\n\n    class CustomFlask(flask.Flask):\n        jinja_environment = CustomEnvironment\n\n    app = CustomFlask(__name__)\n    assert isinstance(app.jinja_env, CustomEnvironment)', start: 443, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 1030}),
  (:Symbol {body_hash: 'cd7bd0fc7acf85e8', deleted: false, end: 27, key: 'tests/test_testing.py::test_environ_defaults_from_config', kind: 'function', name: 'test_environ_defaults_from_config', path: 'tests/test_testing.py', qualname: 'test_environ_defaults_from_config', sig_hash: 'df6ec3162cad163f', signature: 'test_environ_defaults_from_config(app, client)', source: 'def test_environ_defaults_from_config(app, client):\n    app.config["SERVER_NAME"] = "example.com:1234"\n    app.config["APPLICATION_ROOT"] = "/foo"\n\n    @app.route("/")\n    def index():\n        return flask.request.url\n\n    ctx = app.test_request_context()\n    assert ctx.request.url == "http://example.com:1234/foo/"\n\n    rv = client.get("/")\n    assert rv.data == b"http://example.com:1234/foo/"', start: 15, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1031}),
  (:Symbol {body_hash: '652034e5e4df47e6', deleted: false, end: 39, key: 'tests/test_testing.py::test_environ_defaults', kind: 'function', name: 'test_environ_defaults', path: 'tests/test_testing.py', qualname: 'test_environ_defaults', sig_hash: '7e18bfc45618f610', signature: 'test_environ_defaults(app, client, app_ctx, req_ctx)', source: 'def test_environ_defaults(app, client, app_ctx, req_ctx):\n    @app.route("/")\n    def index():\n        return flask.request.url\n\n    ctx = app.test_request_context()\n    assert ctx.request.url == "http://localhost/"\n    with client:\n        rv = client.get("/")\n        assert rv.data == b"http://localhost/"', start: 30, tick: 5, types_hash: '97f34b527db23fc4', _vid: 1032}),
  (:Symbol {body_hash: 'dc68ce3167c53273', deleted: false, end: 54, key: 'tests/test_testing.py::test_environ_base_default', kind: 'function', name: 'test_environ_base_default', path: 'tests/test_testing.py', qualname: 'test_environ_base_default', sig_hash: 'df6ec3162cad163f', signature: 'test_environ_base_default(app, client)', source: 'def test_environ_base_default(app, client):\n    @app.route("/")\n    def index():\n        flask.g.remote_addr = flask.request.remote_addr\n        flask.g.user_agent = flask.request.user_agent.string\n        return ""\n\n    with client:\n        client.get("/")\n        assert flask.g.remote_addr == "127.0.0.1"\n        assert flask.g.user_agent == (\n            f"Werkzeug/{importlib.metadata.version(\'werkzeug\')}"\n        )', start: 42, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1033}),
  (:Symbol {body_hash: '0ed40bdd513de817', deleted: false, end: 70, key: 'tests/test_testing.py::test_environ_base_modified', kind: 'function', name: 'test_environ_base_modified', path: 'tests/test_testing.py', qualname: 'test_environ_base_modified', sig_hash: 'df6ec3162cad163f', signature: 'test_environ_base_modified(app, client)', source: 'def test_environ_base_modified(app, client):\n    @app.route("/")\n    def index():\n        flask.g.remote_addr = flask.request.remote_addr\n        flask.g.user_agent = flask.request.user_agent.string\n        return ""\n\n    client.environ_base["REMOTE_ADDR"] = "192.168.0.22"\n    client.environ_base["HTTP_USER_AGENT"] = "Foo"\n\n    with client:\n        client.get("/")\n        assert flask.g.remote_addr == "192.168.0.22"\n        assert flask.g.user_agent == "Foo"', start: 57, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1034}),
  (:Symbol {body_hash: '62c92eb0a0a8929f', deleted: false, end: 87, key: 'tests/test_testing.py::test_client_open_environ', kind: 'function', name: 'test_client_open_environ', path: 'tests/test_testing.py', qualname: 'test_client_open_environ', sig_hash: '5218354857d8c166', signature: 'test_client_open_environ(app, client, request)', source: 'def test_client_open_environ(app, client, request):\n    @app.route("/index")\n    def index():\n        return flask.request.remote_addr\n\n    builder = EnvironBuilder(app, path="/index", method="GET")\n    request.addfinalizer(builder.close)\n\n    rv = client.open(builder)\n    assert rv.data == b"127.0.0.1"\n\n    environ = builder.get_environ()\n    client.environ_base["REMOTE_ADDR"] = "127.0.0.2"\n    rv = client.open(environ)\n    assert rv.data == b"127.0.0.2"', start: 73, tick: 5, types_hash: '59ebd6057596f5fb', _vid: 1035}),
  (:Symbol {body_hash: 'a5a1063030b076d9', deleted: false, end: 99, key: 'tests/test_testing.py::test_specify_url_scheme', kind: 'function', name: 'test_specify_url_scheme', path: 'tests/test_testing.py', qualname: 'test_specify_url_scheme', sig_hash: 'df6ec3162cad163f', signature: 'test_specify_url_scheme(app, client)', source: 'def test_specify_url_scheme(app, client):\n    @app.route("/")\n    def index():\n        return flask.request.url\n\n    ctx = app.test_request_context(url_scheme="https")\n    assert ctx.request.url == "https://localhost/"\n\n    rv = client.get("/", url_scheme="https")\n    assert rv.data == b"https://localhost/"', start: 90, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1036}),
  (:Symbol {body_hash: '50ddeaacd1a56ca7', deleted: false, end: 107, key: 'tests/test_testing.py::test_path_is_url', kind: 'function', name: 'test_path_is_url', path: 'tests/test_testing.py', qualname: 'test_path_is_url', sig_hash: '462ce794eb370ded', signature: 'test_path_is_url(app)', source: 'def test_path_is_url(app):\n    eb = EnvironBuilder(app, "https://example.com/")\n    assert eb.url_scheme == "https"\n    assert eb.host == "example.com"\n    assert eb.script_root == ""\n    assert eb.path == "/"', start: 102, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 1037}),
  (:Symbol {body_hash: '3f5ea2586217bd67', deleted: false, end: 114, key: 'tests/test_testing.py::test_environbuilder_json_dumps', kind: 'function', name: 'test_environbuilder_json_dumps', path: 'tests/test_testing.py', qualname: 'test_environbuilder_json_dumps', sig_hash: '462ce794eb370ded', signature: 'test_environbuilder_json_dumps(app)', source: 'def test_environbuilder_json_dumps(app):\n    """EnvironBuilder.json_dumps() takes settings from the app."""\n    app.json.ensure_ascii = False\n    eb = EnvironBuilder(app, json="\\u20ac")\n    assert eb.input_stream.read().decode("utf8") == \'"\\u20ac"\'', start: 110, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 1038}),
  (:Symbol {body_hash: '898996cc4b8c049f', deleted: false, end: 138, key: 'tests/test_testing.py::test_blueprint_with_subdomain', kind: 'function', name: 'test_blueprint_with_subdomain', path: 'tests/test_testing.py', qualname: 'test_blueprint_with_subdomain', sig_hash: '4943fbd3d489f4fa', signature: 'test_blueprint_with_subdomain()', source: 'def test_blueprint_with_subdomain():\n    app = flask.Flask(__name__, subdomain_matching=True)\n    app.config["SERVER_NAME"] = "example.com:1234"\n    app.config["APPLICATION_ROOT"] = "/foo"\n    client = app.test_client()\n\n    bp = flask.Blueprint("company", __name__, subdomain="xxx")\n\n    @bp.route("/")\n    def index():\n        return flask.request.url\n\n    app.register_blueprint(bp)\n\n    ctx = app.test_request_context("/", subdomain="xxx")\n    assert ctx.request.url == "http://xxx.example.com:1234/foo/"\n\n    with ctx:\n        assert ctx.request.blueprint == bp.name\n\n    rv = client.get("/", subdomain="xxx")\n    assert rv.data == b"http://xxx.example.com:1234/foo/"', start: 117, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 1039}),
  (:Symbol {body_hash: '7103ac9292f9283b', deleted: false, end: 166, key: 'tests/test_testing.py::test_redirect_keep_session', kind: 'function', name: 'test_redirect_keep_session', path: 'tests/test_testing.py', qualname: 'test_redirect_keep_session', sig_hash: '1ab9b646de8707fd', signature: 'test_redirect_keep_session(app, client, app_ctx)', source: 'def test_redirect_keep_session(app, client, app_ctx):\n    @app.route("/", methods=["GET", "POST"])\n    def index():\n        if flask.request.method == "POST":\n            return flask.redirect("/getsession")\n        flask.session["data"] = "foo"\n        return "index"\n\n    @app.route("/getsession")\n    def get_session():\n        return flask.session.get("data", "<missing>")\n\n    with client:\n        rv = client.get("/getsession")\n        assert rv.data == b"<missing>"\n\n        rv = client.get("/")\n        assert rv.data == b"index"\n        assert flask.session.get("data") == "foo"\n\n        rv = client.post("/", data={}, follow_redirects=True)\n        assert rv.data == b"foo"\n        assert flask.session.get("data") == "foo"\n\n        rv = client.get("/getsession")\n        assert rv.data == b"foo"', start: 141, tick: 5, types_hash: '01b66b9fb364d524', _vid: 1040}),
  (:Symbol {body_hash: '4d2cd0947f04cb64', deleted: false, end: 183, key: 'tests/test_testing.py::test_session_transactions', kind: 'function', name: 'test_session_transactions', path: 'tests/test_testing.py', qualname: 'test_session_transactions', sig_hash: 'df6ec3162cad163f', signature: 'test_session_transactions(app, client)', source: 'def test_session_transactions(app, client):\n    @app.route("/")\n    def index():\n        return str(flask.session["foo"])\n\n    with client:\n        with client.session_transaction() as sess:\n            assert len(sess) == 0\n            sess["foo"] = [42]\n            assert len(sess) == 1\n        rv = client.get("/")\n        assert rv.data == b"[42]"\n        with client.session_transaction() as sess:\n            assert len(sess) == 1\n            assert sess["foo"] == [42]', start: 169, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1041}),
  (:Symbol {body_hash: '4d6d2d0d65963dbd', deleted: false, end: 193, key: 'tests/test_testing.py::test_session_transactions_no_null_sessions', kind: 'function', name: 'test_session_transactions_no_null_sessions', path: 'tests/test_testing.py', qualname: 'test_session_transactions_no_null_sessions', sig_hash: '4943fbd3d489f4fa', signature: 'test_session_transactions_no_null_sessions()', source: 'def test_session_transactions_no_null_sessions():\n    app = flask.Flask(__name__)\n\n    with app.test_client() as c:\n        with pytest.raises(RuntimeError) as e:\n            with c.session_transaction():\n                pass\n        assert "Session backend did not open a session" in str(e.value)', start: 186, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 1042}),
  (:Symbol {body_hash: '32304b4fe6538118', deleted: false, end: 201, key: 'tests/test_testing.py::test_session_transactions_keep_context', kind: 'function', name: 'test_session_transactions_keep_context', path: 'tests/test_testing.py', qualname: 'test_session_transactions_keep_context', sig_hash: '4cd5f2cb40943a25', signature: 'test_session_transactions_keep_context(app, client, req_ctx)', source: 'def test_session_transactions_keep_context(app, client, req_ctx):\n    client.get("/")\n    req = flask.request._get_current_object()\n    assert req is not None\n    with client.session_transaction():\n        assert req is flask.request._get_current_object()', start: 196, tick: 5, types_hash: '329742d6bfef3524', _vid: 1043}),
  (:Symbol {body_hash: 'dce975447aec92fd', deleted: false, end: 209, key: 'tests/test_testing.py::test_session_transaction_needs_cookies', kind: 'function', name: 'test_session_transaction_needs_cookies', path: 'tests/test_testing.py', qualname: 'test_session_transaction_needs_cookies', sig_hash: '462ce794eb370ded', signature: 'test_session_transaction_needs_cookies(app)', source: 'def test_session_transaction_needs_cookies(app):\n    c = app.test_client(use_cookies=False)\n\n    with pytest.raises(TypeError, match="Cookies are disabled."):\n        with c.session_transaction():\n            pass', start: 204, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 1044}),
  (:Symbol {body_hash: 'e16d1d79f487a625', deleted: false, end: 238, key: 'tests/test_testing.py::test_test_client_context_binding', kind: 'function', name: 'test_test_client_context_binding', path: 'tests/test_testing.py', qualname: 'test_test_client_context_binding', sig_hash: 'df6ec3162cad163f', signature: 'test_test_client_context_binding(app, client)', source: 'def test_test_client_context_binding(app, client):\n    app.testing = False\n\n    @app.route("/")\n    def index():\n        flask.g.value = 42\n        return "Hello World!"\n\n    @app.route("/other")\n    def other():\n        raise ZeroDivisionError\n\n    with client:\n        resp = client.get("/")\n        assert flask.g.value == 42\n        assert resp.data == b"Hello World!"\n        assert resp.status_code == 200\n\n    with client:\n        resp = client.get("/other")\n        assert not hasattr(flask.g, "value")\n        assert b"Internal Server Error" in resp.data\n        assert resp.status_code == 500\n        flask.g.value = 23\n\n    with pytest.raises(RuntimeError):\n        flask.g.value  # noqa: B018', start: 212, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1045}),
  (:Symbol {body_hash: 'd7bab6e83eff35b0', deleted: false, end: 248, key: 'tests/test_testing.py::test_reuse_client', kind: 'function', name: 'test_reuse_client', path: 'tests/test_testing.py', qualname: 'test_reuse_client', sig_hash: '03ede65b0f6955e2', signature: 'test_reuse_client(client)', source: 'def test_reuse_client(client):\n    c = client\n\n    with c:\n        assert client.get("/").status_code == 404\n\n    with c:\n        assert client.get("/").status_code == 404', start: 241, tick: 5, types_hash: 'e44c84874e9b5e85', _vid: 1046}),
  (:Symbol {body_hash: '4795cdd1252c3118', deleted: false, end: 260, key: 'tests/test_testing.py::test_full_url_request', kind: 'function', name: 'test_full_url_request', path: 'tests/test_testing.py', qualname: 'test_full_url_request', sig_hash: 'df6ec3162cad163f', signature: 'test_full_url_request(app, client)', source: 'def test_full_url_request(app, client):\n    @app.route("/action", methods=["POST"])\n    def action():\n        return "x"\n\n    with client:\n        rv = client.post("http://domain.com/action?vodka=42", data={"gin": 43})\n        assert rv.status_code == 200\n        assert "gin" in flask.request.form\n        assert "vodka" in flask.request.args', start: 251, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1047}),
  (:Symbol {body_hash: 'bc4b5c3c32bf1967', deleted: false, end: 279, key: 'tests/test_testing.py::test_json_request_and_response', kind: 'function', name: 'test_json_request_and_response', path: 'tests/test_testing.py', qualname: 'test_json_request_and_response', sig_hash: 'df6ec3162cad163f', signature: 'test_json_request_and_response(app, client)', source: 'def test_json_request_and_response(app, client):\n    @app.route("/echo", methods=["POST"])\n    def echo():\n        return jsonify(flask.request.get_json())\n\n    with client:\n        json_data = {"drink": {"gin": 1, "tonic": True}, "price": 10}\n        rv = client.post("/echo", json=json_data)\n\n        # Request should be in JSON\n        assert flask.request.is_json\n        assert flask.request.get_json() == json_data\n\n        # Response should be in JSON\n        assert rv.status_code == 200\n        assert rv.is_json\n        assert rv.get_json() == json_data', start: 263, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1048}),
  (:Symbol {body_hash: 'd98b07d5aa38ea0d', deleted: false, end: 299, key: 'tests/test_testing.py::test_client_json_no_app_context', kind: 'function', name: 'test_client_json_no_app_context', path: 'tests/test_testing.py', qualname: 'test_client_json_no_app_context', sig_hash: 'df6ec3162cad163f', signature: 'test_client_json_no_app_context(app, client)', source: 'def test_client_json_no_app_context(app, client):\n    @app.route("/hello", methods=["POST"])\n    def hello():\n        return f"Hello, {flask.request.json[\'name\']}!"\n\n    class Namespace:\n        count = 0\n\n        def add(self, app):\n            self.count += 1\n\n    ns = Namespace()\n\n    with appcontext_popped.connected_to(ns.add, app):\n        rv = client.post("/hello", json={"name": "Flask"})\n\n    assert rv.get_data(as_text=True) == "Hello, Flask!"\n    assert ns.count == 1', start: 282, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1049}),
  (:Symbol {body_hash: '6c4d507c5aac596c', deleted: false, end: 318, key: 'tests/test_testing.py::test_subdomain', kind: 'function', name: 'test_subdomain', path: 'tests/test_testing.py', qualname: 'test_subdomain', sig_hash: '4943fbd3d489f4fa', signature: 'test_subdomain()', source: 'def test_subdomain():\n    app = flask.Flask(__name__, subdomain_matching=True)\n    app.config["SERVER_NAME"] = "example.com"\n    client = app.test_client()\n\n    @app.route("/", subdomain="<company_id>")\n    def view(company_id):\n        return company_id\n\n    with app.test_request_context():\n        url = flask.url_for("view", company_id="xxx")\n\n    with client:\n        response = client.get(url)\n\n    assert 200 == response.status_code\n    assert b"xxx" == response.data', start: 302, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 1050}),
  (:Symbol {body_hash: '238f99c198547513', deleted: false, end: 335, key: 'tests/test_testing.py::test_nosubdomain', kind: 'function', name: 'test_nosubdomain', path: 'tests/test_testing.py', qualname: 'test_nosubdomain', sig_hash: 'df6ec3162cad163f', signature: 'test_nosubdomain(app, client)', source: 'def test_nosubdomain(app, client):\n    app.config["SERVER_NAME"] = "example.com"\n\n    @app.route("/<company_id>")\n    def view(company_id):\n        return company_id\n\n    with app.test_request_context():\n        url = flask.url_for("view", company_id="xxx")\n\n    with client:\n        response = client.get(url)\n\n    assert 200 == response.status_code\n    assert b"xxx" == response.data', start: 321, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1051}),
  (:Symbol {body_hash: '15c25c09249b484f', deleted: false, end: 347, key: 'tests/test_testing.py::test_cli_runner_class', kind: 'function', name: 'test_cli_runner_class', path: 'tests/test_testing.py', qualname: 'test_cli_runner_class', sig_hash: '462ce794eb370ded', signature: 'test_cli_runner_class(app)', source: 'def test_cli_runner_class(app):\n    runner = app.test_cli_runner()\n    assert isinstance(runner, FlaskCliRunner)\n\n    class SubRunner(FlaskCliRunner):\n        pass\n\n    app.test_cli_runner_class = SubRunner\n    runner = app.test_cli_runner()\n    assert isinstance(runner, SubRunner)', start: 338, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 1052}),
  (:Symbol {body_hash: '5af928063f520955', deleted: false, end: 361, key: 'tests/test_testing.py::test_cli_invoke', kind: 'function', name: 'test_cli_invoke', path: 'tests/test_testing.py', qualname: 'test_cli_invoke', sig_hash: '462ce794eb370ded', signature: 'test_cli_invoke(app)', source: 'def test_cli_invoke(app):\n    @app.cli.command("hello")\n    def hello_command():\n        click.echo("Hello, World!")\n\n    runner = app.test_cli_runner()\n    # invoke with command name\n    result = runner.invoke(args=["hello"])\n    assert "Hello" in result.output\n    # invoke with command object\n    result = runner.invoke(hello_command)\n    assert "Hello" in result.output', start: 350, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 1053}),
  (:Symbol {body_hash: 'a45353d788ef2d84', deleted: false, end: 379, key: 'tests/test_testing.py::test_cli_custom_obj', kind: 'function', name: 'test_cli_custom_obj', path: 'tests/test_testing.py', qualname: 'test_cli_custom_obj', sig_hash: '462ce794eb370ded', signature: 'test_cli_custom_obj(app)', source: 'def test_cli_custom_obj(app):\n    class NS:\n        called = False\n\n    def create_app():\n        NS.called = True\n        return app\n\n    @app.cli.command("hello")\n    def hello_command():\n        click.echo("Hello, World!")\n\n    script_info = ScriptInfo(create_app=create_app)\n    runner = app.test_cli_runner()\n    runner.invoke(hello_command, obj=script_info)\n    assert NS.called', start: 364, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 1054}),
  (:Symbol {body_hash: '54910c2e1c5f66ce', deleted: false, end: 396, key: 'tests/test_testing.py::test_client_pop_all_preserved', kind: 'function', name: 'test_client_pop_all_preserved', path: 'tests/test_testing.py', qualname: 'test_client_pop_all_preserved', sig_hash: '2577083acc47b5e6', signature: 'test_client_pop_all_preserved(app, req_ctx, client)', source: 'def test_client_pop_all_preserved(app, req_ctx, client):\n    @app.route("/")\n    def index():\n        # stream_with_context pushes a third context, preserved by response\n        return flask.stream_with_context("hello")\n\n    # req_ctx fixture pushed an initial context\n    with client:\n        # request pushes a second request context, preserved by client\n        rv = client.get("/")\n\n    # close the response, releasing the context held by stream_with_context\n    rv.close()\n    # only req_ctx fixture should still be pushed\n    assert _cv_request.get(None) is req_ctx', start: 382, tick: 5, types_hash: 'd10adf05e9a0d04f', _vid: 1055}),
  (:Symbol {body_hash: '784dad66df886807', deleted: false, end: 58, key: 'tests/test_user_error_handler.py::test_error_handler_no_match', kind: 'function', name: 'test_error_handler_no_match', path: 'tests/test_user_error_handler.py', qualname: 'test_error_handler_no_match', sig_hash: 'df6ec3162cad163f', signature: 'test_error_handler_no_match(app, client)', source: 'def test_error_handler_no_match(app, client):\n    class CustomException(Exception):\n        pass\n\n    @app.errorhandler(CustomException)\n    def custom_exception_handler(e):\n        assert isinstance(e, CustomException)\n        return "custom"\n\n    with pytest.raises(TypeError) as exc_info:\n        app.register_error_handler(CustomException(), None)\n\n    assert "CustomException() is an instance, not a class." in str(exc_info.value)\n\n    with pytest.raises(ValueError) as exc_info:\n        app.register_error_handler(list, None)\n\n    assert "\'list\' is not a subclass of Exception." in str(exc_info.value)\n\n    @app.errorhandler(500)\n    def handle_500(e):\n        assert isinstance(e, InternalServerError)\n\n        if e.original_exception is not None:\n            return f"wrapped {type(e.original_exception).__name__}"\n\n        return "direct"\n\n    with pytest.raises(ValueError) as exc_info:\n        app.register_error_handler(999, None)\n\n    assert "Use a subclass of HTTPException" in str(exc_info.value)\n\n    @app.route("/custom")\n    def custom_test():\n        raise CustomException()\n\n    @app.route("/keyerror")\n    def key_error():\n        raise KeyError()\n\n    @app.route("/abort")\n    def do_abort():\n        flask.abort(500)\n\n    app.testing = False\n    assert client.get("/custom").data == b"custom"\n    assert client.get("/keyerror").data == b"wrapped KeyError"\n    assert client.get("/abort").data == b"direct"', start: 10, tick: 1, types_hash: '95304b3d97188d9c', _vid: 1056}),
  (:Symbol {body_hash: '3e5c82053a4aeb75', deleted: false, end: 97, key: 'tests/test_user_error_handler.py::test_error_handler_subclass', kind: 'function', name: 'test_error_handler_subclass', path: 'tests/test_user_error_handler.py', qualname: 'test_error_handler_subclass', sig_hash: '462ce794eb370ded', signature: 'test_error_handler_subclass(app)', source: 'def test_error_handler_subclass(app):\n    class ParentException(Exception):\n        pass\n\n    class ChildExceptionUnregistered(ParentException):\n        pass\n\n    class ChildExceptionRegistered(ParentException):\n        pass\n\n    @app.errorhandler(ParentException)\n    def parent_exception_handler(e):\n        assert isinstance(e, ParentException)\n        return "parent"\n\n    @app.errorhandler(ChildExceptionRegistered)\n    def child_exception_handler(e):\n        assert isinstance(e, ChildExceptionRegistered)\n        return "child-registered"\n\n    @app.route("/parent")\n    def parent_test():\n        raise ParentException()\n\n    @app.route("/child-unregistered")\n    def unregistered_test():\n        raise ChildExceptionUnregistered()\n\n    @app.route("/child-registered")\n    def registered_test():\n        raise ChildExceptionRegistered()\n\n    c = app.test_client()\n\n    assert c.get("/parent").data == b"parent"\n    assert c.get("/child-unregistered").data == b"parent"\n    assert c.get("/child-registered").data == b"child-registered"', start: 61, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 1057}),
  (:Symbol {body_hash: 'e759aacb0821c5b3', deleted: false, end: 133, key: 'tests/test_user_error_handler.py::test_error_handler_http_subclass', kind: 'function', name: 'test_error_handler_http_subclass', path: 'tests/test_user_error_handler.py', qualname: 'test_error_handler_http_subclass', sig_hash: '462ce794eb370ded', signature: 'test_error_handler_http_subclass(app)', source: 'def test_error_handler_http_subclass(app):\n    class ForbiddenSubclassRegistered(Forbidden):\n        pass\n\n    class ForbiddenSubclassUnregistered(Forbidden):\n        pass\n\n    @app.errorhandler(403)\n    def code_exception_handler(e):\n        assert isinstance(e, Forbidden)\n        return "forbidden"\n\n    @app.errorhandler(ForbiddenSubclassRegistered)\n    def subclass_exception_handler(e):\n        assert isinstance(e, ForbiddenSubclassRegistered)\n        return "forbidden-registered"\n\n    @app.route("/forbidden")\n    def forbidden_test():\n        raise Forbidden()\n\n    @app.route("/forbidden-registered")\n    def registered_test():\n        raise ForbiddenSubclassRegistered()\n\n    @app.route("/forbidden-unregistered")\n    def unregistered_test():\n        raise ForbiddenSubclassUnregistered()\n\n    c = app.test_client()\n\n    assert c.get("/forbidden").data == b"forbidden"\n    assert c.get("/forbidden-unregistered").data == b"forbidden"\n    assert c.get("/forbidden-registered").data == b"forbidden-registered"', start: 100, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 1058}),
  (:Symbol {body_hash: '70063a7c05f38586', deleted: false, end: 160, key: 'tests/test_user_error_handler.py::test_error_handler_blueprint', kind: 'function', name: 'test_error_handler_blueprint', path: 'tests/test_user_error_handler.py', qualname: 'test_error_handler_blueprint', sig_hash: '462ce794eb370ded', signature: 'test_error_handler_blueprint(app)', source: 'def test_error_handler_blueprint(app):\n    bp = flask.Blueprint("bp", __name__)\n\n    @bp.errorhandler(500)\n    def bp_exception_handler(e):\n        return "bp-error"\n\n    @bp.route("/error")\n    def bp_test():\n        raise InternalServerError()\n\n    @app.errorhandler(500)\n    def app_exception_handler(e):\n        return "app-error"\n\n    @app.route("/error")\n    def app_test():\n        raise InternalServerError()\n\n    app.register_blueprint(bp, url_prefix="/bp")\n\n    c = app.test_client()\n\n    assert c.get("/error").data == b"app-error"\n    assert c.get("/bp/error").data == b"bp-error"', start: 136, tick: 1, types_hash: 'e676b88ce5d6fa4e', _vid: 1059}),
  (:Symbol {body_hash: '645a38fd40a475bc', deleted: false, end: 214, key: 'tests/test_user_error_handler.py::test_default_error_handler', kind: 'function', name: 'test_default_error_handler', path: 'tests/test_user_error_handler.py', qualname: 'test_default_error_handler', sig_hash: '4943fbd3d489f4fa', signature: 'test_default_error_handler()', source: 'def test_default_error_handler():\n    bp = flask.Blueprint("bp", __name__)\n\n    @bp.errorhandler(HTTPException)\n    def bp_exception_handler(e):\n        assert isinstance(e, HTTPException)\n        assert isinstance(e, NotFound)\n        return "bp-default"\n\n    @bp.errorhandler(Forbidden)\n    def bp_forbidden_handler(e):\n        assert isinstance(e, Forbidden)\n        return "bp-forbidden"\n\n    @bp.route("/undefined")\n    def bp_registered_test():\n        raise NotFound()\n\n    @bp.route("/forbidden")\n    def bp_forbidden_test():\n        raise Forbidden()\n\n    app = flask.Flask(__name__)\n\n    @app.errorhandler(HTTPException)\n    def catchall_exception_handler(e):\n        assert isinstance(e, HTTPException)\n        assert isinstance(e, NotFound)\n        return "default"\n\n    @app.errorhandler(Forbidden)\n    def catchall_forbidden_handler(e):\n        assert isinstance(e, Forbidden)\n        return "forbidden"\n\n    @app.route("/forbidden")\n    def forbidden():\n        raise Forbidden()\n\n    @app.route("/slash/")\n    def slash():\n        return "slash"\n\n    app.register_blueprint(bp, url_prefix="/bp")\n\n    c = app.test_client()\n    assert c.get("/bp/undefined").data == b"bp-default"\n    assert c.get("/bp/forbidden").data == b"bp-forbidden"\n    assert c.get("/undefined").data == b"default"\n    assert c.get("/forbidden").data == b"forbidden"\n    # Don\'t handle RequestRedirect raised when adding slash.\n    assert c.get("/slash", follow_redirects=True).data == b"slash"', start: 163, tick: 1, types_hash: '71b37b9a8a57b848', _vid: 1060}),
  (:Symbol {body_hash: '024511cc0f05fc15', deleted: false, end: 295, key: 'tests/test_user_error_handler.py::TestGenericHandlers', kind: 'class', name: 'TestGenericHandlers', path: 'tests/test_user_error_handler.py', qualname: 'TestGenericHandlers', sig_hash: '42ba610a86d15094', signature: 'class TestGenericHandlers', source: 'class TestGenericHandlers:\n    """Test how very generic handlers are dispatched to."""\n\n    class Custom(Exception):\n        pass\n\n    @pytest.fixture()\n    def app(self, app):\n        @app.route("/custom")\n        def do_custom():\n            raise self.Custom()\n\n        @app.route("/error")\n        def do_error():\n            raise KeyError()\n\n        @app.route("/abort")\n        def do_abort():\n            flask.abort(500)\n\n        @app.route("/raise")\n        def do_raise():\n            raise InternalServerError()\n\n        app.config["PROPAGATE_EXCEPTIONS"] = False\n        return app\n\n    def report_error(self, e):\n        original = getattr(e, "original_exception", None)\n\n        if original is not None:\n            return f"wrapped {type(original).__name__}"\n\n        return f"direct {type(e).__name__}"\n\n    @pytest.mark.parametrize("to_handle", (InternalServerError, 500))\n    def test_handle_class_or_code(self, app, client, to_handle):\n        """``InternalServerError`` and ``500`` are aliases, they should\n        have the same behavior. Both should only receive\n        ``InternalServerError``, which might wrap another error.\n        """\n\n        @app.errorhandler(to_handle)\n        def handle_500(e):\n            assert isinstance(e, InternalServerError)\n            return self.report_error(e)\n\n        assert client.get("/custom").data == b"wrapped Custom"\n        assert client.get("/error").data == b"wrapped KeyError"\n        assert client.get("/abort").data == b"direc\n…', start: 217, tick: 1, types_hash: '', _vid: 1061}),
  (:Symbol {body_hash: '78dce6df362a6796', deleted: false, end: 242, key: 'tests/test_user_error_handler.py::TestGenericHandlers.app', kind: 'method', name: 'app', path: 'tests/test_user_error_handler.py', qualname: 'TestGenericHandlers.app', sig_hash: 'd5a3a5b9721effdf', signature: 'app(self, app)', source: '    @pytest.fixture()\n    def app(self, app):\n        @app.route("/custom")\n        def do_custom():\n            raise self.Custom()\n\n        @app.route("/error")\n        def do_error():\n            raise KeyError()\n\n        @app.route("/abort")\n        def do_abort():\n            flask.abort(500)\n\n        @app.route("/raise")\n        def do_raise():\n            raise InternalServerError()\n\n        app.config["PROPAGATE_EXCEPTIONS"] = False\n        return app', start: 224, tick: 1, types_hash: '206018d0371d044e', _vid: 1062}),
  (:Symbol {body_hash: '5ed50bae1c7c55d9', deleted: false, end: 250, key: 'tests/test_user_error_handler.py::TestGenericHandlers.report_error', kind: 'method', name: 'report_error', path: 'tests/test_user_error_handler.py', qualname: 'TestGenericHandlers.report_error', sig_hash: 'eca50bbe187484e8', signature: 'report_error(self, e)', source: '    def report_error(self, e):\n        original = getattr(e, "original_exception", None)\n\n        if original is not None:\n            return f"wrapped {type(original).__name__}"\n\n        return f"direct {type(e).__name__}"', start: 244, tick: 1, types_hash: '95041c4bee88041f', _vid: 1063}),
  (:Symbol {body_hash: '0f32d16c3ce13864', deleted: false, end: 267, key: 'tests/test_user_error_handler.py::TestGenericHandlers.test_handle_class_or_code', kind: 'method', name: 'test_handle_class_or_code', path: 'tests/test_user_error_handler.py', qualname: 'TestGenericHandlers.test_handle_class_or_code', sig_hash: '3b8f97529afa6dec', signature: 'test_handle_class_or_code(self, app, client, to_handle)', source: '    @pytest.mark.parametrize("to_handle", (InternalServerError, 500))\n    def test_handle_class_or_code(self, app, client, to_handle):\n        """``InternalServerError`` and ``500`` are aliases, they should\n        have the same behavior. Both should only receive\n        ``InternalServerError``, which might wrap another error.\n        """\n\n        @app.errorhandler(to_handle)\n        def handle_500(e):\n            assert isinstance(e, InternalServerError)\n            return self.report_error(e)\n\n        assert client.get("/custom").data == b"wrapped Custom"\n        assert client.get("/error").data == b"wrapped KeyError"\n        assert client.get("/abort").data == b"direct InternalServerError"\n        assert client.get("/raise").data == b"direct InternalServerError"', start: 253, tick: 1, types_hash: '2d4455c24e1db46d', _vid: 1064}),
  (:Symbol {body_hash: '7960afad2822e542', deleted: false, end: 281, key: 'tests/test_user_error_handler.py::TestGenericHandlers.test_handle_generic_http', kind: 'method', name: 'test_handle_generic_http', path: 'tests/test_user_error_handler.py', qualname: 'TestGenericHandlers.test_handle_generic_http', sig_hash: '42f384d1dcac74c7', signature: 'test_handle_generic_http(self, app, client)', source: '    def test_handle_generic_http(self, app, client):\n        """``HTTPException`` should only receive ``HTTPException``\n        subclasses. It will receive ``404`` routing exceptions.\n        """\n\n        @app.errorhandler(HTTPException)\n        def handle_http(e):\n            assert isinstance(e, HTTPException)\n            return str(e.code)\n\n        assert client.get("/error").data == b"500"\n        assert client.get("/abort").data == b"500"\n        assert client.get("/not-found").data == b"404"', start: 269, tick: 1, types_hash: 'e7e6568a5bdd7b03', _vid: 1065}),
  (:Symbol {body_hash: '6af8b9fc512e4245', deleted: false, end: 295, key: 'tests/test_user_error_handler.py::TestGenericHandlers.test_handle_generic', kind: 'method', name: 'test_handle_generic', path: 'tests/test_user_error_handler.py', qualname: 'TestGenericHandlers.test_handle_generic', sig_hash: '42f384d1dcac74c7', signature: 'test_handle_generic(self, app, client)', source: '    def test_handle_generic(self, app, client):\n        """Generic ``Exception`` will handle all exceptions directly,\n        including ``HTTPExceptions``.\n        """\n\n        @app.errorhandler(Exception)\n        def handle_exception(e):\n            return self.report_error(e)\n\n        assert client.get("/custom").data == b"direct Custom"\n        assert client.get("/error").data == b"direct KeyError"\n        assert client.get("/abort").data == b"direct InternalServerError"\n        assert client.get("/not-found").data == b"direct NotFound"', start: 283, tick: 1, types_hash: 'e7e6568a5bdd7b03', _vid: 1066}),
  (:Symbol {body_hash: '7f35278aa55a734c', deleted: false, end: 14, key: 'tests/test_views.py::common_test', kind: 'function', name: 'common_test', path: 'tests/test_views.py', qualname: 'common_test', sig_hash: '462ce794eb370ded', signature: 'common_test(app)', source: 'def common_test(app):\n    c = app.test_client()\n\n    assert c.get("/").data == b"GET"\n    assert c.post("/").data == b"POST"\n    assert c.put("/").status_code == 405\n    meths = parse_set_header(c.open("/", method="OPTIONS").headers["Allow"])\n    assert sorted(meths) == ["GET", "HEAD", "OPTIONS", "POST"]', start: 7, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 1067}),
  (:Symbol {body_hash: '5648c6922e2f2e00', deleted: false, end: 25, key: 'tests/test_views.py::test_basic_view', kind: 'function', name: 'test_basic_view', path: 'tests/test_views.py', qualname: 'test_basic_view', sig_hash: '462ce794eb370ded', signature: 'test_basic_view(app)', source: 'def test_basic_view(app):\n    class Index(flask.views.View):\n        methods = ["GET", "POST"]\n\n        def dispatch_request(self):\n            return flask.request.method\n\n    app.add_url_rule("/", view_func=Index.as_view("index"))\n    common_test(app)', start: 17, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 1068}),
  (:Symbol {body_hash: '6410b0507a64cec9', deleted: false, end: 38, key: 'tests/test_views.py::test_method_based_view', kind: 'function', name: 'test_method_based_view', path: 'tests/test_views.py', qualname: 'test_method_based_view', sig_hash: '462ce794eb370ded', signature: 'test_method_based_view(app)', source: 'def test_method_based_view(app):\n    class Index(flask.views.MethodView):\n        def get(self):\n            return "GET"\n\n        def post(self):\n            return "POST"\n\n    app.add_url_rule("/", view_func=Index.as_view("index"))\n\n    common_test(app)', start: 28, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 1069}),
  (:Symbol {body_hash: 'db93c57301675b67', deleted: false, end: 59, key: 'tests/test_views.py::test_view_patching', kind: 'function', name: 'test_view_patching', path: 'tests/test_views.py', qualname: 'test_view_patching', sig_hash: '462ce794eb370ded', signature: 'test_view_patching(app)', source: 'def test_view_patching(app):\n    class Index(flask.views.MethodView):\n        def get(self):\n            raise ZeroDivisionError\n\n        def post(self):\n            raise ZeroDivisionError\n\n    class Other(Index):\n        def get(self):\n            return "GET"\n\n        def post(self):\n            return "POST"\n\n    view = Index.as_view("index")\n    view.view_class = Other\n    app.add_url_rule("/", view_func=view)\n    common_test(app)', start: 41, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 1070}),
  (:Symbol {body_hash: '5b08cb7562b1e30a', deleted: false, end: 77, key: 'tests/test_views.py::test_view_inheritance', kind: 'function', name: 'test_view_inheritance', path: 'tests/test_views.py', qualname: 'test_view_inheritance', sig_hash: 'df6ec3162cad163f', signature: 'test_view_inheritance(app, client)', source: 'def test_view_inheritance(app, client):\n    class Index(flask.views.MethodView):\n        def get(self):\n            return "GET"\n\n        def post(self):\n            return "POST"\n\n    class BetterIndex(Index):\n        def delete(self):\n            return "DELETE"\n\n    app.add_url_rule("/", view_func=BetterIndex.as_view("index"))\n\n    meths = parse_set_header(client.open("/", method="OPTIONS").headers["Allow"])\n    assert sorted(meths) == ["DELETE", "GET", "HEAD", "OPTIONS", "POST"]', start: 62, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1071}),
  (:Symbol {body_hash: '04c8db43d2f885c1', deleted: false, end: 98, key: 'tests/test_views.py::test_view_decorators', kind: 'function', name: 'test_view_decorators', path: 'tests/test_views.py', qualname: 'test_view_decorators', sig_hash: 'df6ec3162cad163f', signature: 'test_view_decorators(app, client)', source: 'def test_view_decorators(app, client):\n    def add_x_parachute(f):\n        def new_function(*args, **kwargs):\n            resp = flask.make_response(f(*args, **kwargs))\n            resp.headers["X-Parachute"] = "awesome"\n            return resp\n\n        return new_function\n\n    class Index(flask.views.View):\n        decorators = [add_x_parachute]\n\n        def dispatch_request(self):\n            return "Awesome"\n\n    app.add_url_rule("/", view_func=Index.as_view("index"))\n    rv = client.get("/")\n    assert rv.headers["X-Parachute"] == "awesome"\n    assert rv.data == b"Awesome"', start: 80, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1072}),
  (:Symbol {body_hash: 'e43273ff98a7c933', deleted: false, end: 138, key: 'tests/test_views.py::test_view_provide_automatic_options_attr', kind: 'function', name: 'test_view_provide_automatic_options_attr', path: 'tests/test_views.py', qualname: 'test_view_provide_automatic_options_attr', sig_hash: '4943fbd3d489f4fa', signature: 'test_view_provide_automatic_options_attr()', source: 'def test_view_provide_automatic_options_attr():\n    app = flask.Flask(__name__)\n\n    class Index1(flask.views.View):\n        provide_automatic_options = False\n\n        def dispatch_request(self):\n            return "Hello World!"\n\n    app.add_url_rule("/", view_func=Index1.as_view("index"))\n    c = app.test_client()\n    rv = c.open("/", method="OPTIONS")\n    assert rv.status_code == 405\n\n    app = flask.Flask(__name__)\n\n    class Index2(flask.views.View):\n        methods = ["OPTIONS"]\n        provide_automatic_options = True\n\n        def dispatch_request(self):\n            return "Hello World!"\n\n    app.add_url_rule("/", view_func=Index2.as_view("index"))\n    c = app.test_client()\n    rv = c.open("/", method="OPTIONS")\n    assert sorted(rv.allow) == ["OPTIONS"]\n\n    app = flask.Flask(__name__)\n\n    class Index3(flask.views.View):\n        def dispatch_request(self):\n            return "Hello World!"\n\n    app.add_url_rule("/", view_func=Index3.as_view("index"))\n    c = app.test_client()\n    rv = c.open("/", method="OPTIONS")\n    assert "OPTIONS" in rv.allow', start: 101, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 1073}),
  (:Symbol {body_hash: '6ffba4bdf8afdd06', deleted: false, end: 152, key: 'tests/test_views.py::test_implicit_head', kind: 'function', name: 'test_implicit_head', path: 'tests/test_views.py', qualname: 'test_implicit_head', sig_hash: 'df6ec3162cad163f', signature: 'test_implicit_head(app, client)', source: 'def test_implicit_head(app, client):\n    class Index(flask.views.MethodView):\n        def get(self):\n            return flask.Response("Blub", headers={"X-Method": flask.request.method})\n\n    app.add_url_rule("/", view_func=Index.as_view("index"))\n    rv = client.get("/")\n    assert rv.data == b"Blub"\n    assert rv.headers["X-Method"] == "GET"\n    rv = client.head("/")\n    assert rv.data == b""\n    assert rv.headers["X-Method"] == "HEAD"', start: 141, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1074}),
  (:Symbol {body_hash: 'd50256b4123ce414', deleted: false, end: 168, key: 'tests/test_views.py::test_explicit_head', kind: 'function', name: 'test_explicit_head', path: 'tests/test_views.py', qualname: 'test_explicit_head', sig_hash: 'df6ec3162cad163f', signature: 'test_explicit_head(app, client)', source: 'def test_explicit_head(app, client):\n    class Index(flask.views.MethodView):\n        def get(self):\n            return "GET"\n\n        def head(self):\n            return flask.Response("", headers={"X-Method": "HEAD"})\n\n    app.add_url_rule("/", view_func=Index.as_view("index"))\n    rv = client.get("/")\n    assert rv.data == b"GET"\n    rv = client.head("/")\n    assert rv.data == b""\n    assert rv.headers["X-Method"] == "HEAD"', start: 155, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1075}),
  (:Symbol {body_hash: '135cfcd0a975d202', deleted: false, end: 186, key: 'tests/test_views.py::test_endpoint_override', kind: 'function', name: 'test_endpoint_override', path: 'tests/test_views.py', qualname: 'test_endpoint_override', sig_hash: '462ce794eb370ded', signature: 'test_endpoint_override(app)', source: 'def test_endpoint_override(app):\n    app.debug = True\n\n    class Index(flask.views.View):\n        methods = ["GET", "POST"]\n\n        def dispatch_request(self):\n            return flask.request.method\n\n    app.add_url_rule("/", view_func=Index.as_view("index"))\n\n    with pytest.raises(AssertionError):\n        app.add_url_rule("/", view_func=Index.as_view("index"))\n\n    # But these tests should still pass. We just log a warning.\n    common_test(app)', start: 171, tick: 5, types_hash: 'e676b88ce5d6fa4e', _vid: 1076}),
  (:Symbol {body_hash: '763b1dfa9eeb30b5', deleted: false, end: 204, key: 'tests/test_views.py::test_methods_var_inheritance', kind: 'function', name: 'test_methods_var_inheritance', path: 'tests/test_views.py', qualname: 'test_methods_var_inheritance', sig_hash: 'df6ec3162cad163f', signature: 'test_methods_var_inheritance(app, client)', source: 'def test_methods_var_inheritance(app, client):\n    class BaseView(flask.views.MethodView):\n        methods = ["GET", "PROPFIND"]\n\n    class ChildView(BaseView):\n        def get(self):\n            return "GET"\n\n        def propfind(self):\n            return "PROPFIND"\n\n    app.add_url_rule("/", view_func=ChildView.as_view("index"))\n\n    assert client.get("/").data == b"GET"\n    assert client.open("/", method="PROPFIND").data == b"PROPFIND"\n    assert ChildView.methods == {"PROPFIND", "GET"}', start: 189, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1077}),
  (:Symbol {body_hash: '9b6ee88bf31b4425', deleted: false, end: 223, key: 'tests/test_views.py::test_multiple_inheritance', kind: 'function', name: 'test_multiple_inheritance', path: 'tests/test_views.py', qualname: 'test_multiple_inheritance', sig_hash: 'df6ec3162cad163f', signature: 'test_multiple_inheritance(app, client)', source: 'def test_multiple_inheritance(app, client):\n    class GetView(flask.views.MethodView):\n        def get(self):\n            return "GET"\n\n    class DeleteView(flask.views.MethodView):\n        def delete(self):\n            return "DELETE"\n\n    class GetDeleteView(GetView, DeleteView):\n        pass\n\n    app.add_url_rule("/", view_func=GetDeleteView.as_view("index"))\n\n    assert client.get("/").data == b"GET"\n    assert client.delete("/").data == b"DELETE"\n    assert sorted(GetDeleteView.methods) == ["DELETE", "GET"]', start: 207, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1078}),
  (:Symbol {body_hash: '2fd92519c83100c6', deleted: false, end: 242, key: 'tests/test_views.py::test_remove_method_from_parent', kind: 'function', name: 'test_remove_method_from_parent', path: 'tests/test_views.py', qualname: 'test_remove_method_from_parent', sig_hash: 'df6ec3162cad163f', signature: 'test_remove_method_from_parent(app, client)', source: 'def test_remove_method_from_parent(app, client):\n    class GetView(flask.views.MethodView):\n        def get(self):\n            return "GET"\n\n    class OtherView(flask.views.MethodView):\n        def post(self):\n            return "POST"\n\n    class View(GetView, OtherView):\n        methods = ["GET"]\n\n    app.add_url_rule("/", view_func=View.as_view("index"))\n\n    assert client.get("/").data == b"GET"\n    assert client.post("/").status_code == 405\n    assert sorted(View.methods) == ["GET"]', start: 226, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1079}),
  (:Symbol {body_hash: 'e5dd25b287f55970', deleted: false, end: 260, key: 'tests/test_views.py::test_init_once', kind: 'function', name: 'test_init_once', path: 'tests/test_views.py', qualname: 'test_init_once', sig_hash: 'df6ec3162cad163f', signature: 'test_init_once(app, client)', source: 'def test_init_once(app, client):\n    n = 0\n\n    class CountInit(flask.views.View):\n        init_every_request = False\n\n        def __init__(self):\n            nonlocal n\n            n += 1\n\n        def dispatch_request(self):\n            return str(n)\n\n    app.add_url_rule("/", view_func=CountInit.as_view("index"))\n    assert client.get("/").data == b"1"\n    assert client.get("/").data == b"1"', start: 245, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1080}),
  (:Symbol {body_hash: 'b82ed5822a5622b6', deleted: true, deleted_tick: 5, end: 13, key: 'tests/typing/typing_app_decorators.py::after_sync', kind: 'function', name: 'after_sync', path: 'tests/typing/typing_app_decorators.py', qualname: 'after_sync', sig_hash: '5e57795fedec4436', signature: 'after_sync(response: Response) -> Response', source: '@app.after_request\ndef after_sync(response: Response) -> Response:\n    return Response()', start: 12, tick: 1, types_hash: '5382f1de291f7bc3', _vid: 1081}),
