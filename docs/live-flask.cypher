  (:Symbol {body_hash: '07aa1871acd6e05d', deleted: false, end: 30, key: 'tests/test_helpers.py::PyBytesIO', kind: 'class', name: 'PyBytesIO', path: 'tests/test_helpers.py', qualname: 'PyBytesIO', sig_hash: '42ba610a86d15094', signature: 'class PyBytesIO', source: 'class PyBytesIO:\n    def __init__(self, *args, **kwargs):\n        self._io = io.BytesIO(*args, **kwargs)\n\n    def __getattr__(self, name):\n        return getattr(self._io, name)', start: 25, tick: 5, types_hash: '', _vid: 901}),
  (:Symbol {body_hash: 'eba950ea56a2a50f', deleted: false, end: 27, key: 'tests/test_helpers.py::PyBytesIO.__init__', kind: 'method', name: '__init__', path: 'tests/test_helpers.py', qualname: 'PyBytesIO.__init__', sig_hash: '720606666acb024c', signature: '__init__(self, *args, **kwargs)', source: '    def __init__(self, *args, **kwargs):\n        self._io = io.BytesIO(*args, **kwargs)', start: 26, tick: 5, types_hash: 'b93f6d5516867d62', _vid: 902}),
