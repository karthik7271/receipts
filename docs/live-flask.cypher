  (:Symbol {body_hash: '5d8f9c4f0bc2e879', deleted: true, deleted_tick: 5, end: 18, key: 'tests/typing/typing_route.py::hello_str', kind: 'function', name: 'hello_str', path: 'tests/typing/typing_route.py', qualname: 'hello_str', sig_hash: '4943fbd3d489f4fa', signature: 'hello_str() -> str', source: '@app.route("/str")\ndef hello_str() -> str:\n    return "<p>Hello, World!</p>"', start: 17, tick: 1, types_hash: 'e4d3f80f24f9ed3d', _vid: 1091}),
  (:Symbol {body_hash: '423cd2a5b4264cc0', deleted: true, deleted_tick: 5, end: 23, key: 'tests/typing/typing_route.py::hello_bytes', kind: 'function', name: 'hello_bytes', path: 'tests/typing/typing_route.py', qualname: 'hello_bytes', sig_hash: '4943fbd3d489f4fa', signature: 'hello_bytes() -> bytes', source: '@app.route("/bytes")\ndef hello_bytes() -> bytes:\n    return b"<p>Hello, World!</p>"', start: 22, tick: 1, types_hash: 'c94db734ac0a006e', _vid: 1092}),
  (:Symbol {body_hash: 'a69811325080417b', deleted: true, deleted_tick: 5, end: 28, key: 'tests/typing/typing_route.py::hello_json', kind: 'function', name: 'hello_json', path: 'tests/typing/typing_route.py', qualname: 'hello_json', sig_hash: '4943fbd3d489f4fa', signature: 'hello_json() -> Response', source: '@app.route("/json")\ndef hello_json() -> Response:\n    return jsonify("Hello, World!")', start: 27, tick: 1, types_hash: '9dc8c623c8f661bb', _vid: 1093}),
  (:Symbol {body_hash: 'd3463451d1af50c0', deleted: true, deleted_tick: 5, end: 33, key: 'tests/typing/typing_route.py::hello_json_dict', kind: 'function', name: 'hello_json_dict', path: 'tests/typing/typing_route.py', qualname: 'hello_json_dict', sig_hash: '4943fbd3d489f4fa', signature: 'hello_json_dict() -> t.Dict[str, t.Any]', source: '@app.route("/json/dict")\ndef hello_json_dict() -> t.Dict[str, t.Any]:\n    return {"response": "Hello, World!"}', start: 32, tick: 1, types_hash: '54cc309b8bf4ff67', _vid: 1094}),
  (:Symbol {body_hash: 'a9d4f5ebb3bfbbae', deleted: true, deleted_tick: 5, end: 38, key: 'tests/typing/typing_route.py::hello_json_list', kind: 'function', name: 'hello_json_list', path: 'tests/typing/typing_route.py', qualname: 'hello_json_list', sig_hash: '4943fbd3d489f4fa', signature: 'hello_json_list() -> t.List[t.Any]', source: '@app.route("/json/dict")\ndef hello_json_list() -> t.List[t.Any]:\n    return [{"message": "Hello"}, {"message": "World"}]', start: 37, tick: 1, types_hash: '9419645cdc63f1dc', _vid: 1095}),
  (:Symbol {body_hash: '1d24f16e422700e3', deleted: true, deleted_tick: 5, end: 42, key: 'tests/typing/typing_route.py::StatusJSON', kind: 'class', name: 'StatusJSON', path: 'tests/typing/typing_route.py', qualname: 'StatusJSON', sig_hash: '426e897c080842a7', signature: 'class StatusJSON(t.TypedDict)', source: 'class StatusJSON(t.TypedDict):\n    status: str', start: 41, tick: 1, types_hash: '', _vid: 1096}),
