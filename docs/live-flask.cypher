  (:Symbol {body_hash: 'b9d1c1661db635a9', deleted: true, deleted_tick: 5, end: 56, key: 'tests/typing/typing_route.py::hello_generator', kind: 'function', name: 'hello_generator', path: 'tests/typing/typing_route.py', qualname: 'hello_generator', sig_hash: '4943fbd3d489f4fa', signature: 'hello_generator() -> t.Generator[str, None, None]', source: '@app.route("/generator")\ndef hello_generator() -> t.Generator[str, None, None]:\n    def show() -> t.Generator[str, None, None]:\n        for x in range(100):\n            yield f"data:{x}\\n\\n"\n\n    return show()', start: 51, tick: 1, types_hash: '70503dfe4a93a680', _vid: 1098}),
  (:Symbol {body_hash: '561107acc9c7458e', deleted: true, deleted_tick: 5, end: 61, key: 'tests/typing/typing_route.py::hello_generator_expression', kind: 'function', name: 'hello_generator_expression', path: 'tests/typing/typing_route.py', qualname: 'hello_generator_expression', sig_hash: '4943fbd3d489f4fa', signature: 'hello_generator_expression() -> t.Iterator[bytes]', source: '@app.route("/generator-expression")\ndef hello_generator_expression() -> t.Iterator[bytes]:\n    return (f"data:{x}\\n\\n".encode() for x in range(100))', start: 60, tick: 1, types_hash: '7bddf14d7682e84e', _vid: 1099}),
  (:Symbol {body_hash: 'a29c2cf99214027c', deleted: true, deleted_tick: 5, end: 66, key: 'tests/typing/typing_route.py::hello_iterator', kind: 'function', name: 'hello_iterator', path: 'tests/typing/typing_route.py', qualname: 'hello_iterator', sig_hash: '4943fbd3d489f4fa', signature: 'hello_iterator() -> t.Iterator[str]', source: '@app.route("/iterator")\ndef hello_iterator() -> t.Iterator[str]:\n    return iter([f"data:{x}\\n\\n" for x in range(100)])', start: 65, tick: 1, types_hash: '829891bf5c0127e8', _vid: 1100}),
  (:Symbol {body_hash: '67878e5d10961cc2', deleted: true, deleted_tick: 5, end: 72, key: 'tests/typing/typing_route.py::tuple_status', kind: 'function', name: 'tuple_status', path: 'tests/typing/typing_route.py', qualname: 'tuple_status', sig_hash: 'fb41caabcf2714e6', signature: 'tuple_status(code: int=200) -> tuple[str, int]', source: '@app.route("/status")\n@app.route("/status/<int:code>")\ndef tuple_status(code: int = 200) -> tuple[str, int]:\n    return "hello", code', start: 71, tick: 1, types_hash: '1b530c0f20ff3560', _vid: 1101}),
  (:Symbol {body_hash: 'c541f30963aa68c5', deleted: true, deleted_tick: 5, end: 77, key: 'tests/typing/typing_route.py::tuple_status_enum', kind: 'function', name: 'tuple_status_enum', path: 'tests/typing/typing_route.py', qualname: 'tuple_status_enum', sig_hash: '4943fbd3d489f4fa', signature: 'tuple_status_enum() -> tuple[str, int]', source: '@app.route("/status-enum")\ndef tuple_status_enum() -> tuple[str, int]:\n    return "hello", HTTPStatus.OK', start: 76, tick: 1, types_hash: '559a32115da377cf', _vid: 1102}),
  (:Symbol {body_hash: 'dfd3380eeccfa34a', deleted: true, deleted_tick: 5, end: 82, key: 'tests/typing/typing_route.py::tuple_headers', kind: 'function', name: 'tuple_headers', path: 'tests/typing/typing_route.py', qualname: 'tuple_headers', sig_hash: '4943fbd3d489f4fa', signature: 'tuple_headers() -> tuple[str, dict[str, str]]', source: '@app.route("/headers")\ndef tuple_headers() -> tuple[str, dict[str, str]]:\n    return "Hello, World!", {"Content-Type": "text/plain"}', start: 81, tick: 1, types_hash: '938a88cc6d8798a3', _vid: 1103}),
  (:Symbol {body_hash: '94621bfc27eb4d57', deleted: true, deleted_tick: 5, end: 88, key: 'tests/typing/typing_route.py::return_template', kind: 'function', name: 'return_template', path: 'tests/typing/typing_route.py', qualname: 'return_template', sig_hash: '12a750cc0b0a0292', signature: 'return_template(name: str | None=None) -> str', source: '@app.route("/template")\n@app.route("/template/<name>")\ndef return_template(name: str | None = None) -> str:\n    return render_template("index.html", name=name)', start: 87, tick: 1, types_hash: 'a99b342e6a1ad889', _vid: 1104}),
  (:Symbol {body_hash: 'ee3abdee80b68317', deleted: true, deleted_tick: 5, end: 93, key: 'tests/typing/typing_route.py::return_template_stream', kind: 'function', name: 'return_template_stream', path: 'tests/typing/typing_route.py', qualname: 'return_template_stream', sig_hash: '4943fbd3d489f4fa', signature: 'return_template_stream() -> t.Iterator[str]', source: '@app.route("/template")\ndef return_template_stream() -> t.Iterator[str]:\n    return stream_template("index.html", name="Hello")', start: 92, tick: 1, types_hash: '829891bf5c0127e8', _vid: 1105}),
  (:Symbol {body_hash: 'd60a49b3bae35805', deleted: true, deleted_tick: 5, end: 98, key: 'tests/typing/typing_route.py::async_route', kind: 'function', name: 'async_route', path: 'tests/typing/typing_route.py', qualname: 'async_route', sig_hash: '4943fbd3d489f4fa', signature: 'async_route() -> str', source: '@app.route("/async")\nasync def async_route() -> str:\n    return "Hello"', start: 97, tick: 1, types_hash: 'e4d3f80f24f9ed3d', _vid: 1106}),
  (:Symbol {body_hash: '7dd69f81f5d673bc', deleted: true, deleted_tick: 5, end: 106, key: 'tests/typing/typing_route.py::RenderTemplateView', kind: 'class', name: 'RenderTemplateView', path: 'tests/typing/typing_route.py', qualname: 'RenderTemplateView', sig_hash: '8f40e5b7eeb17735', signature: 'class RenderTemplateView(View)', source: 'class RenderTemplateView(View):\n    def __init__(self: RenderTemplateView, template_name: str) -> None:\n        self.template_name = template_name\n\n    def dispatch_request(self: RenderTemplateView) -> str:\n        return render_template(self.template_name)', start: 101, tick: 1, types_hash: '', _vid: 1107}),
  (:Symbol {body_hash: '82d9a77af0b12c8a', deleted: true, deleted_tick: 5, end: 103, key: 'tests/typing/typing_route.py::RenderTemplateView.__init__', kind: 'method', name: '__init__', path: 'tests/typing/typing_route.py', qualname: 'RenderTemplateView.__init__', sig_hash: 'd3c2ce2953594337', signature: '__init__(self: RenderTemplateView, template_name: str) -> None', source: '    def __init__(self: RenderTemplateView, template_name: str) -> None:\n        self.template_name = template_name', start: 102, tick: 1, types_hash: 'c4e9ec8fb931b247', _vid: 1108}),
  (:Symbol {body_hash: 'a4640be1c57c5bd5', deleted: true, deleted_tick: 5, end: 106, key: 'tests/typing/typing_route.py::RenderTemplateView.dispatch_request', kind: 'method', name: 'dispatch_request', path: 'tests/typing/typing_route.py', qualname: 'RenderTemplateView.dispatch_request', sig_hash: '9626d105938f0039', signature: 'dispatch_request(self: RenderTemplateView) -> str', source: '    def dispatch_request(self: RenderTemplateView) -> str:\n        return render_template(self.template_name)', start: 105, tick: 1, types_hash: '58e233f048007182', _vid: 1109}),
  (:Sync {at: '2026-11-24T07:14:52+00:00', commit: '8728c3e4', files_changed: 1, id: 'S2', tick: 2, _vid: 1110}),
  (:Change {at: '2026-11-24T07:14:52+00:00', commit: '8728c3e4', detail: '.claude/settings.json changed', id: 'C1', kind: 'file', sync: 'S2', tick: 2, _vid: 1111}),
  (:Sync {at: '2026-11-24T07:15:31+00:00', commit: '8728c3e4', files_changed: 1, id: 'S3', tick: 3, _vid: 1112}),
  (:Change {at: '2026-11-24T07:15:31+00:00', commit: '8728c3e4', detail: '.claude/settings.json changed', id: 'C2', kind: 'file', sync: 'S3', tick: 3, _vid: 1113}),
  (:Fact {author: 'agent', created: '2026-11-24T07:16:00+00:00', id: 'M1', kind: 'fact', reasons: ['Flask._find_error_handler was deleted', 'quoted text is gone from src/flask/app.py'], search_text: 'error-handling routing Flask._find_error_handler', status: 'superseded', superseded_by: 'M2', tags: ['error-handling', 'routing'], text: 'Flask error handler precedence (App._find_error_handler): status-code-specific handlers beat exception-class handlers, even when the class handler is on a blueprint and the code handler is on the app. Within each tier, blueprint handlers (from request.blueprints) beat app handlers, then the exception\'s MRO is walked so the most specific class wins. Non-HTTP exceptions have code None, so only the class tier applies to them.', tick: 4, _vid: 1114}),
  (:Sync {at: '2026-11-24T07:16:33+00:00', commit: 'ab814966', files_changed: 111, id: 'S4', tick: 5, _vid: 1115}),
