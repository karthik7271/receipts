  (:File {deleted: false, hash: '4554c7c77994fdd2', lang: 'python', lines: 113, mtime: 1795504588815925463, path: 'tests/type_check/typing_route.py', size: 2532, tick: 5, updated: '2026-11-24T07:16:33+00:00', _vid: 1131}),
  (:Symbol {body_hash: '0acfb5c7235a4765', deleted: false, end: 306, key: 'src/flask/app.py::Flask.get_send_file_max_age', kind: 'method', name: 'get_send_file_max_age', path: 'src/flask/app.py', qualname: 'Flask.get_send_file_max_age', sig_hash: '673744f8011d99c2', signature: 'get_send_file_max_age(self, filename: str | None) -> int | None', source: '    def get_send_file_max_age(self, filename: str | None) -> int | None:\n        """Used by :func:`send_file` to determine the ``max_age`` cache\n        value for a given file path if it wasn\'t passed.\n\n        By default, this returns :data:`SEND_FILE_MAX_AGE_DEFAULT` from\n        the configuration of :data:`~flask.current_app`. This defaults\n        to ``None``, which tells the browser to use conditional requests\n        instead of a timed cache, which is usually preferable.\n\n        Note this is a duplicate of the same method in the Flask\n        class.\n\n        .. versionchanged:: 2.0\n            The default configuration is ``None`` instead of 12 hours.\n\n        .. versionadded:: 0.9\n        """\n        value = current_app.config["SEND_FILE_MAX_AGE_DEFAULT"]\n\n        if value is None:\n            return None\n\n        if isinstance(value, timedelta):\n            return int(value.total_seconds())\n\n        return value  # type: ignore[no-any-return]', start: 281, tick: 5, types_hash: 'c2fd11ae4334cb9c', _vid: 1132}),
  (:Symbol {body_hash: '23975c9784b8a550', deleted: false, end: 328, key: 'src/flask/app.py::Flask.send_static_file', kind: 'method', name: 'send_static_file', path: 'src/flask/app.py', qualname: 'Flask.send_static_file', sig_hash: '673744f8011d99c2', signature: 'send_static_file(self, filename: str) -> Response', source: '    def send_static_file(self, filename: str) -> Response:\n        """The view function used to serve files from\n        :attr:`static_folder`. A route is automatically registered for\n        this view at :attr:`static_url_path` if :attr:`static_folder` is\n        set.\n\n        Note this is a duplicate of the same method in the Flask\n        class.\n\n        .. versionadded:: 0.5\n\n        """\n        if not self.has_static_folder:\n            raise RuntimeError("\'static_folder\' must be set to serve static_files.")\n\n        # send_file only knows to call get_send_file_max_age on the app,\n        # call it here so it works for blueprints too.\n        max_age = self.get_send_file_max_age(filename)\n        return send_from_directory(\n            t.cast(str, self.static_folder), filename, max_age=max_age\n        )', start: 308, tick: 5, types_hash: '357e939093982212', _vid: 1133}),
  (:Symbol {body_hash: '4abb45658b47bcf5', deleted: false, end: 361, key: 'src/flask/app.py::Flask.open_resource', kind: 'method', name: 'open_resource', path: 'src/flask/app.py', qualname: 'Flask.open_resource', sig_hash: '17280b3aa9033a00', signature: 'open_resource(self, resource: str, mode: str=\'rb\', encoding: str | None=None) -> t.IO[t.AnyStr]', source: '    def open_resource(\n        self, resource: str, mode: str = "rb", encoding: str | None = None\n    ) -> t.IO[t.AnyStr]:\n        """Open a resource file relative to :attr:`root_path` for reading.\n\n        For example, if the file ``schema.sql`` is next to the file\n        ``app.py`` where the ``Flask`` app is defined, it can be opened\n        with:\n\n        .. code-block:: python\n\n            with app.open_resource("schema.sql") as f:\n                conn.executescript(f.read())\n\n        :param resource: Path to the resource relative to :attr:`root_path`.\n        :param mode: Open the file in this mode. Only reading is supported,\n            valid values are ``"r"`` (or ``"rt"``) and ``"rb"``.\n        :param encoding: Open the file with this encoding when opening in text\n            mode. This is ignored when opening in binary mode.\n\n        .. versionchanged:: 3.1\n            Added the ``encoding`` parameter.\n        """\n        if mode not in {"r", "rt", "rb"}:\n            raise ValueError("Resources can only be opened for reading.")\n\n        path = os.path.join(self.root_path, resource)\n\n        if mode == "rb":\n            return open(path, mode)  # pyright: ignore\n\n        return open(path, mode, encoding=encoding)', start: 330, tick: 5, types_hash: '9d35f0b01485ffbd', _vid: 1134}),
  (:Symbol {body_hash: '0acfb5c7235a4765', deleted: false, end: 80, key: 'src/flask/blueprints.py::Blueprint.get_send_file_max_age', kind: 'method', name: 'get_send_file_max_age', path: 'src/flask/blueprints.py', qualname: 'Blueprint.get_send_file_max_age', sig_hash: '673744f8011d99c2', signature: 'get_send_file_max_age(self, filename: str | None) -> int | None', source: '    def get_send_file_max_age(self, filename: str | None) -> int | None:\n        """Used by :func:`send_file` to determine the ``max_age`` cache\n        value for a given file path if it wasn\'t passed.\n\n        By default, this returns :data:`SEND_FILE_MAX_AGE_DEFAULT` from\n        the configuration of :data:`~flask.current_app`. This defaults\n        to ``None``, which tells the browser to use conditional requests\n        instead of a timed cache, which is usually preferable.\n\n        Note this is a duplicate of the same method in the Flask\n        class.\n\n        .. versionchanged:: 2.0\n            The default configuration is ``None`` instead of 12 hours.\n\n        .. versionadded:: 0.9\n        """\n        value = current_app.config["SEND_FILE_MAX_AGE_DEFAULT"]\n\n        if value is None:\n            return None\n\n        if isinstance(value, timedelta):\n            return int(value.total_seconds())\n\n        return value  # type: ignore[no-any-return]', start: 55, tick: 5, types_hash: 'c2fd11ae4334cb9c', _vid: 1135}),
  (:Symbol {body_hash: '23975c9784b8a550', deleted: false, end: 102, key: 'src/flask/blueprints.py::Blueprint.send_static_file', kind: 'method', name: 'send_static_file', path: 'src/flask/blueprints.py', qualname: 'Blueprint.send_static_file', sig_hash: '673744f8011d99c2', signature: 'send_static_file(self, filename: str) -> Response', source: '    def send_static_file(self, filename: str) -> Response:\n        """The view function used to serve files from\n        :attr:`static_folder`. A route is automatically registered for\n        this view at :attr:`static_url_path` if :attr:`static_folder` is\n        set.\n\n        Note this is a duplicate of the same method in the Flask\n        class.\n\n        .. versionadded:: 0.5\n\n        """\n        if not self.has_static_folder:\n            raise RuntimeError("\'static_folder\' must be set to serve static_files.")\n\n        # send_file only knows to call get_send_file_max_age on the app,\n        # call it here so it works for blueprints too.\n        max_age = self.get_send_file_max_age(filename)\n        return send_from_directory(\n            t.cast(str, self.static_folder), filename, max_age=max_age\n        )', start: 82, tick: 5, types_hash: '357e939093982212', _vid: 1136}),
  (:Symbol {body_hash: 'c3a491989467c950', deleted: false, end: 128, key: 'src/flask/blueprints.py::Blueprint.open_resource', kind: 'method', name: 'open_resource', path: 'src/flask/blueprints.py', qualname: 'Blueprint.open_resource', sig_hash: 'd1c6628558fd8486', signature: 'open_resource(self, resource: str, mode: str=\'rb\', encoding: str | None=\'utf-8\') -> t.IO[t.AnyStr]', source: '    def open_resource(\n        self, resource: str, mode: str = "rb", encoding: str | None = "utf-8"\n    ) -> t.IO[t.AnyStr]:\n        """Open a resource file relative to :attr:`root_path` for reading. The\n        blueprint-relative equivalent of the app\'s :meth:`~.Flask.open_resource`\n        method.\n\n        :param resource: Path to the resource relative to :attr:`root_path`.\n        :param mode: Open the file in this mode. Only reading is supported,\n            valid values are ``"r"`` (or ``"rt"``) and ``"rb"``.\n        :param encoding: Open the file with this encoding when opening in text\n            mode. This is ignored when opening in binary mode.\n\n        .. versionchanged:: 3.1\n            Added the ``encoding`` parameter.\n        """\n        if mode not in {"r", "rt", "rb"}:\n            raise ValueError("Resources can only be opened for reading.")\n\n        path = os.path.join(self.root_path, resource)\n\n        if mode == "rb":\n            return open(path, mode)  # pyright: ignore\n\n        return open(path, mode, encoding=encoding)', start: 104, tick: 5, types_hash: '9d35f0b01485ffbd', _vid: 1137}),
  (:Symbol {body_hash: 'f604b0b59c6ab26d', deleted: false, end: 377, key: 'src/flask/cli.py::F', kind: 'constant', name: 'F', path: 'src/flask/cli.py', qualname: 'F', sig_hash: 'f604b0b59c6ab26d', signature: 'F = t.TypeVar("F", bound=t.Callable[..., t.Any])', source: 'F = t.TypeVar("F", bound=t.Callable[..., t.Any])', start: 377, tick: 5, types_hash: '', _vid: 1138}),
  (:Symbol {body_hash: 'b02ee2ec991ee421', deleted: false, end: 17, key: 'src/flask/config.py::T', kind: 'constant', name: 'T', path: 'src/flask/config.py', qualname: 'T', sig_hash: 'b02ee2ec991ee421', signature: 'T = t.TypeVar("T")', source: 'T = t.TypeVar("T")', start: 17, tick: 5, types_hash: '', _vid: 1139}),
  (:Symbol {body_hash: 'f604b0b59c6ab26d', deleted: false, end: 152, key: 'src/flask/ctx.py::F', kind: 'constant', name: 'F', path: 'src/flask/ctx.py', qualname: 'F', sig_hash: 'f604b0b59c6ab26d', signature: 'F = t.TypeVar("F", bound=t.Callable[..., t.Any])', source: 'F = t.TypeVar("F", bound=t.Callable[..., t.Any])', start: 152, tick: 5, types_hash: '', _vid: 1140}),
  (:Symbol {body_hash: '14b5607e37994385', deleted: false, end: 319, key: 'src/flask/json/tag.py::TaggedJSONSerializer._untag_scan', kind: 'method', name: '_untag_scan', path: 'src/flask/json/tag.py', qualname: 'TaggedJSONSerializer._untag_scan', sig_hash: '81e944650cc6d217', signature: '_untag_scan(self, value: t.Any) -> t.Any', source: '    def _untag_scan(self, value: t.Any) -> t.Any:\n        if isinstance(value, dict):\n            # untag each item recursively\n            value = {k: self._untag_scan(v) for k, v in value.items()}\n            # untag the dict itself\n            value = self.untag(value)\n        elif isinstance(value, list):\n            # untag each item recursively\n            value = [self._untag_scan(item) for item in value]\n\n        return value', start: 309, tick: 5, types_hash: '84217169eaf761d6', _vid: 1141}),
  (:Symbol {body_hash: 'bab08a8772e6fdd3', deleted: false, end: 56, key: 'src/flask/sansio/app.py::_make_timedelta', kind: 'function', name: '_make_timedelta', path: 'src/flask/sansio/app.py', qualname: '_make_timedelta', sig_hash: 'e9c5144f3fa8b86f', signature: '_make_timedelta(value: timedelta | int | None) -> timedelta | None', source: 'def _make_timedelta(value: timedelta | int | None) -> timedelta | None:\n    if value is None or isinstance(value, timedelta):\n        return value\n\n    return timedelta(seconds=value)', start: 52, tick: 5, types_hash: 'd24808e22e619f01', _vid: 1142}),
  (:Symbol {body_hash: '15d83116d468aacd', deleted: false, end: 964, key: 'src/flask/sansio/app.py::App', kind: 'class', name: 'App', path: 'src/flask/sansio/app.py', qualname: 'App', sig_hash: '8bc1a8488ed5c4cb', signature: 'class App(Scaffold)', source: 'class App(Scaffold):\n    """The flask object implements a WSGI application and acts as the central\n    object.  It is passed the name of the module or package of the\n    application.  Once it is created it will act as a central registry for\n    the view functions, the URL rules, template configuration and much more.\n\n    The name of the package is used to resolve resources from inside the\n    package or the folder the module is contained in depending on if the\n    package parameter resolves to an actual python package (a folder with\n    an :file:`__init__.py` file inside) or a standard module (just a ``.py`` file).\n\n    For more information about resource loading, see :func:`open_resource`.\n\n    Usually you create a :class:`Flask` instance in your main module or\n    in the :file:`__init__.py` file of your package like this::\n\n        from flask import Flask\n        app = Flask(__name__)\n\n    .. admonition:: About the First Parameter\n\n        The idea of the first parameter is to give Flask an idea of what\n        belongs to your application.  This name is used to find resources\n        on the filesystem, can be used by extensions to improve debugging\n        information and a lot more.\n\n        So it\'s important what you provide there.  If you are using a single\n        module, `__name__` is always the correct value.  If you however are\n        using a package, it\'s usually recommended to hardcode the name of\n        your package there.\n\n        For example if your applicatio\n…', start: 59, tick: 5, types_hash: '', _vid: 1143}),
  (:Symbol {body_hash: '9294e6f6532cfd0d', deleted: false, end: 411, key: 'src/flask/sansio/app.py::App.__init__', kind: 'method', name: '__init__', path: 'src/flask/sansio/app.py', qualname: 'App.__init__', sig_hash: 'e920bd7b41e98b02', signature: '__init__(self, import_name: str, static_url_path: str | None=None, static_folder: str | os.PathLike[str] | None=\'static\', static_host: str | None=None, host_matching: bool=False, subdomain_matching: bool=False, template_folder: str | os.PathLike[str] | None=\'templates\', instance_path: str | None=None, instance_relative_config: bool=False, root_path: str | None=None) -> None', source: '    def __init__(\n        self,\n        import_name: str,\n        static_url_path: str | None = None,\n        static_folder: str | os.PathLike[str] | None = "static",\n        static_host: str | None = None,\n        host_matching: bool = False,\n        subdomain_matching: bool = False,\n        template_folder: str | os.PathLike[str] | None = "templates",\n        instance_path: str | None = None,\n        instance_relative_config: bool = False,\n        root_path: str | None = None,\n    ) -> None:\n        super().__init__(\n            import_name=import_name,\n            static_folder=static_folder,\n            static_url_path=static_url_path,\n            template_folder=template_folder,\n            root_path=root_path,\n        )\n\n        if instance_path is None:\n            instance_path = self.auto_find_instance_path()\n        elif not os.path.isabs(instance_path):\n            raise ValueError(\n                "If an instance path is provided it must be absolute."\n                " A relative path was given instead."\n            )\n\n        #: Holds the path to the instance folder.\n        #:\n        #: .. versionadded:: 0.8\n        self.instance_path = instance_path\n\n        #: The configuration dictionary as :class:`Config`.  This behaves\n        #: exactly like a regular dictionary but supports additional methods\n        #: to load a config from files.\n        self.config = self.make_config(instance_relative_config)\n\n        #: An instance of :attr:`aborter_class` created by\n…', start: 282, tick: 5, types_hash: '8556fb5a9cd908ea', _vid: 1144}),
  (:Symbol {body_hash: 'a6220e6f60388d29', deleted: false, end: 423, key: 'src/flask/sansio/app.py::App._check_setup_finished', kind: 'method', name: '_check_setup_finished', path: 'src/flask/sansio/app.py', qualname: 'App._check_setup_finished', sig_hash: '3d397074aa2665af', signature: '_check_setup_finished(self, f_name: str) -> None', source: '    def _check_setup_finished(self, f_name: str) -> None:\n        if self._got_first_request:\n            raise AssertionError(\n                f"The setup method \'{f_name}\' can no longer be called"\n                " on the application. It has already handled its first"\n                " request, any changes will not be applied"\n                " consistently.\\n"\n                "Make sure all imports, decorators, functions, etc."\n                " needed to set up the application are done before"\n                " running it."\n            )', start: 413, tick: 5, types_hash: '13c1224caf2bd244', _vid: 1145}),
  (:Symbol {body_hash: 'b0cdf91b866e4ffa', deleted: false, end: 440, key: 'src/flask/sansio/app.py::App.name', kind: 'method', name: 'name', path: 'src/flask/sansio/app.py', qualname: 'App.name', sig_hash: '9626d105938f0039', signature: 'name(self) -> str', source: '    @cached_property\n    def name(self) -> str:  # type: ignore\n        """The name of the application.  This is usually the import name\n        with the difference that it\'s guessed from the run file if the\n        import name is main.  This name is used as a display name when\n        Flask needs the name of the application.  It can be set and overridden\n        to change the value.\n\n        .. versionadded:: 0.8\n        """\n        if self.import_name == "__main__":\n            fn: str | None = getattr(sys.modules["__main__"], "__file__", None)\n            if fn is None:\n                return "__main__"\n            return os.path.splitext(os.path.basename(fn))[0]\n        return self.import_name', start: 426, tick: 5, types_hash: '151bde88b2690c8e', _vid: 1146}),
  (:Symbol {body_hash: 'ec992a01dd74697c', deleted: false, end: 467, key: 'src/flask/sansio/app.py::App.logger', kind: 'method', name: 'logger', path: 'src/flask/sansio/app.py', qualname: 'App.logger', sig_hash: '9626d105938f0039', signature: 'logger(self) -> logging.Logger', source: '    @cached_property\n    def logger(self) -> logging.Logger:\n        """A standard Python :class:`~logging.Logger` for the app, with\n        the same name as :attr:`name`.\n\n        In debug mode, the logger\'s :attr:`~logging.Logger.level` will\n        be set to :data:`~logging.DEBUG`.\n\n        If there are no handlers configured, a default handler will be\n        added. See :doc:`/logging` for more information.\n\n        .. versionchanged:: 1.1.0\n            The logger takes the same name as :attr:`name` rather than\n            hard-coding ``"flask.app"``.\n\n        .. versionchanged:: 1.0.0\n            Behavior was simplified. The logger is always named\n            ``"flask.app"``. The level is only set during configuration,\n            it doesn\'t check ``app.debug`` each time. Only one format is\n            used, not different ones depending on ``app.debug``. No\n            handlers are removed, and a handler is only added if no\n            handlers are already configured.\n\n        .. versionadded:: 0.3\n        """\n        return create_logger(self)', start: 443, tick: 5, types_hash: '0379d11197d79b1a', _vid: 1147}),
  (:Symbol {body_hash: '7a72a578c052d183', deleted: false, end: 477, key: 'src/flask/sansio/app.py::App.jinja_env', kind: 'method', name: 'jinja_env', path: 'src/flask/sansio/app.py', qualname: 'App.jinja_env', sig_hash: '9626d105938f0039', signature: 'jinja_env(self) -> Environment', source: '    @cached_property\n    def jinja_env(self) -> Environment:\n        """The Jinja environment used to load templates.\n\n        The environment is created the first time this property is\n        accessed. Changing :attr:`jinja_options` after that will have no\n        effect.\n        """\n        return self.create_jinja_environment()', start: 470, tick: 5, types_hash: '7d9016c5fe036c89', _vid: 1148}),
  (:Symbol {body_hash: '1a4ae51d94e8ce87', deleted: false, end: 480, key: 'src/flask/sansio/app.py::App.create_jinja_environment', kind: 'method', name: 'create_jinja_environment', path: 'src/flask/sansio/app.py', qualname: 'App.create_jinja_environment', sig_hash: '9626d105938f0039', signature: 'create_jinja_environment(self) -> Environment', source: '    def create_jinja_environment(self) -> Environment:\n        raise NotImplementedError()', start: 479, tick: 5, types_hash: '7d9016c5fe036c89', _vid: 1149}),
  (:Symbol {body_hash: '4372c42504b759eb', deleted: false, end: 496, key: 'src/flask/sansio/app.py::App.make_config', kind: 'method', name: 'make_config', path: 'src/flask/sansio/app.py', qualname: 'App.make_config', sig_hash: 'bb65af482a8f2d78', signature: 'make_config(self, instance_relative: bool=False) -> Config', source: '    def make_config(self, instance_relative: bool = False) -> Config:\n        """Used to create the config attribute by the Flask constructor.\n        The `instance_relative` parameter is passed in from the constructor\n        of Flask (there named `instance_relative_config`) and indicates if\n        the config should be relative to the instance path or the root path\n        of the application.\n\n        .. versionadded:: 0.8\n        """\n        root_path = self.root_path\n        if instance_relative:\n            root_path = self.instance_path\n        defaults = dict(self.default_config)\n        defaults["DEBUG"] = get_debug_flag()\n        return self.config_class(root_path, defaults)', start: 482, tick: 5, types_hash: '7cc8949e5d29f9bb', _vid: 1150}),
  (:Symbol {body_hash: '863d2b846dfd4bef', deleted: false, end: 508, key: 'src/flask/sansio/app.py::App.make_aborter', kind: 'method', name: 'make_aborter', path: 'src/flask/sansio/app.py', qualname: 'App.make_aborter', sig_hash: '9626d105938f0039', signature: 'make_aborter(self) -> Aborter', source: '    def make_aborter(self) -> Aborter:\n        """Create the object to assign to :attr:`aborter`. That object\n        is called by :func:`flask.abort` to raise HTTP errors, and can\n        be called directly as well.\n\n        By default, this creates an instance of :attr:`aborter_class`,\n        which defaults to :class:`werkzeug.exceptions.Aborter`.\n\n        .. versionadded:: 2.2\n        """\n        return self.aborter_class()', start: 498, tick: 5, types_hash: '1facea8ef4e58422', _vid: 1151}),
  (:Symbol {body_hash: '1cc3212dcee22435', deleted: false, end: 521, key: 'src/flask/sansio/app.py::App.auto_find_instance_path', kind: 'method', name: 'auto_find_instance_path', path: 'src/flask/sansio/app.py', qualname: 'App.auto_find_instance_path', sig_hash: '9626d105938f0039', signature: 'auto_find_instance_path(self) -> str', source: '    def auto_find_instance_path(self) -> str:\n        """Tries to locate the instance path if it was not provided to the\n        constructor of the application class.  It will basically calculate\n        the path to a folder named ``instance`` next to your main file or\n        the package.\n\n        .. versionadded:: 0.8\n        """\n        prefix, package_path = find_package(self.import_name)\n        if prefix is None:\n            return os.path.join(package_path, "instance")\n        return os.path.join(prefix, "var", f"{self.name}-instance")', start: 510, tick: 5, types_hash: '151bde88b2690c8e', _vid: 1152}),
  (:Symbol {body_hash: '12d3c28d74a7b649', deleted: false, end: 534, key: 'src/flask/sansio/app.py::App.create_global_jinja_loader', kind: 'method', name: 'create_global_jinja_loader', path: 'src/flask/sansio/app.py', qualname: 'App.create_global_jinja_loader', sig_hash: '9626d105938f0039', signature: 'create_global_jinja_loader(self) -> DispatchingJinjaLoader', source: '    def create_global_jinja_loader(self) -> DispatchingJinjaLoader:\n        """Creates the loader for the Jinja2 environment.  Can be used to\n        override just the loader and keeping the rest unchanged.  It\'s\n        discouraged to override this function.  Instead one should override\n        the :meth:`jinja_loader` function instead.\n\n        The global loader dispatches between the loaders of the application\n        and the individual blueprints.\n\n        .. versionadded:: 0.7\n        """\n        return DispatchingJinjaLoader(self)', start: 523, tick: 5, types_hash: 'cb5840339ca6d077', _vid: 1153}),
  (:Symbol {body_hash: '2584b65e5fc13354', deleted: false, end: 547, key: 'src/flask/sansio/app.py::App.select_jinja_autoescape', kind: 'method', name: 'select_jinja_autoescape', path: 'src/flask/sansio/app.py', qualname: 'App.select_jinja_autoescape', sig_hash: '673744f8011d99c2', signature: 'select_jinja_autoescape(self, filename: str) -> bool', source: '    def select_jinja_autoescape(self, filename: str) -> bool:\n        """Returns ``True`` if autoescaping should be active for the given\n        template name. If no template name is given, returns `True`.\n\n        .. versionchanged:: 2.2\n            Autoescaping is now enabled by default for ``.svg`` files.\n\n        .. versionadded:: 0.5\n        """\n        if filename is None:\n            return True\n        return filename.endswith((".html", ".htm", ".xml", ".xhtml", ".svg"))', start: 536, tick: 5, types_hash: '091affdbea17a270', _vid: 1154}),
  (:Symbol {body_hash: 'c8f5cb2a530ed653', deleted: false, end: 567, key: 'src/flask/sansio/app.py::App.debug', kind: 'method', name: 'debug', path: 'src/flask/sansio/app.py', qualname: 'App.debug', sig_hash: '81e944650cc6d217', signature: 'debug(self, value: bool) -> None', source: '    @debug.setter\n    def debug(self, value: bool) -> None:\n        self.config["DEBUG"] = value\n\n        if self.config["TEMPLATES_AUTO_RELOAD"] is None:\n            self.jinja_env.auto_reload = value', start: 563, tick: 5, types_hash: '9fead63e8a5500d0', _vid: 1155}),
  (:Symbol {body_hash: '7ab98fd7b7aed3fb', deleted: false, end: 595, key: 'src/flask/sansio/app.py::App.register_blueprint', kind: 'method', name: 'register_blueprint', path: 'src/flask/sansio/app.py', qualname: 'App.register_blueprint', sig_hash: '6327298e7bdc0b54', signature: 'register_blueprint(self, blueprint: Blueprint, **options: t.Any) -> None', source: '    @setupmethod\n    def register_blueprint(self, blueprint: Blueprint, **options: t.Any) -> None:\n        """Register a :class:`~flask.Blueprint` on the application. Keyword\n        arguments passed to this method will override the defaults set on the\n        blueprint.\n\n        Calls the blueprint\'s :meth:`~flask.Blueprint.register` method after\n        recording the blueprint in the application\'s :attr:`blueprints`.\n\n        :param blueprint: The blueprint to register.\n        :param url_prefix: Blueprint routes will be prefixed with this.\n        :param subdomain: Blueprint routes will match on this subdomain.\n        :param url_defaults: Blueprint routes will use these default values for\n            view arguments.\n        :param options: Additional keyword arguments are passed to\n            :class:`~flask.blueprints.BlueprintSetupState`. They can be\n            accessed in :meth:`~flask.Blueprint.record` callbacks.\n\n        .. versionchanged:: 2.0.1\n            The ``name`` option can be used to change the (pre-dotted)\n            name the blueprint is registered with. This allows the same\n            blueprint to be registered multiple times with unique names\n            for ``url_for``.\n\n        .. versionadded:: 0.7\n        """\n        blueprint.register(self, options)', start: 570, tick: 5, types_hash: '11932f7d151559ce', _vid: 1156}),
  (:Symbol {body_hash: 'dd4ae3c755d24af8', deleted: false, end: 602, key: 'src/flask/sansio/app.py::App.iter_blueprints', kind: 'method', name: 'iter_blueprints', path: 'src/flask/sansio/app.py', qualname: 'App.iter_blueprints', sig_hash: '9626d105938f0039', signature: 'iter_blueprints(self) -> t.ValuesView[Blueprint]', source: '    def iter_blueprints(self) -> t.ValuesView[Blueprint]:\n        """Iterates over all blueprints by the order they were registered.\n\n        .. versionadded:: 0.11\n        """\n        return self.blueprints.values()', start: 597, tick: 5, types_hash: '2aef8d1e8a50257a', _vid: 1157}),
  (:Symbol {body_hash: 'c7b2ecf5fe943d99', deleted: false, end: 661, key: 'src/flask/sansio/app.py::App.add_url_rule', kind: 'method', name: 'add_url_rule', path: 'src/flask/sansio/app.py', qualname: 'App.add_url_rule', sig_hash: '2754b8847381d8d9', signature: 'add_url_rule(self, rule: str, endpoint: str | None=None, view_func: ft.RouteCallable | None=None, provide_automatic_options: bool | None=None, **options: t.Any) -> None', source: '    @setupmethod\n    def add_url_rule(\n        self,\n        rule: str,\n        endpoint: str | None = None,\n        view_func: ft.RouteCallable | None = None,\n        provide_automatic_options: bool | None = None,\n        **options: t.Any,\n    ) -> None:\n        if endpoint is None:\n            endpoint = _endpoint_from_view_func(view_func)  # type: ignore\n        options["endpoint"] = endpoint\n        methods = options.pop("methods", None)\n\n        # if the methods are not given and the view_func object knows its\n        # methods we can use that instead.  If neither exists, we go with\n        # a tuple of only ``GET`` as default.\n        if methods is None:\n            methods = getattr(view_func, "methods", None) or ("GET",)\n        if isinstance(methods, str):\n            raise TypeError(\n                "Allowed methods must be a list of strings, for"\n                \' example: @app.route(..., methods=["POST"])\'\n            )\n        methods = {item.upper() for item in methods}\n\n        # Methods that should always be added\n        required_methods: set[str] = set(getattr(view_func, "required_methods", ()))\n\n        # starting with Flask 0.8 the view_func object can disable and\n        # force-enable the automatic options handling.\n        if provide_automatic_options is None:\n            provide_automatic_options = getattr(\n                view_func, "provide_automatic_options", None\n            )\n\n        if provide_automatic_options is None:\n            if "OPTIONS" \n…', start: 605, tick: 5, types_hash: '321dce8d6f484a1f', _vid: 1158}),
  (:Symbol {body_hash: 'a2a2936b26135248', deleted: false, end: 683, key: 'src/flask/sansio/app.py::App.template_filter', kind: 'method', name: 'template_filter', path: 'src/flask/sansio/app.py', qualname: 'App.template_filter', sig_hash: 'e870d781a9f8234e', signature: 'template_filter(self, name: str | None=None) -> t.Callable[[T_template_filter], T_template_filter]', source: '    @setupmethod\n    def template_filter(\n        self, name: str | None = None\n    ) -> t.Callable[[T_template_filter], T_template_filter]:\n        """A decorator that is used to register custom template filter.\n        You can specify a name for the filter, otherwise the function\n        name will be used. Example::\n\n          @app.template_filter()\n          def reverse(s):\n              return s[::-1]\n\n        :param name: the optional name of the filter, otherwise the\n                     function name will be used.\n        """\n\n        def decorator(f: T_template_filter) -> T_template_filter:\n            self.add_template_filter(f, name=name)\n            return f\n\n        return decorator', start: 664, tick: 5, types_hash: '4127e4fa15aee375', _vid: 1159}),
  (:Symbol {body_hash: '5ecec8c42127f34b', deleted: false, end: 695, key: 'src/flask/sansio/app.py::App.add_template_filter', kind: 'method', name: 'add_template_filter', path: 'src/flask/sansio/app.py', qualname: 'App.add_template_filter', sig_hash: '5e9948e058dadf82', signature: 'add_template_filter(self, f: ft.TemplateFilterCallable, name: str | None=None) -> None', source: '    @setupmethod\n    def add_template_filter(\n        self, f: ft.TemplateFilterCallable, name: str | None = None\n    ) -> None:\n        """Register a custom template filter.  Works exactly like the\n        :meth:`template_filter` decorator.\n\n        :param name: the optional name of the filter, otherwise the\n                     function name will be used.\n        """\n        self.jinja_env.filters[name or f.__name__] = f', start: 686, tick: 5, types_hash: 'e2b38ef2962cef0e', _vid: 1160}),
  (:Symbol {body_hash: 'b67aeea13eaebc3c', deleted: false, end: 724, key: 'src/flask/sansio/app.py::App.template_test', kind: 'method', name: 'template_test', path: 'src/flask/sansio/app.py', qualname: 'App.template_test', sig_hash: 'e870d781a9f8234e', signature: 'template_test(self, name: str | None=None) -> t.Callable[[T_template_test], T_template_test]', source: '    @setupmethod\n    def template_test(\n        self, name: str | None = None\n    ) -> t.Callable[[T_template_test], T_template_test]:\n        """A decorator that is used to register custom template test.\n        You can specify a name for the test, otherwise the function\n        name will be used. Example::\n\n          @app.template_test()\n          def is_prime(n):\n              if n == 2:\n                  return True\n              for i in range(2, int(math.ceil(math.sqrt(n))) + 1):\n                  if n % i == 0:\n                      return False\n              return True\n\n        .. versionadded:: 0.10\n\n        :param name: the optional name of the test, otherwise the\n                     function name will be used.\n        """\n\n        def decorator(f: T_template_test) -> T_template_test:\n            self.add_template_test(f, name=name)\n            return f\n\n        return decorator', start: 698, tick: 5, types_hash: '7bb0092ce13a9516', _vid: 1161}),
  (:Symbol {body_hash: '087e8f7fc8fd5d92', deleted: false, end: 738, key: 'src/flask/sansio/app.py::App.add_template_test', kind: 'method', name: 'add_template_test', path: 'src/flask/sansio/app.py', qualname: 'App.add_template_test', sig_hash: '5e9948e058dadf82', signature: 'add_template_test(self, f: ft.TemplateTestCallable, name: str | None=None) -> None', source: '    @setupmethod\n    def add_template_test(\n        self, f: ft.TemplateTestCallable, name: str | None = None\n    ) -> None:\n        """Register a custom template test.  Works exactly like the\n        :meth:`template_test` decorator.\n\n        .. versionadded:: 0.10\n\n        :param name: the optional name of the test, otherwise the\n                     function name will be used.\n        """\n        self.jinja_env.tests[name or f.__name__] = f', start: 727, tick: 5, types_hash: 'd1fe64a9fcb48ef0', _vid: 1162}),
  (:Symbol {body_hash: '838f8d7930cf95ce', deleted: false, end: 762, key: 'src/flask/sansio/app.py::App.template_global', kind: 'method', name: 'template_global', path: 'src/flask/sansio/app.py', qualname: 'App.template_global', sig_hash: 'e870d781a9f8234e', signature: 'template_global(self, name: str | None=None) -> t.Callable[[T_template_global], T_template_global]', source: '    @setupmethod\n    def template_global(\n        self, name: str | None = None\n    ) -> t.Callable[[T_template_global], T_template_global]:\n        """A decorator that is used to register a custom template global function.\n        You can specify a name for the global function, otherwise the function\n        name will be used. Example::\n\n            @app.template_global()\n            def double(n):\n                return 2 * n\n\n        .. versionadded:: 0.10\n\n        :param name: the optional name of the global function, otherwise the\n                     function name will be used.\n        """\n\n        def decorator(f: T_template_global) -> T_template_global:\n            self.add_template_global(f, name=name)\n            return f\n\n        return decorator', start: 741, tick: 5, types_hash: 'df57042f9930e828', _vid: 1163}),
  (:Symbol {body_hash: 'af59963e6a1dff1a', deleted: false, end: 776, key: 'src/flask/sansio/app.py::App.add_template_global', kind: 'method', name: 'add_template_global', path: 'src/flask/sansio/app.py', qualname: 'App.add_template_global', sig_hash: '5e9948e058dadf82', signature: 'add_template_global(self, f: ft.TemplateGlobalCallable, name: str | None=None) -> None', source: '    @setupmethod\n    def add_template_global(\n        self, f: ft.TemplateGlobalCallable, name: str | None = None\n    ) -> None:\n        """Register a custom template global function. Works exactly like the\n        :meth:`template_global` decorator.\n\n        .. versionadded:: 0.10\n\n        :param name: the optional name of the global function, otherwise the\n                     function name will be used.\n        """\n        self.jinja_env.globals[name or f.__name__] = f', start: 765, tick: 5, types_hash: '348c202fa821dce7', _vid: 1164}),
  (:Symbol {body_hash: 'c306a4374204a0c7', deleted: false, end: 810, key: 'src/flask/sansio/app.py::App.teardown_appcontext', kind: 'method', name: 'teardown_appcontext', path: 'src/flask/sansio/app.py', qualname: 'App.teardown_appcontext', sig_hash: 'ebc36a671d7c2913', signature: 'teardown_appcontext(self, f: T_teardown) -> T_teardown', source: '    @setupmethod\n    def teardown_appcontext(self, f: T_teardown) -> T_teardown:\n        """Registers a function to be called when the application\n        context is popped. The application context is typically popped\n        after the request context for each request, at the end of CLI\n        commands, or after a manually pushed context ends.\n\n        .. code-block:: python\n\n            with app.app_context():\n                ...\n\n        When the ``with`` block exits (or ``ctx.pop()`` is called), the\n        teardown functions are called just before the app context is\n        made inactive. Since a request context typically also manages an\n        application context it would also be called when you pop a\n        request context.\n\n        When a teardown function was called because of an unhandled\n        exception it will be passed an error object. If an\n        :meth:`errorhandler` is registered, it will handle the exception\n        and the teardown will not receive it.\n\n        Teardown functions must avoid raising exceptions. If they\n        execute code that might fail they must surround that code with a\n        ``try``/``except`` block and log any errors.\n\n        The return values of teardown functions are ignored.\n\n        .. versionadded:: 0.9\n        """\n        self.teardown_appcontext_funcs.append(f)\n        return f', start: 779, tick: 5, types_hash: 'e5437a4dc4c93fdb', _vid: 1165}),
  (:Symbol {body_hash: 'a2a2f0c0d4da84e1', deleted: false, end: 821, key: 'src/flask/sansio/app.py::App.shell_context_processor', kind: 'method', name: 'shell_context_processor', path: 'src/flask/sansio/app.py', qualname: 'App.shell_context_processor', sig_hash: 'ebc36a671d7c2913', signature: 'shell_context_processor(self, f: T_shell_context_processor) -> T_shell_context_processor', source: '    @setupmethod\n    def shell_context_processor(\n        self, f: T_shell_context_processor\n    ) -> T_shell_context_processor:\n        """Registers a shell context processor function.\n\n        .. versionadded:: 0.11\n        """\n        self.shell_context_processors.append(f)\n        return f', start: 813, tick: 5, types_hash: '08bbf748a22ccee7', _vid: 1166}),
  (:Symbol {body_hash: 'ee563eae152dc37b', deleted: false, end: 846, key: 'src/flask/sansio/app.py::App._find_error_handler', kind: 'method', name: '_find_error_handler', path: 'src/flask/sansio/app.py', qualname: 'App._find_error_handler', sig_hash: '76b8cfb2e3a92c67', signature: '_find_error_handler(self, e: Exception, blueprints: list[str]) -> ft.ErrorHandlerCallable | None', source: '    def _find_error_handler(\n        self, e: Exception, blueprints: list[str]\n    ) -> ft.ErrorHandlerCallable | None:\n        """Return a registered error handler for an exception in this order:\n        blueprint handler for a specific code, app handler for a specific code,\n        blueprint handler for an exception class, app handler for an exception\n        class, or ``None`` if a suitable handler is not found.\n        """\n        exc_class, code = self._get_exc_class_and_code(type(e))\n        names = (*blueprints, None)\n\n        for c in (code, None) if code is not None else (None,):\n            for name in names:\n                handler_map = self.error_handler_spec[name][c]\n\n                if not handler_map:\n                    continue\n\n                for cls in exc_class.__mro__:\n                    handler = handler_map.get(cls)\n\n                    if handler is not None:\n                        return handler\n        return None', start: 823, tick: 5, types_hash: 'c29724ef5d85d39a', _vid: 1167}),
  (:Symbol {body_hash: 'cb161d304e9a44ba', deleted: false, end: 881, key: 'src/flask/sansio/app.py::App.trap_http_exception', kind: 'method', name: 'trap_http_exception', path: 'src/flask/sansio/app.py', qualname: 'App.trap_http_exception', sig_hash: 'eca50bbe187484e8', signature: 'trap_http_exception(self, e: Exception) -> bool', source: '    def trap_http_exception(self, e: Exception) -> bool:\n        """Checks if an HTTP exception should be trapped or not.  By default\n        this will return ``False`` for all exceptions except for a bad request\n        key error if ``TRAP_BAD_REQUEST_ERRORS`` is set to ``True``.  It\n        also returns ``True`` if ``TRAP_HTTP_EXCEPTIONS`` is set to ``True``.\n\n        This is called for all HTTP exceptions raised by a view function.\n        If it returns ``True`` for any exception the error handler for this\n        exception is not called and it shows up as regular exception in the\n        traceback.  This is helpful for debugging implicitly raised HTTP\n        exceptions.\n\n        .. versionchanged:: 1.0\n            Bad request errors are not trapped by default in debug mode.\n\n        .. versionadded:: 0.8\n        """\n        if self.config["TRAP_HTTP_EXCEPTIONS"]:\n            return True\n\n        trap_bad_request = self.config["TRAP_BAD_REQUEST_ERRORS"]\n\n        # if unset, trap key errors in debug mode\n        if (\n            trap_bad_request is None\n            and self.debug\n            and isinstance(e, BadRequestKeyError)\n        ):\n            return True\n\n        if trap_bad_request:\n            return isinstance(e, BadRequest)\n\n        return False', start: 848, tick: 5, types_hash: '9534d7e3a839de2b', _vid: 1168}),
  (:Symbol {body_hash: '4f7c7b0f1aae3234', deleted: false, end: 891, key: 'src/flask/sansio/app.py::App.should_ignore_error', kind: 'method', name: 'should_ignore_error', path: 'src/flask/sansio/app.py', qualname: 'App.should_ignore_error', sig_hash: '2b3d6a1acc6ade1d', signature: 'should_ignore_error(self, error: BaseException | None) -> bool', source: '    def should_ignore_error(self, error: BaseException | None) -> bool:\n        """This is called to figure out if an error should be ignored\n        or not as far as the teardown system is concerned.  If this\n        function returns ``True`` then the teardown handlers will not be\n        passed the error.\n\n        .. versionadded:: 0.10\n        """\n        return False', start: 883, tick: 5, types_hash: '4368e6ad97beee05', _vid: 1169}),
  (:Symbol {body_hash: '583c34f409649143', deleted: false, end: 909, key: 'src/flask/sansio/app.py::App.redirect', kind: 'method', name: 'redirect', path: 'src/flask/sansio/app.py', qualname: 'App.redirect', sig_hash: 'a7708f5aa38d8f46', signature: 'redirect(self, location: str, code: int=302) -> BaseResponse', source: '    def redirect(self, location: str, code: int = 302) -> BaseResponse:\n        """Create a redirect response object.\n\n        This is called by :func:`flask.redirect`, and can be called\n        directly as well.\n\n        :param location: The URL to redirect to.\n        :param code: The status code for the redirect.\n\n        .. versionadded:: 2.2\n            Moved from ``flask.redirect``, which calls this method.\n        """\n        return _wz_redirect(\n            location,\n            code=code,\n            Response=self.response_class,  # type: ignore[arg-type]\n        )', start: 893, tick: 5, types_hash: '11a5a37e622690bd', _vid: 1170}),
  (:Symbol {body_hash: 'f832a653453a4a7e', deleted: false, end: 930, key: 'src/flask/sansio/app.py::App.inject_url_defaults', kind: 'method', name: 'inject_url_defaults', path: 'src/flask/sansio/app.py', qualname: 'App.inject_url_defaults', sig_hash: 'ef2ed707d2d17578', signature: 'inject_url_defaults(self, endpoint: str, values: dict[str, t.Any]) -> None', source: '    def inject_url_defaults(self, endpoint: str, values: dict[str, t.Any]) -> None:\n        """Injects the URL defaults for the given endpoint directly into\n        the values dictionary passed.  This is used internally and\n        automatically called on URL building.\n\n        .. versionadded:: 0.7\n        """\n        names: t.Iterable[str | None] = (None,)\n\n        # url_for may be called outside a request context, parse the\n        # passed endpoint instead of using request.blueprints.\n        if "." in endpoint:\n            names = chain(\n                names, reversed(_split_blueprint_path(endpoint.rpartition(".")[0]))\n            )\n\n        for name in names:\n            if name in self.url_default_functions:\n                for func in self.url_default_functions[name]:\n                    func(endpoint, values)', start: 911, tick: 5, types_hash: 'f99e69fa1cec6ab9', _vid: 1171}),
  (:Symbol {body_hash: '6093f9cabc4a3f37', deleted: false, end: 964, key: 'src/flask/sansio/app.py::App.handle_url_build_error', kind: 'method', name: 'handle_url_build_error', path: 'src/flask/sansio/app.py', qualname: 'App.handle_url_build_error', sig_hash: '6e77fe1a39a6e557', signature: 'handle_url_build_error(self, error: BuildError, endpoint: str, values: dict[str, t.Any]) -> str', source: '    def handle_url_build_error(\n        self, error: BuildError, endpoint: str, values: dict[str, t.Any]\n    ) -> str:\n        """Called by :meth:`.url_for` if a\n        :exc:`~werkzeug.routing.BuildError` was raised. If this returns\n        a value, it will be returned by ``url_for``, otherwise the error\n        will be re-raised.\n\n        Each function in :attr:`url_build_error_handlers` is called with\n        ``error``, ``endpoint`` and ``values``. If a function returns\n        ``None`` or raises a ``BuildError``, it is skipped. Otherwise,\n        its return value is returned by ``url_for``.\n\n        :param error: The active ``BuildError`` being handled.\n        :param endpoint: The endpoint being built.\n        :param values: The keyword arguments passed to ``url_for``.\n        """\n        for handler in self.url_build_error_handlers:\n            try:\n                rv = handler(error, endpoint, values)\n            except BuildError as e:\n                # make error available outside except block\n                error = e\n            else:\n                if rv is not None:\n                    return rv\n\n        # Re-raise if called with an active exception, otherwise raise\n        # the passed in exception.\n        if error is sys.exc_info()[1]:\n            raise\n\n        raise error', start: 932, tick: 5, types_hash: 'fa68793861c92599', _vid: 1172}),
  (:Symbol {body_hash: '5c108d5529261993', deleted: false, end: 116, key: 'src/flask/sansio/blueprints.py::BlueprintSetupState', kind: 'class', name: 'BlueprintSetupState', path: 'src/flask/sansio/blueprints.py', qualname: 'BlueprintSetupState', sig_hash: '42ba610a86d15094', signature: 'class BlueprintSetupState', source: 'class BlueprintSetupState:\n    """Temporary holder object for registering a blueprint with the\n    application.  An instance of this class is created by the\n    :meth:`~flask.Blueprint.make_setup_state` method and later passed\n    to all register callback functions.\n    """\n\n    def __init__(\n        self,\n        blueprint: Blueprint,\n        app: App,\n        options: t.Any,\n        first_registration: bool,\n    ) -> None:\n        #: a reference to the current application\n        self.app = app\n\n        #: a reference to the blueprint that created this setup state.\n        self.blueprint = blueprint\n\n        #: a dictionary with all options that were passed to the\n        #: :meth:`~flask.Flask.register_blueprint` method.\n        self.options = options\n\n        #: as blueprints can be registered multiple times with the\n        #: application and not everything wants to be registered\n        #: multiple times on it, this attribute can be used to figure\n        #: out if the blueprint was registered in the past already.\n        self.first_registration = first_registration\n\n        subdomain = self.options.get("subdomain")\n        if subdomain is None:\n            subdomain = self.blueprint.subdomain\n\n        #: The subdomain that the blueprint should be active for, ``None``\n        #: otherwise.\n        self.subdomain = subdomain\n\n        url_prefix = self.options.get("url_prefix")\n        if url_prefix is None:\n            url_prefix = self.blueprint.url_prefix\n        #: Th\n…', start: 34, tick: 5, types_hash: '', _vid: 1173}),
  (:Symbol {body_hash: '436a6a720724e92f', deleted: false, end: 85, key: 'src/flask/sansio/blueprints.py::BlueprintSetupState.__init__', kind: 'method', name: '__init__', path: 'src/flask/sansio/blueprints.py', qualname: 'BlueprintSetupState.__init__', sig_hash: 'a5da6dea93121d32', signature: '__init__(self, blueprint: Blueprint, app: App, options: t.Any, first_registration: bool) -> None', source: '    def __init__(\n        self,\n        blueprint: Blueprint,\n        app: App,\n        options: t.Any,\n        first_registration: bool,\n    ) -> None:\n        #: a reference to the current application\n        self.app = app\n\n        #: a reference to the blueprint that created this setup state.\n        self.blueprint = blueprint\n\n        #: a dictionary with all options that were passed to the\n        #: :meth:`~flask.Flask.register_blueprint` method.\n        self.options = options\n\n        #: as blueprints can be registered multiple times with the\n        #: application and not everything wants to be registered\n        #: multiple times on it, this attribute can be used to figure\n        #: out if the blueprint was registered in the past already.\n        self.first_registration = first_registration\n\n        subdomain = self.options.get("subdomain")\n        if subdomain is None:\n            subdomain = self.blueprint.subdomain\n\n        #: The subdomain that the blueprint should be active for, ``None``\n        #: otherwise.\n        self.subdomain = subdomain\n\n        url_prefix = self.options.get("url_prefix")\n        if url_prefix is None:\n            url_prefix = self.blueprint.url_prefix\n        #: The prefix that should be used for all URLs defined on the\n        #: blueprint.\n        self.url_prefix = url_prefix\n\n        self.name = self.options.get("name", blueprint.name)\n        self.name_prefix = self.options.get("name_prefix", "")\n\n        #: A dictionary with URL d\n…', start: 41, tick: 5, types_hash: 'f4e712b66f61e7f7', _vid: 1174}),
  (:Symbol {body_hash: '0e6d0bc960001725', deleted: false, end: 116, key: 'src/flask/sansio/blueprints.py::BlueprintSetupState.add_url_rule', kind: 'method', name: 'add_url_rule', path: 'src/flask/sansio/blueprints.py', qualname: 'BlueprintSetupState.add_url_rule', sig_hash: '4628fc9f2fac03ca', signature: 'add_url_rule(self, rule: str, endpoint: str | None=None, view_func: ft.RouteCallable | None=None, **options: t.Any) -> None', source: '    def add_url_rule(\n        self,\n        rule: str,\n        endpoint: str | None = None,\n        view_func: ft.RouteCallable | None = None,\n        **options: t.Any,\n    ) -> None:\n        """A helper method to register a rule (and optionally a view function)\n        to the application.  The endpoint is automatically prefixed with the\n        blueprint\'s name.\n        """\n        if self.url_prefix is not None:\n            if rule:\n                rule = "/".join((self.url_prefix.rstrip("/"), rule.lstrip("/")))\n            else:\n                rule = self.url_prefix\n        options.setdefault("subdomain", self.subdomain)\n        if endpoint is None:\n            endpoint = _endpoint_from_view_func(view_func)  # type: ignore\n        defaults = self.url_defaults\n        if "defaults" in options:\n            defaults = dict(defaults, **options.pop("defaults"))\n\n        self.app.add_url_rule(\n            rule,\n            f"{self.name_prefix}.{self.name}.{endpoint}".lstrip("."),\n            view_func,\n            defaults=defaults,\n            **options,\n        )', start: 87, tick: 5, types_hash: '92edb61a75b120f7', _vid: 1175}),
  (:Symbol {body_hash: '3d4073f2ad2b1b2f', deleted: false, end: 632, key: 'src/flask/sansio/blueprints.py::Blueprint', kind: 'class', name: 'Blueprint', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint', sig_hash: '8bc1a8488ed5c4cb', signature: 'class Blueprint(Scaffold)', source: 'class Blueprint(Scaffold):\n    """Represents a blueprint, a collection of routes and other\n    app-related functions that can be registered on a real application\n    later.\n\n    A blueprint is an object that allows defining application functions\n    without requiring an application object ahead of time. It uses the\n    same decorators as :class:`~flask.Flask`, but defers the need for an\n    application by recording them for later registration.\n\n    Decorating a function with a blueprint creates a deferred function\n    that is called with :class:`~flask.blueprints.BlueprintSetupState`\n    when the blueprint is registered on an application.\n\n    See :doc:`/blueprints` for more information.\n\n    :param name: The name of the blueprint. Will be prepended to each\n        endpoint name.\n    :param import_name: The name of the blueprint package, usually\n        ``__name__``. This helps locate the ``root_path`` for the\n        blueprint.\n    :param static_folder: A folder with static files that should be\n        served by the blueprint\'s static route. The path is relative to\n        the blueprint\'s root path. Blueprint static files are disabled\n        by default.\n    :param static_url_path: The url to serve static files from.\n        Defaults to ``static_folder``. If the blueprint does not have\n        a ``url_prefix``, the app\'s static route will take precedence,\n        and the blueprint\'s static files won\'t be accessible.\n    :param template_folder: A folder with templates that sh\n…', start: 119, tick: 5, types_hash: '', _vid: 1176}),
  (:Symbol {body_hash: 'd3c190ae484a875c', deleted: false, end: 211, key: 'src/flask/sansio/blueprints.py::Blueprint.__init__', kind: 'method', name: '__init__', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.__init__', sig_hash: '22ebebeeabc99504', signature: '__init__(self, name: str, import_name: str, static_folder: str | os.PathLike[str] | None=None, static_url_path: str | None=None, template_folder: str | os.PathLike[str] | None=None, url_prefix: str | None=None, subdomain: str | None=None, url_defaults: dict[str, t.Any] | None=None, root_path: str | None=None, cli_group: str | None=_sentinel)', source: '    def __init__(\n        self,\n        name: str,\n        import_name: str,\n        static_folder: str | os.PathLike[str] | None = None,\n        static_url_path: str | None = None,\n        template_folder: str | os.PathLike[str] | None = None,\n        url_prefix: str | None = None,\n        subdomain: str | None = None,\n        url_defaults: dict[str, t.Any] | None = None,\n        root_path: str | None = None,\n        cli_group: str | None = _sentinel,  # type: ignore[assignment]\n    ):\n        super().__init__(\n            import_name=import_name,\n            static_folder=static_folder,\n            static_url_path=static_url_path,\n            template_folder=template_folder,\n            root_path=root_path,\n        )\n\n        if not name:\n            raise ValueError("\'name\' may not be empty.")\n\n        if "." in name:\n            raise ValueError("\'name\' may not contain a dot \'.\' character.")\n\n        self.name = name\n        self.url_prefix = url_prefix\n        self.subdomain = subdomain\n        self.deferred_functions: list[DeferredSetupFunction] = []\n\n        if url_defaults is None:\n            url_defaults = {}\n\n        self.url_values_defaults = url_defaults\n        self.cli_group = cli_group\n        self._blueprints: list[tuple[Blueprint, dict[str, t.Any]]] = []', start: 174, tick: 5, types_hash: 'be66d7851eea4a55', _vid: 1177}),
  (:Symbol {body_hash: '0ed2acfa7282e954', deleted: false, end: 221, key: 'src/flask/sansio/blueprints.py::Blueprint._check_setup_finished', kind: 'method', name: '_check_setup_finished', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint._check_setup_finished', sig_hash: '3d397074aa2665af', signature: '_check_setup_finished(self, f_name: str) -> None', source: '    def _check_setup_finished(self, f_name: str) -> None:\n        if self._got_registered_once:\n            raise AssertionError(\n                f"The setup method \'{f_name}\' can no longer be called on the blueprint"\n                f" \'{self.name}\'. It has already been registered at least once, any"\n                " changes will not be applied consistently.\\n"\n                "Make sure all imports, decorators, functions, etc. needed to set up"\n                " the blueprint are done before registering it."\n            )', start: 213, tick: 5, types_hash: '13c1224caf2bd244', _vid: 1178}),
  (:Symbol {body_hash: '5583d4af3b32a31a', deleted: false, end: 230, key: 'src/flask/sansio/blueprints.py::Blueprint.record', kind: 'method', name: 'record', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.record', sig_hash: '2254bb2ac0d34a2d', signature: 'record(self, func: DeferredSetupFunction) -> None', source: '    @setupmethod\n    def record(self, func: DeferredSetupFunction) -> None:\n        """Registers a function that is called when the blueprint is\n        registered on the application.  This function is called with the\n        state as argument as returned by the :meth:`make_setup_state`\n        method.\n        """\n        self.deferred_functions.append(func)', start: 224, tick: 5, types_hash: 'e68a17f9f944a99d', _vid: 1179}),
  (:Symbol {body_hash: 'b27a2f2a682d26bc', deleted: false, end: 244, key: 'src/flask/sansio/blueprints.py::Blueprint.record_once', kind: 'method', name: 'record_once', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.record_once', sig_hash: '2254bb2ac0d34a2d', signature: 'record_once(self, func: DeferredSetupFunction) -> None', source: '    @setupmethod\n    def record_once(self, func: DeferredSetupFunction) -> None:\n        """Works like :meth:`record` but wraps the function in another\n        function that will ensure the function is only called once.  If the\n        blueprint is registered a second time on the application, the\n        function passed is not called.\n        """\n\n        def wrapper(state: BlueprintSetupState) -> None:\n            if state.first_registration:\n                func(state)\n\n        self.record(update_wrapper(wrapper, func))', start: 233, tick: 5, types_hash: 'e68a17f9f944a99d', _vid: 1180}),
  (:Symbol {body_hash: 'fc3e7f2b6c1e71f0', deleted: false, end: 253, key: 'src/flask/sansio/blueprints.py::Blueprint.make_setup_state', kind: 'method', name: 'make_setup_state', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.make_setup_state', sig_hash: 'db4f9315b9016ddb', signature: 'make_setup_state(self, app: App, options: dict[str, t.Any], first_registration: bool=False) -> BlueprintSetupState', source: '    def make_setup_state(\n        self, app: App, options: dict[str, t.Any], first_registration: bool = False\n    ) -> BlueprintSetupState:\n        """Creates an instance of :meth:`~flask.blueprints.BlueprintSetupState`\n        object that is later passed to the register callback functions.\n        Subclasses can override this to return a subclass of the setup state.\n        """\n        return BlueprintSetupState(self, app, options, first_registration)', start: 246, tick: 5, types_hash: '57cb4af6933806df', _vid: 1181}),
  (:Symbol {body_hash: 'ec6e251364979f2f', deleted: false, end: 271, key: 'src/flask/sansio/blueprints.py::Blueprint.register_blueprint', kind: 'method', name: 'register_blueprint', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.register_blueprint', sig_hash: '6327298e7bdc0b54', signature: 'register_blueprint(self, blueprint: Blueprint, **options: t.Any) -> None', source: '    @setupmethod\n    def register_blueprint(self, blueprint: Blueprint, **options: t.Any) -> None:\n        """Register a :class:`~flask.Blueprint` on this blueprint. Keyword\n        arguments passed to this method will override the defaults set\n        on the blueprint.\n\n        .. versionchanged:: 2.0.1\n            The ``name`` option can be used to change the (pre-dotted)\n            name the blueprint is registered with. This allows the same\n            blueprint to be registered multiple times with unique names\n            for ``url_for``.\n\n        .. versionadded:: 2.0\n        """\n        if blueprint is self:\n            raise ValueError("Cannot register a blueprint on itself")\n        self._blueprints.append((blueprint, options))', start: 256, tick: 5, types_hash: '11932f7d151559ce', _vid: 1182}),
  (:Symbol {body_hash: '04fe49fa0a525017', deleted: false, end: 377, key: 'src/flask/sansio/blueprints.py::Blueprint.register', kind: 'method', name: 'register', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.register', sig_hash: '756defd522ba3685', signature: 'register(self, app: App, options: dict[str, t.Any]) -> None', source: '    def register(self, app: App, options: dict[str, t.Any]) -> None:\n        """Called by :meth:`Flask.register_blueprint` to register all\n        views and callbacks registered on the blueprint with the\n        application. Creates a :class:`.BlueprintSetupState` and calls\n        each :meth:`record` callback with it.\n\n        :param app: The application this blueprint is being registered\n            with.\n        :param options: Keyword arguments forwarded from\n            :meth:`~Flask.register_blueprint`.\n\n        .. versionchanged:: 2.3\n            Nested blueprints now correctly apply subdomains.\n\n        .. versionchanged:: 2.1\n            Registering the same blueprint with the same name multiple\n            times is an error.\n\n        .. versionchanged:: 2.0.1\n            Nested blueprints are registered with their dotted name.\n            This allows different blueprints with the same name to be\n            nested at different locations.\n\n        .. versionchanged:: 2.0.1\n            The ``name`` option can be used to change the (pre-dotted)\n            name the blueprint is registered with. This allows the same\n            blueprint to be registered multiple times with unique names\n            for ``url_for``.\n        """\n        name_prefix = options.get("name_prefix", "")\n        self_name = options.get("name", self.name)\n        name = f"{name_prefix}.{self_name}".lstrip(".")\n\n        if name in app.blueprints:\n            bp_desc = "this" if app.blueprints[name\n…', start: 273, tick: 5, types_hash: 'efb52aa868900971', _vid: 1183}),
  (:Symbol {body_hash: '4ca57a1e80886e26', deleted: false, end: 410, key: 'src/flask/sansio/blueprints.py::Blueprint._merge_blueprint_funcs', kind: 'method', name: '_merge_blueprint_funcs', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint._merge_blueprint_funcs', sig_hash: '958ed73ff874f561', signature: '_merge_blueprint_funcs(self, app: App, name: str) -> None', source: '    def _merge_blueprint_funcs(self, app: App, name: str) -> None:\n        def extend(\n            bp_dict: dict[ft.AppOrBlueprintKey, list[t.Any]],\n            parent_dict: dict[ft.AppOrBlueprintKey, list[t.Any]],\n        ) -> None:\n            for key, values in bp_dict.items():\n                key = name if key is None else f"{name}.{key}"\n                parent_dict[key].extend(values)\n\n        for key, value in self.error_handler_spec.items():\n            key = name if key is None else f"{name}.{key}"\n            value = defaultdict(\n                dict,\n                {\n                    code: {exc_class: func for exc_class, func in code_values.items()}\n                    for code, code_values in value.items()\n                },\n            )\n            app.error_handler_spec[key] = value\n\n        for endpoint, func in self.view_functions.items():\n            app.view_functions[endpoint] = func\n\n        extend(self.before_request_funcs, app.before_request_funcs)\n        extend(self.after_request_funcs, app.after_request_funcs)\n        extend(\n            self.teardown_request_funcs,\n            app.teardown_request_funcs,\n        )\n        extend(self.url_default_functions, app.url_default_functions)\n        extend(self.url_value_preprocessors, app.url_value_preprocessors)\n        extend(self.template_context_processors, app.template_context_processors)', start: 379, tick: 5, types_hash: 'b1d069c14ed1d1f3', _vid: 1184}),
  (:Symbol {body_hash: 'cddd63a8d7857d0f', deleted: false, end: 441, key: 'src/flask/sansio/blueprints.py::Blueprint.add_url_rule', kind: 'method', name: 'add_url_rule', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.add_url_rule', sig_hash: '2754b8847381d8d9', signature: 'add_url_rule(self, rule: str, endpoint: str | None=None, view_func: ft.RouteCallable | None=None, provide_automatic_options: bool | None=None, **options: t.Any) -> None', source: '    @setupmethod\n    def add_url_rule(\n        self,\n        rule: str,\n        endpoint: str | None = None,\n        view_func: ft.RouteCallable | None = None,\n        provide_automatic_options: bool | None = None,\n        **options: t.Any,\n    ) -> None:\n        """Register a URL rule with the blueprint. See :meth:`.Flask.add_url_rule` for\n        full documentation.\n\n        The URL rule is prefixed with the blueprint\'s URL prefix. The endpoint name,\n        used with :func:`url_for`, is prefixed with the blueprint\'s name.\n        """\n        if endpoint and "." in endpoint:\n            raise ValueError("\'endpoint\' may not contain a dot \'.\' character.")\n\n        if view_func and hasattr(view_func, "__name__") and "." in view_func.__name__:\n            raise ValueError("\'view_func\' name may not contain a dot \'.\' character.")\n\n        self.record(\n            lambda s: s.add_url_rule(\n                rule,\n                endpoint,\n                view_func,\n                provide_automatic_options=provide_automatic_options,\n                **options,\n            )\n        )', start: 413, tick: 5, types_hash: '321dce8d6f484a1f', _vid: 1185}),
  (:Symbol {body_hash: '6ab193bf69820f99', deleted: false, end: 458, key: 'src/flask/sansio/blueprints.py::Blueprint.app_template_filter', kind: 'method', name: 'app_template_filter', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.app_template_filter', sig_hash: 'e870d781a9f8234e', signature: 'app_template_filter(self, name: str | None=None) -> t.Callable[[T_template_filter], T_template_filter]', source: '    @setupmethod\n    def app_template_filter(\n        self, name: str | None = None\n    ) -> t.Callable[[T_template_filter], T_template_filter]:\n        """Register a template filter, available in any template rendered by the\n        application. Equivalent to :meth:`.Flask.template_filter`.\n\n        :param name: the optional name of the filter, otherwise the\n                     function name will be used.\n        """\n\n        def decorator(f: T_template_filter) -> T_template_filter:\n            self.add_app_template_filter(f, name=name)\n            return f\n\n        return decorator', start: 444, tick: 5, types_hash: '4127e4fa15aee375', _vid: 1186}),
  (:Symbol {body_hash: 'bc1b84f3a07de0f5', deleted: false, end: 475, key: 'src/flask/sansio/blueprints.py::Blueprint.add_app_template_filter', kind: 'method', name: 'add_app_template_filter', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.add_app_template_filter', sig_hash: '5e9948e058dadf82', signature: 'add_app_template_filter(self, f: ft.TemplateFilterCallable, name: str | None=None) -> None', source: '    @setupmethod\n    def add_app_template_filter(\n        self, f: ft.TemplateFilterCallable, name: str | None = None\n    ) -> None:\n        """Register a template filter, available in any template rendered by the\n        application. Works like the :meth:`app_template_filter` decorator. Equivalent to\n        :meth:`.Flask.add_template_filter`.\n\n        :param name: the optional name of the filter, otherwise the\n                     function name will be used.\n        """\n\n        def register_template(state: BlueprintSetupState) -> None:\n            state.app.jinja_env.filters[name or f.__name__] = f\n\n        self.record_once(register_template)', start: 461, tick: 5, types_hash: 'e2b38ef2962cef0e', _vid: 1187}),
  (:Symbol {body_hash: '5e708d9e226c28a0', deleted: false, end: 494, key: 'src/flask/sansio/blueprints.py::Blueprint.app_template_test', kind: 'method', name: 'app_template_test', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.app_template_test', sig_hash: 'e870d781a9f8234e', signature: 'app_template_test(self, name: str | None=None) -> t.Callable[[T_template_test], T_template_test]', source: '    @setupmethod\n    def app_template_test(\n        self, name: str | None = None\n    ) -> t.Callable[[T_template_test], T_template_test]:\n        """Register a template test, available in any template rendered by the\n        application. Equivalent to :meth:`.Flask.template_test`.\n\n        .. versionadded:: 0.10\n\n        :param name: the optional name of the test, otherwise the\n                     function name will be used.\n        """\n\n        def decorator(f: T_template_test) -> T_template_test:\n            self.add_app_template_test(f, name=name)\n            return f\n\n        return decorator', start: 478, tick: 5, types_hash: '7bb0092ce13a9516', _vid: 1188}),
  (:Symbol {body_hash: 'eb1838eee0e350dd', deleted: false, end: 513, key: 'src/flask/sansio/blueprints.py::Blueprint.add_app_template_test', kind: 'method', name: 'add_app_template_test', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.add_app_template_test', sig_hash: '5e9948e058dadf82', signature: 'add_app_template_test(self, f: ft.TemplateTestCallable, name: str | None=None) -> None', source: '    @setupmethod\n    def add_app_template_test(\n        self, f: ft.TemplateTestCallable, name: str | None = None\n    ) -> None:\n        """Register a template test, available in any template rendered by the\n        application. Works like the :meth:`app_template_test` decorator. Equivalent to\n        :meth:`.Flask.add_template_test`.\n\n        .. versionadded:: 0.10\n\n        :param name: the optional name of the test, otherwise the\n                     function name will be used.\n        """\n\n        def register_template(state: BlueprintSetupState) -> None:\n            state.app.jinja_env.tests[name or f.__name__] = f\n\n        self.record_once(register_template)', start: 497, tick: 5, types_hash: 'd1fe64a9fcb48ef0', _vid: 1189}),
  (:Symbol {body_hash: 'a375a229a3da4f16', deleted: false, end: 532, key: 'src/flask/sansio/blueprints.py::Blueprint.app_template_global', kind: 'method', name: 'app_template_global', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.app_template_global', sig_hash: 'e870d781a9f8234e', signature: 'app_template_global(self, name: str | None=None) -> t.Callable[[T_template_global], T_template_global]', source: '    @setupmethod\n    def app_template_global(\n        self, name: str | None = None\n    ) -> t.Callable[[T_template_global], T_template_global]:\n        """Register a template global, available in any template rendered by the\n        application. Equivalent to :meth:`.Flask.template_global`.\n\n        .. versionadded:: 0.10\n\n        :param name: the optional name of the global, otherwise the\n                     function name will be used.\n        """\n\n        def decorator(f: T_template_global) -> T_template_global:\n            self.add_app_template_global(f, name=name)\n            return f\n\n        return decorator', start: 516, tick: 5, types_hash: 'df57042f9930e828', _vid: 1190}),
  (:Symbol {body_hash: 'a225df670e907ce6', deleted: false, end: 551, key: 'src/flask/sansio/blueprints.py::Blueprint.add_app_template_global', kind: 'method', name: 'add_app_template_global', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.add_app_template_global', sig_hash: '5e9948e058dadf82', signature: 'add_app_template_global(self, f: ft.TemplateGlobalCallable, name: str | None=None) -> None', source: '    @setupmethod\n    def add_app_template_global(\n        self, f: ft.TemplateGlobalCallable, name: str | None = None\n    ) -> None:\n        """Register a template global, available in any template rendered by the\n        application. Works like the :meth:`app_template_global` decorator. Equivalent to\n        :meth:`.Flask.add_template_global`.\n\n        .. versionadded:: 0.10\n\n        :param name: the optional name of the global, otherwise the\n                     function name will be used.\n        """\n\n        def register_template(state: BlueprintSetupState) -> None:\n            state.app.jinja_env.globals[name or f.__name__] = f\n\n        self.record_once(register_template)', start: 535, tick: 5, types_hash: '348c202fa821dce7', _vid: 1191}),
  (:Symbol {body_hash: '2835c7b00899d86f', deleted: false, end: 561, key: 'src/flask/sansio/blueprints.py::Blueprint.before_app_request', kind: 'method', name: 'before_app_request', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.before_app_request', sig_hash: 'ebc36a671d7c2913', signature: 'before_app_request(self, f: T_before_request) -> T_before_request', source: '    @setupmethod\n    def before_app_request(self, f: T_before_request) -> T_before_request:\n        """Like :meth:`before_request`, but before every request, not only those handled\n        by the blueprint. Equivalent to :meth:`.Flask.before_request`.\n        """\n        self.record_once(\n            lambda s: s.app.before_request_funcs.setdefault(None, []).append(f)\n        )\n        return f', start: 554, tick: 5, types_hash: '051402312aa72da7', _vid: 1192}),
  (:Symbol {body_hash: 'eeb845d40f931da1', deleted: false, end: 571, key: 'src/flask/sansio/blueprints.py::Blueprint.after_app_request', kind: 'method', name: 'after_app_request', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.after_app_request', sig_hash: 'ebc36a671d7c2913', signature: 'after_app_request(self, f: T_after_request) -> T_after_request', source: '    @setupmethod\n    def after_app_request(self, f: T_after_request) -> T_after_request:\n        """Like :meth:`after_request`, but after every request, not only those handled\n        by the blueprint. Equivalent to :meth:`.Flask.after_request`.\n        """\n        self.record_once(\n            lambda s: s.app.after_request_funcs.setdefault(None, []).append(f)\n        )\n        return f', start: 564, tick: 5, types_hash: '11cebedf592cd20f', _vid: 1193}),
  (:Symbol {body_hash: '4d9877994203af26', deleted: false, end: 581, key: 'src/flask/sansio/blueprints.py::Blueprint.teardown_app_request', kind: 'method', name: 'teardown_app_request', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.teardown_app_request', sig_hash: 'ebc36a671d7c2913', signature: 'teardown_app_request(self, f: T_teardown) -> T_teardown', source: '    @setupmethod\n    def teardown_app_request(self, f: T_teardown) -> T_teardown:\n        """Like :meth:`teardown_request`, but after every request, not only those\n        handled by the blueprint. Equivalent to :meth:`.Flask.teardown_request`.\n        """\n        self.record_once(\n            lambda s: s.app.teardown_request_funcs.setdefault(None, []).append(f)\n        )\n        return f', start: 574, tick: 5, types_hash: 'e5437a4dc4c93fdb', _vid: 1194}),
  (:Symbol {body_hash: '0959e6a9895ece57', deleted: false, end: 593, key: 'src/flask/sansio/blueprints.py::Blueprint.app_context_processor', kind: 'method', name: 'app_context_processor', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.app_context_processor', sig_hash: 'ebc36a671d7c2913', signature: 'app_context_processor(self, f: T_template_context_processor) -> T_template_context_processor', source: '    @setupmethod\n    def app_context_processor(\n        self, f: T_template_context_processor\n    ) -> T_template_context_processor:\n        """Like :meth:`context_processor`, but for templates rendered by every view, not\n        only by the blueprint. Equivalent to :meth:`.Flask.context_processor`.\n        """\n        self.record_once(\n            lambda s: s.app.template_context_processors.setdefault(None, []).append(f)\n        )\n        return f', start: 584, tick: 5, types_hash: 'dd857fb5c4772440', _vid: 1195}),
  (:Symbol {body_hash: '0073ed6e7b5b5055', deleted: false, end: 610, key: 'src/flask/sansio/blueprints.py::Blueprint.app_errorhandler', kind: 'method', name: 'app_errorhandler', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.app_errorhandler', sig_hash: '1ea3d26175e51ccc', signature: 'app_errorhandler(self, code: type[Exception] | int) -> t.Callable[[T_error_handler], T_error_handler]', source: '    @setupmethod\n    def app_errorhandler(\n        self, code: type[Exception] | int\n    ) -> t.Callable[[T_error_handler], T_error_handler]:\n        """Like :meth:`errorhandler`, but for every request, not only those handled by\n        the blueprint. Equivalent to :meth:`.Flask.errorhandler`.\n        """\n\n        def decorator(f: T_error_handler) -> T_error_handler:\n            def from_blueprint(state: BlueprintSetupState) -> None:\n                state.app.errorhandler(code)(f)\n\n            self.record_once(from_blueprint)\n            return f\n\n        return decorator', start: 596, tick: 5, types_hash: '8735722c9e2a1278', _vid: 1196}),
  (:Symbol {body_hash: 'e4d3f769193d8376', deleted: false, end: 622, key: 'src/flask/sansio/blueprints.py::Blueprint.app_url_value_preprocessor', kind: 'method', name: 'app_url_value_preprocessor', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.app_url_value_preprocessor', sig_hash: 'ebc36a671d7c2913', signature: 'app_url_value_preprocessor(self, f: T_url_value_preprocessor) -> T_url_value_preprocessor', source: '    @setupmethod\n    def app_url_value_preprocessor(\n        self, f: T_url_value_preprocessor\n    ) -> T_url_value_preprocessor:\n        """Like :meth:`url_value_preprocessor`, but for every request, not only those\n        handled by the blueprint. Equivalent to :meth:`.Flask.url_value_preprocessor`.\n        """\n        self.record_once(\n            lambda s: s.app.url_value_preprocessors.setdefault(None, []).append(f)\n        )\n        return f', start: 613, tick: 5, types_hash: '51578653f0862796', _vid: 1197}),
  (:Symbol {body_hash: 'cecbb0d8aa839317', deleted: false, end: 632, key: 'src/flask/sansio/blueprints.py::Blueprint.app_url_defaults', kind: 'method', name: 'app_url_defaults', path: 'src/flask/sansio/blueprints.py', qualname: 'Blueprint.app_url_defaults', sig_hash: 'ebc36a671d7c2913', signature: 'app_url_defaults(self, f: T_url_defaults) -> T_url_defaults', source: '    @setupmethod\n    def app_url_defaults(self, f: T_url_defaults) -> T_url_defaults:\n        """Like :meth:`url_defaults`, but for every request, not only those handled by\n        the blueprint. Equivalent to :meth:`.Flask.url_defaults`.\n        """\n        self.record_once(\n            lambda s: s.app.url_default_functions.setdefault(None, []).append(f)\n        )\n        return f', start: 625, tick: 5, types_hash: '9a48bf9aab352d7a', _vid: 1198}),
  (:Symbol {body_hash: 'f604b0b59c6ab26d', deleted: false, end: 27, key: 'src/flask/sansio/scaffold.py::F', kind: 'constant', name: 'F', path: 'src/flask/sansio/scaffold.py', qualname: 'F', sig_hash: 'f604b0b59c6ab26d', signature: 'F = t.TypeVar("F", bound=t.Callable[..., t.Any])', source: 'F = t.TypeVar("F", bound=t.Callable[..., t.Any])', start: 27, tick: 5, types_hash: '', _vid: 1199});
CREATE (:Symbol {body_hash: '8110d6e1adcd3a47', deleted: false, end: 49, key: 'src/flask/sansio/scaffold.py::setupmethod', kind: 'function', name: 'setupmethod', path: 'src/flask/sansio/scaffold.py', qualname: 'setupmethod', sig_hash: '5f4579065549aa63', signature: 'setupmethod(f: F) -> F', source: 'def setupmethod(f: F) -> F:\n    f_name = f.__name__\n\n    def wrapper_func(self: Scaffold, *args: t.Any, **kwargs: t.Any) -> t.Any:\n        self._check_setup_finished(f_name)\n        return f(self, *args, **kwargs)\n\n    return t.cast(F, update_wrapper(wrapper_func, f))', start: 42, tick: 5, types_hash: '12142ee83ef0c418', _vid: 1200}),
  (:Symbol {body_hash: '7ed37415df067fb4', deleted: false, end: 698, key: 'src/flask/sansio/scaffold.py::Scaffold', kind: 'class', name: 'Scaffold', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold', sig_hash: '42ba610a86d15094', signature: 'class Scaffold', source: 'class Scaffold:\n    """Common behavior shared between :class:`~flask.Flask` and\n    :class:`~flask.blueprints.Blueprint`.\n\n    :param import_name: The import name of the module where this object\n        is defined. Usually :attr:`__name__` should be used.\n    :param static_folder: Path to a folder of static files to serve.\n        If this is set, a static route will be added.\n    :param static_url_path: URL prefix for the static route.\n    :param template_folder: Path to a folder containing template files.\n        for rendering. If this is set, a Jinja loader will be added.\n    :param root_path: The path that static, template, and resource files\n        are relative to. Typically not set, it is discovered based on\n        the ``import_name``.\n\n    .. versionadded:: 2.0\n    """\n\n    cli: Group\n    name: str\n    _static_folder: str | None = None\n    _static_url_path: str | None = None\n\n    def __init__(\n        self,\n        import_name: str,\n        static_folder: str | os.PathLike[str] | None = None,\n        static_url_path: str | None = None,\n        template_folder: str | os.PathLike[str] | None = None,\n        root_path: str | None = None,\n    ):\n        #: The name of the package or module that this object belongs\n        #: to. Do not change this once it is set by the constructor.\n        self.import_name = import_name\n\n        self.static_folder = static_folder  # type: ignore\n        self.static_url_path = static_url_path\n\n        #: The path to the templates folder, r\n…', start: 52, tick: 5, types_hash: '', _vid: 1201}),
  (:Symbol {body_hash: '5df776d488177437', deleted: false, end: 215, key: 'src/flask/sansio/scaffold.py::Scaffold.__init__', kind: 'method', name: '__init__', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.__init__', sig_hash: '0f70264e9ecfb7af', signature: '__init__(self, import_name: str, static_folder: str | os.PathLike[str] | None=None, static_url_path: str | None=None, template_folder: str | os.PathLike[str] | None=None, root_path: str | None=None)', source: '    def __init__(\n        self,\n        import_name: str,\n        static_folder: str | os.PathLike[str] | None = None,\n        static_url_path: str | None = None,\n        template_folder: str | os.PathLike[str] | None = None,\n        root_path: str | None = None,\n    ):\n        #: The name of the package or module that this object belongs\n        #: to. Do not change this once it is set by the constructor.\n        self.import_name = import_name\n\n        self.static_folder = static_folder  # type: ignore\n        self.static_url_path = static_url_path\n\n        #: The path to the templates folder, relative to\n        #: :attr:`root_path`, to add to the template loader. ``None`` if\n        #: templates should not be added.\n        self.template_folder = template_folder\n\n        if root_path is None:\n            root_path = get_root_path(self.import_name)\n\n        #: Absolute path to the package on the filesystem. Used to look\n        #: up resources contained in the package.\n        self.root_path = root_path\n\n        #: A dictionary mapping endpoint names to view functions.\n        #:\n        #: To register a view function, use the :meth:`route` decorator.\n        #:\n        #: This data structure is internal. It should not be modified\n        #: directly and its format may change at any time.\n        self.view_functions: dict[str, ft.RouteCallable] = {}\n\n        #: A data structure of registered error handlers, in the format\n        #: ``{scope: {code: {class: handler}}}``. The\n…', start: 75, tick: 5, types_hash: '226b773f8d8c1347', _vid: 1202}),
  (:Symbol {body_hash: '3f9a12fc6fc594a8', deleted: false, end: 218, key: 'src/flask/sansio/scaffold.py::Scaffold.__repr__', kind: 'method', name: '__repr__', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.__repr__', sig_hash: '9626d105938f0039', signature: '__repr__(self) -> str', source: '    def __repr__(self) -> str:\n        return f"<{type(self).__name__} {self.name!r}>"', start: 217, tick: 5, types_hash: '151bde88b2690c8e', _vid: 1203}),
  (:Symbol {body_hash: '20355cbd5020aeb4', deleted: false, end: 221, key: 'src/flask/sansio/scaffold.py::Scaffold._check_setup_finished', kind: 'method', name: '_check_setup_finished', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold._check_setup_finished', sig_hash: '3d397074aa2665af', signature: '_check_setup_finished(self, f_name: str) -> None', source: '    def _check_setup_finished(self, f_name: str) -> None:\n        raise NotImplementedError', start: 220, tick: 5, types_hash: '13c1224caf2bd244', _vid: 1204}),
  (:Symbol {body_hash: '18ad29937dcf8fc5', deleted: false, end: 238, key: 'src/flask/sansio/scaffold.py::Scaffold.static_folder', kind: 'method', name: 'static_folder', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.static_folder', sig_hash: '81e944650cc6d217', signature: 'static_folder(self, value: str | os.PathLike[str] | None) -> None', source: '    @static_folder.setter\n    def static_folder(self, value: str | os.PathLike[str] | None) -> None:\n        if value is not None:\n            value = os.fspath(value).rstrip(r"\\/")\n\n        self._static_folder = value', start: 234, tick: 5, types_hash: '59d9e5358464d750', _vid: 1205}),
  (:Symbol {body_hash: 'a8d81f2cb252ce00', deleted: false, end: 246, key: 'src/flask/sansio/scaffold.py::Scaffold.has_static_folder', kind: 'method', name: 'has_static_folder', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.has_static_folder', sig_hash: '9626d105938f0039', signature: 'has_static_folder(self) -> bool', source: '    @property\n    def has_static_folder(self) -> bool:\n        """``True`` if :attr:`static_folder` is set.\n\n        .. versionadded:: 0.5\n        """\n        return self.static_folder is not None', start: 241, tick: 5, types_hash: '64c86fa5713fa282', _vid: 1206}),
  (:Symbol {body_hash: 'b292397bf76f3351', deleted: false, end: 269, key: 'src/flask/sansio/scaffold.py::Scaffold.static_url_path', kind: 'method', name: 'static_url_path', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.static_url_path', sig_hash: '81e944650cc6d217', signature: 'static_url_path(self, value: str | None) -> None', source: '    @static_url_path.setter\n    def static_url_path(self, value: str | None) -> None:\n        if value is not None:\n            value = value.rstrip("/")\n\n        self._static_url_path = value', start: 265, tick: 5, types_hash: 'b24cbb92d6c14bbd', _vid: 1207}),
  (:Symbol {body_hash: '0fb9f791235fbf59', deleted: false, end: 282, key: 'src/flask/sansio/scaffold.py::Scaffold.jinja_loader', kind: 'method', name: 'jinja_loader', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.jinja_loader', sig_hash: '9626d105938f0039', signature: 'jinja_loader(self) -> BaseLoader | None', source: '    @cached_property\n    def jinja_loader(self) -> BaseLoader | None:\n        """The Jinja loader for this object\'s templates. By default this\n        is a class :class:`jinja2.loaders.FileSystemLoader` to\n        :attr:`template_folder` if it is set.\n\n        .. versionadded:: 0.5\n        """\n        if self.template_folder is not None:\n            return FileSystemLoader(os.path.join(self.root_path, self.template_folder))\n        else:\n            return None', start: 272, tick: 5, types_hash: '21ccbb5463da1f2d', _vid: 1208}),
  (:Symbol {body_hash: '4ebb357976a3bb30', deleted: false, end: 293, key: 'src/flask/sansio/scaffold.py::Scaffold._method_route', kind: 'method', name: '_method_route', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold._method_route', sig_hash: 'b9104893442eb477', signature: '_method_route(self, method: str, rule: str, options: dict[str, t.Any]) -> t.Callable[[T_route], T_route]', source: '    def _method_route(\n        self,\n        method: str,\n        rule: str,\n        options: dict[str, t.Any],\n    ) -> t.Callable[[T_route], T_route]:\n        if "methods" in options:\n            raise TypeError("Use the \'route\' decorator to use the \'methods\' argument.")\n\n        return self.route(rule, methods=[method], **options)', start: 284, tick: 5, types_hash: 'c562892572bf6014', _vid: 1209}),
  (:Symbol {body_hash: 'e3181d3d579b1421', deleted: false, end: 301, key: 'src/flask/sansio/scaffold.py::Scaffold.get', kind: 'method', name: 'get', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.get', sig_hash: '4cb65333a5963a1d', signature: 'get(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]', source: '    @setupmethod\n    def get(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]:\n        """Shortcut for :meth:`route` with ``methods=["GET"]``.\n\n        .. versionadded:: 2.0\n        """\n        return self._method_route("GET", rule, options)', start: 296, tick: 5, types_hash: '507d2e3716252a34', _vid: 1210}),
  (:Symbol {body_hash: 'eaad29ca48827ce7', deleted: false, end: 309, key: 'src/flask/sansio/scaffold.py::Scaffold.post', kind: 'method', name: 'post', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.post', sig_hash: '4cb65333a5963a1d', signature: 'post(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]', source: '    @setupmethod\n    def post(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]:\n        """Shortcut for :meth:`route` with ``methods=["POST"]``.\n\n        .. versionadded:: 2.0\n        """\n        return self._method_route("POST", rule, options)', start: 304, tick: 5, types_hash: '507d2e3716252a34', _vid: 1211}),
  (:Symbol {body_hash: 'd8a7983da586e2be', deleted: false, end: 317, key: 'src/flask/sansio/scaffold.py::Scaffold.put', kind: 'method', name: 'put', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.put', sig_hash: '4cb65333a5963a1d', signature: 'put(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]', source: '    @setupmethod\n    def put(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]:\n        """Shortcut for :meth:`route` with ``methods=["PUT"]``.\n\n        .. versionadded:: 2.0\n        """\n        return self._method_route("PUT", rule, options)', start: 312, tick: 5, types_hash: '507d2e3716252a34', _vid: 1212}),
  (:Symbol {body_hash: 'c1438143edc06693', deleted: false, end: 325, key: 'src/flask/sansio/scaffold.py::Scaffold.delete', kind: 'method', name: 'delete', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.delete', sig_hash: '4cb65333a5963a1d', signature: 'delete(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]', source: '    @setupmethod\n    def delete(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]:\n        """Shortcut for :meth:`route` with ``methods=["DELETE"]``.\n\n        .. versionadded:: 2.0\n        """\n        return self._method_route("DELETE", rule, options)', start: 320, tick: 5, types_hash: '507d2e3716252a34', _vid: 1213}),
  (:Symbol {body_hash: '22f521aa2735109f', deleted: false, end: 333, key: 'src/flask/sansio/scaffold.py::Scaffold.patch', kind: 'method', name: 'patch', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.patch', sig_hash: '4cb65333a5963a1d', signature: 'patch(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]', source: '    @setupmethod\n    def patch(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]:\n        """Shortcut for :meth:`route` with ``methods=["PATCH"]``.\n\n        .. versionadded:: 2.0\n        """\n        return self._method_route("PATCH", rule, options)', start: 328, tick: 5, types_hash: '507d2e3716252a34', _vid: 1214}),
  (:Symbol {body_hash: '465045eef0ba80f3', deleted: false, end: 365, key: 'src/flask/sansio/scaffold.py::Scaffold.route', kind: 'method', name: 'route', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.route', sig_hash: '4cb65333a5963a1d', signature: 'route(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]', source: '    @setupmethod\n    def route(self, rule: str, **options: t.Any) -> t.Callable[[T_route], T_route]:\n        """Decorate a view function to register it with the given URL\n        rule and options. Calls :meth:`add_url_rule`, which has more\n        details about the implementation.\n\n        .. code-block:: python\n\n            @app.route("/")\n            def index():\n                return "Hello, World!"\n\n        See :ref:`url-route-registrations`.\n\n        The endpoint name for the route defaults to the name of the view\n        function if the ``endpoint`` parameter isn\'t passed.\n\n        The ``methods`` parameter defaults to ``["GET"]``. ``HEAD`` and\n        ``OPTIONS`` are added automatically.\n\n        :param rule: The URL rule string.\n        :param options: Extra options passed to the\n            :class:`~werkzeug.routing.Rule` object.\n        """\n\n        def decorator(f: T_route) -> T_route:\n            endpoint = options.pop("endpoint", None)\n            self.add_url_rule(rule, endpoint, f, **options)\n            return f\n\n        return decorator', start: 336, tick: 5, types_hash: '507d2e3716252a34', _vid: 1215}),
  (:Symbol {body_hash: '8b9ab53577da7394', deleted: false, end: 433, key: 'src/flask/sansio/scaffold.py::Scaffold.add_url_rule', kind: 'method', name: 'add_url_rule', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.add_url_rule', sig_hash: '2754b8847381d8d9', signature: 'add_url_rule(self, rule: str, endpoint: str | None=None, view_func: ft.RouteCallable | None=None, provide_automatic_options: bool | None=None, **options: t.Any) -> None', source: '    @setupmethod\n    def add_url_rule(\n        self,\n        rule: str,\n        endpoint: str | None = None,\n        view_func: ft.RouteCallable | None = None,\n        provide_automatic_options: bool | None = None,\n        **options: t.Any,\n    ) -> None:\n        """Register a rule for routing incoming requests and building\n        URLs. The :meth:`route` decorator is a shortcut to call this\n        with the ``view_func`` argument. These are equivalent:\n\n        .. code-block:: python\n\n            @app.route("/")\n            def index():\n                ...\n\n        .. code-block:: python\n\n            def index():\n                ...\n\n            app.add_url_rule("/", view_func=index)\n\n        See :ref:`url-route-registrations`.\n\n        The endpoint name for the route defaults to the name of the view\n        function if the ``endpoint`` parameter isn\'t passed. An error\n        will be raised if a function has already been registered for the\n        endpoint.\n\n        The ``methods`` parameter defaults to ``["GET"]``. ``HEAD`` is\n        always added automatically, and ``OPTIONS`` is added\n        automatically by default.\n\n        ``view_func`` does not necessarily need to be passed, but if the\n        rule should participate in routing an endpoint name must be\n        associated with a view function at some point with the\n        :meth:`endpoint` decorator.\n\n        .. code-block:: python\n\n            app.add_url_rule("/", endpoint="index")\n\n            @app.endpoint("index\n…', start: 368, tick: 5, types_hash: '321dce8d6f484a1f', _vid: 1216}),
  (:Symbol {body_hash: '4447ab323f3678f7', deleted: false, end: 457, key: 'src/flask/sansio/scaffold.py::Scaffold.endpoint', kind: 'method', name: 'endpoint', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.endpoint', sig_hash: '2ee582ec75ea84f6', signature: 'endpoint(self, endpoint: str) -> t.Callable[[F], F]', source: '    @setupmethod\n    def endpoint(self, endpoint: str) -> t.Callable[[F], F]:\n        """Decorate a view function to register it for the given\n        endpoint. Used if a rule is added without a ``view_func`` with\n        :meth:`add_url_rule`.\n\n        .. code-block:: python\n\n            app.add_url_rule("/ex", endpoint="example")\n\n            @app.endpoint("example")\n            def example():\n                ...\n\n        :param endpoint: The endpoint name to associate with the view\n            function.\n        """\n\n        def decorator(f: F) -> F:\n            self.view_functions[endpoint] = f\n            return f\n\n        return decorator', start: 436, tick: 5, types_hash: 'd685993277b77ee8', _vid: 1217}),
  (:Symbol {body_hash: 'def05ba096c8b1a6', deleted: false, end: 484, key: 'src/flask/sansio/scaffold.py::Scaffold.before_request', kind: 'method', name: 'before_request', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.before_request', sig_hash: 'ebc36a671d7c2913', signature: 'before_request(self, f: T_before_request) -> T_before_request', source: '    @setupmethod\n    def before_request(self, f: T_before_request) -> T_before_request:\n        """Register a function to run before each request.\n\n        For example, this can be used to open a database connection, or\n        to load the logged in user from the session.\n\n        .. code-block:: python\n\n            @app.before_request\n            def load_user():\n                if "user_id" in session:\n                    g.user = db.session.get(session["user_id"])\n\n        The function will be called without any arguments. If it returns\n        a non-``None`` value, the value is handled as if it was the\n        return value from the view, and further request handling is\n        stopped.\n\n        This is available on both app and blueprint objects. When used on an app, this\n        executes before every request. When used on a blueprint, this executes before\n        every request that the blueprint handles. To register with a blueprint and\n        execute before every request, use :meth:`.Blueprint.before_app_request`.\n        """\n        self.before_request_funcs.setdefault(None, []).append(f)\n        return f', start: 460, tick: 5, types_hash: '051402312aa72da7', _vid: 1218}),
  (:Symbol {body_hash: '89edaa159281d715', deleted: false, end: 505, key: 'src/flask/sansio/scaffold.py::Scaffold.after_request', kind: 'method', name: 'after_request', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.after_request', sig_hash: 'ebc36a671d7c2913', signature: 'after_request(self, f: T_after_request) -> T_after_request', source: '    @setupmethod\n    def after_request(self, f: T_after_request) -> T_after_request:\n        """Register a function to run after each request to this object.\n\n        The function is called with the response object, and must return\n        a response object. This allows the functions to modify or\n        replace the response before it is sent.\n\n        If a function raises an exception, any remaining\n        ``after_request`` functions will not be called. Therefore, this\n        should not be used for actions that must execute, such as to\n        close resources. Use :meth:`teardown_request` for that.\n\n        This is available on both app and blueprint objects. When used on an app, this\n        executes after every request. When used on a blueprint, this executes after\n        every request that the blueprint handles. To register with a blueprint and\n        execute after every request, use :meth:`.Blueprint.after_app_request`.\n        """\n        self.after_request_funcs.setdefault(None, []).append(f)\n        return f', start: 487, tick: 5, types_hash: '11cebedf592cd20f', _vid: 1219}),
  (:Symbol {body_hash: '761dc7b031412b52', deleted: false, end: 539, key: 'src/flask/sansio/scaffold.py::Scaffold.teardown_request', kind: 'method', name: 'teardown_request', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.teardown_request', sig_hash: 'ebc36a671d7c2913', signature: 'teardown_request(self, f: T_teardown) -> T_teardown', source: '    @setupmethod\n    def teardown_request(self, f: T_teardown) -> T_teardown:\n        """Register a function to be called when the request context is\n        popped. Typically this happens at the end of each request, but\n        contexts may be pushed manually as well during testing.\n\n        .. code-block:: python\n\n            with app.test_request_context():\n                ...\n\n        When the ``with`` block exits (or ``ctx.pop()`` is called), the\n        teardown functions are called just before the request context is\n        made inactive.\n\n        When a teardown function was called because of an unhandled\n        exception it will be passed an error object. If an\n        :meth:`errorhandler` is registered, it will handle the exception\n        and the teardown will not receive it.\n\n        Teardown functions must avoid raising exceptions. If they\n        execute code that might fail they must surround that code with a\n        ``try``/``except`` block and log any errors.\n\n        The return values of teardown functions are ignored.\n\n        This is available on both app and blueprint objects. When used on an app, this\n        executes after every request. When used on a blueprint, this executes after\n        every request that the blueprint handles. To register with a blueprint and\n        execute after every request, use :meth:`.Blueprint.teardown_app_request`.\n        """\n        self.teardown_request_funcs.setdefault(None, []).append(f)\n        return f', start: 508, tick: 5, types_hash: 'e5437a4dc4c93fdb', _vid: 1220}),
  (:Symbol {body_hash: '27ea85946913165e', deleted: false, end: 556, key: 'src/flask/sansio/scaffold.py::Scaffold.context_processor', kind: 'method', name: 'context_processor', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.context_processor', sig_hash: 'ebc36a671d7c2913', signature: 'context_processor(self, f: T_template_context_processor) -> T_template_context_processor', source: '    @setupmethod\n    def context_processor(\n        self,\n        f: T_template_context_processor,\n    ) -> T_template_context_processor:\n        """Registers a template context processor function. These functions run before\n        rendering a template. The keys of the returned dict are added as variables\n        available in the template.\n\n        This is available on both app and blueprint objects. When used on an app, this\n        is called for every rendered template. When used on a blueprint, this is called\n        for templates rendered from the blueprint\'s views. To register with a blueprint\n        and affect every template, use :meth:`.Blueprint.app_context_processor`.\n        """\n        self.template_context_processors[None].append(f)\n        return f', start: 542, tick: 5, types_hash: 'dd857fb5c4772440', _vid: 1221}),
  (:Symbol {body_hash: '276c2762e1641d95', deleted: false, end: 581, key: 'src/flask/sansio/scaffold.py::Scaffold.url_value_preprocessor', kind: 'method', name: 'url_value_preprocessor', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.url_value_preprocessor', sig_hash: 'ebc36a671d7c2913', signature: 'url_value_preprocessor(self, f: T_url_value_preprocessor) -> T_url_value_preprocessor', source: '    @setupmethod\n    def url_value_preprocessor(\n        self,\n        f: T_url_value_preprocessor,\n    ) -> T_url_value_preprocessor:\n        """Register a URL value preprocessor function for all view\n        functions in the application. These functions will be called before the\n        :meth:`before_request` functions.\n\n        The function can modify the values captured from the matched url before\n        they are passed to the view. For example, this can be used to pop a\n        common language code value and place it in ``g`` rather than pass it to\n        every view.\n\n        The function is passed the endpoint name and values dict. The return\n        value is ignored.\n\n        This is available on both app and blueprint objects. When used on an app, this\n        is called for every request. When used on a blueprint, this is called for\n        requests that the blueprint handles. To register with a blueprint and affect\n        every request, use :meth:`.Blueprint.app_url_value_preprocessor`.\n        """\n        self.url_value_preprocessors[None].append(f)\n        return f', start: 559, tick: 5, types_hash: '51578653f0862796', _vid: 1222}),
  (:Symbol {body_hash: '6ba012cb7ab00049', deleted: false, end: 595, key: 'src/flask/sansio/scaffold.py::Scaffold.url_defaults', kind: 'method', name: 'url_defaults', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.url_defaults', sig_hash: 'ebc36a671d7c2913', signature: 'url_defaults(self, f: T_url_defaults) -> T_url_defaults', source: '    @setupmethod\n    def url_defaults(self, f: T_url_defaults) -> T_url_defaults:\n        """Callback function for URL defaults for all view functions of the\n        application.  It\'s called with the endpoint and values and should\n        update the values passed in place.\n\n        This is available on both app and blueprint objects. When used on an app, this\n        is called for every request. When used on a blueprint, this is called for\n        requests that the blueprint handles. To register with a blueprint and affect\n        every request, use :meth:`.Blueprint.app_url_defaults`.\n        """\n        self.url_default_functions[None].append(f)\n        return f', start: 584, tick: 5, types_hash: '9a48bf9aab352d7a', _vid: 1223}),
  (:Symbol {body_hash: '94d02e7c98c201d0', deleted: false, end: 639, key: 'src/flask/sansio/scaffold.py::Scaffold.errorhandler', kind: 'method', name: 'errorhandler', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.errorhandler', sig_hash: '95e4c361c4335bf9', signature: 'errorhandler(self, code_or_exception: type[Exception] | int) -> t.Callable[[T_error_handler], T_error_handler]', source: '    @setupmethod\n    def errorhandler(\n        self, code_or_exception: type[Exception] | int\n    ) -> t.Callable[[T_error_handler], T_error_handler]:\n        """Register a function to handle errors by code or exception class.\n\n        A decorator that is used to register a function given an\n        error code.  Example::\n\n            @app.errorhandler(404)\n            def page_not_found(error):\n                return \'This page does not exist\', 404\n\n        You can also register handlers for arbitrary exceptions::\n\n            @app.errorhandler(DatabaseError)\n            def special_exception_handler(error):\n                return \'Database connection failed\', 500\n\n        This is available on both app and blueprint objects. When used on an app, this\n        can handle errors from every request. When used on a blueprint, this can handle\n        errors from requests that the blueprint handles. To register with a blueprint\n        and affect every request, use :meth:`.Blueprint.app_errorhandler`.\n\n        .. versionadded:: 0.7\n            Use :meth:`register_error_handler` instead of modifying\n            :attr:`error_handler_spec` directly, for application wide error\n            handlers.\n\n        .. versionadded:: 0.7\n           One can now additionally also register custom exception types\n           that do not necessarily have to be a subclass of the\n           :class:`~werkzeug.exceptions.HTTPException` class.\n\n        :param code_or_exception: the code as integer for the\n…', start: 598, tick: 5, types_hash: '4348ce84f2c5c482', _vid: 1224}),
  (:Symbol {body_hash: '101732d830648f09', deleted: false, end: 654, key: 'src/flask/sansio/scaffold.py::Scaffold.register_error_handler', kind: 'method', name: 'register_error_handler', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold.register_error_handler', sig_hash: '7d24fd4d39d3edb4', signature: 'register_error_handler(self, code_or_exception: type[Exception] | int, f: ft.ErrorHandlerCallable) -> None', source: '    @setupmethod\n    def register_error_handler(\n        self,\n        code_or_exception: type[Exception] | int,\n        f: ft.ErrorHandlerCallable,\n    ) -> None:\n        """Alternative error attach function to the :meth:`errorhandler`\n        decorator that is more straightforward to use for non decorator\n        usage.\n\n        .. versionadded:: 0.7\n        """\n        exc_class, code = self._get_exc_class_and_code(code_or_exception)\n        self.error_handler_spec[None][code][exc_class] = f', start: 642, tick: 5, types_hash: 'da880d4031d609aa', _vid: 1225}),
  (:Symbol {body_hash: '0ea49af771bbc2d3', deleted: false, end: 698, key: 'src/flask/sansio/scaffold.py::Scaffold._get_exc_class_and_code', kind: 'method', name: '_get_exc_class_and_code', path: 'src/flask/sansio/scaffold.py', qualname: 'Scaffold._get_exc_class_and_code', sig_hash: '0f91a5ccf12243e5', signature: '_get_exc_class_and_code(exc_class_or_code: type[Exception] | int) -> tuple[type[Exception], int | None]', source: '    @staticmethod\n    def _get_exc_class_and_code(\n        exc_class_or_code: type[Exception] | int,\n    ) -> tuple[type[Exception], int | None]:\n        """Get the exception class being handled. For HTTP status codes\n        or ``HTTPException`` subclasses, return both the exception and\n        status code.\n\n        :param exc_class_or_code: Any exception class, or an HTTP status\n            code as an integer.\n        """\n        exc_class: type[Exception]\n\n        if isinstance(exc_class_or_code, int):\n            try:\n                exc_class = default_exceptions[exc_class_or_code]\n            except KeyError:\n                raise ValueError(\n                    f"\'{exc_class_or_code}\' is not a recognized HTTP"\n                    " error code. Use a subclass of HTTPException with"\n                    " that code instead."\n                ) from None\n        else:\n            exc_class = exc_class_or_code\n\n        if isinstance(exc_class, Exception):\n            raise TypeError(\n                f"{exc_class!r} is an instance, not a class. Handlers"\n                " can only be registered for Exception classes or HTTP"\n                " error codes."\n            )\n\n        if not issubclass(exc_class, Exception):\n            raise ValueError(\n                f"\'{exc_class.__name__}\' is not a subclass of Exception."\n                " Handlers can only be registered for Exception classes"\n                " or HTTP error codes."\n            )\n\n        if issubclass(exc_cla\n…', start: 657, tick: 5, types_hash: '136948ad73a48e1a', _vid: 1226}),
  (:Symbol {body_hash: 'b05f6f4282111b92', deleted: false, end: 706, key: 'src/flask/sansio/scaffold.py::_endpoint_from_view_func', kind: 'function', name: '_endpoint_from_view_func', path: 'src/flask/sansio/scaffold.py', qualname: '_endpoint_from_view_func', sig_hash: '09453761aed62e04', signature: '_endpoint_from_view_func(view_func: ft.RouteCallable) -> str', source: 'def _endpoint_from_view_func(view_func: ft.RouteCallable) -> str:\n    """Internal helper that returns the default endpoint for a given\n    function.  This always is the function name.\n    """\n    assert view_func is not None, "expected view func if endpoint is not provided."\n    return view_func.__name__', start: 701, tick: 5, types_hash: '5973b47117f38b0a', _vid: 1227}),
  (:Symbol {body_hash: '1abe04484e934cc6', deleted: false, end: 751, key: 'src/flask/sansio/scaffold.py::_find_package_path', kind: 'function', name: '_find_package_path', path: 'src/flask/sansio/scaffold.py', qualname: '_find_package_path', sig_hash: '2188e13e5563eb55', signature: '_find_package_path(import_name: str) -> str', source: 'def _find_package_path(import_name: str) -> str:\n    """Find the path that contains the package or module."""\n    root_mod_name, _, _ = import_name.partition(".")\n\n    try:\n        root_spec = importlib.util.find_spec(root_mod_name)\n\n        if root_spec is None:\n            raise ValueError("not found")\n    except (ImportError, ValueError):\n        # ImportError: the machinery told us it does not exist\n        # ValueError:\n        #    - the module name was invalid\n        #    - the module name is __main__\n        #    - we raised `ValueError` due to `root_spec` being `None`\n        return os.getcwd()\n\n    if root_spec.submodule_search_locations:\n        if root_spec.origin is None or root_spec.origin == "namespace":\n            # namespace package\n            package_spec = importlib.util.find_spec(import_name)\n\n            if package_spec is not None and package_spec.submodule_search_locations:\n                # Pick the path in the namespace that contains the submodule.\n                package_path = pathlib.Path(\n                    os.path.commonpath(package_spec.submodule_search_locations)\n                )\n                search_location = next(\n                    location\n                    for location in root_spec.submodule_search_locations\n                    if package_path.is_relative_to(location)\n                )\n            else:\n                # Pick the first path.\n                search_location = root_spec.submodule_search_locations[0]\n\n            r\n…', start: 709, tick: 5, types_hash: '215c6c202cf6fada', _vid: 1228}),
  (:Symbol {body_hash: '7eb793e4360fecbf', deleted: false, end: 792, key: 'src/flask/sansio/scaffold.py::find_package', kind: 'function', name: 'find_package', path: 'src/flask/sansio/scaffold.py', qualname: 'find_package', sig_hash: '2188e13e5563eb55', signature: 'find_package(import_name: str) -> tuple[str | None, str]', source: 'def find_package(import_name: str) -> tuple[str | None, str]:\n    """Find the prefix that a package is installed under, and the path\n    that it would be imported from.\n\n    The prefix is the directory containing the standard directory\n    hierarchy (lib, bin, etc.). If the package is not installed to the\n    system (:attr:`sys.prefix`) or a virtualenv (``site-packages``),\n    ``None`` is returned.\n\n    The path is the entry in :attr:`sys.path` that contains the package\n    for import. If the package is not installed, it\'s assumed that the\n    package was imported from the current working directory.\n    """\n    package_path = _find_package_path(import_name)\n    py_prefix = os.path.abspath(sys.prefix)\n\n    # installed to the system\n    if pathlib.PurePath(package_path).is_relative_to(py_prefix):\n        return py_prefix, package_path\n\n    site_parent, site_folder = os.path.split(package_path)\n\n    # installed to a virtualenv\n    if site_folder.lower() == "site-packages":\n        parent, folder = os.path.split(site_parent)\n\n        # Windows (prefix/lib/site-packages)\n        if folder.lower() == "lib":\n            return parent, package_path\n\n        # Unix (prefix/lib/pythonX.Y/site-packages)\n        if os.path.basename(parent).lower() == "lib":\n            return os.path.dirname(parent), package_path\n\n        # something else (prefix/site-packages)\n        return site_parent, package_path\n\n    # not installed\n    return None, package_path', start: 754, tick: 5, types_hash: 'a736ba9043a2fc04', _vid: 1229}),
  (:Symbol {body_hash: '6740acd36a87fcb3', deleted: false, end: 235, key: 'src/flask/sessions.py::SessionInterface.get_cookie_partitioned', kind: 'method', name: 'get_cookie_partitioned', path: 'src/flask/sessions.py', qualname: 'SessionInterface.get_cookie_partitioned', sig_hash: 'd5a3a5b9721effdf', signature: 'get_cookie_partitioned(self, app: Flask) -> bool', source: '    def get_cookie_partitioned(self, app: Flask) -> bool:\n        """Returns True if the cookie should be partitioned. By default, uses\n        the value of :data:`SESSION_COOKIE_PARTITIONED`.\n\n        .. versionadded:: 3.1\n        """\n        return app.config["SESSION_COOKIE_PARTITIONED"]  # type: ignore[no-any-return]', start: 229, tick: 5, types_hash: 'f6a5810733cc6a2c', _vid: 1230}),
  (:Symbol {body_hash: 'efcac1fe61b71bbc', deleted: false, end: 295, key: 'src/flask/sessions.py::_lazy_sha1', kind: 'function', name: '_lazy_sha1', path: 'src/flask/sessions.py', qualname: '_lazy_sha1', sig_hash: 'fe7261ae93b5077d', signature: '_lazy_sha1(string: bytes=b\'\') -> t.Any', source: 'def _lazy_sha1(string: bytes = b"") -> t.Any:\n    """Don\'t access ``hashlib.sha1`` until runtime. FIPS builds may not include\n    SHA-1, in which case the import and use as a default would fail before the\n    developer can configure something else.\n    """\n    return hashlib.sha1(string)', start: 290, tick: 5, types_hash: '9d4de875ac10b059', _vid: 1231}),
  (:Symbol {body_hash: '08c81d6bdee2e1cc', deleted: false, end: 105, key: 'src/flask/testing.py::_get_werkzeug_version', kind: 'function', name: '_get_werkzeug_version', path: 'src/flask/testing.py', qualname: '_get_werkzeug_version', sig_hash: '4943fbd3d489f4fa', signature: '_get_werkzeug_version() -> str', source: 'def _get_werkzeug_version() -> str:\n    global _werkzeug_version\n\n    if not _werkzeug_version:\n        _werkzeug_version = importlib.metadata.version("werkzeug")\n\n    return _werkzeug_version', start: 99, tick: 5, types_hash: 'e4d3f80f24f9ed3d', _vid: 1232}),
  (:Symbol {body_hash: 'f604b0b59c6ab26d', deleted: false, end: 9, key: 'src/flask/views.py::F', kind: 'constant', name: 'F', path: 'src/flask/views.py', qualname: 'F', sig_hash: 'f604b0b59c6ab26d', signature: 'F = t.TypeVar("F", bound=t.Callable[..., t.Any])', source: 'F = t.TypeVar("F", bound=t.Callable[..., t.Any])', start: 9, tick: 5, types_hash: '', _vid: 1233}),
  (:Symbol {body_hash: '07ca97a19d694a96', deleted: false, end: 117, key: 'src/flask/wrappers.py::Request.max_form_memory_size', kind: 'method', name: 'max_form_memory_size', path: 'src/flask/wrappers.py', qualname: 'Request.max_form_memory_size', sig_hash: '81e944650cc6d217', signature: 'max_form_memory_size(self, value: int | None) -> None', source: '    @max_form_memory_size.setter\n    def max_form_memory_size(self, value: int | None) -> None:\n        self._max_form_memory_size = value', start: 116, tick: 5, types_hash: 'a14fa08f7293a7c3', _vid: 1234}),
  (:Symbol {body_hash: 'b2a80891019322c9', deleted: false, end: 144, key: 'src/flask/wrappers.py::Request.max_form_parts', kind: 'method', name: 'max_form_parts', path: 'src/flask/wrappers.py', qualname: 'Request.max_form_parts', sig_hash: '81e944650cc6d217', signature: 'max_form_parts(self, value: int | None) -> None', source: '    @max_form_parts.setter\n    def max_form_parts(self, value: int | None) -> None:\n        self._max_form_parts = value', start: 143, tick: 5, types_hash: 'a14fa08f7293a7c3', _vid: 1235}),
  (:Symbol {body_hash: 'e4240cba76a951c2', deleted: false, end: 136, key: 'tests/conftest.py::modules_tmp_path', kind: 'function', name: 'modules_tmp_path', path: 'tests/conftest.py', qualname: 'modules_tmp_path', sig_hash: '9612cdafecb5b0cf', signature: 'modules_tmp_path(tmp_path, monkeypatch)', source: '@pytest.fixture\ndef modules_tmp_path(tmp_path, monkeypatch):\n    """A temporary directory added to sys.path."""\n    rv = tmp_path / "modules_tmp"\n    rv.mkdir()\n    monkeypatch.syspath_prepend(os.fspath(rv))\n    return rv', start: 131, tick: 5, types_hash: 'e1a406a2fec7c7f3', _vid: 1236}),
  (:Symbol {body_hash: '70867878469336c0', deleted: false, end: 142, key: 'tests/conftest.py::modules_tmp_path_prefix', kind: 'function', name: 'modules_tmp_path_prefix', path: 'tests/conftest.py', qualname: 'modules_tmp_path_prefix', sig_hash: 'f97af840c1f9916f', signature: 'modules_tmp_path_prefix(modules_tmp_path, monkeypatch)', source: '@pytest.fixture\ndef modules_tmp_path_prefix(modules_tmp_path, monkeypatch):\n    monkeypatch.setattr(sys, "prefix", os.fspath(modules_tmp_path))\n    return modules_tmp_path', start: 140, tick: 5, types_hash: '99ae6fa114e79828', _vid: 1237}),
  (:Symbol {body_hash: '3fddc2928fc77d3e', deleted: false, end: 392, key: 'tests/test_basic.py::test_session_secret_key_fallbacks', kind: 'function', name: 'test_session_secret_key_fallbacks', path: 'tests/test_basic.py', qualname: 'test_session_secret_key_fallbacks', sig_hash: 'df6ec3162cad163f', signature: 'test_session_secret_key_fallbacks(app, client) -> None', source: 'def test_session_secret_key_fallbacks(app, client) -> None:\n    @app.post("/")\n    def set_session() -> str:\n        flask.session["a"] = 1\n        return ""\n\n    @app.get("/")\n    def get_session() -> dict[str, t.Any]:\n        return dict(flask.session)\n\n    # Set session with initial secret key\n    client.post()\n    assert client.get().json == {"a": 1}\n    # Change secret key, session can\'t be loaded and appears empty\n    app.secret_key = "new test key"\n    assert client.get().json == {}\n    # Add initial secret key as fallback, session can be loaded\n    app.config["SECRET_KEY_FALLBACKS"] = ["test key"]\n    assert client.get().json == {"a": 1}', start: 374, tick: 5, types_hash: '28ec2edd45ba25c1', _vid: 1238}),
  (:Symbol {body_hash: 'fa1d1801eca80300', deleted: false, end: 588, key: 'tests/test_basic.py::test_session_refresh_vary', kind: 'function', name: 'test_session_refresh_vary', path: 'tests/test_basic.py', qualname: 'test_session_refresh_vary', sig_hash: 'df6ec3162cad163f', signature: 'test_session_refresh_vary(app, client)', source: 'def test_session_refresh_vary(app, client):\n    @app.get("/login")\n    def login():\n        flask.session["user_id"] = 1\n        flask.session.permanent = True\n        return ""\n\n    @app.get("/ignored")\n    def ignored():\n        return ""\n\n    rv = client.get("/login")\n    assert rv.headers["Vary"] == "Cookie"\n    rv = client.get("/ignored")\n    assert rv.headers["Vary"] == "Cookie"', start: 574, tick: 5, types_hash: '95304b3d97188d9c', _vid: 1239}),
  (:Symbol {body_hash: 'f30ebb5843e86a7b', deleted: false, end: 1526, key: 'tests/test_basic.py::test_server_name_matching', kind: 'function', name: 'test_server_name_matching', path: 'tests/test_basic.py', qualname: 'test_server_name_matching', sig_hash: '51d610cef457051e', signature: 'test_server_name_matching(subdomain_matching: bool, host_matching: bool, expect_base: str, expect_abc: str, expect_xyz: str) -> None', source: '@pytest.mark.parametrize(\n    ("subdomain_matching", "host_matching", "expect_base", "expect_abc", "expect_xyz"),\n    [\n        (False, False, "default", "default", "default"),\n        (True, False, "default", "abc", "<invalid>"),\n        (False, True, "default", "abc", "default"),\n    ],\n)\ndef test_server_name_matching(\n    subdomain_matching: bool,\n    host_matching: bool,\n    expect_base: str,\n    expect_abc: str,\n    expect_xyz: str,\n) -> None:\n    app = flask.Flask(\n        __name__,\n        subdomain_matching=subdomain_matching,\n        host_matching=host_matching,\n        static_host="example.test" if host_matching else None,\n    )\n    app.config["SERVER_NAME"] = "example.test"\n\n    @app.route("/", defaults={"name": "default"}, host="<name>")\n    @app.route("/", subdomain="<name>", host="<name>.example.test")\n    def index(name: str) -> str:\n        return name\n\n    client = app.test_client()\n\n    r = client.get(base_url="http://example.test")\n    assert r.text == expect_base\n\n    r = client.get(base_url="http://abc.example.test")\n    assert r.text == expect_abc\n\n    with pytest.warns() if subdomain_matching else nullcontext():\n        r = client.get(base_url="http://xyz.other.test")\n\n    assert r.text == expect_xyz', start: 1495, tick: 5, types_hash: 'a798f60be8dcfa2e', _vid: 1240}),
  (:Symbol {body_hash: '117c22ed5bf9bcb0', deleted: false, end: 702, key: 'tests/test_cli.py::test_run_exclude_patterns', kind: 'function', name: 'test_run_exclude_patterns', path: 'tests/test_cli.py', qualname: 'test_run_exclude_patterns', sig_hash: '4943fbd3d489f4fa', signature: 'test_run_exclude_patterns()', source: 'def test_run_exclude_patterns():\n    ctx = run_command.make_context("run", ["--exclude-patterns", __file__])\n    assert ctx.params["exclude_patterns"] == [__file__]', start: 700, tick: 5, types_hash: '71b37b9a8a57b848', _vid: 1241}),
  (:Symbol {body_hash: '42de4f4eb042fe82', deleted: false, end: 169, key: 'tests/test_helpers.py::TestUrlFor.test_url_for_with_self', kind: 'method', name: 'test_url_for_with_self', path: 'tests/test_helpers.py', qualname: 'TestUrlFor.test_url_for_with_self', sig_hash: 'b277783819d26a03', signature: 'test_url_for_with_self(self, app, req_ctx)', source: '    def test_url_for_with_self(self, app, req_ctx):\n        @app.route("/<self>")\n        def index(self):\n            return "42"\n\n        assert flask.url_for("index", self="2") == "/2"', start: 164, tick: 5, types_hash: '0dd1f85cbc066703', _vid: 1242}),
  (:Symbol {body_hash: '3192fe9231af79f7', deleted: false, end: 343, key: 'tests/test_helpers.py::test_open_resource', kind: 'function', name: 'test_open_resource', path: 'tests/test_helpers.py', qualname: 'test_open_resource', sig_hash: 'e5759eb243568d12', signature: 'test_open_resource(mode)', source: '@pytest.mark.parametrize("mode", ("r", "rb", "rt"))\ndef test_open_resource(mode):\n    app = flask.Flask(__name__)\n\n    with app.open_resource("static/index.html", mode) as f:\n        assert "<h1>Hello World!</h1>" in str(f.read())', start: 339, tick: 5, types_hash: '0a697c19c03fd363', _vid: 1243}),
  (:Symbol {body_hash: 'c81abefbe9bdac79', deleted: false, end: 351, key: 'tests/test_helpers.py::test_open_resource_exceptions', kind: 'function', name: 'test_open_resource_exceptions', path: 'tests/test_helpers.py', qualname: 'test_open_resource_exceptions', sig_hash: 'e5759eb243568d12', signature: 'test_open_resource_exceptions(mode)', source: '@pytest.mark.parametrize("mode", ("w", "x", "a", "r+"))\ndef test_open_resource_exceptions(mode):\n    app = flask.Flask(__name__)\n\n    with pytest.raises(ValueError):\n        app.open_resource("static/index.html", mode)', start: 347, tick: 5, types_hash: '0a697c19c03fd363', _vid: 1244}),
  (:Symbol {body_hash: '52cbe7dc5ebe7756', deleted: false, end: 360, key: 'tests/test_helpers.py::test_open_resource_with_encoding', kind: 'function', name: 'test_open_resource_with_encoding', path: 'tests/test_helpers.py', qualname: 'test_open_resource_with_encoding', sig_hash: 'd561642330f8579e', signature: 'test_open_resource_with_encoding(tmp_path, encoding)', source: '@pytest.mark.parametrize("encoding", ("utf-8", "utf-16-le"))\ndef test_open_resource_with_encoding(tmp_path, encoding):\n    app = flask.Flask(__name__, root_path=os.fspath(tmp_path))\n    (tmp_path / "test").write_text("test", encoding=encoding)\n\n    with app.open_resource("test", mode="rt", encoding=encoding) as f:\n        assert f.read() == "test"', start: 355, tick: 5, types_hash: 'ec4fadf06a49645c', _vid: 1245}),
  (:Symbol {body_hash: '4b30b401f912e01a', deleted: false, end: 22, key: 'tests/test_request.py::test_max_content_length', kind: 'function', name: 'test_max_content_length', path: 'tests/test_request.py', qualname: 'test_max_content_length', sig_hash: 'df6ec3162cad163f', signature: 'test_max_content_length(app: Flask, client: FlaskClient) -> None', source: 'def test_max_content_length(app: Flask, client: FlaskClient) -> None:\n    app.config["MAX_CONTENT_LENGTH"] = 50\n\n    @app.post("/")\n    def index():\n        request.form["myfile"]\n        AssertionError()\n\n    @app.errorhandler(413)\n    def catcher(error):\n        return "42"\n\n    rv = client.post("/", data={"myfile": "foo" * 50})\n    assert rv.data == b"42"', start: 9, tick: 5, types_hash: '56fc7a807e590854', _vid: 1246}),
  (:Symbol {body_hash: '9153a45877676e74', deleted: false, end: 54, key: 'tests/test_request.py::test_limit_config', kind: 'function', name: 'test_limit_config', path: 'tests/test_request.py', qualname: 'test_limit_config', sig_hash: '462ce794eb370ded', signature: 'test_limit_config(app: Flask)', source: 'def test_limit_config(app: Flask):\n    app.config["MAX_CONTENT_LENGTH"] = 100\n    app.config["MAX_FORM_MEMORY_SIZE"] = 50\n    app.config["MAX_FORM_PARTS"] = 3\n    r = Request({})\n\n    # no app context, use Werkzeug defaults\n    assert r.max_content_length is None\n    assert r.max_form_memory_size == 500_000\n    assert r.max_form_parts == 1_000\n\n    # in app context, use config\n    with app.app_context():\n        assert r.max_content_length == 100\n        assert r.max_form_memory_size == 50\n        assert r.max_form_parts == 3\n\n    # regardless of app context, use override\n    r.max_content_length = 90\n    r.max_form_memory_size = 30\n    r.max_form_parts = 4\n\n    assert r.max_content_length == 90\n    assert r.max_form_memory_size == 30\n    assert r.max_form_parts == 4\n\n    with app.app_context():\n        assert r.max_content_length == 90\n        assert r.max_form_memory_size == 30\n        assert r.max_form_parts == 4', start: 25, tick: 5, types_hash: '1d1192b93c4c7551', _vid: 1247}),
  (:Symbol {body_hash: 'fa108190b6563fdc', deleted: false, end: 70, key: 'tests/test_request.py::test_trusted_hosts_config', kind: 'function', name: 'test_trusted_hosts_config', path: 'tests/test_request.py', qualname: 'test_trusted_hosts_config', sig_hash: '462ce794eb370ded', signature: 'test_trusted_hosts_config(app: Flask) -> None', source: 'def test_trusted_hosts_config(app: Flask) -> None:\n    app.config["TRUSTED_HOSTS"] = ["example.test", ".other.test"]\n\n    @app.get("/")\n    def index() -> str:\n        return ""\n\n    client = app.test_client()\n    r = client.get(base_url="http://example.test")\n    assert r.status_code == 200\n    r = client.get(base_url="http://a.other.test")\n    assert r.status_code == 200\n    r = client.get(base_url="http://bad.test")\n    assert r.status_code == 400', start: 57, tick: 5, types_hash: 'b5147f2a60ebaff9', _vid: 1248}),
  (:Symbol {body_hash: 'b82ed5822a5622b6', deleted: false, end: 11, key: 'tests/type_check/typing_app_decorators.py::after_sync', kind: 'function', name: 'after_sync', path: 'tests/type_check/typing_app_decorators.py', qualname: 'after_sync', sig_hash: '5e57795fedec4436', signature: 'after_sync(response: Response) -> Response', source: '@app.after_request\ndef after_sync(response: Response) -> Response:\n    return Response()', start: 10, tick: 5, types_hash: '5382f1de291f7bc3', _vid: 1249}),
