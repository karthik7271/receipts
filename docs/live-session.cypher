  (:Change {at: '2026-11-17T12:48:05+00:00', commit: 'f34565c', detail: 'tinyshop/settings.py changed', id: 'C11', kind: 'file', sync: 'S1', tick: 1, _vid: 39}),
  (:Fact {author: 'agent', created: '2026-11-17T12:49:04+00:00', id: 'M1', kind: 'convention', reasons: ['Money changed', 'quoted text is gone from tinyshop/money.py'], search_text: 'money Money', status: 'superseded', superseded_by: 'M8', tags: ['money'], text: 'Money is stored as integer cents; Money.__init__ raises TypeError for non-int, and Money.from_dollars takes a string (not float) and truncates to 2 decimals. Never pass floats as amounts.', tick: 2, _vid: 40}),
  (:Fact {author: 'agent', created: '2026-11-17T12:49:05+00:00', id: 'M2', kind: 'gotcha', reasons: ['quoted text is gone from tinyshop/money.py'], search_text: 'money rounding ', status: 'superseded', superseded_by: 'M9', tags: ['money', 'rounding'], text: 'All fractional money math (discount, tax, refund) goes through Money.times, which does round(cents * factor) – Python banker\'s rounding (half to even), not half-up.', tick: 3, _vid: 41}),
  (:Fact {author: 'agent', created: '2026-11-17T12:49:06+00:00', id: 'M3', kind: 'fact', reasons: ['quoted text is gone from tinyshop/pricing.py'], search_text: 'discount apply_discount', status: 'superseded', superseded_by: 'M10', tags: ['discount'], text: 'Discounts are integer percents applied to the pre-tax subtotal and capped at MAX_DISCOUNT_PERCENT = 50; apply_discount raises ValueError outside 0..50.', tick: 4, _vid: 42}),
  (:Fact {author: 'agent', created: '2026-11-17T12:49:08+00:00', id: 'M4', kind: 'fact', reasons: ['quoted text is gone from config/settings.yaml'], search_text: 'config load_settings', status: 'superseded', superseded_by: 'M11', tags: ['config'], text: 'Settings live in config/settings.yaml, parsed by a hand-rolled flat key: value loader (no YAML lib; no nesting, \'#\' comments stripped, values with \'.\' become float, else int, else str). Current lines: tax_rate: 0.08, currency: USD, free_shipping_over: 50.', tick: 5, _vid: 43}),
  (:Fact {author: 'agent', created: '2026-11-17T12:49:11+00:00', id: 'M5', kind: 'fact', reasons: ['total changed', 'builds on M4 (superseded), M3 (superseded)'], search_text: 'totals tax total', status: 'superseded', superseded_by: 'M12', tags: ['totals', 'tax'], text: 'checkout.total = sum(items) -> apply_discount -> add tax_for(discounted, tax_rate), so tax is charged on the DISCOUNTED amount; tax_rate is read from settings on every call (load_settings, no caching). Builds on the discount cap and the settings file.', tick: 6, _vid: 44}),
  (:Fact {author: 'agent', created: '2026-11-17T12:49:12+00:00', id: 'M6', kind: 'fact', reasons: ['refund_amount depends on Money.times, whose signature changed', 'builds on M2 (superseded)'], search_text: 'refunds refund_amount', status: 'superseded', superseded_by: 'M13', tags: ['refunds'], text: 'refund_amount(paid, returned_fraction) prorates paid.times(fraction) (so rounds per Money.times), requires 0 < fraction <= 1 else ValueError. It refunds a fraction of what was PAID (tax included); there is no separate tax/shipping refund logic.', tick: 7, _vid: 45}),
  (:Fact {author: 'agent', created: '2026-11-17T12:49:14+00:00', id: 'M7', kind: 'gotcha', reasons: [], search_text: 'config dead-config total', status: 'fresh', tags: ['config', 'dead-config'], text: 'Gotcha: settings keys `currency` and `free_shipping_over` are NOT read by any code; currency is hardcoded as CURRENCY = "USD" in money.py and checkout.total has no shipping logic. Changing those yaml lines has no effect.', tick: 8, _vid: 46}),
  (:Sync {at: '2026-11-17T14:15:39+00:00', commit: '1a08bc5', files_changed: 7, id: 'S2', tick: 9, _vid: 47}),
