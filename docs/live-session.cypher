  (:Symbol {body_hash: '6e1966a9f849bf96', deleted: false, end: 6, key: 'tinyshop/money.py::CENT', kind: 'constant', name: 'CENT', path: 'tinyshop/money.py', qualname: 'CENT', sig_hash: '6e1966a9f849bf96', signature: 'CENT = Decimal("0.01")', source: 'CENT = Decimal("0.01")', start: 6, tick: 9, types_hash: '', _vid: 49}),
  (:Symbol {body_hash: 'a1209c690dac8a9d', deleted: false, end: 5, key: 'tinyshop/promotions.py::MAX_DISCOUNT_PERCENT', kind: 'constant', name: 'MAX_DISCOUNT_PERCENT', path: 'tinyshop/promotions.py', qualname: 'MAX_DISCOUNT_PERCENT', sig_hash: 'a1209c690dac8a9d', signature: 'MAX_DISCOUNT_PERCENT = 50', source: 'MAX_DISCOUNT_PERCENT = 50', start: 5, tick: 9, types_hash: '', _vid: 50}),
  (:Symbol {body_hash: 'eeb8f942a37308ec', deleted: false, end: 12, key: 'tinyshop/promotions.py::discount_for', kind: 'function', name: 'discount_for', path: 'tinyshop/promotions.py', qualname: 'discount_for', sig_hash: 'f0f499a3c39cb029', signature: 'discount_for(subtotal: Money, percent: int) -> Money', source: 'def discount_for(subtotal: Money, percent: int) -> Money:\n    """Discounts apply to the pre-tax subtotal and are capped."""\n    if not 0 <= percent <= MAX_DISCOUNT_PERCENT:\n        raise ValueError(f"discounts are capped at {MAX_DISCOUNT_PERCENT}%")\n    return subtotal.times(1 - percent / 100)', start: 8, tick: 9, types_hash: '03f7aac16b3c8ab1', _vid: 51}),
