  (:Change {at: '2026-11-17T14:15:39+00:00', commit: '1a08bc5', detail: 'tests/test_checkout.py changed', id: 'C25', kind: 'file', sync: 'S2', tick: 9, _vid: 65}),
  (:Change {at: '2026-11-17T14:15:39+00:00', commit: '1a08bc5', detail: 'tinyshop/checkout.py changed', id: 'C26', kind: 'file', sync: 'S2', tick: 9, _vid: 66}),
  (:Change {at: '2026-11-17T14:15:39+00:00', commit: '1a08bc5', detail: 'tinyshop/money.py changed', id: 'C27', kind: 'file', sync: 'S2', tick: 9, _vid: 67}),
  (:Change {at: '2026-11-17T14:15:39+00:00', commit: '1a08bc5', detail: 'tinyshop/pricing.py changed', id: 'C28', kind: 'file', sync: 'S2', tick: 9, _vid: 68}),
  (:Change {at: '2026-11-17T14:15:39+00:00', commit: '1a08bc5', detail: 'tinyshop/promotions.py changed', id: 'C29', kind: 'file', sync: 'S2', tick: 9, _vid: 69}),
  (:Change {at: '2026-11-17T14:15:39+00:00', commit: '1a08bc5', detail: 'tinyshop/refunds.py changed', id: 'C30', kind: 'file', sync: 'S2', tick: 9, _vid: 70}),
  (:Fact {author: 'agent', created: '2026-11-17T14:16:16+00:00', id: 'M8', kind: 'convention', reasons: [], search_text: 'money ', status: 'fresh', tags: ['money'], text: 'Money stores a Decimal dollar amount quantized to the cent with ROUND_HALF_UP (Money.__init__ accepts Decimal or str). Money.from_dollars takes a str. Not integer cents anymore.', tick: 10, _vid: 71}),
  (:Verification {action: 'superseded', at: '2026-11-17T14:16:16+00:00', by: 'agent', note: 'replaced by M8', _vid: 72}),
  (:Fact {author: 'agent', created: '2026-11-17T14:16:18+00:00', id: 'M9', kind: 'gotcha', reasons: [], search_text: 'money rounding ', status: 'fresh', tags: ['money', 'rounding'], text: 'All fractional money math (discount, tax, refund) goes through Money.times, which multiplies the Decimal amount by Decimal(factor) and re-quantizes to the cent with ROUND_HALF_UP (half-up, not banker\'s rounding). Float factors are converted via Decimal(float), so they carry binary-float noise before rounding.', tick: 11, _vid: 73}),
  (:Verification {action: 'superseded', at: '2026-11-17T14:16:18+00:00', by: 'agent', note: 'replaced by M9', _vid: 74}),
  (:Fact {author: 'agent', created: '2026-11-17T14:16:19+00:00', id: 'M10', kind: 'fact', reasons: [], search_text: 'discount ', status: 'fresh', tags: ['discount'], text: 'Discounts live in tinyshop/promotions.py (not pricing.py). discount_for(subtotal, percent) takes an integer percent applied to the pre-tax subtotal, capped at MAX_DISCOUNT_PERCENT = 50, and raises ValueError outside 0..50. It returns the discounted amount (subtotal.times(1 - percent/100)), not the discount itself.', tick: 12, _vid: 75}),
  (:Verification {action: 'superseded', at: '2026-11-17T14:16:19+00:00', by: 'agent', note: 'replaced by M10', _vid: 76}),
  (:Fact {author: 'agent', created: '2026-11-17T14:16:20+00:00', id: 'M11', kind: 'fact', reasons: [], search_text: 'config ', status: 'fresh', tags: ['config'], text: 'Settings live in config/settings.yaml, parsed by a hand-rolled flat key: value loader in tinyshop/settings.py (no YAML lib; \'#\' comments stripped; values with \'.\' become float, else int, else str). Current lines: tax_rate: 0.0825, currency: USD, free_shipping_over: 50.', tick: 13, _vid: 77}),
  (:Verification {action: 'superseded', at: '2026-11-17T14:16:20+00:00', by: 'agent', note: 'replaced by M11', _vid: 78}),
  (:Fact {author: 'agent', created: '2026-11-17T14:16:22+00:00', id: 'M12', kind: 'fact', reasons: [], search_text: 'totals tax ', status: 'fresh', tags: ['totals', 'tax'], text: 'checkout.total(items, discount_percent) = sum(items) -> promotions.discount_for -> add pricing.tax_for(discounted, tax_rate). Tax is charged on the DISCOUNTED amount; tax_rate is read from settings on every call (load_settings, no caching).', tick: 14, _vid: 79}),
  (:Verification {action: 'superseded', at: '2026-11-17T14:16:22+00:00', by: 'agent', note: 'replaced by M12', _vid: 80}),
  (:Fact {author: 'agent', created: '2026-11-17T14:16:23+00:00', id: 'M13', kind: 'fact', reasons: [], search_text: 'refunds ', status: 'fresh', tags: ['refunds'], text: 'refund_amount(paid, returned_fraction) returns paid.times(fraction), so it rounds half-up per Money.times. It requires 0 < fraction <= 1, else ValueError. It refunds a fraction of what was PAID (discount and tax already baked in); there is no separate tax or shipping refund logic.', tick: 15, _vid: 81}),
  (:Verification {action: 'superseded', at: '2026-11-17T14:16:23+00:00', by: 'agent', note: 'replaced by M13', _vid: 82}),
  (:Verification {action: 'reaffirmed', at: '2026-11-17T14:16:23+00:00', by: 'agent', note: 'Re-read checkout.py, money.py, settings.py: currency and free_shipping_over are still unread by code; CURRENCY is hardcoded and total has no shipping logic.', _vid: 83}),
  (:Sync {at: '2026-11-24T07:17:31+00:00', commit: '74fe93b', files_changed: 2, id: 'S3', tick: 17, _vid: 84}),
  (:Change {at: '2026-11-24T07:17:31+00:00', commit: '74fe93b', detail: '.claude/settings.json was deleted', id: 'C31', kind: 'file', sync: 'S3', tick: 17, _vid: 85}),
  (:Change {at: '2026-11-24T07:17:31+00:00', commit: '74fe93b', detail: '.mcp.json was deleted', id: 'C32', kind: 'file', sync: 'S3', tick: 17, _vid: 86});
UNWIND [{s: 12, d: 18, p: {}}, {s: 12, d: 14, p: {}}, {s: 13, d: 18, p: {}}, {s: 13, d: 16, p: {}}, {s: 13, d: 26, p: {}}, {s: 14, d: 25, p: {}}, {s: 14, d: 28, p: {}}, {s: 14, d: 16, p: {}}, {s: 14, d: 51, p: {}}, {s: 19, d: 16, p: {}}, {s: 21, d: 16, p: {}}, {s: 25, d: 21, p: {}}, {s: 26, d: 21, p: {}}, {s: 51, d: 21, p: {}}] AS r MATCH (a {_vid: r.s}), (b {_vid: r.d}) CREATE (a)-[x:CALLS]->(b) SET x = r.p;
UNWIND [{s: 40, d: 8, p: {at: '2026-11-17T12:49:04+00:00', hash: '5997443d286c8b31', line: 11, mode: 'quote', ok: false, quote: 'raise TypeError("Money is stored as integer cents")', sig_hash: '', snapshot: '    def __init__(self, cents: int):\n        if not isinstance(cents, int):\n            raise TypeError("Money is stored as integer cents")\n        self.cents = cents\n', tick: 2}}, {s: 40, d: 16, p: {at: '2026-11-17T12:49:04+00:00', hash: '6ba7932036c1623a', line: 6, mode: 'symbol', ok: true, quote: '', sig_hash: '42ba610a86d15094', snapshot: 'class Money:\n    """An amount of money, stored as integer cents."""\n\n    def __init__(self, cents: int):\n        if not isinstance(cents, int):\n            raise TypeError("Money is stored as integer cents")\n        self.cents = cents\n\n    @classmethod\n    def from_dollars(cls, dollars: str) -> "Money":\n        whole, _, frac = dollars.partition(".")\n        return cls(int(whole) * 100 + int((frac + "00")[:2]))\n\n    def __add__(self, other: "Money") -> "Money":\n        return Money(self.cents + other.cents)\n\n    def __eq__(self, other: object) -> bool:\n        return isinstance(other, Money) and other.cents == self.cents\n\n    def times(self, factor: float) -> "Money":\n        return Money(round(self.cents * factor))\n\n    def __str__(self) -> str:\n        return f"${self.cents // 100}.{self.cents % 100:02d}"', tick: 2}}, {s: 41, d: 8, p: {at: '2026-11-17T12:49:05+00:00', hash: '0fe9e03b4048963c', line: 26, mode: 'quote', ok: false, quote: 'return Money(round(self.cents * factor))', sig_hash: '', snapshot: '\n    def times(self, factor: float) -> "Money":\n        return Money(round(self.cents * factor))\n\n    def __str__(self) -> str:', tick: 3}}, {s: 42, d: 51, p: {at: '2026-11-17T12:49:06+00:00', followed: ['tinyshop/pricing.py::apply_discount'], hash: 'eeb8f942a37308ec', line: 8, mode: 'symbol', ok: true, quote: '', sig_hash: 'f0f499a3c39cb029', snapshot: 'def apply_discount(subtotal: Money, percent: int) -> Money:\n    """Discounts apply to the pre-tax subtotal and are capped."""\n    if not 0 <= percent <= MAX_DISCOUNT_PERCENT:\n        raise ValueError(f"discounts are capped at {MAX_DISCOUNT_PERCENT}%")\n    return subtotal.times(1 - percent / 100)', tick: 4}}, {s: 42, d: 9, p: {at: '2026-11-17T12:49:06+00:00', hash: '35b5596260952755', line: 5, mode: 'quote', ok: false, quote: 'MAX_DISCOUNT_PERCENT = 50', sig_hash: '', snapshot: 'from .money import Money\n\nMAX_DISCOUNT_PERCENT = 50\n\n', tick: 4}}, {s: 43, d: 28, p: {at: '2026-11-17T12:49:08+00:00', hash: '8207536500a98638', line: 8, mode: 'symbol', ok: true, quote: '', sig_hash: '4943fbd3d489f4fa', snapshot: 'def load_settings() -> dict:\n    out = {}\n    for line in SETTINGS_FILE.read_text().splitlines():\n        line = line.split("#", 1)[0].strip()\n        if ":" in line:\n            key, value = (p.strip() for p in line.split(":", 1))\n            try:\n                out[key] = float(value) if "." in value else int(value)\n            except ValueError:\n                out[key] = value\n    return out', tick: 5}}, {s: 43, d: 4, p: {at: '2026-11-17T12:49:08+00:00', hash: '5d5218550af6aecd', line: 4, mode: 'quote', ok: true, quote: 'free_shipping_over: 50', sig_hash: '', snapshot: 'tax_rate: 0.08\ncurrency: USD\nfree_shipping_over: 50', tick: 5}}, {s: 43, d: 4, p: {at: '2026-11-17T12:49:08+00:00', hash: 'fdfeeb0bceedecdf', line: 2, mode: 'quote', ok: false, quote: 'tax_rate: 0.08', sig_hash: '', snapshot: '# tinyshop settings\ntax_rate: 0.08\ncurrency: USD\nfree_shipping_over: 50', tick: 5}}, {s: 44, d: 7, p: {at: '2026-11-17T12:49:11+00:00', hash: 'a3a3c37947a83d1a', line: 14, mode: 'quote', ok: true, quote: 'return discounted + tax_for(discounted, rate)', sig_hash: '', snapshot: '    discounted = apply_discount(subtotal, discount_percent)\n    rate = load_settings()["tax_rate"]\n    return discounted + tax_for(discounted, rate)', tick: 6}}, {s: 44, d: 14, p: {at: '2026-11-17T12:49:11+00:00', hash: '905d20b97d21cda7', line: 8, mode: 'symbol', ok: true, quote: '', sig_hash: '21cf4d659112d9e3', snapshot: 'def total(items: list[Money], discount_percent: int = 0) -> Money:\n    """Discounted subtotal plus tax on the discounted amount."""\n    subtotal = sum(items, Money(0))\n    discounted = apply_discount(subtotal, discount_percent)\n    rate = load_settings()["tax_rate"]\n    return discounted + tax_for(discounted, rate)', tick: 6}}, {s: 45, d: 10, p: {at: '2026-11-17T12:49:12+00:00', hash: 'eff118909c9e1c9d', line: 9, mode: 'quote', ok: true, quote: 'if not 0 < returned_fraction <= 1:', sig_hash: '', snapshot: 'def refund_amount(paid: Money, returned_fraction: float) -> Money:\n    """Partial refunds are prorated and rounded to the nearest cent."""\n    if not 0 < returned_fraction <= 1:\n        raise ValueError("returned_fraction must be in (0, 1]")\n    return paid.times(returned_fraction)', tick: 7}}, {s: 45, d: 26, p: {at: '2026-11-17T12:49:12+00:00', hash: '353ed8023d22c5ee', line: 6, mode: 'symbol', ok: true, quote: '', sig_hash: '8bcd45e0c4f74529', snapshot: 'def refund_amount(paid: Money, returned_fraction: float) -> Money:\n    """Partial refunds are prorated and rounded to the nearest cent."""\n    if not 0 < returned_fraction <= 1:\n        raise ValueError("returned_fraction must be in (0, 1]")\n    return paid.times(returned_fraction)', tick: 7}}, {s: 46, d: 14, p: {at: '2026-11-17T12:49:14+00:00', hash: 'eadd5fe3e381aa5a', line: 8, mode: 'symbol', ok: true, quote: '', sig_hash: '21cf4d659112d9e3', snapshot: 'def total(items: list[Money], discount_percent: int = 0) -> Money:\n    """Discounted subtotal plus tax on the discounted amount."""\n    subtotal = sum(items, Money(0))\n    discounted = discount_for(subtotal, discount_percent)\n    rate = load_settings()["tax_rate"]\n    return discounted + tax_for(discounted, rate)', tick: 16}}, {s: 46, d: 4, p: {at: '2026-11-17T12:49:14+00:00', hash: '5d5218550af6aecd', line: 4, mode: 'quote', ok: true, quote: 'free_shipping_over: 50', sig_hash: '', snapshot: 'tax_rate: 0.08\ncurrency: USD\nfree_shipping_over: 50', tick: 16}}, {s: 46, d: 8, p: {at: '2026-11-17T12:49:14+00:00', hash: '6416c5bfef5f426c', line: 5, mode: 'quote', ok: true, quote: 'CURRENCY = "USD"', sig_hash: '', snapshot: '"""Money helpers for tinyshop."""\n\nCURRENCY = "USD"\n\n', tick: 16}}, {s: 71, d: 8, p: {at: '2026-11-17T14:16:16+00:00', hash: '0af2dd4ff50b272e', line: 13, mode: 'quote', ok: true, quote: 'self.amount = Decimal(amount).quantize(CENT, rounding=ROUND_HALF_UP)', sig_hash: '', snapshot: '\n    def __init__(self, amount: Decimal | str):\n        self.amount = Decimal(amount).quantize(CENT, rounding=ROUND_HALF_UP)\n\n    @classmethod', tick: 10}}, {s: 73, d: 8, p: {at: '2026-11-17T14:16:18+00:00', hash: '90a4527d70a48ca6', line: 26, mode: 'quote', ok: true, quote: 'return Money(self.amount * Decimal(factor))', sig_hash: '', snapshot: '\n    def times(self, factor: Decimal | str) -> "Money":\n        return Money(self.amount * Decimal(factor))\n\n    def __str__(self) -> str:', tick: 11}}, {s: 75, d: 48, p: {at: '2026-11-17T14:16:19+00:00', hash: '7bc5637ade229307', line: 12, mode: 'quote', ok: true, quote: 'return subtotal.times(1 - percent / 100)', sig_hash: '', snapshot: '    if not 0 <= percent <= MAX_DISCOUNT_PERCENT:\n        raise ValueError(f"discounts are capped at {MAX_DISCOUNT_PERCENT}%")\n    return subtotal.times(1 - percent / 100)', tick: 12}}, {s: 75, d: 48, p: {at: '2026-11-17T14:16:19+00:00', hash: '35b5596260952755', line: 5, mode: 'quote', ok: true, quote: 'MAX_DISCOUNT_PERCENT = 50', sig_hash: '', snapshot: 'from .money import Money\n\nMAX_DISCOUNT_PERCENT = 50\n\n', tick: 12}}, {s: 77, d: 11, p: {at: '2026-11-17T14:16:20+00:00', hash: '613d830ea8c619b4', line: 15, mode: 'quote', ok: true, quote: 'out[key] = float(value) if "." in value else int(value)', sig_hash: '', snapshot: '            key, value = (p.strip() for p in line.split(":", 1))\n            try:\n                out[key] = float(value) if "." in value else int(value)\n            except ValueError:\n                out[key] = value', tick: 13}}, {s: 77, d: 4, p: {at: '2026-11-17T14:16:20+00:00', hash: '44151a2dc80a8cea', line: 2, mode: 'quote', ok: true, quote: 'tax_rate: 0.0825', sig_hash: '', snapshot: '# tinyshop settings\ntax_rate: 0.0825\ncurrency: USD\nfree_shipping_over: 50', tick: 13}}, {s: 79, d: 7, p: {at: '2026-11-17T14:16:22+00:00', hash: 'a3a3c37947a83d1a', line: 14, mode: 'quote', ok: true, quote: 'return discounted + tax_for(discounted, rate)', sig_hash: '', snapshot: '    discounted = discount_for(subtotal, discount_percent)\n    rate = load_settings()["tax_rate"]\n    return discounted + tax_for(discounted, rate)', tick: 14}}, {s: 81, d: 10, p: {at: '2026-11-17T14:16:23+00:00', hash: 'cd081db1b568b39e', line: 13, mode: 'quote', ok: true, quote: 'return paid.times(returned_fraction)', sig_hash: '', snapshot: '            "returned_fraction must be in (0, 1]"\n        )\n    return paid.times(returned_fraction)', tick: 15}}] AS r MATCH (a {_vid: r.s}), (b {_vid: r.d}) CREATE (a)-[x:CITES]->(b) SET x = r.p;
