  (:Symbol {body_hash: '4fe454ada072e788', deleted: false, end: 10, key: 'tests/test_checkout.py::test_discount_applied_before_tax', kind: 'function', name: 'test_discount_applied_before_tax', path: 'tests/test_checkout.py', qualname: 'test_discount_applied_before_tax', sig_hash: '4943fbd3d489f4fa', signature: 'test_discount_applied_before_tax()', source: 'def test_discount_applied_before_tax():\n    # $100 with 10% off -> $90.00 + 8.25% tax ($7.43) = $97.43\n    assert total([Money.from_dollars("100.00")], discount_percent=10) == Money.from_dollars("97.43")', start: 8, tick: 10, _vid: 10}),
  (:Symbol {body_hash: '5cba6eee5a3b99bf', deleted: false, end: 14, key: 'tests/test_checkout.py::test_partial_refund_rounds_to_cent', kind: 'function', name: 'test_partial_refund_rounds_to_cent', path: 'tests/test_checkout.py', qualname: 'test_partial_refund_rounds_to_cent', sig_hash: '4943fbd3d489f4fa', signature: 'test_partial_refund_rounds_to_cent()', source: 'def test_partial_refund_rounds_to_cent():\n    assert refund_amount(Money.from_dollars("10.00"), Decimal("0.3333")) == Money("3.33")', start: 13, tick: 10, _vid: 11}),
  (:Symbol {body_hash: '7feee022ef5290ec', deleted: false, end: 14, key: 'tinyshop/checkout.py::total', kind: 'function', name: 'total', path: 'tinyshop/checkout.py', qualname: 'total', sig_hash: '99db861d6b6bf7b1', signature: 'total(items: list[Money], discount_percent: int=0) -> Money', source: 'def total(items: list[Money], discount_percent: int = 0) -> Money:\n    """Discounted subtotal plus tax on the discounted amount."""\n    subtotal = sum(items, Money(0))\n    discounted = discount_for(subtotal, discount_percent)\n    rate = load_settings()["tax_rate"]\n    return discounted + tax_for(discounted, rate)', start: 9, tick: 10, _vid: 12}),
  (:Symbol {body_hash: '0bca2cbb44eeb080', deleted: false, end: 5, key: 'tinyshop/money.py::CURRENCY', kind: 'constant', name: 'CURRENCY', path: 'tinyshop/money.py', qualname: 'CURRENCY', sig_hash: '0bca2cbb44eeb080', signature: 'CURRENCY = "USD"', source: 'CURRENCY = "USD"', start: 5, tick: 10, _vid: 13}),
  (:Symbol {body_hash: '2e41f863ea984ca7', deleted: false, end: 29, key: 'tinyshop/money.py::Money', kind: 'class', name: 'Money', path: 'tinyshop/money.py', qualname: 'Money', sig_hash: '42ba610a86d15094', signature: 'class Money', source: 'class Money:\n    """An amount of money in dollars, as a Decimal quantized to the cent."""\n\n    def __init__(self, amount: Decimal | str):\n        self.amount = Decimal(amount).quantize(CENT, rounding=ROUND_HALF_UP)\n\n    @classmethod\n    def from_dollars(cls, dollars: str) -> "Money":\n        return cls(Decimal(dollars))\n\n    def __add__(self, other: "Money") -> "Money":\n        return Money(self.amount + other.amount)\n\n    def __eq__(self, other: object) -> bool:\n        return isinstance(other, Money) and other.amount == self.amount\n\n    def times(self, factor: Decimal | str) -> "Money":\n        return Money(self.amount * Decimal(factor))\n\n    def __str__(self) -> str:\n        return f"${self.amount:,.2f}"', start: 9, tick: 10, _vid: 14}),
  (:Symbol {body_hash: '7854eec3b6d7434b', deleted: false, end: 13, key: 'tinyshop/money.py::Money.__init__', kind: 'method', name: '__init__', path: 'tinyshop/money.py', qualname: 'Money.__init__', sig_hash: 'cc65e4699c884454', signature: '__init__(self, amount: Decimal | str)', source: '    def __init__(self, amount: Decimal | str):\n        self.amount = Decimal(amount).quantize(CENT, rounding=ROUND_HALF_UP)', start: 12, tick: 10, _vid: 15}),
  (:Symbol {body_hash: 'd503a60ab141e377', deleted: false, end: 17, key: 'tinyshop/money.py::Money.from_dollars', kind: 'method', name: 'from_dollars', path: 'tinyshop/money.py', qualname: 'Money.from_dollars', sig_hash: 'a1e01af514c5ad52', signature: 'from_dollars(cls, dollars: str) -> \'Money\'', source: '    @classmethod\n    def from_dollars(cls, dollars: str) -> "Money":\n        return cls(Decimal(dollars))', start: 16, tick: 10, _vid: 16}),
  (:Symbol {body_hash: '4a9b7de16fd2705b', deleted: false, end: 20, key: 'tinyshop/money.py::Money.__add__', kind: 'method', name: '__add__', path: 'tinyshop/money.py', qualname: 'Money.__add__', sig_hash: '69a058ba05935117', signature: '__add__(self, other: \'Money\') -> \'Money\'', source: '    def __add__(self, other: "Money") -> "Money":\n        return Money(self.amount + other.amount)', start: 19, tick: 10, _vid: 17}),
  (:Symbol {body_hash: 'de7462db0b33fef2', deleted: false, end: 23, key: 'tinyshop/money.py::Money.__eq__', kind: 'method', name: '__eq__', path: 'tinyshop/money.py', qualname: 'Money.__eq__', sig_hash: 'ddc5778c1006af8c', signature: '__eq__(self, other: object) -> bool', source: '    def __eq__(self, other: object) -> bool:\n        return isinstance(other, Money) and other.amount == self.amount', start: 22, tick: 10, _vid: 18}),
  (:Symbol {body_hash: '7660de788f5bfe32', deleted: false, end: 26, key: 'tinyshop/money.py::Money.times', kind: 'method', name: 'times', path: 'tinyshop/money.py', qualname: 'Money.times', sig_hash: '6fb661ddf16ea716', signature: 'times(self, factor: Decimal | str) -> \'Money\'', source: '    def times(self, factor: Decimal | str) -> "Money":\n        return Money(self.amount * Decimal(factor))', start: 25, tick: 10, _vid: 19}),
  (:Symbol {body_hash: '744376dda07125cf', deleted: false, end: 29, key: 'tinyshop/money.py::Money.__str__', kind: 'method', name: '__str__', path: 'tinyshop/money.py', qualname: 'Money.__str__', sig_hash: 'e7481622e680e4f4', signature: '__str__(self) -> str', source: '    def __str__(self) -> str:\n        return f"${self.amount:,.2f}"', start: 28, tick: 10, _vid: 20}),
  (:Symbol {body_hash: 'a1209c690dac8a9d', deleted: true, deleted_tick: 10, end: 5, key: 'tinyshop/pricing.py::MAX_DISCOUNT_PERCENT', kind: 'constant', name: 'MAX_DISCOUNT_PERCENT', path: 'tinyshop/pricing.py', qualname: 'MAX_DISCOUNT_PERCENT', sig_hash: 'a1209c690dac8a9d', signature: 'MAX_DISCOUNT_PERCENT = 50', source: 'MAX_DISCOUNT_PERCENT = 50', start: 5, tick: 1, _vid: 21}),
  (:Symbol {body_hash: '9f7997c787de30b5', deleted: true, deleted_tick: 10, end: 12, key: 'tinyshop/pricing.py::apply_discount', kind: 'function', name: 'apply_discount', path: 'tinyshop/pricing.py', qualname: 'apply_discount', sig_hash: '7c580e5945876de4', signature: 'apply_discount(subtotal: Money, percent: int) -> Money', source: 'def apply_discount(subtotal: Money, percent: int) -> Money:\n    """Discounts apply to the pre-tax subtotal and are capped."""\n    if not 0 <= percent <= MAX_DISCOUNT_PERCENT:\n        raise ValueError(f"discounts are capped at {MAX_DISCOUNT_PERCENT}%")\n    return subtotal.times(1 - percent / 100)', start: 8, tick: 1, _vid: 22}),
  (:Symbol {body_hash: '23863577aa76ade4', deleted: false, end: 7, key: 'tinyshop/pricing.py::tax_for', kind: 'function', name: 'tax_for', path: 'tinyshop/pricing.py', qualname: 'tax_for', sig_hash: 'fc10a827782c74c4', signature: 'tax_for(amount: Money, rate: float) -> Money', source: 'def tax_for(amount: Money, rate: float) -> Money:\n    return amount.times(rate)', start: 6, tick: 10, _vid: 23}),
  (:Symbol {body_hash: '82f48d625926f4e8', deleted: false, end: 13, key: 'tinyshop/refunds.py::refund_amount', kind: 'function', name: 'refund_amount', path: 'tinyshop/refunds.py', qualname: 'refund_amount', sig_hash: '8bc9313d0f340727', signature: 'refund_amount(paid: Money, returned_fraction: float) -> Money', source: 'def refund_amount(paid: Money, returned_fraction: float) -> Money:\n    """Partial refunds are prorated and rounded to the nearest cent."""\n    # Guard against nonsense fractions (zero, negative, or more than everything).\n    if not 0 < returned_fraction <= 1:\n        raise ValueError(\n            "returned_fraction must be in (0, 1]"\n        )\n    return paid.times(returned_fraction)', start: 6, tick: 10, _vid: 24}),
  (:Symbol {body_hash: 'be2bbf88f27cba49', deleted: false, end: 5, key: 'tinyshop/settings.py::SETTINGS_FILE', kind: 'constant', name: 'SETTINGS_FILE', path: 'tinyshop/settings.py', qualname: 'SETTINGS_FILE', sig_hash: 'be2bbf88f27cba49', signature: 'SETTINGS_FILE = Path(__file__).resolve().parent.parent / "config" / "settings.yaml"', source: 'SETTINGS_FILE = Path(__file__).resolve().parent.parent / "config" / "settings.yaml"', start: 5, tick: 1, _vid: 25}),
  (:Symbol {body_hash: '0c82ab1123540889', deleted: false, end: 18, key: 'tinyshop/settings.py::load_settings', kind: 'function', name: 'load_settings', path: 'tinyshop/settings.py', qualname: 'load_settings', sig_hash: '76a369d85fbda822', signature: 'load_settings() -> dict', source: 'def load_settings() -> dict:\n    out = {}\n    for line in SETTINGS_FILE.read_text().splitlines():\n        line = line.split("#", 1)[0].strip()\n        if ":" in line:\n            key, value = (p.strip() for p in line.split(":", 1))\n            try:\n                out[key] = float(value) if "." in value else int(value)\n            except ValueError:\n                out[key] = value\n    return out', start: 8, tick: 1, _vid: 26}),
