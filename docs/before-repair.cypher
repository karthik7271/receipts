UNWIND [{s: 36, d: 14, p: {at: '2026-11-17T17:22:57+00:00', hash: 'c766a957738f9916', line: 6, mode: 'symbol', ok: true, quote: '', sig_hash: '42ba610a86d15094', snapshot: 'class Money:\n    """An amount of money, stored as integer cents."""\n\n    def __init__(self, cents: int):\n        if not isinstance(cents, int):\n            raise TypeError("Money is stored as integer cents")\n        self.cents = cents\n\n    @classmethod\n    def from_dollars(cls, dollars: str) -> "Money":\n        whole, _, frac = dollars.partition(".")\n        return cls(int(whole) * 100 + int((frac + "00")[:2]))\n\n    def __add__(self, other: "Money") -> "Money":\n        return Money(self.cents + other.cents)\n\n    def __eq__(self, other: object) -> bool:\n        return isinstance(other, Money) and other.cents == self.cents\n\n    def times(self, factor: float) -> "Money":\n        return Money(round(self.cents * factor))\n\n    def __str__(self) -> str:\n        return f"${self.cents // 100}.{self.cents % 100:02d}"', tick: 2}}, {s: 37, d: 49, p: {at: '2026-11-17T17:22:57+00:00', followed: ['tinyshop/pricing.py::apply_discount'], hash: '9f7997c787de30b5', line: 8, mode: 'symbol', ok: true, quote: '', sig_hash: '7c580e5945876de4', snapshot: 'def apply_discount(subtotal: Money, percent: int) -> Money:\n    """Discounts apply to the pre-tax subtotal and are capped."""\n    if not 0 <= percent <= MAX_DISCOUNT_PERCENT:\n        raise ValueError(f"discounts are capped at {MAX_DISCOUNT_PERCENT}%")\n    return subtotal.times(1 - percent / 100)', tick: 3}}, {s: 38, d: 2, p: {at: '2026-11-17T17:22:57+00:00', hash: 'fdfeeb0bceedecdf', line: 2, mode: 'quote', ok: false, quote: 'tax_rate: 0.08', sig_hash: '', snapshot: '# tinyshop settings\ntax_rate: 0.08\ncurrency: USD\nfree_shipping_over: 50', tick: 4}}, {s: 39, d: 24, p: {at: '2026-11-17T17:22:57+00:00', hash: '82f48d625926f4e8', line: 6, mode: 'symbol', ok: true, quote: '', sig_hash: '8bc9313d0f340727', snapshot: 'def refund_amount(paid: Money, returned_fraction: float) -> Money:\n    """Partial refunds are prorated and rounded to the nearest cent."""\n    if not 0 < returned_fraction <= 1:\n        raise ValueError("returned_fraction must be in (0, 1]")\n    return paid.times(returned_fraction)', tick: 5}}, {s: 40, d: 12, p: {at: '2026-11-17T17:22:57+00:00', hash: '58e50d0890dbbf5b', line: 8, mode: 'symbol', ok: true, quote: '', sig_hash: '99db861d6b6bf7b1', snapshot: 'def total(items: list[Money], discount_percent: int = 0) -> Money:\n    """Discounted subtotal plus tax on the discounted amount."""\n    subtotal = sum(items, Money(0))\n    discounted = apply_discount(subtotal, discount_percent)\n    rate = load_settings()["tax_rate"]\n    return discounted + tax_for(discounted, rate)', tick: 6}}, {s: 41, d: 20, p: {at: '2026-11-17T17:22:57+00:00', hash: 'df0df7abc0f3326b', line: 28, mode: 'symbol', ok: true, quote: '', sig_hash: 'e7481622e680e4f4', snapshot: '    def __str__(self) -> str:\n        return f"${self.cents // 100}.{self.cents % 100:02d}"', tick: 7}}, {s: 42, d: 43, p: {at: '2026-11-17T17:22:57+00:00', hash: '', mode: 'external', ok: true, quote: '', sig_hash: '', snapshot: '', tick: 8}}, {s: 42, d: 13, p: {at: '2026-11-17T17:22:57+00:00', hash: '0bca2cbb44eeb080', line: 3, mode: 'symbol', ok: true, quote: '', sig_hash: '0bca2cbb44eeb080', snapshot: 'CURRENCY = "USD"', tick: 8}}, {s: 44, d: 2, p: {at: '2026-11-17T17:22:57+00:00', hash: '5d5218550af6aecd', line: 4, mode: 'quote', ok: true, quote: 'free_shipping_over: 50', sig_hash: '', snapshot: 'tax_rate: 0.08\ncurrency: USD\nfree_shipping_over: 50', tick: 9}}] AS r MATCH (a {_vid: r.s}), (b {_vid: r.d}) CREATE (a)-[x:CITES]->(b) SET x = r.p;
