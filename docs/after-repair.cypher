  (:Symbol {body_hash: '4fe454ada072e788', deleted: false, end: 10, key: 'tests/test_checkout.py::test_discount_applied_before_tax', kind: 'function', name: 'test_discount_applied_before_tax', path: 'tests/test_checkout.py', qualname: 'test_discount_applied_before_tax', sig_hash: '4943fbd3d489f4fa', signature: 'test_discount_applied_before_tax()', source: 'def test_discount_applied_before_tax():\n    # $100 with 10% off -> $90.00 + 8.25% tax ($7.43) = $97.43\n    assert total([Money.from_dollars("100.00")], discount_percent=10) == Money.from_dollars("97.43")', start: 8, tick: 10, types_hash: '71b37b9a8a57b848', _vid: 10}),
  (:Symbol {body_hash: '5cba6eee5a3b99bf', deleted: false, end: 14, key: 'tests/test_checkout.py::test_partial_refund_rounds_to_cent', kind: 'function', name: 'test_partial_refund_rounds_to_cent', path: 'tests/test_checkout.py', qualname: 'test_partial_refund_rounds_to_cent', sig_hash: '4943fbd3d489f4fa', signature: 'test_partial_refund_rounds_to_cent()', source: 'def test_partial_refund_rounds_to_cent():\n    assert refund_amount(Money.from_dollars("10.00"), Decimal("0.3333")) == Money("3.33")', start: 13, tick: 10, types_hash: '71b37b9a8a57b848', _vid: 11}),
  (:Symbol {body_hash: 'eadd5fe3e381aa5a', deleted: false, end: 14, key: 'tinyshop/checkout.py::total', kind: 'function', name: 'total', path: 'tinyshop/checkout.py', qualname: 'total', sig_hash: '21cf4d659112d9e3', signature: 'total(items: list[Money], discount_percent: int=0) -> Money', source: 'def total(items: list[Money], discount_percent: int = 0) -> Money:\n    """Discounted subtotal plus tax on the discounted amount."""\n    subtotal = sum(items, Money(0))\n    discounted = discount_for(subtotal, discount_percent)\n    rate = load_settings()["tax_rate"]\n    return discounted + tax_for(discounted, rate)', start: 9, tick: 10, types_hash: '2f1f60eaaecce82a', _vid: 12}),
  (:Symbol {body_hash: '0bca2cbb44eeb080', deleted: false, end: 5, key: 'tinyshop/money.py::CURRENCY', kind: 'constant', name: 'CURRENCY', path: 'tinyshop/money.py', qualname: 'CURRENCY', sig_hash: '0bca2cbb44eeb080', signature: 'CURRENCY = "USD"', source: 'CURRENCY = "USD"', start: 5, tick: 10, types_hash: '', _vid: 13}),
  (:Symbol {body_hash: 'd744e38056dc1218', deleted: false, end: 29, key: 'tinyshop/money.py::Money', kind: 'class', name: 'Money', path: 'tinyshop/money.py', qualname: 'Money', sig_hash: '42ba610a86d15094', signature: 'class Money', source: 'class Money:\n    """An amount of money in dollars, as a Decimal quantized to the cent."""\n\n    def __init__(self, amount: Decimal | str):\n        self.amount = Decimal(amount).quantize(CENT, rounding=ROUND_HALF_UP)\n\n    @classmethod\n    def from_dollars(cls, dollars: str) -> "Money":\n        return cls(Decimal(dollars))\n\n    def __add__(self, other: "Money") -> "Money":\n        return Money(self.amount + other.amount)\n\n    def __eq__(self, other: object) -> bool:\n        return isinstance(other, Money) and other.amount == self.amount\n\n    def times(self, factor: Decimal | str) -> "Money":\n        return Money(self.amount * Decimal(factor))\n\n    def __str__(self) -> str:\n        return f"${self.amount:,.2f}"', start: 9, tick: 10, types_hash: '', _vid: 14}),
  (:Symbol {body_hash: '22811bab69aa35dd', deleted: false, end: 13, key: 'tinyshop/money.py::Money.__init__', kind: 'method', name: '__init__', path: 'tinyshop/money.py', qualname: 'Money.__init__', sig_hash: 'e6776d6141a04d2a', signature: '__init__(self, amount: Decimal | str)', source: '    def __init__(self, amount: Decimal | str):\n        self.amount = Decimal(amount).quantize(CENT, rounding=ROUND_HALF_UP)', start: 12, tick: 10, types_hash: '84bb7036976abb22', _vid: 15}),
  (:Symbol {body_hash: 'ef6e57c312e0caee', deleted: false, end: 17, key: 'tinyshop/money.py::Money.from_dollars', kind: 'method', name: 'from_dollars', path: 'tinyshop/money.py', qualname: 'Money.from_dollars', sig_hash: 'c39c0fbdb0dc4fdc', signature: 'from_dollars(cls, dollars: str) -> \'Money\'', source: '    @classmethod\n    def from_dollars(cls, dollars: str) -> "Money":\n        return cls(Decimal(dollars))', start: 16, tick: 10, types_hash: '86de6e6cf66953d9', _vid: 16}),
  (:Symbol {body_hash: '6e239c1e0602426d', deleted: false, end: 20, key: 'tinyshop/money.py::Money.__add__', kind: 'method', name: '__add__', path: 'tinyshop/money.py', qualname: 'Money.__add__', sig_hash: '64424d10ce4f1c1b', signature: '__add__(self, other: \'Money\') -> \'Money\'', source: '    def __add__(self, other: "Money") -> "Money":\n        return Money(self.amount + other.amount)', start: 19, tick: 10, types_hash: '67c28fc67fe8f1e3', _vid: 17}),
  (:Symbol {body_hash: 'b41ddc06665ec684', deleted: false, end: 23, key: 'tinyshop/money.py::Money.__eq__', kind: 'method', name: '__eq__', path: 'tinyshop/money.py', qualname: 'Money.__eq__', sig_hash: '64424d10ce4f1c1b', signature: '__eq__(self, other: object) -> bool', source: '    def __eq__(self, other: object) -> bool:\n        return isinstance(other, Money) and other.amount == self.amount', start: 22, tick: 10, types_hash: '6004154763c25e20', _vid: 18}),
  (:Symbol {body_hash: 'a182260f9db5ff67', deleted: false, end: 26, key: 'tinyshop/money.py::Money.times', kind: 'method', name: 'times', path: 'tinyshop/money.py', qualname: 'Money.times', sig_hash: '105f656933a01c1f', signature: 'times(self, factor: Decimal | str) -> \'Money\'', source: '    def times(self, factor: Decimal | str) -> "Money":\n        return Money(self.amount * Decimal(factor))', start: 25, tick: 10, types_hash: '99634a101f8eee50', _vid: 19}),
  (:Symbol {body_hash: '08dd92caa5386430', deleted: false, end: 29, key: 'tinyshop/money.py::Money.__str__', kind: 'method', name: '__str__', path: 'tinyshop/money.py', qualname: 'Money.__str__', sig_hash: '9626d105938f0039', signature: '__str__(self) -> str', source: '    def __str__(self) -> str:\n        return f"${self.amount:,.2f}"', start: 28, tick: 10, types_hash: '151bde88b2690c8e', _vid: 20}),
  (:Symbol {body_hash: 'a1209c690dac8a9d', deleted: true, deleted_tick: 10, end: 5, key: 'tinyshop/pricing.py::MAX_DISCOUNT_PERCENT', kind: 'constant', name: 'MAX_DISCOUNT_PERCENT', path: 'tinyshop/pricing.py', qualname: 'MAX_DISCOUNT_PERCENT', sig_hash: 'a1209c690dac8a9d', signature: 'MAX_DISCOUNT_PERCENT = 50', source: 'MAX_DISCOUNT_PERCENT = 50', start: 5, tick: 1, types_hash: '', _vid: 21}),
  (:Symbol {body_hash: 'eeb8f942a37308ec', deleted: true, deleted_tick: 10, end: 12, key: 'tinyshop/pricing.py::apply_discount', kind: 'function', name: 'apply_discount', path: 'tinyshop/pricing.py', qualname: 'apply_discount', sig_hash: 'f0f499a3c39cb029', signature: 'apply_discount(subtotal: Money, percent: int) -> Money', source: 'def apply_discount(subtotal: Money, percent: int) -> Money:\n    """Discounts apply to the pre-tax subtotal and are capped."""\n    if not 0 <= percent <= MAX_DISCOUNT_PERCENT:\n        raise ValueError(f"discounts are capped at {MAX_DISCOUNT_PERCENT}%")\n    return subtotal.times(1 - percent / 100)', start: 8, tick: 1, types_hash: '03f7aac16b3c8ab1', _vid: 22}),
  (:Symbol {body_hash: '5d5e69e82019b31f', deleted: false, end: 7, key: 'tinyshop/pricing.py::tax_for', kind: 'function', name: 'tax_for', path: 'tinyshop/pricing.py', qualname: 'tax_for', sig_hash: '5a0793ea22338816', signature: 'tax_for(amount: Money, rate: float) -> Money', source: 'def tax_for(amount: Money, rate: float) -> Money:\n    return amount.times(rate)', start: 6, tick: 10, types_hash: 'e7c10d7c9a4631fc', _vid: 23}),
  (:Symbol {body_hash: '353ed8023d22c5ee', deleted: false, end: 13, key: 'tinyshop/refunds.py::refund_amount', kind: 'function', name: 'refund_amount', path: 'tinyshop/refunds.py', qualname: 'refund_amount', sig_hash: '8bcd45e0c4f74529', signature: 'refund_amount(paid: Money, returned_fraction: float) -> Money', source: 'def refund_amount(paid: Money, returned_fraction: float) -> Money:\n    """Partial refunds are prorated and rounded to the nearest cent."""\n    # Guard against nonsense fractions (zero, negative, or more than everything).\n    if not 0 < returned_fraction <= 1:\n        raise ValueError(\n            "returned_fraction must be in (0, 1]"\n        )\n    return paid.times(returned_fraction)', start: 6, tick: 10, types_hash: 'c046a0159e5c5afe', _vid: 24}),
  (:Symbol {body_hash: 'be2bbf88f27cba49', deleted: false, end: 5, key: 'tinyshop/settings.py::SETTINGS_FILE', kind: 'constant', name: 'SETTINGS_FILE', path: 'tinyshop/settings.py', qualname: 'SETTINGS_FILE', sig_hash: 'be2bbf88f27cba49', signature: 'SETTINGS_FILE = Path(__file__).resolve().parent.parent / "config" / "settings.yaml"', source: 'SETTINGS_FILE = Path(__file__).resolve().parent.parent / "config" / "settings.yaml"', start: 5, tick: 1, types_hash: '', _vid: 25}),
  (:Symbol {body_hash: '8207536500a98638', deleted: false, end: 18, key: 'tinyshop/settings.py::load_settings', kind: 'function', name: 'load_settings', path: 'tinyshop/settings.py', qualname: 'load_settings', sig_hash: '4943fbd3d489f4fa', signature: 'load_settings() -> dict', source: 'def load_settings() -> dict:\n    out = {}\n    for line in SETTINGS_FILE.read_text().splitlines():\n        line = line.split("#", 1)[0].strip()\n        if ":" in line:\n            key, value = (p.strip() for p in line.split(":", 1))\n            try:\n                out[key] = float(value) if "." in value else int(value)\n            except ValueError:\n                out[key] = value\n    return out', start: 8, tick: 1, types_hash: 'a0f4b0ce7eaaa19f', _vid: 26}),
  (:Fact {author: 'agent', created: '2026-11-24T07:17:46+00:00', id: 'M1', kind: 'convention', reasons: ['Money changed'], search_text: 'Money', status: 'superseded', superseded_by: 'M10', tags: [], text: 'All money is stored as integer cents in Money; never use floats for amounts.', tick: 2, _vid: 27}),
  (:Fact {author: 'agent', created: '2026-11-24T07:17:46+00:00', id: 'M2', kind: 'fact', reasons: [], search_text: 'apply_discount', status: 'fresh', tags: [], text: 'Discounts apply to the pre-tax subtotal and are capped at 50%.', tick: 3, _vid: 28}),
  (:Fact {author: 'agent', created: '2026-11-24T07:17:46+00:00', id: 'M3', kind: 'fact', reasons: ['quoted text is gone from config/settings.yaml'], search_text: '', status: 'superseded', superseded_by: 'M9', tags: [], text: 'Sales tax is 8%, set in config/settings.yaml.', tick: 4, _vid: 29}),
  (:Fact {author: 'agent', created: '2026-11-24T07:17:46+00:00', id: 'M4', kind: 'fact', reasons: ['refund_amount depends on Money.times, whose type hints changed', 'builds on M1 (superseded)'], search_text: 'refund_amount', status: 'superseded', superseded_by: 'M11', tags: [], text: 'Refunds are prorated in integer cents and rounded to the nearest cent.', tick: 5, _vid: 30}),
  (:Fact {author: 'agent', created: '2026-11-24T07:17:46+00:00', id: 'M5', kind: 'gotcha', reasons: ['total changed', 'builds on M3 (superseded)'], search_text: 'total', status: 'superseded', superseded_by: 'M12', tags: [], text: 'Order total = discounted subtotal + tax on the discounted amount, so $100 with 10% off totals $97.20.', tick: 6, _vid: 31}),
  (:Fact {author: 'agent', created: '2026-11-24T07:17:46+00:00', id: 'M6', kind: 'howto', reasons: ['Money.__str__ changed'], search_text: 'Money.__str__', status: 'superseded', superseded_by: 'M13', tags: [], text: 'Format money with str(Money), which renders $D.CC.', tick: 7, _vid: 32}),
  (:Fact {author: 'agent', created: '2026-11-24T07:17:46+00:00', id: 'M7', kind: 'decision', reasons: [], search_text: 'CURRENCY', status: 'fresh', tags: [], text: 'tinyshop is single-currency: CURRENCY is fixed to USD.', tick: 8, _vid: 33}),
