UNWIND [{s: 27, d: 14, p: {at: '2026-11-24T07:17:46+00:00', hash: '6ba7932036c1623a', line: 6, mode: 'symbol', ok: true, quote: '', sig_hash: '42ba610a86d15094', snapshot: 'class Money:\n    """An amount of money, stored as integer cents."""\n\n    def __init__(self, cents: int):\n        if not isinstance(cents, int):\n            raise TypeError("Money is stored as integer cents")\n        self.cents = cents\n\n    @classmethod\n    def from_dollars(cls, dollars: str) -> "Money":\n        whole, _, frac = dollars.partition(".")\n        return cls(int(whole) * 100 + int((frac + "00")[:2]))\n\n    def __add__(self, other: "Money") -> "Money":\n        return Money(self.cents + other.cents)\n\n    def __eq__(self, other: object) -> bool:\n        return isinstance(other, Money) and other.cents == self.cents\n\n    def times(self, factor: float) -> "Money":\n        return Money(round(self.cents * factor))\n\n    def __str__(self) -> str:\n        return f"${self.cents // 100}.{self.cents % 100:02d}"', tick: 2}}, {s: 28, d: 40, p: {at: '2026-11-24T07:17:46+00:00', followed: ['tinyshop/pricing.py::apply_discount'], hash: 'eeb8f942a37308ec', line: 8, mode: 'symbol', ok: true, quote: '', sig_hash: 'f0f499a3c39cb029', snapshot: 'def discount_for(subtotal: Money, percent: int) -> Money:\n    """Discounts apply to the pre-tax subtotal and are capped."""\n    if not 0 <= percent <= MAX_DISCOUNT_PERCENT:\n        raise ValueError(f"discounts are capped at {MAX_DISCOUNT_PERCENT}%")\n    return subtotal.times(1 - percent / 100)', tick: 13}}, {s: 29, d: 2, p: {at: '2026-11-24T07:17:46+00:00', hash: 'fdfeeb0bceedecdf', line: 2, mode: 'quote', ok: false, quote: 'tax_rate: 0.08', sig_hash: '', snapshot: '# tinyshop settings\ntax_rate: 0.08\ncurrency: USD\nfree_shipping_over: 50', tick: 4}}, {s: 30, d: 24, p: {at: '2026-11-24T07:17:46+00:00', hash: '353ed8023d22c5ee', line: 6, mode: 'symbol', ok: true, quote: '', sig_hash: '8bcd45e0c4f74529', snapshot: 'def refund_amount(paid: Money, returned_fraction: float) -> Money:\n    """Partial refunds are prorated and rounded to the nearest cent."""\n    if not 0 < returned_fraction <= 1:\n        raise ValueError("returned_fraction must be in (0, 1]")\n    return paid.times(returned_fraction)', tick: 5}}, {s: 31, d: 12, p: {at: '2026-11-24T07:17:46+00:00', hash: '905d20b97d21cda7', line: 8, mode: 'symbol', ok: true, quote: '', sig_hash: '21cf4d659112d9e3', snapshot: 'def total(items: list[Money], discount_percent: int = 0) -> Money:\n    """Discounted subtotal plus tax on the discounted amount."""\n    subtotal = sum(items, Money(0))\n    discounted = apply_discount(subtotal, discount_percent)\n    rate = load_settings()["tax_rate"]\n    return discounted + tax_for(discounted, rate)', tick: 6}}, {s: 32, d: 20, p: {at: '2026-11-24T07:17:46+00:00', hash: 'ec125a51f7346404', line: 28, mode: 'symbol', ok: true, quote: '', sig_hash: '9626d105938f0039', snapshot: '    def __str__(self) -> str:\n        return f"${self.cents // 100}.{self.cents % 100:02d}"', tick: 7}}, {s: 33, d: 34, p: {at: '2026-11-24T07:17:46+00:00', hash: '', mode: 'external', ok: true, quote: '', sig_hash: '', snapshot: '', tick: 8}}, {s: 33, d: 13, p: {at: '2026-11-24T07:17:46+00:00', hash: '0bca2cbb44eeb080', line: 3, mode: 'symbol', ok: true, quote: '', sig_hash: '0bca2cbb44eeb080', snapshot: 'CURRENCY = "USD"', tick: 8}}, {s: 35, d: 2, p: {at: '2026-11-24T07:17:46+00:00', hash: '5d5218550af6aecd', line: 4, mode: 'quote', ok: true, quote: 'free_shipping_over: 50', sig_hash: '', snapshot: 'tax_rate: 0.08\ncurrency: USD\nfree_shipping_over: 50', tick: 9}}, {s: 60, d: 2, p: {at: '2026-11-24T07:17:46+00:00', hash: '44151a2dc80a8cea', line: 2, mode: 'quote', ok: true, quote: 'tax_rate: 0.0825', sig_hash: '', snapshot: '# tinyshop settings\ntax_rate: 0.0825\ncurrency: USD\nfree_shipping_over: 50', tick: 11}}, {s: 62, d: 14, p: {at: '2026-11-24T07:17:46+00:00', hash: 'd744e38056dc1218', line: 9, mode: 'symbol', ok: true, quote: '', sig_hash: '42ba610a86d15094', snapshot: 'class Money:\n    """An amount of money in dollars, as a Decimal quantized to the cent."""\n\n    def __init__(self, amount: Decimal | str):\n        self.amount = Decimal(amount).quantize(CENT, rounding=ROUND_HALF_UP)\n\n    @classmethod\n    def from_dollars(cls, dollars: str) -> "Money":\n        return cls(Decimal(dollars))\n\n    def __add__(self, other: "Money") -> "Money":\n        return Money(self.amount + other.amount)\n\n    def __eq__(self, other: object) -> bool:\n        return isinstance(other, Money) and other.amount == self.amount\n\n    def times(self, factor: Decimal | str) -> "Money":\n        return Money(self.amount * Decimal(factor))\n\n    def __str__(self) -> str:\n        return f"${self.amount:,.2f}"', tick: 12}}, {s: 65, d: 24, p: {at: '2026-11-24T07:17:46+00:00', hash: '353ed8023d22c5ee', line: 6, mode: 'symbol', ok: true, quote: '', sig_hash: '8bcd45e0c4f74529', snapshot: 'def refund_amount(paid: Money, returned_fraction: float) -> Money:\n    """Partial refunds are prorated and rounded to the nearest cent."""\n    # Guard against nonsense fractions (zero, negative, or more than everything).\n    if not 0 < returned_fraction <= 1:\n        raise ValueError(\n            "returned_fraction must be in (0, 1]"\n        )\n    return paid.times(returned_fraction)', tick: 14}}, {s: 67, d: 12, p: {at: '2026-11-24T07:17:46+00:00', hash: 'eadd5fe3e381aa5a', line: 9, mode: 'symbol', ok: true, quote: '', sig_hash: '21cf4d659112d9e3', snapshot: 'def total(items: list[Money], discount_percent: int = 0) -> Money:\n    """Discounted subtotal plus tax on the discounted amount."""\n    subtotal = sum(items, Money(0))\n    discounted = discount_for(subtotal, discount_percent)\n    rate = load_settings()["tax_rate"]\n    return discounted + tax_for(discounted, rate)', tick: 15}}, {s: 69, d: 20, p: {at: '2026-11-24T07:17:46+00:00', hash: '08dd92caa5386430', line: 28, mode: 'symbol', ok: true, quote: '', sig_hash: '9626d105938f0039', snapshot: '    def __str__(self) -> str:\n        return f"${self.amount:,.2f}"', tick: 16}}] AS r MATCH (a {_vid: r.s}), (b {_vid: r.d}) CREATE (a)-[x:CITES]->(b) SET x = r.p;
